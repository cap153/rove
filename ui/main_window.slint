import { Theme, FileRow, GridLine, TabInfo, SidebarItem, StagingItem, BreadcrumbSegment, IconSearch, IconClose, IconRefresh, IconNavArrow, IconPlus, IconSplit, SettingsNavItem, SettingsActionGroup, SettingsShortcutGroup, SettingsDriveItem } from "common.slint";
import { TabBar } from "tab_bar.slint";
import { Sidebar } from "sidebar.slint";
import { FileList } from "file_list.slint";
import { StagingTray } from "staging_tray.slint";
import { SettingsPage } from "settings_page.slint";
import { ActionEditorDialog } from "action_editor.slint";
import { NetworkLocationDialog } from "network_location_dialog.slint";
import { SingleLineEdit } from "single_line_edit.slint";
// SettingsDriveItem 需从入口文件再导出，否则 Rust 侧拿到的是废弃的内部别名。
export { SettingsDriveItem } from "common.slint";

// 将 common.slint 中的 Theme 全局从根文件再导出——
// Slint 规定：全局单例只有从根文件（或 slint! 宏）导出，Rust 侧才能通过
// ui.global::<Theme>() 访问，否则其值会被编译期内联。
export { Theme } from "common.slint";
export { DialogJumpWindow, JumpResult } from "dialog_jump.slint";

// 工具栏导航按钮（内部自居中，高度适应工具栏，杜绝偏上问题）
component nav-btn inherits Rectangle {
    in property <string> direction; // "left" | "right" | "up"
    in property <bool> enabled;
    callback clicked();

    width: 28px;
    height: 100%; // 占满工具栏 44px 高度

    // 内部视觉方块：精准 28px x 28px，完美垂直居中。
    // parent 即外层 44px 高的 nav-btn，引用合法且绝对居中。
    Rectangle {
        width: 28px;
        height: 28px;
        y: (parent.height - self.height) / 2;
        border-radius: 5px;
        background: (root.enabled && nav-ta.has-hover) ? Theme.bg-hover : transparent;

        IconNavArrow {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            direction: root.direction;
            size: 12px;
            icon-color: root.enabled
                ? (nav-ta.has-hover ? Theme.text-primary : Theme.text-secondary)
                : Theme.text-disabled;
        }
    }

    nav-ta := TouchArea {
        width: 100%;
        height: 100%;
        enabled: root.enabled;
        clicked => {
            root.clicked();
        }
    }
}

// Rove 主窗口。
//
// 布局（复刻 Pulse）：
//   ┌──────────────────────────────────────────┐
//   │ 标签栏（多标签、+ 新建、中键关闭）            │
//   │ 工具栏（前进/后退/向上 | 面包屑 | 新建/刷新 | 过滤）│
//   │ ┌────────┐ ┌───────────────────────────┐ │
//   │ │ 侧边栏  │ │ 虚拟文件列表               │ │
//   │ │  + 暂存 │ │                           │ │
//   │ └────────┘ └───────────────────────────┘ │
//   │ 状态栏                                    │
//   └──────────────────────────────────────────┘
export component MainWindow inherits Window {
    title: "Rove";
    no-frame: true; // 移除 Windows 原生黑色标题栏与边框，改由 TabBar 右侧自绘控制按钮
    // 废弃 Winit 内置缩放：全部交由 app.rs 的 WM_NCHITTEST 钩子接管，
    // 否则 Winit 会在客户区内部私自接管光标并触发缩放（导致右上角按钮区域出现调整大小箭头）。
    resize-border-width: 0px;
    // 核心修改 1：下调至 560px，解除 Windows 左右半屏贴靠（768px/640px）的尺寸封锁
    min-width: 560px;
    min-height: 500px;
    preferred-width: 1200px;
    preferred-height: 760px;
    background: Theme.bg-main;
    default-font-family: Theme.font-family;

    // ---- 状态（Rust 驱动） ----
    in-out property <[TabInfo]> tabs: [];
    in-out property <int> active-tab: 0;
    in-out property <bool> tab-loading: false;
    /// 当前激活的是否为设置页标签。
    in-out property <bool> settings-open: false;
    /// 设置页内是否有文本框持有键盘焦点（由 SettingsPage 上报）。
    /// 键盘处理器据此放行按键，否则全局 keymap 会把 Enter 吃掉。
    in-out property <bool> settings-text-focus: false;
    // 设置页数据。
    in-out property <[SettingsNavItem]> settings-nav-items: [];
    in-out property <[SettingsActionGroup]> settings-action-groups: [];
    in-out property <[SettingsShortcutGroup]> settings-shortcut-groups: [];
    in-out property <string> settings-recording-item: "";
    callback settings_shortcut_record(string, int);
    callback settings_shortcut_reset(string, int);
    callback settings_shortcut_unbind(string, int);
    callback settings_shortcut_add_alternate(string);
    callback settings_shortcut_remove_alternate(string, int);
    callback settings_shortcut_reset_all();
    // 设置页子页标题 / 描述 / 新增入口 / 内容高度。
    in-out property <string> settings-page-title: "本地右键菜单";
    in-out property <string> settings-page-desc: "";
    in-out property <bool> settings-show-add: true;
    in-out property <length> settings-content-height: 0px;
    // 是否显示隐藏文件（来自 config.show_hidden，驱动设置页「通用」开关）。
    in-out property <bool> show-hidden: false;
    callback show_hidden_toggled(bool);

    // ---- 搜索与索引看板（Rust 驱动） ----
    in-out property <bool> search-ready: true;
    in-out property <string> search-status-text: "索引未构建";
    in-out property <string> search-items-count: "0";
    in-out property <string> search-size-text: "0 MB";
    in-out property <int> search-drives-count: 0;
    in-out property <string> search-last-scan-time: "未记录";
    in-out property <[SettingsDriveItem]> search-drives: [];
    in-out property <[string]> search-builtin-exclusions: [];
    in-out property <[string]> search-custom-exclusions: [];
    in-out property <[string]> menu-hide-keywords: [];
    in-out property <string> menu-hide-input: "";
    in-out property <string> search-exclude-input: "";
    in-out property <bool> search-idle-enabled: true;
    in-out property <int> search-idle-minutes: 60;
    in-out property <int> search-max-results: 1000;
    callback search_rescan_clicked();
    callback search_drive_toggled(string, bool); // letter, enabled
    callback search_add_exclusion_clicked();
    callback search_remove_exclusion_clicked(string); // path
    callback search_pick_folder_clicked();
    callback search_reset_exclusions_clicked();
    callback menu_hide_add_clicked();
    callback menu_hide_remove_clicked(string);
    callback menu_hide_restore_clicked();
    callback search_idle_toggled(bool);
    callback search_idle_minutes_changed(int);
    callback search_max_results_changed(int);
    // 动作编辑器弹窗状态。
    in-out property <string> settings-editor-title: "";
    in-out property <bool> settings-editor-open: false;
    in-out property <string> settings-editor-id: "";
    in-out property <string> settings-editor-label: "";
    in-out property <string> settings-editor-group: "";
    in-out property <string> settings-editor-target: "any";
    in-out property <string> settings-editor-extensions: "";
    in-out property <string> settings-editor-program: "";
    in-out property <string> settings-editor-args: "";
    // 编辑器「层级归属」可选分组（含内置的「一级菜单」）。
    in-out property <[string]> settings-editor-group-options: ["一级菜单"];
    // 添加网络位置弹窗状态。
    in-out property <bool> network-dialog-open: false;
    in-out property <string> network-dialog-title: "添加网络位置";
    in-out property <string> network-dialog-server: "";
    in-out property <string> network-dialog-alias: "";
    in-out property <string> network-dialog-error: "";
    callback network_dialog_connect();
    callback network_dialog_cancel();
    in-out property <[SidebarItem]> sidebar-items: [];
    in-out property <string> sidebar-active-id: "";
    in-out property <[FileRow]> file-rows: [];
    in-out property <int> file-total: 0;
    in-out property <bool> file-loading: false;
    /// 图标视图“展开名称”目标（单个选中 / 重命名）：条目绝对索引与完整名称。
    in-out property <int> file-expand-index: -1;
    in-out property <string> file-expand-name: "";
    /// 浮层名称的逐行高亮分段与框宽（Rust 与切行同源算出）。
    in-out property <[GridLine]> file-expand-lines: [];
    in-out property <length> file-expand-box-w: 0px;
    // 分屏右栏数据源（分屏关闭时不使用）。
    in-out property <[FileRow]> file-rows-right: [];
    in-out property <int> file-total-right: 0;
    in-out property <bool> file-loading-right: false;
    in-out property <int> file-expand-index-right: -1;
    in-out property <string> file-expand-name-right: "";
    in-out property <[GridLine]> file-expand-lines-right: [];
    in-out property <length> file-expand-box-w-right: 0px;
    in-out property <string> sort-key: "name";
    in-out property <bool> sort-ascending: true;
    in-out property <string> rename-path: "";
    /// 重命名发生在哪一栏（0 左 / 1 右）。不能用 active-pane：
    /// 重命名期间点击别处会切换聚焦面板，输入框就会跳到另一栏。
    in-out property <int> rename-pane: 0;
    /// 重命名输入框的当前文本（图标视图的浮层输入框双向绑定到它）。
    in-out property <string> rename-text: "";
    /// 重命名时只选主名（不含扩展名）的结束字节偏移；-1 表示全选。
    in-out property <int> rename-select-end: -1;
    in-out property <[StagingItem]> staging-items: [];
    in-out property <bool> staging-expanded: true;
    /// 展开/收起变化时上报给 Rust 落盘；启动时灌入同值会被 Rust 侧幂等挡掉。
    changed staging-expanded => {
        root.staging_expanded_changed(root.staging-expanded);
    }
    in-out property <[BreadcrumbSegment]> breadcrumbs: [];
    in-out property <string> filter-text: "";
    in-out property <bool> can-go-back: false;
    in-out property <bool> can-go-forward: false;
    in-out property <bool> can-go-up: false;
    in-out property <string> status-left: "";
    in-out property <string> status-right: "";
    in-out property <string> status-job: "";
    /// 状态栏文案是否为危险提示（失败 / 超限 / 删除等），红色高亮由 Rust 判定。
    in-out property <bool> status-danger: false;
    /// 面包屑路径编辑态（点击地址栏空白处进入，Enter 确认 / Esc 取消）。
    in-out property <bool> path-editing: false;
    /// 本次地址栏编辑中，输入框是否确实获得过焦点。
    /// 与重命名同理：只有确认“真获过焦”，才能用“失焦”去做退出编辑的判断，
    /// 否则创建阶段的假失焦会让编辑框刚弹出就自行关闭。
    ///
    /// 注：本想按规则把 focus() 移到父级 changed 里，但 Slint 不允许访问 `if` 块内声明的
    /// 元素 id（Cannot access id 'path-edit-input'），所以焦点仍由输入框自身 init 请求；
    /// 退出编辑本来就由所有点击路径的 clear-all-focus() 确定性覆盖，不依赖失焦。
    private property <bool> path-edit-had-focus: false;
    changed path-editing => {
        root.path-edit-had-focus = false;
    }
    in-out property <string> path-edit-text: "";
    /// 侧栏分区拖拽排序指示器（Rust 计算落点）。
    in-out property <bool> sidebar-drop-visible: false;
    in-out property <length> sidebar-drop-y: 0px;
    /// 标签拖动交换的视觉状态（Rust 计算，透传给 TabBar）。
    in-out property <int> tab-drag-index: -1;
    in-out property <int> tab-drop-slot: -1;
    in-out property <bool> tab-drop-visible: false;
    /// 文件列表可视高度（Rust 只读，用于虚拟窗口计算；由 FileList 绑定）。
    in-out property <length> list-height;
/// 视图模式（Pulse 式视图切换）。直通 FileList。
in-out property <string> view-mode <=> file-list.view-mode;
/// 「路径」列显隐（仅回收站开启）。直通 FileList。
in-out property <bool> show-path-column <=> file-list.show-path-column;
out property <int> cells-per-row: file-list.cells-per-row;
    out property <length> view-width: file-list.view-width;
out property <length> row-height-out: file-list.row-height-out;
    /// 格子实际宽/高（Rust 卡选与拖放定位用；高度按真实字体行高算出来）
    out property <length> cell-w-out: file-list.cell-w-out;
    out property <length> cell-h-out: file-list.cell-h-out;
    /// 图标网格均分后的间隙：左右栏宽度可能不同，各自导出供框选命中用。
    out property <length> grid-gap-out: file-list.grid-gap-out;
    out property <length> grid-gap-right-out: file-list-right.grid-gap-out;
    out property <bool> is-icons-view-out: file-list.is-icons-view;
    /// 过滤输入框是否持有焦点（焦点在内时不响应应用级快捷键）。
    in-out property <bool> filter-has-focus;
    filter-has-focus: filter-input.has-focus;
    /// 文件列表可视高度（Rust 只读，用于虚拟窗口计算）。
    list-height: file-list.view-height;

    // ---- 分屏（步骤 1：UI 搭建，核心逻辑待后续） ----
    in-out property <bool> is-split: false;
    in-out property <int> active-pane: 0;
    in-out property <float> split-ratio: 0.5; // 左右分屏**显示**比例（受限后）
    // 分屏**期望**比例：用户拖出来的值（Rust 存 tab.split_ratio 并回推这个），
    // 窗口变窄时只降级 split-ratio，窗口变宽后可自动回到 want。
    in-out property <float> split-ratio-want: 0.5;

    // 单栏最小宽度：容纳 1 列超大图标（196px）+ 内容边距，再留一点余量
    pure function min-pane-width() -> length {
        return 240px;
    }

    // 辅助函数：当前窗口下侧边栏可用宽度上限
    // 单栏至少留 min-pane-width；双栏 min-pane-width*2 + 8px
    pure function max-sidebar-width() -> length {
        let right_min = root.is-split ? (root.min-pane-width() * 2 + 8px) : root.min-pane-width();
        return max(70px, root.width - right_min);
    }

    // 核心修改 3：侧边栏宽度分“用户期望宽”与“实际显示宽”两层。
    //
    // 旧实现只有一个 sidebar-w，窗口变窄（最小化时 winit 甚至上报 0x0）
    // 会把用户设定的宽度永久改写并落盘，还原后自然变窄。
    // 现在：
    //   sidebar-want = 用户拖拽设定的宽度，唯一被持久化的值；
    //   sidebar-w     = min(want, 当前窗口允许的最大值)，只是显示层降级。
    // 于是“窗口挤压”只是暂时受限，窗口恢复后自动长回 want。
    // 注：这里不用属性绑定而是用 changed 处理器——绑定会让
    // max-sidebar-width() 依赖 root.width，而 root.width 又受布局反哺，形成绑定环。
    in-out property <length> sidebar-want: 236px;
    in-out property <length> sidebar-w: 236px;

    /// 分屏可用宽度（窗口宽 - 侧栅宽）。
    /// **不能**在属性绑定里直接写 `root.width - root.sidebar-w` 或读 `file-split.width`：
    /// 窗口宽度本身会受布局首选尺寸反哺，直接绑会形成绑定环（Slint 会警告并可能 panic）。
    /// 所以跟 sidebar-w 一样，用 changed 处理器算好存起来，子元素只读这个普通属性。
    private property <length> split-avail: 0px;

    function sync-split-avail() {
        root.split-avail = max(0px, root.width - root.sidebar-w);
    }

    function sync-sidebar-width() {
        root.sidebar-w = min(root.sidebar-want, root.max-sidebar-width());
    }

    // 分屏比例约束：任何一栏都不得窄于 min-pane-width（否则图标被裁切并出现横向滚动条）。
    // 窗口变窄（最大化→还原、缩放、贴靠）时必须重新钳制：比例是在宽窗口下拖出来的，
    // 直接沿用会让某一栏被压到几十像素。
    // 只用 root.width / sidebar-w 推算，不读布局派生值（避免处理器内拿到上帧的几何）。
    function clamp-split-ratio() {
        if (!root.is-split) {
            return;
        }
        let avail = root.split-avail - 8px;
        if (avail < 1px) {
            return;
        }
        let min_ratio = max(0.2, min(0.45, root.min-pane-width() / avail));
        root.split-ratio = max(min_ratio, min(1.0 - min_ratio, root.split-ratio-want));
    }

    // 窗口宽度变化（最小化/还原/贴靠/缩放）：只降级显示，绝不动 want
    changed width => {
        root.sync-sidebar-width();
        root.sync-split-avail();
        root.clamp-split-ratio();
    }

    // 用户拖拽了宽度：want 变化后同步显示（保持两栏最小值约束）
    changed sidebar-want => {
        root.sync-sidebar-width();
    }

    // 页面/标签切换时 Rust 会回推 want，这里重新受限
    changed split-ratio-want => {
        root.clamp-split-ratio();
    }

    // 侧栏显示宽变化（被窗口挤压或拖拽）后，可分配给两栏的空间也变了
    changed sidebar-w => {
        root.sync-split-avail();
        root.clamp-split-ratio();
    }

    // 切换分屏状态时执行约束重置
    changed is-split => {
        if (root.is-split) {
            root.sync-sidebar-width();
            root.split-ratio-want = 0.5;
            root.split-ratio = 0.5;
        }
    }

    // ---- 回调（Rust 处理） ----
    callback new_tab_requested();
    callback tab_activated(id: int);
    callback tab_closed(id: int);
    callback tab_drag(index: int, phase: int, x: length);

    // 窗口控制（无边框标题栏）：由 TabBar 右侧按钮触发；
    // 窗口移动不使用回调，TabBar 内直接用原生 WindowMoveArea。
    callback window_minimize();
    callback window_maximize();
    callback window_close();
    callback nav_back();
    callback nav_forward();
    callback nav_up();
    callback breadcrumb_clicked(path: string);
    callback path_edit_committed(path: string);
    /// 诊断：地址栏面包屑流量几何（视口 / 内容 / 偏移 / 段数）。
    callback crumb_dbg(view_w: length, content_w: length, content_x: length, n: int);
    /// 诊断：地址栏空白处被点到（进入编辑态）。
    callback crumb_edit_clicked(x: length, content_x: length);

    // 把面包屑的各段拼回完整路径。
    // 磁盘路径各段自带前缀（`C:\`、`C:\Users`），直接取最后一段即可；
    // UNC 路径的分段是 "\\\\服务器" 与 "\\\\服务器\\共享"，同样取最后一段；
    // 关键是**不能**用 join 重拼（Slint 的 path 处理会吃掉前导反斜杠）。
    pure function join-crumbs(segs: [BreadcrumbSegment]) -> string {
        if (segs.length == 0) {
            return "";
        }
        let last = segs[segs.length - 1];
        return last.path == "" ? last.label : last.path;
    }
    callback sidebar_header_drag(index: int, phase: int, y: length);
    callback sidebar_network_drag(index: int, phase: int, y: length);
    callback sidebar_quick_drag(index: int, phase: int, y: length);
    callback sidebar_item_activated(id: string);
    callback sidebar_item_right_clicked(id: string);
    /// 仅在用户拖拽结束时上报（落盘用）；窗口尺寸变化导致的被动收缩不上报。
    callback sidebar_width_changed(float);
    callback file_row_pointer_event(index: int, event: PointerEvent, x: length, y: length);
    callback file_row_double_clicked(index: int);
    callback file_header_clicked(key: string);
    callback file_scroll_changed(offset: length);
    /// 排查用：滚动位置变化时连同几何一并上报（Rust 仅在重命名期间落日志）。
    callback file_scroll_dbg(pane: int, offset: length, content-h: length, view-h: length, min-y: length, content-y: length);
    /// 用户主动滚动信号（滚轮/拖滚动条），用于解除重命名期的假滚动拦截。
    callback file_scroll_user_input(pane: int);
    /// 排查用：重命名输入框生命周期/焦点状态。
    callback file_rename_dbg(pane: int, kind: string, has_focus: bool);
    /// 排查用：图标视图名字区/浮层的全部尺寸与判断结果。
    callback file_name_debug(pane: int, info: string, name: string);
    /// 排查用：列表/滚动条宽度几何。
    callback file_sb_debug(pane: int, info: string);
    /// 重命名输入内容变了（Rust 用它把超长名字截到 Windows 上限）。
    callback file_rename_text_changed(pane: int, text: string);
    // 分屏右栏滚动 / 分隔条比例落盘
    callback file_scroll_changed_right(offset: length);
    callback split_ratio_changed(ratio: float);
    callback file_background_pointer_event(event: PointerEvent, x: length, y: length);
    callback file_rubber_band_selected(x1: length, y1: length, x2: length, y2: length);
    callback file_rubber_band_move(x1: length, y1: length, x2: length, y2: length);
    callback file_rename_committed(path: string, new_name: string);
    callback file_rename_cancelled();
    callback staging_item_removed(index: int);
    callback staging_clear_requested();
    callback staging_copy_here_requested();
    callback staging_move_here_requested();
    callback staging_expanded_changed(bool);
    callback filter_edited(text: string);
    callback new_folder_requested();
    callback refresh_requested();
    callback paste_requested();
    callback view_picker_requested();
    callback settings_requested();
    // 分屏：切换分屏开关 / 某栏获得焦点（active-pane 高亮与地址栏归属）
    callback toggle_split();
    callback pane_focused(int);
    callback settings_nav_changed(id: string);
    // 诊断：设置页滚动几何（视口 / 内容 / 实测首选高度）。
    callback settings_scroll_debug(viewport: length, content: length, preferred: length);
    callback settings_action_toggled(id: string, enabled: bool);
    callback settings_group_toggled(name: string, expanded: bool);
    callback settings_action_add();
    callback settings_action_edit(id: string);
    callback settings_action_delete(id: string);
    callback settings_editor_save(
        id: string,
        label: string,
        group: string,
        target: string,
        extensions: string,
        program: string,
        args: string
    );
    callback settings_editor_cancel();
    callback settings_editor_browse();
    in-out property <bool> can-paste: false;

    // ---- 布局常量 ----
    private property <length> topbar-h: 82px; // 标签栏 38 + 工具栏 44
    private property <length> statusbar-h: 28px;

    /// 文件列表滚动到顶端（Rust 调用）。
    public function scroll-list-to-top() {
        file-list.scroll-to-top();
    }

    // 供 Rust 强制对齐滚动条（直接操作底层 Flickable，不依赖属性 changed 事件）。
    public function set-file-scroll-y(pane: int, v: length) {
        if (pane == 0) {
            file-list.set-scroll-y(v);
        } else {
            file-list-right.set-scroll-y(v);
        }
    }

    public function scroll_tabs_to_end() {
        tab-bar.scroll-to-end();
    }

    public function scroll_tabs_to_index(i: int) {
        tab-bar.scroll-to-index(i);
    }

    /// 文件列表行命中测试（外部拖入定位目标文件夹，Rust 调用）。
    public function row-hit-test(wx: length, wy: length) -> int {
        file-list.row-hit-test(wx - file-list.absolute-position.x, wy - file-list.absolute-position.y);
    }

    /// 获取指定行相对主窗口的坐标几何 [x, y, width, height]（用于原生高亮框绘制）。
    public function get-item-rect(idx: int) -> [length] {
        let r = file-list.get-item-rect(idx);
        return [r[0] + file-list.absolute-position.x, r[1] + file-list.absolute-position.y, r[2], r[3]];
    }

    /// 获取指定窗口坐标下的目标 pane 和行索引，返回 [pane_index, row_index]。
    /// 分屏时以右栏左边界为分界判定命中哪一栏。
    public function get-drop-target(wx: length, wy: length) -> [int] {
        if (root.is-split) {
            if (wx >= file-list-right.absolute-position.x) {
                return [1, file-list-right.row-hit-test(wx - file-list-right.absolute-position.x, wy - file-list-right.absolute-position.y)];
            }
        }
        return [0, file-list.row-hit-test(wx - file-list.absolute-position.x, wy - file-list.absolute-position.y)];
    }

    /// 获取指定 pane 和行索引相对窗口的坐标几何 [x, y, width, height]。
    public function get-item-rect-target(pane: int, idx: int) -> [length] {
        if (pane == 0) {
            let r = file-list.get-item-rect(idx);
            return [r[0] + file-list.absolute-position.x, r[1] + file-list.absolute-position.y, r[2], r[3]];
        }
        let r = file-list-right.get-item-rect(idx);
        return [r[0] + file-list-right.absolute-position.x, r[1] + file-list-right.absolute-position.y, r[2], r[3]];
    }

    /// 拖出上膛：行按下时禁用 flick 交互滚动，让拖动只发起 OLE 拖放。
    /// 分屏时两栏都上膛（隐藏的右栏无副作用），保证从任意一栏都能发起拖出。
    public function set-drag-armed(v: bool) {
        file-list.set-drag-armed(v);
        file-list-right.set-drag-armed(v);
    }

    /// 统一失焦：同时释放搜索框光标并退出地址栏编辑态。
    public function clear-all-focus() {
        // 核心修复：点击背景/侧栏/工具栏等位置时，若有进行中的重命名，先按已输入文本提交，
        // 与资源管理器一致（失焦即确认）。必须在上面的 clear-focus 之前做，
        // 否则输入框已被销毁、取不到用户输入的文本。
        file-list.commit-rename();
        file-list-right.commit-rename();
        filter-input.blur-input();
        root.path-editing = false;
    }

    /// 聚焦并全选搜索框（Ctrl+F，Rust 调用）。
    public function focus-search-box() {
        filter-input.focus-input();
        filter-input.select-all-text();
    }

    /// 进入地址栏编辑态（点击地址栏 / 「+」新建标签共用，Rust 可调）。
    /// 必须先预填再置 true：if 块重建时输入框 init 会 focus + select-all，
    /// 顺序反过来只会选中上一次编辑的残留文本。
    public function begin-path-edit() {
        // UNC 路径不能重拼（会吃掉前导反斜杠），直接取最后一段的原始 path。
        root.path-edit-text = root.breadcrumbs.length > 0 ? join-crumbs(root.breadcrumbs) : "";
        root.path-editing = true;
    }

    /// 拖拽悬停高亮：把命中的目标行索引暴露给 Rust（拖入/拖出悬停时设置）。
    in-out property <int> file-drop-hover-index <=> file-list.drop-hover-index;

    /// 标题栏空白拖拽区的起止坐标（供 Win32 WM_NCHITTEST 判定，见 app.rs drag_hittest）。
    out property <length> drag-area-x: tab-bar.drag-x;
    out property <length> drag-area-w: tab-bar.drag-w;

    /// 窗口是否处于最大化（Rust 经 IsZoomed 实时同步）。
    ///
    /// 刻意不用 Slint 内置的 `maximized`：那个是**命令属性**（置 true 会真的
    /// 下发最大化），拿它回传 OS 状态会形成命令回路——例如最小化一个已最大化
    /// 的窗口时 IsZoomed 返回 0，回传就会把用户的最大化状态误还原。故用独立的
    /// 无副作用属性，仅用于驱动 resize-border-width 动态归零。
    in-out property <bool> win-maximized: false;

    VerticalLayout {
        spacing: 0px;

        // ---- 标签栏 ----
        tab-bar := TabBar {
            tabs: root.tabs;
            active-tab: root.active-tab;
            loading: root.tab-loading;
            drag-index: root.tab-drag-index;
            drop-slot: root.tab-drop-slot;
            tab-drop-visible: root.tab-drop-visible;
            tab_drag(index, phase, x) => { root.tab_drag(index, phase, x); }
            tab_activated(id) => {
                root.clear-all-focus();
                root.tab_activated(id);
            }
            tab_closed(id) => {
                root.tab_closed(id);
            }
            new_tab_requested() => {
                root.clear-all-focus();
                root.new_tab_requested();
            }
            window_minimize => { root.window_minimize(); }
            window_maximize => { root.window_maximize(); }
            window_close => { root.window_close(); }
            settings_requested => {
                root.clear-all-focus();
                root.settings_requested();
            }
        }

        // ---- 工具栏（设置页整体收起，内容从标签栏下方直接开始）----
        Rectangle {
            visible: !root.settings-open;
            height: root.settings-open ? 0px : 44px;
            background: Theme.bg-main;

            // 工具栏空白处点击：退出一切输入聚焦
            TouchArea {
                width: 100%;
                height: 100%;
                clicked => {
                    root.clear-all-focus();
                }
            }

            HorizontalLayout {
                x: 0px;
                y: 0px;
                width: 100%;
                height: parent.height;
                spacing: 4px;
                // ⚠️ 严禁在此处加 alignment: center！那是水平居中，会导致整行被挤压缩在屏幕中央！
                padding-left: 8px;
                padding-right: 10px;

                // 导航按钮组（间距收拢至 2px，紧凑协调）
                nav-btn {
                    direction: "left";
                    enabled: root.can-go-back;
                    clicked => { root.nav_back(); }
                }
                nav-btn {
                    direction: "right";
                    enabled: root.can-go-forward;
                    clicked => { root.nav_forward(); }
                }
                nav-btn {
                    direction: "up";
                    enabled: root.can-go-up;
                    clicked => { root.nav_up(); }
                }

                // 分隔竖线。
                Rectangle {
                    width: 1px;
                    height: 20px;
                    y: (parent.height - 20px) / 2;
                    background: Theme.border;
                }

                // 面包屑地址栏（复刻 Pulse：常态即为 28px 圆角输入框，与右侧搜索框严格统一）
                Rectangle {
                    horizontal-stretch: 1;
                    min-width: 0px; // 窄窗口下允许压缩到 0，绝不把其他按钮挤出窗口
                    height: 28px;
                    y: (parent.height - self.height) / 2;
                    border-radius: 6px;
                    background: Theme.bg-input;
                    border-width: 1px;
                    border-color: root.path-editing ? Theme.accent : Theme.border;
                    clip: true;

                    // 1. 编辑态：文本输入框直接嵌入
                    if (root.path-editing) : path-edit-input := SingleLineEdit {
                        x: 8px;
                        width: parent.width - 16px;
                        height: parent.height;
                        text <=> root.path-edit-text;
                        font-size: 12px;
                        text-color: Theme.text-primary;

                        accepted(t) => {
                            root.path_editing = false;
                            root.path_edit_committed(t);
                        }

                        key-pressed(event) => {
                            if (event.text == Key.Escape) {
                                root.path-editing = false;
                                return EventResult.accept;
                            }
                            return EventResult.reject;
                        }

                        // 失焦即退出编辑（视为取消）。
                        // 必须先确认本次确实获过焦，否则创建初期的假失焦会立即关掉编辑框。
                        focus-changed(has) => {
                            if (has) {
                                root.path-edit-had-focus = true;
                            } else if (root.path-edit-had-focus && root.path-editing) {
                                root.path-editing = false;
                            }
                        }

                        // 注：焦点仍在 init 里请求（Slint 不允许从 if 块外部访问其内元素 id）。
                        // 退出编辑不依赖失焦：所有点击路径都会走 clear-all-focus()。
                        init => {
                            self.focus-input();
                            self.select-all-text();
                        }
                    }

                    // 2. 非编辑态：展示面包屑胶囊流，点击空白处无缝进入编辑
                    if (!root.path-editing) : crumbs-flick := Flickable {
                        x: 4px;
                        width: parent.width - 8px;
                        height: parent.height;
                        // 末尾固定留 24px 空白：滚到最右侧时仍有一块可点击区域进入编辑态
                        content-width: max(crumbs-layout.preferred-width + 24px, self.width);
                        interactive: true;

                        // 面包屑变化/重建后滚到最右端（显示最深路径）。
                        //
                        // 旧实现直接赋 content-x = -10000px：此时布局还没算完，
                        // content-width 可能还是旧值（或 0），越界修正拿不到正确下限，
                        // 结果可能停在任意偏移 —— 窄窗口下的“地址栏一片空白”就是这么来的。
                        // 改为：先挂一个待滚动标记，等下一帧布局落定后再算精确下限。
                        private property <[BreadcrumbSegment]> breadcrumbs-watch: root.breadcrumbs;
                        private property <bool> scroll-end-pending: true;
                        changed breadcrumbs-watch => {
                            crumbs-flick.scroll-end-pending = true;
                        }
                        Timer {
                            interval: 0ms;
                            running: crumbs-flick.scroll-end-pending;
                            triggered => {
                                crumbs-flick.scroll-end-pending = false;
                                crumbs-flick.content-x = min(0px, crumbs-flick.width - crumbs-flick.content-width);
                                root.crumb_dbg(
                                    crumbs-flick.width,
                                    crumbs-flick.content-width,
                                    crumbs-flick.content-x,
                                    root.breadcrumbs.length,
                                );
                            }
                        }

                        // 点击/滚轮层：必须跟随**视口**而不是内容。
                        // Flickable 的子元素处在内容坐标系，会随 content-x 一起左移，
                        // 直接写 100% 会在滚动后整体滑出可视区 —— 这就是
                        // “窄窗口下点右侧空白没反应”的原因（未滚动时 x=0 才侥幸正常）。
                        // 用 -content-x 抵消滚动，它便永远盖住可见区域。
                        crumb-bg-ta := TouchArea {
                            x: -crumbs-flick.content-x;
                            width: 100%;
                            height: 100%;
                            mouse-cursor: text; // 悬停显示文本光标（与资源管理器一致）
                            clicked => {
                                root.begin-path-edit();
                                root.crumb_edit_clicked(self.mouse-x, crumbs-flick.content-x);
                            }
                            // 竖向滚轮映射为横向滚动（地址栏只会在横向上溢出）
                            scroll-event(event) => {
                                let d = event.delta-y != 0px ? event.delta-y : event.delta-x;
                                if (d != 0px) {
                                    crumbs-flick.scroll-end-pending = false;
                                    let min-x = min(0px, crumbs-flick.width - crumbs-flick.content-width);
                                    crumbs-flick.content-x = max(min-x, min(0px, crumbs-flick.content-x + d));
                                    return EventResult.accept;
                                }
                                return EventResult.reject;
                            }
                        }

                        crumbs-layout := HorizontalLayout {
                            x: 0px;
                            y: 0px;
                            height: parent.height;
                            spacing: 0px;

                            for seg[i] in root.breadcrumbs : Rectangle {
                                height: parent.height;
                                width: crumb-text.preferred-width + (i == 0 ? 12px : 24px);

                                // 分隔箭头 "›"
                                if (i > 0) : Text {
                                    x: 0px;
                                    width: 12px;
                                    height: parent.height;
                                    text: "›";
                                    color: Theme.text-disabled;
                                    font-size: 12px;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }

                                // 单个路径胶囊（悬停微底色）
                                Rectangle {
                                    x: i == 0 ? 0px : 12px;
                                    width: parent.width - (i == 0 ? 0px : 12px);
                                    height: 22px;
                                    y: (parent.height - 22px) / 2;
                                    border-radius: 4px;
                                    background: crumb-ta.has-hover ? Theme.bg-hover : transparent;

                                    crumb-text := Text {
                                        text: seg.label;
                                        color: i == root.breadcrumbs.length - 1 ? Theme.text-primary : Theme.text-secondary;
                                        font-size: 12px;
                                        font-weight: i == root.breadcrumbs.length - 1 ? 600 : 400;
                                        vertical-alignment: center;
                                        horizontal-alignment: center;
                                        width: 100%;
                                        height: 100%;
                                        overflow: elide;
                                    }

                                    crumb-ta := TouchArea {
                                        width: 100%;
                                        height: 100%;
                                        mouse-cursor: text; // 整条地址栏统一文本光标（与资源管理器一致）
                                        clicked => {
                                            root.breadcrumb_clicked(seg.path);
                                        }
                                        // 滚轮作用在胶囊上时同样横向滚动整条地址栏
                                        scroll-event(event) => {
                                            let d = event.delta-y != 0px ? event.delta-y : event.delta-x;
                                            if (d != 0px) {
                                                crumbs-flick.scroll-end-pending = false;
                                                let min-x = min(0px, crumbs-flick.width - crumbs-flick.content-width);
                                                crumbs-flick.content-x = max(min-x, min(0px, crumbs-flick.content-x + d));
                                                return EventResult.accept;
                                            }
                                            return EventResult.reject;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                // 刷新按钮（28px x 28px，与左侧导航按钮尺寸完全对称）
                Rectangle {
                    width: 28px;
                    height: 28px;
                    y: (parent.height - self.height) / 2;
                    border-radius: 5px;
                    background: refresh-ta.has-hover ? Theme.bg-hover : transparent;

                    IconRefresh {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        size: 14px;
                        icon-color: refresh-ta.has-hover ? Theme.text-primary : Theme.text-secondary;
                    }

                    refresh-ta := TouchArea {
                        width: 100%;
                        height: 100%;
                        clicked => {
                            root.refresh_requested();
                        }
                    }
                }

                // 新建文件夹按钮（改用矢量十字，高度绝对与刷新按钮水平对齐）
                Rectangle {
                    width: 28px;
                    height: 28px;
                    y: (parent.height - self.height) / 2;
                    border-radius: 5px;
                    background: newfolder-ta.has-hover ? Theme.bg-hover : transparent;

                    IconPlus {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        size: 12px;
                        icon-color: newfolder-ta.has-hover ? Theme.text-primary : Theme.text-secondary;
                    }

                    newfolder-ta := TouchArea {
                        width: 100%;
                        height: 100%;
                        clicked => {
                            root.new_folder_requested();
                        }
                    }
                }

                // 视图切换（Pulse 式下拉）。
                Rectangle {
                    width: 28px;
                    height: 28px;
                    y: (parent.height - self.height) / 2;
                    border-radius: 5px;
                    background: view-ta.has-hover ? Theme.bg-hover : transparent;

                    Text {
                        text: "▦";
                        color: Theme.text-secondary;
                        font-family: Theme.symbol-font-family;
                        font-size: 13px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        width: 100%;
                        height: 100%;
                        y: -0.3px;
                    }

                    view-ta := TouchArea {
                        width: 100%;
                        height: 100%;
                        clicked => {
                            root.view_picker_requested();
                        }
                    }
                }

                // 分屏切换按钮（放在视图按钮与搜索框之间）。28x28，激活时高亮。
                Rectangle {
                    width: 28px;
                    height: 28px;
                    y: (parent.height - self.height) / 2;
                    border-radius: 5px;
                    background: root.is-split ? Theme.accent : (split-ta.has-hover ? Theme.bg-hover : transparent);

                    IconSplit {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        size: 13px;
                        icon-color: root.is-split ? Theme.accent-text : (split-ta.has-hover ? Theme.text-primary : Theme.text-secondary);
                    }

                    split-ta := TouchArea {
                        width: 100%;
                        height: 100%;
                        clicked => {
                            root.toggle_split();
                        }
                    }
                }

                // 当前目录过滤搜索（全局 MFT 搜索为后续阶段）。
                Rectangle {
                    width: 200px;
                    height: 28px;
                    y: (parent.height - 28px) / 2;
                    border-radius: 6px;
                    background: Theme.bg-input;
                    border-width: 1px;
                    border-color: Theme.border;

                    // 底层兜底:点击图标 / 边距等空白处也能聚焦输入框。
                    // 落在输入框上的点击由上层 TextInput 自己处理(光标定位)。
                    search-frame-ta := TouchArea {
                        width: 100%;
                        height: 100%;
                        clicked => {
                            filter-input.focus-input();
                        }
                    }

                    HorizontalLayout {
                        spacing: 4px;
                        padding-left: 8px;
                        padding-right: 6px;
                        height: parent.height;

                        IconSearch {
                            width: 14px;
                            height: 14px;
                            y: (parent.height - self.height) / 2;
                            size: 13px;
                        }

                        filter-input := SingleLineEdit {
                            // 独占剩余宽度(占位文字已移出布局),整个框可点。
                            horizontal-stretch: 1;
                            height: parent.height;
                            text <=> root.filter-text;
                            font-size: 12px;
                            text-color: Theme.text-primary;

                            edited(t) => {
                                root.filter_edited(t);
                            }

                            // 点击搜索框（搜聚焦）也是“点击其他位置”：先提交进行中的重命名，
                            // 并确定性退出地址栏编辑（不依赖失焦时序）。
                            // 用“获得焦距”而非“失去焦距”判定，避开输入框创建初期的假失焦。
                            focus-changed(has) => {
                                if (has) {
                                    file-list.commit-rename();
                                    file-list-right.commit-rename();
                                    root.path-editing = false;
                                }
                            }

                            key-pressed(event) => {
                                if (event.text == Key.Escape) {
                                    self.text = "";
                                    root.filter_edited("");
                                    self.blur-input();
                                    return EventResult.accept;
                                }
                                return EventResult.reject;
                            }
                        }

                        if (root.filter-text != "") : Rectangle {
                            width: 16px;
                            height: 16px;
                            y: (parent.height - 16px) / 2;
                            border-radius: 4px;
                            background: filter-clear-ta.has-hover ? Theme.close-hover : transparent;

                            IconClose {
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                size: 8px;
                                icon-color: filter-clear-ta.has-hover ? #FFFFFF : Theme.text-secondary;
                            }

                            filter-clear-ta := TouchArea {
                                width: 100%;
                                height: 100%;
                                clicked => {
                                    filter-input.text = "";
                                    root.filter_edited("");
                                }
                            }
                        }
                    }

                    // 占位提示(绝对定位覆盖,不参与布局——否则会与输入框
                    // 均分宽度,导致输入框只剩图标旁一小条可点)。
                    if (root.filter-text == "") : Text {
                        x: 26px;
                        width: parent.width - 32px;
                        height: parent.height;
                        text: "搜索当前文件夹";
                        color: Theme.text-disabled;
                        font-size: 12px;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }
            }
        }

        // ---- 主体：侧边栏 + 文件列表（无缝叠层，绝不露底） ----
        Rectangle {
            horizontal-stretch: 1;
            vertical-stretch: 1;

            // 底层：侧边栏与内容区 0 缝隙直接贴合
            HorizontalLayout {
                width: 100%;
                height: 100%;
                spacing: 0px;

                // 1. 侧栏（宽度严格等于 sidebar-w，无任何额外包裹，紧贴内容区）
                if (!root.settings-open) : Sidebar {
                    width: root.sidebar-w;
                    height: 100%;
                    items: root.sidebar-items;
                    active-id: root.sidebar-active-id;
                    loading: root.file-loading;
                    staging-items: root.staging-items;
                    // 双向绑定：托盘标题栏点击改的是内部 expanded，必须回流到
                    // MainWindow 才能触发 changed 上报给 Rust 落盘。
                    staging-expanded <=> root.staging-expanded;
                    drop-visible: root.sidebar-drop-visible;
                    drop-y: root.sidebar-drop-y;
                    item_activated(id) => {
                        root.clear-all-focus();
                        root.sidebar_item_activated(id);
                    }
                    item_right_clicked(id) => {
                        root.clear-all-focus();
                        root.sidebar_item_right_clicked(id);
                    }
                    background_clicked => {
                        root.clear-all-focus();
                    }
                    header_drag(index, phase, y) => {
                        root.sidebar_header_drag(index, phase, y);
                    }
                    network_drag(index, phase, y) => {
                        root.sidebar_network_drag(index, phase, y);
                    }
                    quick_drag(index, phase, y) => {
                        root.sidebar_quick_drag(index, phase, y);
                    }
                    staging_item_removed(index) => {
                        root.staging_item_removed(index);
                    }
                    staging_clear_requested() => {
                        root.staging_clear_requested();
                    }
                    staging_copy_here_requested() => {
                        root.staging_copy_here_requested();
                    }
                    staging_move_here_requested() => {
                        root.staging_move_here_requested();
                    }
                }

            // ---- 主体内容区：文件列表 or 设置页 ----
            // Slint 中 visible:false 的元素仍参与布局占位，因此把两者叠放在
            // 同一个「弹性容器」内：容器负责吃满剩余宽度（preferred 为 0），
            // 内部两个子页面各自 100% 填充、互斥显示，谁都不会挤压对方。
            //
            // 切勿在此写 `height: parent.height`：容器高度 ← HorizontalLayout
            // ← 根布局 ← 窗口布局信息，而子页面又是 height:100%，会构成 Slint
            // 明令禁止的绑定循环（编译期告警、运行期可能 panic）。
            Rectangle {
                horizontal-stretch: 1;
                height: 100%;
                min-width: 0px; // 允许按需收缩，绝不向外溢出窗口
                background: Theme.bg-list;

                file-split := HorizontalLayout {
                    width: 100%;
                    height: 100%;
                    min-width: 0px;
                    visible: !root.settings-open;

                    // 左栏（固定 pane 0）。分屏时宽度按 split-ratio 分配。
                    // 用外层 Rectangle 包一层，便于给聚焦面板加高亮描边；file-list 命名不变。
                    //
                    // 宽度用 **horizontal-stretch 比例**，不要用显式 width：
                    // 写死 width 会被 Slint 当作“固定尺寸”，顺着布局信息上抛成窗口的最小/最大宽度，
                    // 表现为「最大化再还原后再也拖不动宽度」「设置页无法最大化」。
                    // 两栅 preferred 都强制为 0，stretch 比例分出来的就是精确比例宽度，
                    // 不会再出现「一边停不下来、一边只剩几十像素」。
                    left-pane := Rectangle {
                    horizontal-stretch: root.is-split ? root.split-ratio : 1.0;
                    min-width: 0px;
                    preferred-width: 0px;
                    height: 100%;
                    background: Theme.bg-list;

                    file-list := FileList {
                        width: 100%;
                        height: 100%;
                        visible: true;
                        rows: root.file-rows;
                    expand-index: root.file-expand-index;
                    expand-name: root.file-expand-name;
                    expand-lines: root.file-expand-lines;
                    expand-box-w: root.file-expand-box-w;
                    total-count: root.file-total;
                    sort-key: root.sort-key;
                    sort-ascending: root.sort-ascending;
                    rename-path: root.rename-pane == 0 ? root.rename-path : "";
                    rename-text <=> root.rename-text;
                    rename-select-end: root.rename-select-end;
                    loading: root.file-loading;
                    row_pointer_event(index, event, x, y) => {
                        if (event.kind == PointerEventKind.down) {
                            root.clear-all-focus();
                            root.pane_focused(0);
                        }
                        root.file_row_pointer_event(index, event, x, y);
                    }
                    row_double_clicked(index) => {
                        root.file_row_double_clicked(index);
                    }
                    header_clicked(key) => {
                        root.pane_focused(0);
                        root.file_header_clicked(key);
                    }
                    scroll_changed(offset) => {
                        root.file_scroll_changed(offset);
                    }
                    scroll_dbg(offset, ch, vh, miny, cy) => {
                        root.file_scroll_dbg(0, offset, ch, vh, miny, cy);
                    }
                    scroll_user_input() => {
                        root.file_scroll_user_input(0);
                    }
                    rename_dbg(kind, hf) => {
                        root.file_rename_dbg(0, kind, hf);
                    }
                    name_debug(info, nm) => {
                        root.file_name_debug(0, info, nm);
                    }
                    sb_debug(info) => {
                        root.file_sb_debug(0, info);
                    }
                    rename_text_changed(t) => {
                        root.file_rename_text_changed(0, t);
                    }
                    background_pointer_event(event, x, y) => {
                        if (event.kind == PointerEventKind.down) {
                            root.clear-all-focus();
                            root.pane_focused(0);
                        }
                        root.file_background_pointer_event(event, x, y);
                    }
                    rubber_band_selected(x1, y1, x2, y2) => {
                        root.file_rubber_band_selected(x1, y1, x2, y2);
                    }
                    rubber_band_move(x1, y1, x2, y2) => {
                        root.file_rubber_band_move(x1, y1, x2, y2);
                    }
                    rename_committed(path, new-name) => {
                        root.file_rename_committed(path, new-name);
                    }
                    rename_cancelled() => {
                        root.file_rename_cancelled();
                    }
                    }

                    // 聚焦高亮：顶部 2px 强调条（画在列表之上，避免被背景盖住）。
                    Rectangle {
                        y: 0;
                        width: 100%;
                        height: 2px;
                        background: root.is-split && root.active-pane == 0 ? Theme.accent : transparent;
                    }
                    }

                    // 分屏可拖分隔条（8px 热区，1px 常驻精致底线，悬停 2px 主题色渐变）
                    if (root.is-split) : Rectangle {
                        width: 8px;
                        height: 100%;
                        background: transparent;

                        Rectangle {
                            x: (parent.width - self.width) / 2;
                            width: (splitter-ta.has-hover || splitter-ta.pressed) ? 2px : 1px;
                            height: 100%;
                            background: (splitter-ta.has-hover || splitter-ta.pressed) ? Theme.accent : Theme.divider;
                            animate width, background { duration: 120ms; easing: ease-out; }
                        }

                        splitter-ta := TouchArea {
                            width: 100%;
                            height: 100%;
                            mouse-cursor: col-resize;
                            moved => {
                                if (self.pressed) {
                                    // 用 split-avail（窗口宽 - 侧栅宽）而不是 file-split.width：
                                    // 两栅宽度现在就是这个值算出来的，同源才能拖得准。
                                    let pane_space = root.split-avail - 8px;
                                    if (pane_space > 1px) {
                                        let mx = splitter-ta.absolute-position.x + self.mouse-x - file-split.absolute-position.x;
                                        let min_pane_w = root.min-pane-width();
                                        let max_left_w = pane_space - min_pane_w;
                                        let clamped_left_w = max(min_pane_w, min(max_left_w, mx));
                                        let want = clamped_left_w / pane_space;
                                        root.split-ratio-want = max(0.2, min(0.8, want));
                                        root.clamp-split-ratio();
                                    }
                                }
                            }
                            pointer-event(e) => {
                                if (e.kind == PointerEventKind.up) {
                                    root.split_ratio_changed(root.split-ratio-want);
                                }
                            }
                        }
                    }

                    // 右栏（固定 pane 1）。常驻声明以便公共函数访问其几何。
                    // 非分屏时 stretch 为 0、preferred 也是 0 → 真正占 0 宽。
                    right-pane := Rectangle {
                    visible: root.is-split;
                    horizontal-stretch: root.is-split ? (1.0 - root.split-ratio) : 0.0;
                    min-width: 0px;
                    preferred-width: 0px;
                    height: 100%;
                    background: Theme.bg-list;

                    file-list-right := FileList {
                        width: 100%;
                        height: 100%;
                        rows: root.file-rows-right;
                        expand-index: root.file-expand-index-right;
                        expand-name: root.file-expand-name-right;
                        expand-lines: root.file-expand-lines-right;
                        expand-box-w: root.file-expand-box-w-right;
                        total-count: root.file-total-right;
                        sort-key: root.sort-key;
                        sort-ascending: root.sort-ascending;
                        view-mode: root.view-mode;
                        show-path-column: root.show-path-column;
                        rename-path: root.rename-pane == 1 ? root.rename-path : "";
                        rename-text <=> root.rename-text;
                        rename-select-end: root.rename-select-end;
                        loading: root.file-loading-right;
                        row_pointer_event(index, event, x, y) => {
                            if (event.kind == PointerEventKind.down) {
                                root.clear-all-focus();
                                root.pane_focused(1);
                            }
                            if (event.kind == PointerEventKind.down && event.button == PointerEventButton.right) {
                                root.file_row_pointer_event(index, event, x + left-pane.width + 5px, y);
                            } else {
                                root.file_row_pointer_event(index, event, x, y);
                            }
                        }
                        row_double_clicked(index) => {
                            root.file_row_double_clicked(index);
                        }
                        header_clicked(key) => {
                            root.pane_focused(1);
                            root.file_header_clicked(key);
                        }
                        scroll_changed(offset) => {
                            root.file_scroll_changed_right(offset);
                        }
                        scroll_dbg(offset, ch, vh, miny, cy) => {
                            root.file_scroll_dbg(1, offset, ch, vh, miny, cy);
                        }
                        scroll_user_input() => {
                            root.file_scroll_user_input(1);
                        }
                        rename_dbg(kind, hf) => {
                            root.file_rename_dbg(1, kind, hf);
                        }
                        name_debug(info, nm) => {
                            root.file_name_debug(1, info, nm);
                        }
                        sb_debug(info) => {
                            root.file_sb_debug(1, info);
                        }
                        rename_text_changed(t) => {
                            root.file_rename_text_changed(1, t);
                        }
                        background_pointer_event(event, x, y) => {
                            if (event.kind == PointerEventKind.down) {
                                root.clear-all-focus();
                                root.pane_focused(1);
                            }
                            if (event.kind == PointerEventKind.down && event.button == PointerEventButton.right) {
                                root.file_background_pointer_event(event, x + left-pane.width + 5px, y);
                            } else {
                                root.file_background_pointer_event(event, x, y);
                            }
                        }
                        rename_committed(path, new-name) => {
                            root.file_rename_committed(path, new-name);
                        }
                        rename_cancelled() => {
                            root.file_rename_cancelled();
                        }
                        rubber_band_selected(x1, y1, x2, y2) => {
                            root.file_rubber_band_selected(x1, y1, x2, y2);
                        }
                        rubber_band_move(x1, y1, x2, y2) => {
                            root.file_rubber_band_move(x1, y1, x2, y2);
                        }
                    }

                    // 聚焦高亮：顶部 2px 强调条。
                    Rectangle {
                        y: 0;
                        width: 100%;
                        height: 2px;
                        background: root.active-pane == 1 ? Theme.accent : transparent;
                    }
                    }
                }

                SettingsPage {
                    width: 100%;
                    height: 100%;
                    visible: root.settings-open;
                    nav-items: root.settings-nav-items;
                    action-groups: root.settings-action-groups;
                    shortcut-groups: root.settings-shortcut-groups;
                    recording-item-key: root.settings-recording-item;
                    shortcut_record_clicked(id, slot) => { root.settings_shortcut_record(id, slot); }
                    shortcut_reset_clicked(id, slot) => { root.settings_shortcut_reset(id, slot); }
                    shortcut_unbind_clicked(id, slot) => { root.settings_shortcut_unbind(id, slot); }
                    shortcut_add_alternate_clicked(id) => { root.settings_shortcut_add_alternate(id); }
                    shortcut_remove_alternate_clicked(id, slot) => { root.settings_shortcut_remove_alternate(id, slot); }
                    shortcut_reset_all_clicked() => { root.settings_shortcut_reset_all(); }
                    page-title: root.settings-page-title;
                    page-desc: root.settings-page-desc;
                    show-add: root.settings-show-add;
                    content-height: root.settings-content-height;
                    show-hidden: root.show-hidden;
                    show_hidden_toggled(v) => { root.show_hidden_toggled(v); }
                    search-ready: root.search-ready;
                    search-status-text: root.search-status-text;
                    search-items-count: root.search-items-count;
                    search-size-text: root.search-size-text;
                    search-drives-count: root.search-drives-count;
                    search-last-scan-time: root.search-last-scan-time;
                    search-drives: root.search-drives;
                    search-builtin-exclusions: root.search-builtin-exclusions;
                    search-custom-exclusions: root.search-custom-exclusions;
                    exclude-input-text <=> root.search-exclude-input; // 核心修复：改为双向绑定
                    menu-hide-keywords: root.menu-hide-keywords;
                    hide-input-text <=> root.menu-hide-input;
                    menu_hide_add_clicked() => { root.menu_hide_add_clicked(); }
                    menu_hide_remove_clicked(k) => { root.menu_hide_remove_clicked(k); }
                    menu_hide_restore_clicked() => { root.menu_hide_restore_clicked(); }
                    text_focus_changed(v) => { root.settings-text-focus = v; }
                    search-idle-enabled: root.search-idle-enabled;
                    search-idle-minutes: root.search-idle-minutes;
                    search-max-results: root.search-max-results;
                    search_rescan_clicked() => { root.search_rescan_clicked(); }
                    search_drive_toggled(letter, indexed) => { root.search_drive_toggled(letter, indexed); }
                    search_add_exclusion_clicked() => { root.search_add_exclusion_clicked(); }
                    search_remove_exclusion_clicked(path) => { root.search_remove_exclusion_clicked(path); }
                    search_pick_folder_clicked() => { root.search_pick_folder_clicked(); }
                    search_reset_exclusions_clicked() => { root.search_reset_exclusions_clicked(); }
                    search_idle_toggled(enabled) => { root.search_idle_toggled(enabled); }
                    search_idle_minutes_changed(mins) => { root.search_idle_minutes_changed(mins); }
                    search_max_results_changed(res) => { root.search_max_results_changed(res); }
                    scroll_debug(viewport, content, preferred) => {
                        root.settings_scroll_debug(viewport, content, preferred);
                    }
                    nav_changed(id) => {
                        root.settings_nav_changed(id);
                    }
                    action_toggled(id, enabled) => {
                        root.settings_action_toggled(id, enabled);
                    }
                    group_toggled(name, expanded) => {
                        root.settings_group_toggled(name, expanded);
                    }
                    action_add() => {
                        root.settings_action_add();
                    }
                    action_edit(id) => {
                        root.settings_action_edit(id);
                    }
                    action_delete(id) => {
                        root.settings_action_delete(id);
                    }
                }
            }
            }

            // 3. 拖拽热区浮层：跨骑在分界线上（左 4px / 右 4px），完全不占排版像素，静止完全透明
            if (!root.settings-open) : Rectangle {
                x: root.sidebar-w - 4px;
                y: 0px;
                width: 8px;
                height: 100%;
                z: 30; // 悬浮在内容最上层
                background: transparent;

                Rectangle {
                    x: (parent.width - self.width) / 2;
                    width: 2px;
                    height: 100%;
                    border-radius: 1px;
                    background: Theme.accent;
                    opacity: (sidebar-resizer-ta.has-hover || sidebar-resizer-ta.pressed) ? 1.0 : 0.0;
                    animate opacity { duration: 150ms; easing: ease-out; }
                }

                sidebar-resizer-ta := TouchArea {
                    width: 100%;
                    height: 100%;
                    mouse-cursor: col-resize;
                    moved => {
                        if (self.pressed) {
                            let new_w = self.absolute-position.x + self.mouse-x;
                            // 单栏最小 70px；上限由当前窗口宽度决定（双栏另算）
                            let clamped_w = max(70px, min(root.max-sidebar-width(), new_w));
                            root.sidebar-want = clamped_w;
                            root.clamp-split-ratio();
                        }
                    }
                    pointer-event(e) => {
                        if (e.kind == PointerEventKind.up) { root.sidebar_width_changed(root.sidebar-want / 1px); }
                    }
                }
            }
        }

        // ---- 状态栏（设置页不显示：计数对设置无意义）----
        Rectangle {
            visible: !root.settings-open;
            height: root.settings-open ? 0px : root.statusbar-h;
            background: Theme.bg-statusbar;

            Rectangle {
                y: 0px;
                width: 100%;
                height: 1px;
                background: Theme.divider;
            }

            HorizontalLayout {
                x: 0px;
                y: 0px;
                width: 100%;
                height: parent.height;
                spacing: 12px;
                padding-left: 12px;
                padding-right: 12px;

                Text {
                    text: root.status-left;
                    color: Theme.text-secondary;
                    font-size: 11.5px;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                }

                if (root.status-job != "") : Text {
                    text: root.status-job;
                    // 失败 / 名称超限 / 删除等强提醒用红色，普通提示保持主题色。
                    color: root.status-danger ? Theme.danger : Theme.accent;
                    font-size: 11.5px;
                    vertical-alignment: center;
                }

                Text {
                    text: root.status-right;
                    color: Theme.text-secondary;
                    font-size: 11.5px;
                    vertical-alignment: center;
                    horizontal-alignment: right;
                }
            }
        }
    }

    // 动作编辑器弹窗（新增 / 编辑自定义右键菜单）。
    ActionEditorDialog {
        visible: root.settings-editor-open;
        title: root.settings-editor-title;
        group-options: root.settings-editor-group-options;
        edit-id <=> root.settings-editor-id;
        edit-label <=> root.settings-editor-label;
        edit-group <=> root.settings-editor-group;
        edit-target <=> root.settings-editor-target;
        edit-extensions <=> root.settings-editor-extensions;
        edit-program <=> root.settings-editor-program;
        edit-args <=> root.settings-editor-args;
        browse => {
            root.settings_editor_browse();
        }
        save => {
            root.settings_editor_save(
                root.settings-editor-id,
                root.settings-editor-label,
                root.settings-editor-group,
                root.settings-editor-target,
                root.settings-editor-extensions,
                root.settings-editor-program,
                root.settings-editor-args
            );
        }
        cancel => {
            root.settings_editor_cancel();
        }
    }

    // 添加网络位置弹窗。
    network-dialog := NetworkLocationDialog {
        visible: root.network-dialog-open;
        title: root.network-dialog-title;
        server <=> root.network-dialog-server;
        alias <=> root.network-dialog-alias;
        error <=> root.network-dialog-error;
        connect-clicked => {
            root.network_dialog_connect();
        }
        cancel-clicked => {
            root.network_dialog_cancel();
        }
    }

    /// 弹窗打开后把焦点交给地址输入框（Rust 侧等一帧再调）。
    public function focus-network-dialog() {
        network-dialog.focus-server();
    }

}

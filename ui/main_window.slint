import { Theme, FileRow, TabInfo, SidebarItem, StagingItem, BreadcrumbSegment, IconSearch, IconClose, IconRefresh, IconNavArrow, IconPlus, IconSplit, SettingsNavItem, SettingsActionGroup, SettingsShortcutGroup } from "common.slint";
import { TabBar } from "tab_bar.slint";
import { Sidebar } from "sidebar.slint";
import { FileList } from "file_list.slint";
import { StagingTray } from "staging_tray.slint";
import { ContextMenu, SubMenuPopover, MenuItem } from "context_menu.slint";
import { SettingsPage } from "settings_page.slint";
import { ActionEditorDialog } from "action_editor.slint";
import { PreviewWindow } from "preview_window.slint";
export { PreviewWindow } from "preview_window.slint";

// 将 common.slint 中的 Theme 全局从根文件再导出——
// Slint 规定：全局单例只有从根文件（或 slint! 宏）导出，Rust 侧才能通过
// ui.global::<Theme>() 访问，否则其值会被编译期内联。
export { Theme } from "common.slint";
export { DialogJumpWindow, JumpResult } from "dialog_jump.slint";

// 工具栏导航按钮（内部自居中，高度适应工具栏，杜绝偏上问题）
component nav-btn inherits Rectangle {
    in property <string> direction; // "left" | "right" | "up"
    in property <bool> enabled;
    callback clicked();

    width: 28px;
    height: 100%; // 占满工具栏 44px 高度

    // 内部视觉方块：精准 28px x 28px，完美垂直居中。
    // parent 即外层 44px 高的 nav-btn，引用合法且绝对居中。
    Rectangle {
        width: 28px;
        height: 28px;
        y: (parent.height - self.height) / 2;
        border-radius: 5px;
        background: (root.enabled && nav-ta.has-hover) ? Theme.bg-hover : transparent;

        IconNavArrow {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            direction: root.direction;
            size: 12px;
            icon-color: root.enabled
                ? (nav-ta.has-hover ? Theme.text-primary : Theme.text-secondary)
                : Theme.text-disabled;
        }
    }

    nav-ta := TouchArea {
        width: 100%;
        height: 100%;
        enabled: root.enabled;
        clicked => {
            root.clicked();
        }
    }
}

// Rove 主窗口。
//
// 布局（复刻 Pulse）：
//   ┌──────────────────────────────────────────┐
//   │ 标签栏（多标签、+ 新建、中键关闭）            │
//   │ 工具栏（前进/后退/向上 | 面包屑 | 新建/刷新 | 过滤）│
//   │ ┌────────┐ ┌───────────────────────────┐ │
//   │ │ 侧边栏  │ │ 虚拟文件列表               │ │
//   │ │  + 暂存 │ │                           │ │
//   │ └────────┘ └───────────────────────────┘ │
//   │ 状态栏                                    │
//   └──────────────────────────────────────────┘
export component MainWindow inherits Window {
    title: "Rove";
    no-frame: true; // 移除 Windows 原生黑色标题栏与边框，改由 TabBar 右侧自绘控制按钮
    // 废弃 Winit 内置缩放：全部交由 app.rs 的 WM_NCHITTEST 钩子接管，
    // 否则 Winit 会在客户区内部私自接管光标并触发缩放（导致右上角按钮区域出现调整大小箭头）。
    resize-border-width: 0px;
    min-width: 880px;
    min-height: 560px;
    preferred-width: 1200px;
    preferred-height: 760px;
    background: Theme.bg-main;
    default-font-family: Theme.font-family;

    // ---- 状态（Rust 驱动） ----
    in-out property <[TabInfo]> tabs: [];
    in-out property <int> active-tab: 0;
    in-out property <bool> tab-loading: false;
    /// 当前激活的是否为设置页标签。
    in-out property <bool> settings-open: false;
    // 设置页数据。
    in-out property <[SettingsNavItem]> settings-nav-items: [];
    in-out property <[SettingsActionGroup]> settings-action-groups: [];
    in-out property <[SettingsShortcutGroup]> settings-shortcut-groups: [];
    in-out property <string> settings-recording-item: "";
    callback settings_shortcut_record(string, int);
    callback settings_shortcut_reset(string, int);
    callback settings_shortcut_unbind(string, int);
    callback settings_shortcut_add_alternate(string);
    callback settings_shortcut_remove_alternate(string, int);
    callback settings_shortcut_reset_all();
    // 设置页子页标题 / 描述 / 新增入口 / 内容高度。
    in-out property <string> settings-page-title: "本地右键菜单";
    in-out property <string> settings-page-desc: "";
    in-out property <bool> settings-show-add: true;
    in-out property <length> settings-content-height: 0px;
    // 是否显示隐藏文件（来自 config.show_hidden，驱动设置页「通用」开关）。
    in-out property <bool> show-hidden: false;
    callback show_hidden_toggled(bool);
    // 动作编辑器弹窗状态。
    in-out property <string> settings-editor-title: "";
    in-out property <bool> settings-editor-open: false;
    in-out property <string> settings-editor-id: "";
    in-out property <string> settings-editor-label: "";
    in-out property <string> settings-editor-group: "";
    in-out property <string> settings-editor-target: "any";
    in-out property <string> settings-editor-extensions: "";
    in-out property <string> settings-editor-program: "";
    in-out property <string> settings-editor-args: "";
    // 编辑器「层级归属」可选分组（含内置的「一级菜单」）。
    in-out property <[string]> settings-editor-group-options: ["一级菜单"];
    in-out property <[SidebarItem]> sidebar-items: [];
    in-out property <string> sidebar-active-id: "";
    in-out property <[FileRow]> file-rows: [];
    in-out property <int> file-total: 0;
    in-out property <bool> file-loading: false;
    // 分屏右栏数据源（分屏关闭时不使用）。
    in-out property <[FileRow]> file-rows-right: [];
    in-out property <int> file-total-right: 0;
    in-out property <bool> file-loading-right: false;
    in-out property <string> sort-key: "name";
    in-out property <bool> sort-ascending: true;
    in-out property <string> rename-path: "";
    in-out property <[StagingItem]> staging-items: [];
    in-out property <bool> staging-expanded: true;
    in-out property <[BreadcrumbSegment]> breadcrumbs: [];
    in-out property <string> filter-text: "";
    in-out property <bool> can-go-back: false;
    in-out property <bool> can-go-forward: false;
    in-out property <bool> can-go-up: false;
    in-out property <string> status-left: "";
    in-out property <string> status-right: "";
    in-out property <string> status-job: "";
    /// 面包屑路径编辑态（点击地址栏空白处进入，Enter 确认 / Esc 取消）。
    in-out property <bool> path-editing: false;
    in-out property <string> path-edit-text: "";
    /// 侧栏分区拖拽排序指示器（Rust 计算落点）。
    in-out property <bool> sidebar-drop-visible: false;
    in-out property <length> sidebar-drop-y: 0px;
    /// 文件列表可视高度（Rust 只读，用于虚拟窗口计算；由 FileList 绑定）。
    in-out property <length> list-height;
/// 视图模式（Pulse 式视图切换）。直通 FileList。
in-out property <string> view-mode <=> file-list.view-mode;
/// 「路径」列显隐（仅回收站开启）。直通 FileList。
in-out property <bool> show-path-column <=> file-list.show-path-column;
out property <int> cells-per-row: file-list.cells-per-row;
    out property <length> view-width: file-list.view-width;
out property <length> row-height-out: file-list.row-height-out;
    /// 过滤输入框是否持有焦点（焦点在内时不响应应用级快捷键）。
    in-out property <bool> filter-has-focus;
    filter-has-focus: filter-input.has-focus;
    /// 文件列表可视高度（Rust 只读，用于虚拟窗口计算）。
    list-height: file-list.view-height;

    // ---- 分屏（步骤 1：UI 搭建，核心逻辑待后续） ----
    in-out property <bool> is-split: false;
    in-out property <int> active-pane: 0;
    in-out property <float> split-ratio: 0.5; // 左右分屏比例，0~1 之间

    // ---- 右键菜单状态 ----
    in-out property <[MenuItem]> menu-items: [];
    in-out property <length> menu-items-height: 0px;
    in-out property <[MenuItem]> submenu-items: [];
    in-out property <length> submenu-items-height: 0px;
    in-out property <bool> menu-open: false;
    property <length> click-x;
    property <length> click-y;
    // 主菜单最终位置(窗口坐标,四向钳制到内容区),供二级菜单对齐引用。
    property <length> menu-x: max(sidebar-w + 8px, min(sidebar-w + click-x, root.width - 232px));
    property <length> menu-y: max(topbar-h + 8px, min(topbar-h + click-y, root.height - menu-items-height - 8px));
    // 悬停的子菜单项相对主菜单顶部的 y(Rust 按行高累计),二级菜单顶部对齐该项。
    in-out property <length> submenu-row-y: 0px;

    // ---- 回调（Rust 处理） ----
    callback new_tab_requested();
    callback tab_activated(id: int);
    callback tab_closed(id: int);

    // 窗口控制（无边框标题栏）：由 TabBar 右侧按钮触发；
    // 窗口移动不使用回调，TabBar 内直接用原生 WindowMoveArea。
    callback window_minimize();
    callback window_maximize();
    callback window_close();
    callback nav_back();
    callback nav_forward();
    callback nav_up();
    callback breadcrumb_clicked(path: string);
    callback path_edit_committed(path: string);
    callback sidebar_header_drag(index: int, phase: int, y: length);
    callback sidebar_item_activated(id: string);
    callback file_row_pointer_event(index: int, event: PointerEvent, x: length, y: length);
    callback file_row_double_clicked(index: int);
    callback file_header_clicked(key: string);
    callback file_scroll_changed(offset: length);
    // 分屏右栏滚动 / 分隔条比例落盘
    callback file_scroll_changed_right(offset: length);
    callback split_ratio_changed(ratio: float);
    callback file_background_pointer_event(event: PointerEvent, x: length, y: length);
    callback file_rename_committed(path: string, new_name: string);
    callback file_rename_cancelled();
    callback staging_item_removed(index: int);
    callback staging_clear_requested();
    callback staging_copy_here_requested();
    callback staging_move_here_requested();
    callback menu_item_triggered(id: string);
    callback menu_submenu_hovered(index: int, entered: bool);
    callback filter_edited(text: string);
    callback new_folder_requested();
    callback refresh_requested();
    callback paste_requested();
    callback view_picker_requested();
    callback settings_requested();
    // 分屏：切换分屏开关 / 某栏获得焦点（active-pane 高亮与地址栏归属）
    callback toggle_split();
    callback pane_focused(int);
    callback settings_nav_changed(id: string);
    // 诊断：设置页滚动几何（视口 / 内容 / 实测首选高度）。
    callback settings_scroll_debug(viewport: length, content: length, preferred: length);
    callback settings_action_toggled(id: string, enabled: bool);
    callback settings_group_toggled(name: string, expanded: bool);
    callback settings_action_add();
    callback settings_action_edit(id: string);
    callback settings_action_delete(id: string);
    callback settings_editor_save(
        id: string,
        label: string,
        group: string,
        target: string,
        extensions: string,
        program: string,
        args: string
    );
    callback settings_editor_cancel();
    callback settings_editor_browse();
    in-out property <bool> can-paste: false;

    // ---- 布局常量 ----
    private property <length> sidebar-w: 236px;
    private property <length> topbar-h: 82px; // 标签栏 38 + 工具栏 44
    private property <length> statusbar-h: 28px;

    /// 文件列表滚动到顶端（Rust 调用）。
    public function scroll-list-to-top() {
        file-list.scroll-to-top();
    }

    /// 文件列表行命中测试（外部拖入定位目标文件夹，Rust 调用）。
    public function row-hit-test(wx: length, wy: length) -> int {
        file-list.row-hit-test(wx - file-list.absolute-position.x, wy - file-list.absolute-position.y);
    }

    /// 获取指定行相对主窗口的坐标几何 [x, y, width, height]（用于原生高亮框绘制）。
    public function get-item-rect(idx: int) -> [length] {
        let r = file-list.get-item-rect(idx);
        return [r[0] + file-list.absolute-position.x, r[1] + file-list.absolute-position.y, r[2], r[3]];
    }

    /// 获取指定窗口坐标下的目标 pane 和行索引，返回 [pane_index, row_index]。
    /// 分屏时以右栏左边界为分界判定命中哪一栏。
    public function get-drop-target(wx: length, wy: length) -> [int] {
        if (root.is-split) {
            if (wx >= file-list-right.absolute-position.x) {
                return [1, file-list-right.row-hit-test(wx - file-list-right.absolute-position.x, wy - file-list-right.absolute-position.y)];
            }
        }
        return [0, file-list.row-hit-test(wx - file-list.absolute-position.x, wy - file-list.absolute-position.y)];
    }

    /// 获取指定 pane 和行索引相对窗口的坐标几何 [x, y, width, height]。
    public function get-item-rect-target(pane: int, idx: int) -> [length] {
        if (pane == 0) {
            let r = file-list.get-item-rect(idx);
            return [r[0] + file-list.absolute-position.x, r[1] + file-list.absolute-position.y, r[2], r[3]];
        }
        let r = file-list-right.get-item-rect(idx);
        return [r[0] + file-list-right.absolute-position.x, r[1] + file-list-right.absolute-position.y, r[2], r[3]];
    }

    /// 拖出上膛：行按下时禁用 flick 交互滚动，让拖动只发起 OLE 拖放。
    /// 分屏时两栏都上膛（隐藏的右栏无副作用），保证从任意一栏都能发起拖出。
    public function set-drag-armed(v: bool) {
        file-list.set-drag-armed(v);
        file-list-right.set-drag-armed(v);
    }

    /// 统一失焦：同时释放搜索框光标并退出地址栏编辑态。
    public function clear-all-focus() {
        filter-input.clear-focus();
        root.path-editing = false;
    }

    /// 聚焦并全选搜索框（Ctrl+F，Rust 调用）。
    public function focus-search-box() {
        filter-input.focus();
        filter-input.select-all();
    }

    /// 拖拽悬停高亮：把命中的目标行索引暴露给 Rust（拖入/拖出悬停时设置）。
    in-out property <int> file-drop-hover-index <=> file-list.drop-hover-index;

    /// 标题栏空白拖拽区的起止坐标（供 Win32 WM_NCHITTEST 判定，见 app.rs drag_hittest）。
    out property <length> drag-area-x: tab-bar.drag-x;
    out property <length> drag-area-w: tab-bar.drag-w;

    /// 窗口是否处于最大化（Rust 经 IsZoomed 实时同步）。
    ///
    /// 刻意不用 Slint 内置的 `maximized`：那个是**命令属性**（置 true 会真的
    /// 下发最大化），拿它回传 OS 状态会形成命令回路——例如最小化一个已最大化
    /// 的窗口时 IsZoomed 返回 0，回传就会把用户的最大化状态误还原。故用独立的
    /// 无副作用属性，仅用于驱动 resize-border-width 动态归零。
    in-out property <bool> win-maximized: false;

    VerticalLayout {
        spacing: 0px;

        // ---- 标签栏 ----
        tab-bar := TabBar {
            tabs: root.tabs;
            active-tab: root.active-tab;
            loading: root.tab-loading;
            tab_activated(id) => {
                root.clear-all-focus();
                root.tab_activated(id);
            }
            tab_closed(id) => {
                root.tab_closed(id);
            }
            new_tab_requested() => {
                root.clear-all-focus();
                root.new_tab_requested();
            }
            window_minimize => { root.window_minimize(); }
            window_maximize => { root.window_maximize(); }
            window_close => { root.window_close(); }
            settings_requested => {
                root.clear-all-focus();
                root.settings_requested();
            }
        }

        // ---- 工具栏（设置页整体收起，内容从标签栏下方直接开始）----
        Rectangle {
            visible: !root.settings-open;
            height: root.settings-open ? 0px : 44px;
            background: Theme.bg-main;

            // 工具栏空白处点击：退出一切输入聚焦
            TouchArea {
                width: 100%;
                height: 100%;
                clicked => {
                    root.clear-all-focus();
                }
            }

            HorizontalLayout {
                x: 0px;
                y: 0px;
                width: 100%;
                height: parent.height;
                spacing: 4px;
                // ⚠️ 严禁在此处加 alignment: center！那是水平居中，会导致整行被挤压缩在屏幕中央！
                padding-left: 8px;
                padding-right: 10px;

                // 导航按钮组（间距收拢至 2px，紧凑协调）
                nav-btn {
                    direction: "left";
                    enabled: root.can-go-back;
                    clicked => { root.nav_back(); }
                }
                nav-btn {
                    direction: "right";
                    enabled: root.can-go-forward;
                    clicked => { root.nav_forward(); }
                }
                nav-btn {
                    direction: "up";
                    enabled: root.can-go-up;
                    clicked => { root.nav_up(); }
                }

                // 分隔竖线。
                Rectangle {
                    width: 1px;
                    height: 20px;
                    y: (parent.height - 20px) / 2;
                    background: Theme.border;
                }

                // 面包屑地址栏（复刻 Pulse：常态即为 28px 圆角输入框，与右侧搜索框严格统一）
                Rectangle {
                    horizontal-stretch: 1;
                    height: 28px;
                    y: (parent.height - self.height) / 2;
                    border-radius: 6px;
                    background: Theme.bg-input;
                    border-width: 1px;
                    border-color: root.path-editing ? Theme.accent : Theme.border;
                    clip: true;

                    // 1. 编辑态：文本输入框直接嵌入
                    if (root.path-editing) : TextInput {
                        x: 8px;
                        width: parent.width - 16px;
                        height: parent.height;
                        text: root.path-edit-text;
                        font-size: 12px;
                        color: Theme.text-primary;
                        vertical-alignment: center;
                        single-line: true;

                        accepted => {
                            root.path_editing = false;
                            root.path_edit_committed(self.text);
                        }

                        key-pressed(event) => {
                            if (event.text == Key.Escape) {
                                root.path-editing = false;
                                return EventResult.accept;
                            }
                            return EventResult.reject;
                        }

                        changed has-focus => {
                            // 失焦即退出编辑（视为取消）。
                            if (!self.has-focus && root.path-editing) {
                                root.path-editing = false;
                            }
                        }

                        init => {
                            self.focus();
                            self.select-all();
                        }
                    }

                    // 2. 非编辑态：展示面包屑胶囊流，点击空白处无缝进入编辑
                    if (!root.path-editing) : crumbs-flick := Flickable {
                        x: 4px;
                        width: parent.width - 8px;
                        height: parent.height;
                        content-width: max(crumbs-layout.preferred-width, self.width);
                        interactive: true;

                        // 面包屑变化后滚到最右端（显示最深路径）。
                        // 本元素位于 if 分支内，根级 changed 已不可访问；
                        // changed 语法仅支持本元素属性，故用别名属性中转观测。
                        // 编辑态切换会重建本元素，init 保证重建后同样定位到最右端。
                        private property <[BreadcrumbSegment]> breadcrumbs-watch: root.breadcrumbs;
                        changed breadcrumbs-watch => {
                            self.content-x = -10000px;
                        }
                        init => {
                            self.content-x = -10000px;
                        }

                        // 点击文本框内空白处进入路径编辑
                        crumb-bg-ta := TouchArea {
                            width: 100%;
                            height: 100%;
                            clicked => {
                                root.path-editing = true;
                                root.path-edit-text = root.breadcrumbs[root.breadcrumbs.length - 1].path;
                            }
                        }

                        crumbs-layout := HorizontalLayout {
                            x: 0px;
                            y: 0px;
                            height: parent.height;
                            spacing: 0px;

                            for seg[i] in root.breadcrumbs : Rectangle {
                                height: parent.height;
                                width: crumb-text.preferred-width + (i == 0 ? 12px : 24px);

                                // 分隔箭头 "›"
                                if (i > 0) : Text {
                                    x: 0px;
                                    width: 12px;
                                    height: parent.height;
                                    text: "›";
                                    color: Theme.text-disabled;
                                    font-size: 12px;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }

                                // 单个路径胶囊（悬停微底色）
                                Rectangle {
                                    x: i == 0 ? 0px : 12px;
                                    width: parent.width - (i == 0 ? 0px : 12px);
                                    height: 22px;
                                    y: (parent.height - 22px) / 2;
                                    border-radius: 4px;
                                    background: crumb-ta.has-hover ? Theme.bg-hover : transparent;

                                    crumb-text := Text {
                                        text: seg.label;
                                        color: i == root.breadcrumbs.length - 1 ? Theme.text-primary : Theme.text-secondary;
                                        font-size: 12px;
                                        font-weight: i == root.breadcrumbs.length - 1 ? 600 : 400;
                                        vertical-alignment: center;
                                        horizontal-alignment: center;
                                        width: 100%;
                                        height: 100%;
                                        overflow: elide;
                                    }

                                    crumb-ta := TouchArea {
                                        width: 100%;
                                        height: 100%;
                                        clicked => {
                                            root.breadcrumb_clicked(seg.path);
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                // 刷新按钮（28px x 28px，与左侧导航按钮尺寸完全对称）
                Rectangle {
                    width: 28px;
                    height: 28px;
                    y: (parent.height - self.height) / 2;
                    border-radius: 5px;
                    background: refresh-ta.has-hover ? Theme.bg-hover : transparent;

                    IconRefresh {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        size: 14px;
                        icon-color: refresh-ta.has-hover ? Theme.text-primary : Theme.text-secondary;
                    }

                    refresh-ta := TouchArea {
                        width: 100%;
                        height: 100%;
                        clicked => {
                            root.refresh_requested();
                        }
                    }
                }

                // 新建文件夹按钮（改用矢量十字，高度绝对与刷新按钮水平对齐）
                Rectangle {
                    width: 28px;
                    height: 28px;
                    y: (parent.height - self.height) / 2;
                    border-radius: 5px;
                    background: newfolder-ta.has-hover ? Theme.bg-hover : transparent;

                    IconPlus {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        size: 12px;
                        icon-color: newfolder-ta.has-hover ? Theme.text-primary : Theme.text-secondary;
                    }

                    newfolder-ta := TouchArea {
                        width: 100%;
                        height: 100%;
                        clicked => {
                            root.new_folder_requested();
                        }
                    }
                }

                // 视图切换（Pulse 式下拉）。
                Rectangle {
                    width: 28px;
                    height: 28px;
                    y: (parent.height - self.height) / 2;
                    border-radius: 5px;
                    background: view-ta.has-hover ? Theme.bg-hover : transparent;

                    Text {
                        text: "▦";
                        color: Theme.text-secondary;
                        font-family: Theme.symbol-font-family;
                        font-size: 13px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        width: 100%;
                        height: 100%;
                        y: -0.3px;
                    }

                    view-ta := TouchArea {
                        width: 100%;
                        height: 100%;
                        clicked => {
                            root.view_picker_requested();
                        }
                    }
                }

                // 分屏切换按钮（放在视图按钮与搜索框之间）。28x28，激活时高亮。
                Rectangle {
                    width: 28px;
                    height: 28px;
                    y: (parent.height - self.height) / 2;
                    border-radius: 5px;
                    background: root.is-split ? Theme.accent : (split-ta.has-hover ? Theme.bg-hover : transparent);

                    IconSplit {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        size: 13px;
                        icon-color: root.is-split ? Theme.accent-text : (split-ta.has-hover ? Theme.text-primary : Theme.text-secondary);
                    }

                    split-ta := TouchArea {
                        width: 100%;
                        height: 100%;
                        clicked => {
                            root.toggle_split();
                        }
                    }
                }

                // 当前目录过滤搜索（全局 MFT 搜索为后续阶段）。
                Rectangle {
                    width: 200px;
                    height: 28px;
                    y: (parent.height - 28px) / 2;
                    border-radius: 6px;
                    background: Theme.bg-input;
                    border-width: 1px;
                    border-color: Theme.border;

                    // 底层兜底:点击图标 / 边距等空白处也能聚焦输入框。
                    // 落在输入框上的点击由上层 TextInput 自己处理(光标定位)。
                    search-frame-ta := TouchArea {
                        width: 100%;
                        height: 100%;
                        clicked => {
                            filter-input.focus();
                        }
                    }

                    HorizontalLayout {
                        spacing: 4px;
                        padding-left: 8px;
                        padding-right: 6px;
                        height: parent.height;

                        IconSearch {
                            width: 14px;
                            height: 14px;
                            y: (parent.height - self.height) / 2;
                            size: 13px;
                        }

                        filter-input := TextInput {
                            // 独占剩余宽度(占位文字已移出布局),整个框可点。
                            horizontal-stretch: 1;
                            height: parent.height;
                            text <=> root.filter-text;
                            font-size: 12px;
                            color: Theme.text-primary;
                            vertical-alignment: center;
                            single-line: true;

                            edited => {
                                root.filter_edited(self.text);
                            }

                            key-pressed(event) => {
                                if (event.text == Key.Escape) {
                                    self.text = "";
                                    root.filter_edited("");
                                    self.clear-focus();
                                    return EventResult.accept;
                                }
                                return EventResult.reject;
                            }
                        }

                        if (root.filter-text != "") : Rectangle {
                            width: 16px;
                            height: 16px;
                            y: (parent.height - 16px) / 2;
                            border-radius: 4px;
                            background: filter-clear-ta.has-hover ? Theme.bg-hover : transparent;

                            IconClose {
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                size: 8px;
                            }

                            filter-clear-ta := TouchArea {
                                width: 100%;
                                height: 100%;
                                clicked => {
                                    filter-input.text = "";
                                    root.filter_edited("");
                                }
                            }
                        }
                    }

                    // 占位提示(绝对定位覆盖,不参与布局——否则会与输入框
                    // 均分宽度,导致输入框只剩图标旁一小条可点)。
                    if (root.filter-text == "") : Text {
                        x: 26px;
                        width: parent.width - 32px;
                        height: parent.height;
                        text: "搜索当前文件夹";
                        color: Theme.text-disabled;
                        font-size: 12px;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }
            }
        }

        // ---- 主体：侧边栏 + 文件列表 ----
        HorizontalLayout {
            spacing: 0px;
            horizontal-stretch: 1;
            vertical-stretch: 1;

            // 侧栏列：纵向布局（侧栏滚动区 + 底部固定暂存托盘）。
            // 设置页为全屏布局，不渲染文件侧栏（宽度收为 0 以彻底让出布局空间）。
            VerticalLayout {
                visible: !root.settings-open;
                width: root.settings-open ? 0px : root.sidebar-w;
                horizontal-stretch: 0;
                spacing: 0px;

                Sidebar {
                    vertical-stretch: 1;
                    items: root.sidebar-items;
                    active-id: root.sidebar-active-id;
                    loading: root.file-loading;
                    staging-items: root.staging-items;
                    staging-expanded: root.staging-expanded;
                    drop-visible: root.sidebar-drop-visible;
                    drop-y: root.sidebar-drop-y;
                    item_activated(id) => {
                        root.clear-all-focus();
                        root.sidebar_item_activated(id);
                    }
                    background_clicked => {
                        root.clear-all-focus();
                    }
                    header_drag(index, phase, y) => {
                        root.sidebar_header_drag(index, phase, y);
                    }
                    staging_item_removed(index) => {
                        root.staging_item_removed(index);
                    }
                    staging_clear_requested() => {
                        root.staging_clear_requested();
                    }
                    staging_copy_here_requested() => {
                        root.staging_copy_here_requested();
                    }
                    staging_move_here_requested() => {
                        root.staging_move_here_requested();
                    }
                }
            }

            // ---- 主体内容区：文件列表 or 设置页 ----
            // Slint 中 visible:false 的元素仍参与布局占位，因此把两者叠放在
            // 同一个「弹性容器」内：容器负责吃满剩余宽度（preferred 为 0），
            // 内部两个子页面各自 100% 填充、互斥显示，谁都不会挤压对方。
            //
            // 切勿在此写 `height: parent.height`：容器高度 ← HorizontalLayout
            // ← 根布局 ← 窗口布局信息，而子页面又是 height:100%，会构成 Slint
            // 明令禁止的绑定循环（编译期告警、运行期可能 panic）。
            Rectangle {
                horizontal-stretch: 1;

                file-split := HorizontalLayout {
                    width: 100%;
                    height: 100%;
                    visible: !root.settings-open;

                    // 左栏（固定 pane 0）。分屏时宽度按 split-ratio 分配。
                    // 用外层 Rectangle 包一层，便于给聚焦面板加高亮描边；file-list 命名不变。
                    left-pane := Rectangle {
                    horizontal-stretch: root.is-split ? root.split-ratio : 1.0;
                    height: 100%;
                    background: Theme.bg-list;

                    file-list := FileList {
                        width: 100%;
                        height: 100%;
                        visible: true;
                        rows: root.file-rows;
                    total-count: root.file-total;
                    sort-key: root.sort-key;
                    sort-ascending: root.sort-ascending;
                    rename-path: root.rename-path;
                    loading: root.file-loading;
                    row_pointer_event(index, event, x, y) => {
                        if (event.kind == PointerEventKind.down) {
                            root.clear-all-focus();
                            root.pane_focused(0);
                        }
                        root.file_row_pointer_event(index, event, x, y);
                    }
                    row_double_clicked(index) => {
                        root.file_row_double_clicked(index);
                    }
                    header_clicked(key) => {
                        root.pane_focused(0);
                        root.file_header_clicked(key);
                    }
                    scroll_changed(offset) => {
                        root.file_scroll_changed(offset);
                    }
                    background_pointer_event(event, x, y) => {
                        if (event.kind == PointerEventKind.down) {
                            root.clear-all-focus();
                            root.pane_focused(0);
                        }
                        root.file_background_pointer_event(event, x, y);
                    }
                    rename_committed(path, new-name) => {
                        root.file_rename_committed(path, new-name);
                    }
                    rename_cancelled() => {
                        root.file_rename_cancelled();
                    }
                    }

                    // 聚焦高亮：顶部 2px 强调条（画在列表之上，避免被背景盖住）。
                    Rectangle {
                        y: 0;
                        width: 100%;
                        height: 2px;
                        background: root.is-split && root.active-pane == 0 ? Theme.accent : transparent;
                    }
                    }

                    // 可拖分隔条：按布局宽度换算左右比例（限制 20%~80%），松手落盘。
                    if (root.is-split) : Rectangle {
                        width: 5px;
                        background: splitter-ta.has-hover || splitter-ta.pressed ? Theme.accent : Theme.divider;

                        splitter-ta := TouchArea {
                            width: 100%;
                            height: 100%;
                            moved => {
                                if (self.pressed) {
                                    if (file-split.width > 1px) {
                                        let mx = splitter-ta.absolute-position.x + self.mouse-x - file-split.absolute-position.x;
                                        let ratio = mx / file-split.width;
                                        root.split-ratio = max(0.2, min(0.8, ratio));
                                    }
                                }
                            }
                            pointer-event(e) => {
                                if (e.kind == PointerEventKind.up) {
                                    root.split_ratio_changed(root.split-ratio);
                                }
                            }
                        }
                    }

                    // 右栏（固定 pane 1）。常驻声明以便公共函数访问其几何，
                    // 非分屏时通过 visible 隐藏（不可见元素不参与布局）。
                    right-pane := Rectangle {
                    visible: root.is-split;
                    horizontal-stretch: root.is-split ? (1.0 - root.split-ratio) : 0.0;
                    height: 100%;
                    background: Theme.bg-list;

                    file-list-right := FileList {
                        width: 100%;
                        height: 100%;
                        rows: root.file-rows-right;
                        total-count: root.file-total-right;
                        sort-key: root.sort-key;
                        sort-ascending: root.sort-ascending;
                        view-mode: root.view-mode;
                        show-path-column: root.show-path-column;
                        rename-path: "";
                        loading: root.file-loading-right;
                        row_pointer_event(index, event, x, y) => {
                            if (event.kind == PointerEventKind.down) {
                                root.clear-all-focus();
                                root.pane_focused(1);
                            }
                            if (event.kind == PointerEventKind.down && event.button == PointerEventButton.right) {
                                root.file_row_pointer_event(index, event, x + left-pane.width + 5px, y);
                            } else {
                                root.file_row_pointer_event(index, event, x, y);
                            }
                        }
                        row_double_clicked(index) => {
                            root.file_row_double_clicked(index);
                        }
                        header_clicked(key) => {
                            root.pane_focused(1);
                            root.file_header_clicked(key);
                        }
                        scroll_changed(offset) => {
                            root.file_scroll_changed_right(offset);
                        }
                        background_pointer_event(event, x, y) => {
                            if (event.kind == PointerEventKind.down) {
                                root.clear-all-focus();
                                root.pane_focused(1);
                            }
                            if (event.kind == PointerEventKind.down && event.button == PointerEventButton.right) {
                                root.file_background_pointer_event(event, x + left-pane.width + 5px, y);
                            } else {
                                root.file_background_pointer_event(event, x, y);
                            }
                        }
                        rename_committed(path, new-name) => {
                            root.file_rename_committed(path, new-name);
                        }
                        rename_cancelled() => {
                            root.file_rename_cancelled();
                        }
                    }

                    // 聚焦高亮：顶部 2px 强调条。
                    Rectangle {
                        y: 0;
                        width: 100%;
                        height: 2px;
                        background: root.active-pane == 1 ? Theme.accent : transparent;
                    }
                    }
                }

                SettingsPage {
                    width: 100%;
                    height: 100%;
                    visible: root.settings-open;
                    nav-items: root.settings-nav-items;
                    action-groups: root.settings-action-groups;
                    shortcut-groups: root.settings-shortcut-groups;
                    recording-item-key: root.settings-recording-item;
                    shortcut_record_clicked(id, slot) => { root.settings_shortcut_record(id, slot); }
                    shortcut_reset_clicked(id, slot) => { root.settings_shortcut_reset(id, slot); }
                    shortcut_unbind_clicked(id, slot) => { root.settings_shortcut_unbind(id, slot); }
                    shortcut_add_alternate_clicked(id) => { root.settings_shortcut_add_alternate(id); }
                    shortcut_remove_alternate_clicked(id, slot) => { root.settings_shortcut_remove_alternate(id, slot); }
                    shortcut_reset_all_clicked() => { root.settings_shortcut_reset_all(); }
                    page-title: root.settings-page-title;
                    page-desc: root.settings-page-desc;
                    show-add: root.settings-show-add;
                    content-height: root.settings-content-height;
                    show-hidden: root.show-hidden;
                    show_hidden_toggled(v) => { root.show_hidden_toggled(v); }
                    scroll_debug(viewport, content, preferred) => {
                        root.settings_scroll_debug(viewport, content, preferred);
                    }
                    nav_changed(id) => {
                        root.settings_nav_changed(id);
                    }
                    action_toggled(id, enabled) => {
                        root.settings_action_toggled(id, enabled);
                    }
                    group_toggled(name, expanded) => {
                        root.settings_group_toggled(name, expanded);
                    }
                    action_add() => {
                        root.settings_action_add();
                    }
                    action_edit(id) => {
                        root.settings_action_edit(id);
                    }
                    action_delete(id) => {
                        root.settings_action_delete(id);
                    }
                }
            }
        }

        // ---- 状态栏（设置页不显示：计数对设置无意义）----
        Rectangle {
            visible: !root.settings-open;
            height: root.settings-open ? 0px : root.statusbar-h;
            background: Theme.bg-statusbar;

            Rectangle {
                y: 0px;
                width: 100%;
                height: 1px;
                background: Theme.divider;
            }

            HorizontalLayout {
                x: 0px;
                y: 0px;
                width: 100%;
                height: parent.height;
                spacing: 12px;
                padding-left: 12px;
                padding-right: 12px;

                Text {
                    text: root.status-left;
                    color: Theme.text-secondary;
                    font-size: 11.5px;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                }

                if (root.status-job != "") : Text {
                    text: root.status-job;
                    color: Theme.accent;
                    font-size: 11.5px;
                    vertical-alignment: center;
                }

                Text {
                    text: root.status-right;
                    color: Theme.text-secondary;
                    font-size: 11.5px;
                    vertical-alignment: center;
                    horizontal-alignment: right;
                }
            }
        }
    }

    // ---- 右键菜单（含遮罩：点击空白处关闭） ----
    if (root.menu-open) : Rectangle {
        x: 0px;
        y: 0px;
        width: 100%;
        height: 100%;
        z: 90;
        background: transparent;

        TouchArea {
            width: 100%;
            height: 100%;
            pointer-event(event) => {
                if (event.kind == PointerEventKind.down) {
                    root.close-menu();
                    return EventResult.accept;
                }
                return EventResult.reject;
            }
        }
    }

    ContextMenu {
        x: root.menu-x;
        y: root.menu-y;
        visible: root.menu-open;
        items: root.menu-items;
        items-height: root.menu-items-height;
        item_triggered(id) => {
            root.menu_item_triggered(id);
        }
        submenu_hovered(index, entered) => {
            root.menu_submenu_hovered(index, entered);
        }
    }

    SubMenuPopover {
        // 优先展开在主菜单右侧;窗口右缘放不下时翻转到主菜单左侧。
        x: (root.menu-x + 224px + self.width > root.width - 8px)
            ? max(root.sidebar-w + 8px, root.menu-x - self.width - 4px)
            : (root.menu-x + 224px);
        // 顶部与主菜单中悬停的项对齐,越界时钳回窗口内。
        y: max(8px, min(root.menu-y + root.submenu-row-y, root.height - self.height - 8px));
        visible: root.menu-open && root.submenu-items.length > 0;
        items: root.submenu-items;
        items-height: root.submenu-items-height;
        item_triggered(id) => {
            root.menu_item_triggered(id);
        }
    }

    // 动作编辑器弹窗（新增 / 编辑自定义右键菜单）。
    ActionEditorDialog {
        visible: root.settings-editor-open;
        title: root.settings-editor-title;
        group-options: root.settings-editor-group-options;
        edit-id <=> root.settings-editor-id;
        edit-label <=> root.settings-editor-label;
        edit-group <=> root.settings-editor-group;
        edit-target <=> root.settings-editor-target;
        edit-extensions <=> root.settings-editor-extensions;
        edit-program <=> root.settings-editor-program;
        edit-args <=> root.settings-editor-args;
        browse => {
            root.settings_editor_browse();
        }
        save => {
            root.settings_editor_save(
                root.settings-editor-id,
                root.settings-editor-label,
                root.settings-editor-group,
                root.settings-editor-target,
                root.settings-editor-extensions,
                root.settings-editor-program,
                root.settings-editor-args
            );
        }
        cancel => {
            root.settings_editor_cancel();
        }
    }

    // 供 Rust 调用的公开函数。
    public function close-menu() {
        root.menu-open = false;
        root.menu-items = [];
        root.submenu-items = [];
        root.click-x = 0px;
        root.click-y = 0px;
    }

    // 打开右键菜单：记录窗口坐标，Rust 随后填充模型。
    public function open-menu(x: length, y: length) {
        root.click-x = x;
        root.click-y = y;
        root.menu-open = true;
    }

    // 供 Rust 调用的公开函数：绝对坐标弹出菜单（用于工具栏下拉，消除侧栏与工具栏的叠加偏移）。
    // x/y 为窗口绝对坐标，内部换算为内容区坐标（减去侧栏与顶栏），与 open-menu 同一体系。
    public function open-menu-absolute(x: length, y: length) {
        root.click-x = x - root.sidebar-w;
        root.click-y = y - root.topbar-h;
        root.menu-open = true;
    }

}

import { Theme, TabInfo, IconClose, IconTab, IconPlus } from "common.slint";

// 顶部标签栏：复刻 Pulse 的扁平标签样式（激活标签白底 + 主题色下边线），
// 支持点击切换、悬停/激活显示关闭按钮、中键关闭、双击空白新建。
export component TabBar inherits Rectangle {
    in-out property <[TabInfo]> tabs: [];
    in-out property <int> active-tab: 0;
    in-out property <bool> loading: false;

    // 标签拖动交换：拖动期间只更新这几个视觉状态，绝不重建 tabs 模型，
    // 否则 Repeater 会销毁行实例、动画被中断。松手时由 Rust 一次性交换。
    in property <int> drag-index: -1;  // 正在拖的标签（-1 = 无）
    in property <int> drop-slot: -1;   // 目标位置（-1 = 无）
    in property <bool> tab-drop-visible: false;

    callback tab_activated(id: int);
    callback tab_closed(id: int);
    /// 标签页右键菜单（关闭其他 / 关闭左侧 / 关闭右侧）。
    callback tab_context_requested(id: int);
    callback new_tab_requested();
    /// 拖动交换：phase 0 按下 / 1 拖动 / 2 松开，x 为行内局部横坐标。
    callback tab_drag(index: int, phase: int, x: length);

    // 窗口控制（无边框标题栏整合，详见 main_window.slint 的 no-frame）。
    // 注意：窗口拖动不使用回调，改用下方原生 WindowMoveArea；
    // 其几何另行导出给 Win32 WM_NCHITTEST 钩子，以支持触屏手指拖拽。
    callback window_minimize();
    callback window_maximize();
    callback window_close();
    callback settings_requested(); // 标题栏设置齿轮入口

    /// 待生效的滚动目标：-1 = 滚到最右，>= 0 = 把该下标的标签滚进可视区。
    ///
    /// 为什么要「待生效」而不是算一次就完事：tabs 模型换掉后 Repeater 还没重建，
    /// `tabs-flick.width` / `content-width` 仍是旧值（窗口刚创建时甚至还是 0），
    /// 此刻直接算 content-x 会按旧总宽夹住，新标签/当前标签就会落在可视区外。
    /// 所以先记下目标，等布局宽度真正变化时补滚，直到布局跟上为止。
    private property <int> scroll-target: -1;
    private property <bool> scroll-pending: false;
    private property <int> scroll-tries: 0;

    /// 把标签条滚到最右（Rust 新建标签后调用）。
    public function scroll-to-end() {
        root.start-scroll(-1);
    }

    /// 把第 i 个标签滚进可视区（窄窗口打开设置标签 / 启动恢复上次标签页用）。
    public function scroll-to-index(i: int) {
        root.start-scroll(i);
    }

    function start-scroll(target: int) {
        // 先置待生效标记：给 content-x 赋值本身就可能触发一次布局刷新，
        // 若那一次 `changed content-width` 看见标记是 false 就不会补滚，
        // 结果正好差一整格。
        root.scroll-target = target;
        root.scroll-tries = 0;
        root.scroll-pending = true;
        root.apply-scroll();
    }

    function apply-scroll() {
        // 模型按 153px/格 估算（比实际宽度多几像素），用来判断布局有没有跟上。
        let estimated = root.tabs.length * 153px;
        let laid-out = tabs-flick.content-width;
        let view-w = tabs-flick.width;
        let total-w = max(estimated, laid-out);
        let max-scroll = max(0px, total-w - view-w);

        // 每格 150px + 3px 间距，所以 n 个标签的内容宽度应该正好是 153n - 3。
        // 差得多说明 Repeater 还没重建，布局还是上一个标签数时的样子。
        let expected = max(root.tabs.length * 153px - 3px, 0px);
        let stale = abs(laid-out - expected) > 4px;

        // 布局没跟上模型时，这一帧算出来的偏移必然是错的，一个像素都不能写：
        // - view-w <= 0：窗口尚未显示（-total 甚至超出真实下限）；
        // - stale：视口还是旧的标签数宽度。例如「最小化时被资源管理器唤醒并
        //   新开一个标签」，此刻视口仍是 1 格的 150px，右边界 303px 被判定为
        //   「超出可视区」，content-x 被写成 150-303=-153 —— 整个老标签被推到
        //   视野左侧外，界面上只剩 1 个标签（表现为「接管打开吞掉一个标签」），
        //   而且布局补上来之后也没有任何地方会把它拉回去。
        if (view-w <= 0px || stale) {
            if (root.scroll-tries < 20) {
                root.scroll-tries += 1;
                root.scroll-pending = true;
            } else {
                root.scroll-pending = false;
            }
            return;
        }

        // 偏移必须永远落在 [-max-scroll, 0] 内。上面那种按旧宽度写进去的
        // 越界值不会自己回来（Slint 只在用户拖动时夹），每次补滚都顺手夹一次。
        if (tabs-flick.content-x < -max-scroll || tabs-flick.content-x > 0px) {
            tabs-flick.content-x = max(-max-scroll, min(0px, tabs-flick.content-x));
        }

        if (root.scroll-target < 0) {
            tabs-flick.content-x = -max-scroll;
        } else {
            // 目标标签在内容坐标系里的左右边界。
            let left = root.scroll-target * 153px;
            let right = left + 150px;
            let visible-left = -tabs-flick.content-x;
            if (left < visible-left) {
                tabs-flick.content-x = max(-max-scroll, min(0px, -left));
            } else if (right > visible-left + view-w) {
                tabs-flick.content-x = max(-max-scroll, min(0px, view-w - right));
            }
        }

        // 位置写完了：布局已经跟上（stale 已在入口挡掉），收尾复位。
        root.scroll-pending = false;
        root.scroll-tries = 0;
    }

    // 布局迟迟不更新时的兜底：16ms 一档、最多约 20 档（≈320ms）。
    // 启动恢复标签页时窗口常常还没显示，`tabs-flick.width` 是 0，
    // 只靠 `changed content-width` 可能等不到变化（宽度一开始就是 0，
    // 之后虽然会变，但顺序不保证），必须自己轮询几帧。
    Timer {
        interval: 16ms;
        running: root.scroll-pending;
        triggered => {
            root.apply-scroll();
        }
    }

    // 当前标签一换（点击、快捷键、恢复上次标签页、批量关闭后落到锚点），
    // 就保证它在可视区内：只在需要时最小位移，已经在视野里就完全不动。
    changed active-tab => {
        root.start-scroll(root.active-tab);
    }

    // 导出空白拖拽区的起止位置（供后端 WM_NCHITTEST 判定，见 app.rs drag_hittest）
    out property <length> drag-x: drag-spacer.x;
    out property <length> drag-w: drag-spacer.width;

    height: 38px;
    background: Theme.bg-tabstrip;

    HorizontalLayout {
        x: 0px;
        y: 0px;
        width: 100%;
        height: 100%;
        spacing: 3px;
        padding-left: 8px;
        padding-right: 0px; // 关闭按钮贴死右边界：最大化时甩到最右上角可盲点关闭

        // 1. 标签滚动视口：自适应宽度但严格受右侧控制区约束，超量时绝对不挤占窗口按钮
        tabs-area := Rectangle {
            // 右侧预留：控制按钮组 170px + 新建按钮 28px + 舒适拖拽空白区 68px + 间距 = 270px
            width: min(tabs-layout.preferred-width, max(0px, parent.width - 270px));
            height: parent.height;
            clip: true;

            tabs-flick := Flickable {
                width: 100%;
                height: 100%;
                interactive: false;
                content-width: tabs-layout.preferred-width;
                // 布局宽度变化（新建标签、窗口刚显示、缩放）时补滚。
                // 只在待办状态下补，避免抢走用户手动滚动的位置。
                changed content-width => {
                    if (root.scroll-pending) {
                        root.apply-scroll();
                    }
                }
                // 视口宽度变化 = 窗口缩放 / 从最大化还原 / 侧栏拖宽。
                // 变窄后当前标签可能整个滑出可视区，用户就看不出自己在哪一页，
                // 所以这里无条件把「当前标签」重新拉回可视范围
                // （已在可视区内时是空操作，不会移动任何东西）。
                changed width => {
                    if (root.scroll-pending) {
                        root.apply-scroll();
                    } else {
                        root.start-scroll(root.active-tab);
                    }
                }

                tabs-layout := HorizontalLayout {
                    x: 0px;
                    y: 0px;
                    height: 100%;
                    spacing: 3px;

                    for tab[i] in root.tabs : Rectangle {
                        width: 150px;
                        horizontal-stretch: 0;
                        height: 34px;
                        border-top-left-radius: 6px;
                        border-top-right-radius: 6px;
                        background: tab.active ? Theme.bg-active-tab
                            : (root.drop-slot == i && root.drag-index >= 0 ? Theme.bg-selected
                            : (ta.has-hover ? Theme.bg-hover : transparent));
                        animate background { duration: 120ms; easing: ease-out; }
                        // 被拖起的标签淡出，配合落点竖线给出交换反馈。
                        opacity: root.drag-index == i ? 0.55 : 1.0;
                        animate opacity { duration: 120ms; easing: ease-out; }

                        Rectangle {
                            y: parent.height - 2px;
                            x: 0px;
                            width: parent.width;
                            height: 2px;
                            background: tab.active ? Theme.accent : transparent;
                        }

                        HorizontalLayout {
                            spacing: 6px;
                            padding-left: 10px;
                            padding-right: 6px;
                            height: parent.height;

                            if (tab.active && root.loading) : Rectangle {
                                width: 14px;
                                height: 14px;
                                y: (parent.height - 14px) / 2;
                                border-radius: 7px;
                                background: Math.mod(animation-tick(), 800ms) < 400ms
                                    ? Theme.accent.transparentize(0.55)
                                    : Theme.accent;
                            }
                            if (!(tab.active && root.loading)) : Rectangle {
                                width: 16px;
                                height: 16px;
                                y: (parent.height - 16px) / 2;
                                border-radius: 4px;
                                background: Theme.accent.transparentize(0.82);

                                Text {
                                    text: tab.icon-text;
                                    color: Theme.accent;
                                    font-size: 10px;
                                    font-weight: 700;
                                    font-family: Theme.symbol-font-family;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }

                            Text {
                                text: tab.title;
                                color: tab.active ? Theme.text-primary : Theme.text-secondary;
                                font-size: 12.5px;
                                vertical-alignment: center;
                                overflow: elide;
                                horizontal-stretch: 1;
                            }

                            close-btn := Rectangle {
                                width: 18px;
                                height: 18px;
                                y: (parent.height - 18px) / 2;
                                border-radius: 4px;
                                background: close-ta.has-hover ? Theme.close-hover : transparent;
                                // 悬停关闭按钮时外层 ta.has-hover 未必成立，必须把
                                // close-ta 也算进来，否则整个红底会被压到 35% 透明。
                                opacity: (tab.active || ta.has-hover || close-ta.has-hover) ? 1.0 : 0.35;

                                IconClose {
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                    size: 8px;
                                    stroke-width: 1.1px;
                                    icon-color: close-ta.has-hover ? #FFFFFF : Theme.text-secondary;
                                }
                            }
                        }

                        ta := TouchArea {
                            width: 100%;
                            height: 100%;

                            clicked => {
                                root.tab_activated(tab.id);
                            }

                            pointer-event(event) => {
                                if (event.kind == PointerEventKind.down && event.button == PointerEventButton.middle) {
                                    root.tab_closed(tab.id);
                                    return EventResult.accept;
                                }
                                // 右键弹菜单。accept 掉，避免事件继续传给下层
                                // （下层是拖拽用的 ta 之外的东西，重复触发会弹两次菜单）。
                                if (event.kind == PointerEventKind.down && event.button == PointerEventButton.right) {
                                    root.tab_context_requested(tab.id);
                                    return EventResult.accept;
                                }
                                // 左键按下/松开上报拖动（与侧栏三阶段一致，中键关闭不受影响）。
                                if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                                    root.tab_drag(i, 0, self.mouse-x);
                                } else if (event.kind == PointerEventKind.up && event.button == PointerEventButton.left) {
                                    root.tab_drag(i, 2, self.mouse-x);
                                }
                                return EventResult.reject;
                            }
                            moved => {
                                if (self.pressed) {
                                    root.tab_drag(i, 1, self.mouse-x);
                                }
                            }

                            // 滚轮在标签上可直接左右平滑滚动
                            scroll-event(event) => {
                                if (event.delta-y != 0px && tabs-flick.content-width > tabs-flick.width) {
                                    let max-scroll = tabs-flick.content-width - tabs-flick.width;
                                    tabs-flick.content-x = max(-max-scroll, min(0px, tabs-flick.content-x + event.delta-y));
                                    return EventResult.accept;
                                }
                                return EventResult.reject;
                            }
                        }

                        close-ta := TouchArea {
                            x: parent.width - 34px;
                            y: 8px;
                            width: 26px;
                            height: 18px;

                            clicked => {
                                root.tab_closed(tab.id);
                            }
                        }
                    }
                }
                // 落点竖线：随目标标签平滑滑动，作为交换动画的视觉反馈。
                if (root.tab-drop-visible) : Rectangle {
                    x: root.drop-slot * 153px - 1.5px;
                    y: 2px;
                    width: 3px;
                    height: parent.height - 4px;
                    border-radius: 1.5px;
                    background: Theme.accent;
                    z: 10;
                    animate x { duration: 120ms; easing: ease-out; }
                }
            }
        }

        // 新建标签按钮（矢量十字，严格垂直居中，与右侧窗口控制按钮同排）
        Rectangle {
            width: 28px;
            height: 28px;
            y: (parent.height - self.height) / 2;
            border-radius: 6px;
            background: new-ta.has-hover ? Theme.bg-hover : transparent;

            IconPlus {
                size: 11px;
                icon-color: new-ta.has-hover ? Theme.text-primary : Theme.text-secondary;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
            }

            new-ta := TouchArea {
                width: 100%;
                height: 100%;
                clicked => {
                    root.new_tab_requested();
                }
            }
        }


        // 剩余空白区域：Slint 原生移动区域。
        // 内部严禁放 TouchArea：触控指针会被其捕获，而手指在非客户区
        // （HTCAPTION）不会产生对应释放事件，导致指针永久卡在捕获态——
        // 表现为触屏拖不动，且随后鼠标拖动也一并失效。
        // 双击最大化由 Windows 原生标题栏语义接管，无需在此处理。
        drag-spacer := WindowMoveArea {
            horizontal-stretch: 1;
            min-width: 60px; // 强制至少保留 60px 舒适拖拽宽度
            height: parent.height;
        }

        // 窗口控制按钮组 (设置 / 最小化 / 最大化 / 关闭)
        HorizontalLayout {
            min-width: 170px;        // 锁定 170px：布局收缩时也不允许压到按钮
            max-width: 170px;
            horizontal-stretch: 0;   // 严禁在窗口缩窄时被压缩
            spacing: 0px;
            height: parent.height;

            // 设置齿轮（排在最小化左侧，36px）
            Rectangle {
                width: 36px;
                height: parent.height;
                background: settings-ta.has-hover ? Theme.bg-hover : transparent;

                Text {
                    text: "⚙";
                    color: settings-ta.has-hover ? Theme.text-primary : Theme.text-secondary;
                    font-family: Theme.symbol-font-family;
                    font-size: 13px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    width: 100%;
                    height: 100%;
                    y: -0.8px;
                }
                settings-ta := TouchArea {
                    clicked => { root.settings_requested(); }
                }
            }

            // 最小化：精准 10px × 1.1px 纤细横线
            Rectangle {
                width: 44px;
                height: parent.height;
                background: min-ta.has-hover ? Theme.bg-hover : transparent;

                // 父级是普通 Rectangle（非布局），子元素必须显式居中。
                Rectangle {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    width: 10px;
                    height: 1.1px;
                    border-radius: 0.5px;
                    background: min-ta.has-hover ? Theme.text-primary : Theme.text-secondary;
                }
                min-ta := TouchArea {
                    clicked => { root.window_minimize(); }
                }
            }

            // 最大化 / 还原：9.5px × 9.5px、1.1px 框宽、1.5px 柔和微圆角（对标 Sigma 质感）
            Rectangle {
                width: 44px;
                height: parent.height;
                background: max-ta.has-hover ? Theme.bg-hover : transparent;

                Rectangle {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    width: 9.5px;
                    height: 9.5px;
                    border-width: 1.1px;
                    border-radius: 1.5px; // 柔和微圆角，大幅削减笨重感
                    border-color: max-ta.has-hover ? Theme.text-primary : Theme.text-secondary;
                    background: transparent;
                }
                max-ta := TouchArea {
                    clicked => { root.window_maximize(); }
                }
            }

            // 关闭：微调增大到 10.5px，线宽与最大化线框严格一致
            Rectangle {
                width: 46px;
                height: parent.height;
                background: close-win-ta.has-hover ? Theme.close-hover : transparent;

                IconClose {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    size: 10.5px; // 增大尺寸
                    stroke-width: 1.15px; // 线宽匹配
                    icon-color: close-win-ta.has-hover ? #FFFFFF : Theme.text-secondary;
                }
                close-win-ta := TouchArea {
                    clicked => { root.window_close(); }
                }
            }
        }
    }
}

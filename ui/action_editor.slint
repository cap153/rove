import { I18n } from "i18n.slint";
// 动作编辑器弹窗（新增 / 编辑自定义右键菜单项）。
import { Theme, IconClose } from "common.slint";
import { SingleLineEdit } from "single_line_edit.slint";

// 标准风格化文本输入框（带背景底槽、1px 边框、聚焦高亮与占位提示）
component StyledInput inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder: "";
    in property <bool> enabled: true;

    height: 32px;
    vertical-stretch: 0;
    border-radius: 6px;
    background: Theme.bg-main;
    border-width: 1px;
    border-color: ti.has-focus ? Theme.accent : Theme.border;

    ti := SingleLineEdit {
        x: 10px;
        width: parent.width - 20px;
        height: parent.height;
        text <=> root.text;
        font-size: 12.5px;
        text-color: Theme.text-primary;
        enabled: root.enabled;
    }

    if (root.text == "" && !ti.has-focus && root.placeholder != "") : Text {
        x: 10px;
        width: parent.width - 20px;
        height: parent.height;
        text: root.placeholder;
        font-size: 12px;
        color: Theme.text-disabled;
        vertical-alignment: center;
    }
}

// 作用对象单选按钮。
component RadioDot inherits Rectangle {
    in-out property <bool> selected: false;
    in property <string> label: "";
    callback clicked-cb();

    height: 24px;
    background: transparent;

    HorizontalLayout {
        spacing: 6px;
        alignment: start;

        Rectangle {
            width: 14px;
            height: 14px;
            y: (parent.height - self.height) / 2;
            border-radius: 7px;
            border-width: 1px;
            border-color: root.selected ? Theme.accent : Theme.border;

            Rectangle {
                visible: root.selected;
                x: 3px;
                y: 3px;
                width: 8px;
                height: 8px;
                border-radius: 4px;
                background: Theme.accent;
            }
        }

        Text {
            text: root.label;
            color: Theme.text-primary;
            font-size: 12px;
            vertical-alignment: center;
        }
    }

    TouchArea {
        width: 100%;
        height: 100%;
        clicked => {
            root.clicked-cb();
        }
    }
}

// 参数模板占位符按钮：点击自动追加双引号包裹的参数
component TokenChip inherits Rectangle {
    in property <string> token: "";
    in-out property <string> target-text;
    callback append-cb();

    height: 22px;
    border-radius: 4px;
    border-width: 1px;
    border-color: Theme.border;
    background: token-ta.has-hover ? Theme.bg-hover : transparent;

    HorizontalLayout {
        padding-left: 6px;
        padding-right: 6px;

        Text {
            text: root.token;
            color: Theme.text-secondary;
            font-size: 11px;
            vertical-alignment: center;
        }
    }

    token-ta := TouchArea {
        width: 100%;
        height: 100%;
        clicked => {
            let quoted = "\"" + root.token + "\"";
            if (root.target-text != "") {
                root.target-text += " ";
            }
            root.target-text += quoted;
            root.append-cb();
        }
    }
}

export component ActionEditorDialog inherits Rectangle {
    in property <string> title: I18n.strings[52];
    in property <[string]> group-options: [I18n.strings[5]];
    in-out property <string> edit-id: "";
    in-out property <string> edit-label: "";
    in-out property <string> edit-group: "";
    in-out property <string> edit-target: "any";
    in-out property <string> edit-extensions: "";
    in-out property <string> edit-program: "";
    in-out property <string> edit-args: "";
    in-out property <string> edit-working-dir: "";

    callback save();
    callback cancel();
    callback browse();

    // 内部控制层级下拉框展开状态
    property <bool> dropdown-open: false;

    width: 100%;
    height: 100%;

    // 1. 半透明黑色遮罩：仅吸收点击拦截穿透，不触发关闭（彻底防止误触丢失输入）
    Rectangle {
        width: 100%;
        height: 100%;
        background: #000000;
        opacity: 0.45;

        TouchArea {
            width: 100%;
            height: 100%;
            // 点击遮罩空白区不执行 cancel()
        }
    }

    // 2. 弹窗卡片：自适应内容高度，拒绝硬编码拉伸造成的空白错位
    Rectangle {
        x: (parent.width - self.width) / 2;
        y: max(16px, (parent.height - self.height) / 2);
        width: 480px;
        height: card-layout.preferred-height;
        background: Theme.bg-input;
        border-radius: 10px;
        border-width: 1px;
        border-color: Theme.border;

        card-layout := VerticalLayout {
            padding-left: 24px;
            padding-right: 24px;
            padding-top: 20px;
            padding-bottom: 20px;
            spacing: 14px; // 严格统一的行间距节奏！
            alignment: start;

            // 标题行 + 右上角关闭叉号
            HorizontalLayout {
                height: 24px;

                Text {
                    text: root.title;
                    color: Theme.text-primary;
                    font-size: 16px;
                    font-weight: 600;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }

                Rectangle {
                    width: 24px;
                    height: 24px;
                    border-radius: 4px;
                    background: close-ta.has-hover ? Theme.close-hover : transparent;

                    IconClose {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        size: 9px;
                        stroke-width: 1.1px;
                        icon-color: close-ta.has-hover ? #FFFFFF : Theme.text-secondary;
                    }

                    close-ta := TouchArea {
                        width: 100%;
                        height: 100%;
                        clicked => {
                            root.cancel();
                        }
                    }
                }
            }

            // 字段 1：显示名称
            VerticalLayout {
                spacing: 4px;
                Text { text: I18n.strings[30]; color: Theme.text-secondary; font-size: 12px; }
                StyledInput {
                    text <=> root.edit-label;
                    placeholder: I18n.strings[15];
                }
            }

            // 字段 2：程序路径 + 浏览按钮
            VerticalLayout {
                spacing: 4px;
                Text { text: I18n.strings[49]; color: Theme.text-secondary; font-size: 12px; }
                HorizontalLayout {
                    spacing: 8px;

                    StyledInput {
                        horizontal-stretch: 1;
                        text <=> root.edit-program;
                        placeholder: I18n.strings[29];
                    }

                    Rectangle {
                        width: 76px;
                        height: 32px;
                        border-radius: 6px;
                        border-width: 1px;
                        border-color: Theme.border;
                        background: browse-ta.has-hover ? Theme.bg-hover : transparent;

                        Text {
                            text: I18n.strings[62];
                            color: Theme.text-primary;
                            font-size: 12px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            width: 100%;
                            height: 100%;
                        }

                        browse-ta := TouchArea {
                            width: 100%;
                            height: 100%;
                            clicked => {
                                root.browse();
                            }
                        }
                    }
                }
            }

            // 字段 3：参数模板
            VerticalLayout {
                spacing: 4px;
                Text { text: I18n.strings[26]; color: Theme.text-secondary; font-size: 12px; }
                StyledInput {
                    text <=> root.edit-args;
                    placeholder: I18n.strings[12];
                }

                HorizontalLayout {
                    spacing: 6px;
                    alignment: start;

                    for tok in ["{target_path}", "{target_paths}", "{target_dir}", "{name}", "{stem}"] : TokenChip {
                        token: tok;
                        target-text <=> root.edit-args;
                    }
                }
            }

            // 字段 4：作用对象（单选）
            VerticalLayout {
                spacing: 4px;
                Text { text: I18n.strings[10]; color: Theme.text-secondary; font-size: 12px; }

                HorizontalLayout {
                    spacing: 16px;
                    alignment: start;

                    RadioDot {
                        label: I18n.strings[19];
                        selected: root.edit-target == "any";
                        clicked-cb => { root.edit-target = "any"; }
                    }
                    RadioDot {
                        label: I18n.strings[8];
                        selected: root.edit-target == "file";
                        clicked-cb => { root.edit-target = "file"; }
                    }
                    RadioDot {
                        label: I18n.strings[9];
                        selected: root.edit-target == "dir";
                        clicked-cb => { root.edit-target = "dir"; }
                    }
                }
            }

            // 字段 5：层级归属（可输入新名称新建二级菜单；右侧箭头列出已有分组）
            VerticalLayout {
                spacing: 4px;
                Text { text: I18n.strings[39]; color: Theme.text-secondary; font-size: 12px; }

                drop-box := Rectangle {
                    height: 32px;
                    border-radius: 6px;
                    background: Theme.bg-main;
                    border-width: 1px;
                    border-color: group-input.has-focus || root.dropdown-open ? Theme.accent : Theme.border;

                    group-input := SingleLineEdit {
                        x: 10px;
                        width: parent.width - 36px;
                        height: parent.height;
                        text <=> root.edit-group;
                        font-size: 12.5px;
                        text-color: Theme.text-primary;
                    }

                    if (root.edit-group == "" && !group-input.has-focus) : Text {
                        x: 10px;
                        width: parent.width - 36px;
                        height: parent.height;
                        text: I18n.strings[5];
                        font-size: 12.5px;
                        color: Theme.text-disabled;
                        vertical-alignment: center;
                        overflow: elide;
                    }

                    // 箭头：只负责列出已有分组，不抢输入框的焦点
                    Rectangle {
                        x: parent.width - 26px;
                        width: 22px;
                        height: 100%;
                        background: transparent;

                        Text {
                            // 上拉菜单：展开时箭头朝上 ▲，收起时朝下 ▼
                            text: root.dropdown-open ? "▲" : "▼";
                            color: Theme.text-secondary;
                            font-size: 8px;
                            font-family: Theme.symbol-font-family;
                            vertical-alignment: center;
                            horizontal-alignment: center;
                            width: 100%;
                            height: 100%;
                        }

                        TouchArea {
                            width: 100%;
                            height: 100%;
                            clicked => {
                                root.dropdown-open = !root.dropdown-open;
                            }
                        }
                    }

                    // 上拉菜单浮层：直接挂在 drop-box 内部，坐标为负值向上展开！
                    // 彻底解决跨组件绝对坐标错位的 Bug，上方空间充足，限高 140px 自动滚动
                    if (root.dropdown-open) : Rectangle {
                        x: 0px;
                        y: -self.height - 4px; // 向上弹出，紧贴 drop-box 顶端
                        width: parent.width;
                        height: min(140px, root.group-options.length * 30px + 8px);
                        z: 100;
                        background: Theme.bg-input;
                        border-radius: 6px;
                        border-width: 1px;
                        border-color: Theme.border;
                        clip: true;

                        Flickable {
                            width: 100%;
                            height: 100%;
                            content-height: opt-layout.preferred-height;
                            interactive: true;

                            opt-layout := VerticalLayout {
                                padding-top: 4px;
                                padding-bottom: 4px;
                                spacing: 0px;

                                for opt in root.group-options : Rectangle {
                                    height: 30px;
                                    background: opt-ta.has-hover ? Theme.bg-hover : (root.edit-group == (opt == I18n.strings[5] ? "" : opt) ? Theme.bg-selected : transparent);

                                    HorizontalLayout {
                                        padding-left: 10px;
                                        padding-right: 10px;

                                        Text {
                                            text: opt;
                                            color: root.edit-group == (opt == I18n.strings[5] ? "" : opt) ? Theme.accent : Theme.text-primary;
                                            font-size: 12px;
                                            font-weight: root.edit-group == (opt == I18n.strings[5] ? "" : opt) ? 600 : 400;
                                            vertical-alignment: center;
                                        }
                                    }

                                    opt-ta := TouchArea {
                                        width: 100%;
                                        height: 100%;
                                        clicked => {
                                            root.edit-group = (opt == I18n.strings[5] ? "" : opt);
                                            root.dropdown-open = false;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // 字段 6：适用扩展名
            VerticalLayout {
                spacing: 4px;
                Text { text: I18n.strings[77]; color: Theme.text-secondary; font-size: 12px; }
                StyledInput {
                    text <=> root.edit-extensions;
                    placeholder: I18n.strings[14];
                }
            }

            // 底部操作按钮
            HorizontalLayout {
                height: 34px;
                spacing: 12px;
                alignment: end;

                Rectangle {
                    width: 72px;
                    height: parent.height;
                    background: cancel-btn-ta.has-hover ? Theme.bg-hover : transparent;
                    border-radius: 6px;
                    border-width: 1px;
                    border-color: Theme.border;

                    Text {
                        text: I18n.strings[27];
                        color: Theme.text-primary;
                        font-size: 12.5px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        width: 100%;
                        height: 100%;
                    }

                    cancel-btn-ta := TouchArea {
                        width: 100%;
                        height: 100%;
                        clicked => {
                            root.cancel();
                        }
                    }
                }

                Rectangle {
                    width: 72px;
                    height: parent.height;
                    background: save-btn-ta.has-hover ? Theme.accent-hover : Theme.accent;
                    border-radius: 6px;

                    Text {
                        text: I18n.strings[16];
                        color: white;
                        font-size: 12.5px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        width: 100%;
                        height: 100%;
                    }

                    save-btn-ta := TouchArea {
                        width: 100%;
                        height: 100%;
                        clicked => {
                            root.save();
                        }
                    }
                }
            }
        }
    }
}

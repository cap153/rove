import { Button, ListView, ScrollView } from "std-widgets.slint";

// 表格预览行（固定 8 列）
export struct PreviewRow {
    c0: string,
    c1: string,
    c2: string,
    c3: string,
    c4: string,
    c5: string,
    c6: string,
    c7: string,
    count: int,
}

export component PreviewWindow inherits Window {
    title: "预览";
    min-width: 560px;
    min-height: 420px;
    preferred-width: 760px;
    preferred-height: 560px;
    background: #f2f2f2;
    default-font-family: "Microsoft YaHei";

    in property <string> file-name: "";
    in property <string> file-info: "";
    in property <string> content-kind: "info";
    in property <image> preview-image;
    in property <string> text-content: "";
    in property <[PreviewRow]> table-rows: [];
    in property <string> message: "";

    callback open-external();
    callback close-window();

    VerticalLayout {
        padding: 10px;
        spacing: 8px;

        // 标题栏
        HorizontalLayout {
            height: 26px;
            spacing: 8px;
            Text {
                text: root.file-name;
                horizontal-stretch: 1;
                vertical-alignment: center;
                font-size: 13px;
                font-weight: 700;
                color: #1a1a1a;
                overflow: TextOverflow.elide;
            }
            Text {
                text: root.file-info;
                vertical-alignment: center;
                font-size: 11px;
                color: #555555;
            }
        }

        Rectangle {
            horizontal-stretch: 1;
            background: #ffffff;
            border-width: 1px;
            border-color: #d4d4d4;

            // 图片
            if root.content-kind == "image": Image {
                source: root.preview-image;
                image-fit: contain;
                width: 100%;
                height: 100%;
            }

            // 文本 / 代码 / Markdown
            if root.content-kind == "text": ScrollView {
                width: 100%;
                height: 100%;
                Text {
                    text: root.text-content;
                    font-family: "Consolas";
                    font-size: 12px;
                    color: #1a1a1a;
                    wrap: TextWrap.word-wrap;
                }
            }

            // CSV / Excel 表格
            if root.content-kind == "table": ScrollView {
                width: 100%;
                height: 100%;
                ListView {
                    width: 100%;
                    height: 100%;
                    for row[i] in root.table-rows: Rectangle {
                        height: 24px;
                        background: Math.mod(i, 2) == 0 ? #ffffff : #f7f7f7;
                        HorizontalLayout {
                            padding: 4px;
                            spacing: 1px;
                            Text { text: row.c0; width: 140px; vertical-alignment: center; font-size: 11px; color: #1a1a1a; overflow: TextOverflow.elide; }
                            Text { text: row.c1; width: 120px; vertical-alignment: center; font-size: 11px; color: #1a1a1a; overflow: TextOverflow.elide; }
                            Text { text: row.c2; width: 120px; vertical-alignment: center; font-size: 11px; color: #1a1a1a; overflow: TextOverflow.elide; }
                            Text { text: row.c3; width: 120px; vertical-alignment: center; font-size: 11px; color: #1a1a1a; overflow: TextOverflow.elide; }
                            Text { text: row.c4; width: 120px; vertical-alignment: center; font-size: 11px; color: #1a1a1a; overflow: TextOverflow.elide; }
                            Text { text: row.c5; width: 120px; vertical-alignment: center; font-size: 11px; color: #1a1a1a; overflow: TextOverflow.elide; }
                            Text { text: row.c6; width: 120px; vertical-alignment: center; font-size: 11px; color: #1a1a1a; overflow: TextOverflow.elide; }
                            Text { text: row.c7; width: 120px; vertical-alignment: center; font-size: 11px; color: #1a1a1a; overflow: TextOverflow.elide; }
                        }
                    }
                }
            }

            // 信息卡（PDF / 音视频 / 二进制）
            if root.content-kind == "info": VerticalLayout {
                padding: 24px;
                spacing: 12px;
                alignment: center;
                Text {
                    text: root.message == "" ? "无可用预览" : root.message;
                    horizontal-alignment: center;
                    font-size: 13px;
                    color: #444444;
                    wrap: TextWrap.word-wrap;
                }
            }
        }

        // 底部按钮
        HorizontalLayout {
            height: 28px;
            spacing: 8px;
            alignment: end;
            Button {
                text: "用默认程序打开";
                clicked => { root.open-external(); }
            }
            Button {
                text: "关闭";
                clicked => { root.close-window(); }
            }
        }
    }
}

import { Button, CheckBox, ComboBox, LineEdit, ListView, ScrollView } from "std-widgets.slint";

// ============================================================ 数据模型

export struct TextSpan {
    text: string,
    is-match: bool,
}

export struct FileEntry {
    name: string,
    path: string,
    kind: string,
    size: string,
    modified: string,
    is-dir: bool,
    has-image: bool,
    image: image,
    badge: string,
    badge-color: color,
    spans: [TextSpan],
}

export struct TabItem {
    id: int,
    kind: string,
    title: string,
    path: string,
}

export struct StagingItem {
    name: string,
    path: string,
}

export struct MenuNode {
    id: int,
    label: string,
    kind: string,
    enabled: bool,
}

export struct Breadcrumb {
    name: string,
    path: string,
}

export struct DriveItem {
    letter: string,
    label: string,
    used-percent: float,
    capacity: string,
}

export struct SideItem {
    id: string,
    label: string,
    detail: string,
    tint: color,
}

export struct SearchSuggestion {
    id: int,
    label: string,
    hint: string,
}

export struct ActionRow {
    id: string,
    label: string,
    kind: string,
    enabled: bool,
    depth: int,
    detail: string,
    has-command: bool,
}

// ============================================================ 矢量图标（Path 绘制，避免字体缺字）

component IconBack inherits Path {
    width: 16px;
    height: 16px;
    stroke: #444444;
    stroke-width: 1.8px;
    viewbox-width: 16;
    viewbox-height: 16;
    MoveTo { x: 10; y: 3; }
    LineTo { x: 4.5; y: 8; }
    LineTo { x: 10; y: 13; }
}

component IconForward inherits Path {
    width: 16px;
    height: 16px;
    stroke: #444444;
    stroke-width: 1.8px;
    viewbox-width: 16;
    viewbox-height: 16;
    MoveTo { x: 6; y: 3; }
    LineTo { x: 11.5; y: 8; }
    LineTo { x: 6; y: 13; }
}

component IconUp inherits Path {
    width: 16px;
    height: 16px;
    stroke: #444444;
    stroke-width: 1.8px;
    viewbox-width: 16;
    viewbox-height: 16;
    MoveTo { x: 3; y: 10.5; }
    LineTo { x: 8; y: 5; }
    LineTo { x: 13; y: 10.5; }
}

component IconRefresh inherits Path {
    width: 16px;
    height: 16px;
    stroke: #444444;
    stroke-width: 1.6px;
    viewbox-width: 16;
    viewbox-height: 16;
    MoveTo { x: 13; y: 8; }
    QuadraticTo { control-x: 13; control-y: 12.2; x: 8.8; y: 12.2; }
    QuadraticTo { control-x: 4.6; control-y: 12.2; x: 4.6; y: 8; }
    QuadraticTo { control-x: 4.6; control-y: 3.8; x: 8.8; y: 3.8; }
    QuadraticTo { control-x: 12.4; control-y: 3.8; x: 13.4; y: 7.2; }
    MoveTo { x: 13; y: 3.4; }
    LineTo { x: 13.6; y: 7.6; }
    LineTo { x: 9.6; y: 7.2; }
}

component IconSearch inherits Path {
    width: 14px;
    height: 14px;
    stroke: #5f6368;
    stroke-width: 1.6px;
    viewbox-width: 16;
    viewbox-height: 16;
    MoveTo { x: 6.6; y: 6.6; }
    LineTo { x: 11.4; y: 11.4; }
    MoveTo { x: 11.8; y: 4.6; }
    QuadraticTo { control-x: 11.8; control-y: 8.2; x: 8.2; y: 8.2; }
    QuadraticTo { control-x: 4.6; control-y: 8.2; x: 4.6; y: 4.6; }
    QuadraticTo { control-x: 4.6; control-y: 1; x: 8.2; y: 1; }
    QuadraticTo { control-x: 11.8; control-y: 1; x: 11.8; y: 4.6; }
}

component IconClose inherits Path {
    width: 10px;
    height: 10px;
    stroke: #5f6368;
    stroke-width: 1.4px;
    viewbox-width: 12;
    viewbox-height: 12;
    MoveTo { x: 3; y: 3; }
    LineTo { x: 9; y: 9; }
    MoveTo { x: 9; y: 3; }
    LineTo { x: 3; y: 9; }
}

component IconChevron inherits Path {
    width: 12px;
    height: 12px;
    stroke: #9aa0a6;
    stroke-width: 1.4px;
    viewbox-width: 12;
    viewbox-height: 12;
    MoveTo { x: 4.5; y: 2.5; }
    LineTo { x: 8.5; y: 6; }
    LineTo { x: 4.5; y: 9.5; }
}

component IconFolder inherits Path {
    width: 16px;
    height: 16px;
    fill: #5b9bd5;
    viewbox-width: 16;
    viewbox-height: 16;
    MoveTo { x: 1.5; y: 4; }
    LineTo { x: 1.5; y: 13; }
    LineTo { x: 14.5; y: 13; }
    LineTo { x: 14.5; y: 6; }
    LineTo { x: 8; y: 6; }
    LineTo { x: 6.5; y: 4; }
    Close { }
}

component IconFile inherits Path {
    width: 16px;
    height: 16px;
    fill: #9aa0a6;
    viewbox-width: 16;
    viewbox-height: 16;
    MoveTo { x: 4; y: 1.5; }
    LineTo { x: 9.5; y: 1.5; }
    LineTo { x: 12.5; y: 4.5; }
    LineTo { x: 12.5; y: 14.5; }
    LineTo { x: 4; y: 14.5; }
    Close { }
    MoveTo { x: 9.2; y: 1.8; }
    LineTo { x: 9.2; y: 4.8; }
    LineTo { x: 12.2; y: 4.8; }
}

// ============================================================ 通用控件

component GhostButton inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    in property <int> btn-min-width: 52;
    callback clicked();

    height: 26px;
    min-width: root.btn-min-width * 1px;
    background: touch.has-hover && root.enabled ? #e4e6eb : Colors.transparent;
    border-radius: 4px;

    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }

    Text {
        text: root.text;
        horizontal-alignment: center;
        vertical-alignment: center;
        font-size: 12px;
        color: root.enabled ? #202124 : #9aa0a6;
    }
}

component NavButton inherits Rectangle {
    in property <bool> enabled: true;
    in property <string> tip;
    callback clicked();

    width: 30px;
    height: 28px;
    background: touch.has-hover && root.enabled ? #e4e6eb : Colors.transparent;
    border-radius: 4px;

    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        alignment: center;
        if root.tip == "back": IconBack {}
        if root.tip == "forward": IconForward {}
        if root.tip == "up": IconUp {}
        if root.tip == "refresh": IconRefresh {}
    }
}

// ============================================================ 文件行

component FileRow inherits Rectangle {
    in property <FileEntry> entry;
    in property <int> index;
    in property <bool> selected;
    in property <bool> editing;
    in property <bool> show-path;
    in-out property <string> edit-text;
    callback clicked();
    callback double-clicked();
    callback right-clicked(int, length, length);
    callback commit-edit(string);
    callback cancel-edit();

    height: 28px;
    background: root.selected ? #d3e6fa : (Math.mod(root.index, 2) == 0 ? #ffffff : #fafafa);

    TouchArea {
        width: 100%;
        height: 100%;
        clicked => { root.clicked(); }
        double-clicked => { root.double-clicked(); }
        pointer-event(event) => {
            if event.button == PointerEventButton.right && event.kind == PointerEventKind.down {
                root.right-clicked(root.index, self.mouse-x, root.y + self.mouse-y);
            }
        }
    }

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 10px;
        spacing: 8px;

        // 缩略图 / 类型图标
        if root.entry.has-image: Image {
            source: root.entry.image;
            width: 18px;
            height: 18px;
            vertical-alignment: center;
        }
        if !root.entry.has-image && root.entry.is-dir: Rectangle {
            width: 18px;
            height: 18px;
            IconFolder {
                width: 16px;
                height: 16px;
            }
        }
        if !root.entry.has-image && !root.entry.is-dir: Rectangle {
            width: 18px;
            height: 18px;
            IconFile {
                width: 16px;
                height: 16px;
            }
        }

        // 名称（搜索时按 span 高亮）
        if root.editing: LineEdit {
            text <=> root.edit-text;
            horizontal-stretch: 1;
            height: 20px;
            accepted(text) => { root.commit-edit(text); }
            init => {
                self.focus();
                self.select-all();
            }
        }
        if !root.editing: HorizontalLayout {
            horizontal-stretch: 1;
            alignment: start;
            spacing: 0px;
            for span in root.entry.spans : Text {
                text: span.text;
                vertical-alignment: center;
                font-size: 12px;
                font-weight: span.is-match ? 700 : 400;
                color: span.is-match
                    ? (root.selected ? #0b3d91 : #0b57d0)
                    : (root.selected ? #000000 : #1a1a1a);
            }
        }

        // 路径列：仅搜索模式
        if root.show-path: Text {
            text: root.entry.path;
            width: 260px;
            vertical-alignment: center;
            horizontal-alignment: left;
            overflow: TextOverflow.elide;
            color: root.selected ? #333333 : #6b6b6b;
            font-size: 10px;
        }

        Text {
            text: root.entry.modified;
            width: 132px;
            vertical-alignment: center;
            horizontal-alignment: right;
            color: root.selected ? #333333 : #5f6368;
            font-size: 11px;
        }

        Rectangle {
            width: 50px;
            height: 16px;
            background: root.entry.badge-color;
            border-radius: 8px;
            Text {
                text: root.entry.badge;
                horizontal-alignment: center;
                vertical-alignment: center;
                font-size: 9px;
                color: #ffffff;
            }
        }

        Text {
            text: root.entry.size;
            width: 80px;
            vertical-alignment: center;
            horizontal-alignment: right;
            color: root.selected ? #333333 : #5f6368;
            font-size: 11px;
        }
    }
}

// ============================================================ 菜单行

component MenuRow inherits Rectangle {
    in property <MenuNode> item;
    callback activated(int);
    callback hovered(int);

    height: root.item.kind == "separator" ? 9px : 26px;
    background: #ffffff;

    if root.item.kind == "separator": Rectangle {
        x: 8px;
        y: 4px;
        width: parent.width - 16px;
        height: 1px;
        background: #e0e0e0;
    }

    TouchArea {
        width: 100%;
        height: 100%;
        enabled: root.item.enabled && root.item.kind != "separator";
        changed has-hover => {
            if (self.has-hover) {
                root.hovered(root.item.id);
            }
        }
        clicked => { root.activated(root.item.id); }
    }

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 8px;
        Text {
            text: root.item.label;
            vertical-alignment: center;
            horizontal-stretch: 1;
            font-size: 12px;
            color: root.item.enabled ? #1a1a1a : #9a9a9a;
        }
        if root.item.kind == "submenu": Text {
            text: ">";
            vertical-alignment: center;
            color: #6a6a6a;
            font-size: 11px;
        }
    }
}

// ============================================================ 侧边栏行

component SideRow inherits Rectangle {
    in property <string> label;
    in property <string> detail;
    in property <color> tint;
    callback activated();

    height: 30px;
    background: #f7f8fa;
    TouchArea {
        width: 100%;
        height: 100%;
        clicked => { root.activated(); }
    }
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 8px;
        spacing: 8px;
        Rectangle {
            width: 8px;
            height: 8px;
            background: root.tint;
            border-radius: 2px;
        }
        Text {
            text: root.label;
            vertical-alignment: center;
            horizontal-stretch: 1;
            font-size: 12px;
            color: #1a1a1a;
            overflow: TextOverflow.elide;
        }
        Text {
            text: root.detail;
            vertical-alignment: center;
            font-size: 10px;
            color: #80868b;
        }
    }
}

component DriveRow inherits Rectangle {
    in property <DriveItem> drive;
    callback activated();

    height: 44px;
    background: #f7f8fa;
    TouchArea {
        width: 100%;
        height: 100%;
        clicked => { root.activated(); }
    }
    VerticalLayout {
        padding-left: 10px;
        padding-right: 10px;
        padding-top: 6px;
        padding-bottom: 6px;
        spacing: 3px;
        HorizontalLayout {
            Text {
                text: root.drive.label + " (" + root.drive.letter + ")";
                vertical-alignment: center;
                horizontal-stretch: 1;
                font-size: 12px;
                color: #1a1a1a;
                overflow: TextOverflow.elide;
            }
            Text {
                text: root.drive.capacity;
                vertical-alignment: center;
                font-size: 10px;
                color: #80868b;
            }
        }
        Rectangle {
            height: 5px;
            background: #e3e6ea;
            border-radius: 3px;
            Rectangle {
                width: parent.width * root.drive.used-percent / 100;
                height: parent.height;
                background: root.drive.used-percent > 90 ? #e8715a : #6ba3e0;
                border-radius: 3px;
            }
        }
    }
}

component SideNavItem inherits Rectangle {
    in property <string> label;
    in property <int> page;
    in property <int> current;
    callback activated(int);

    height: 32px;
    background: root.page == root.current ? #e8f0fe : Colors.transparent;
    border-radius: 4px;
    TouchArea {
        width: 100%;
        height: 100%;
        clicked => { root.activated(root.page); }
    }
    HorizontalLayout {
        padding-left: 8px;
        Text {
            text: root.label;
            vertical-alignment: center;
            font-size: 12px;
            color: root.page == root.current ? #0b57d0 : #1a1a1a;
        }
    }
}

// ============================================================ 主窗口

export component MainWindow inherits Window {
    title: "Rove";
    min-width: 1000px;
    min-height: 620px;
    preferred-width: 1280px;
    preferred-height: 800px;
    background: #f2f2f2;

    // 中文字体回退（Slint 只接受单字族名）
    default-font-family: "Microsoft YaHei";

    // ---- 标签 ----
    in property <[TabItem]> tabs: [];
    in-out property <int> active-tab: 0;
    in-out property <string> active-tab-kind: "explorer";

    // ---- 当前目录 ----
    in-out property <string> current-path: "";
    in-out property <string> current-path2: "";
    in property <[Breadcrumb]> breadcrumbs: [];
    in-out property <bool> can-go-back: false;
    in-out property <bool> can-go-forward: false;

    // ---- 列表 ----
    in property <[FileEntry]> entries: [];
    in property <[FileEntry]> entries2: [];
    in-out property <int> selected-index: -1;
    in-out property <int> selected-index2: -1;
    in-out property <bool> split-view: false;
    in-out property <int> sort-mode: 0;
    in-out property <bool> show-path-column: false;

    // ---- 重命名 ----
    in-out property <int> rename-index: -1;
    in-out property <string> rename-text: "";

    // ---- 侧边栏 ----
    in property <[SideItem]> quick-items: [];
    in property <[DriveItem]> drives: [];
    in-out property <bool> network-expanded: false;
    in property <[StagingItem]> staging-items: [];
    in-out property <bool> staging-visible: true;

    // ---- 搜索 ----
    in-out property <string> search-text: "";
    in-out property <bool> search-active: false;
    in-out property <int> search-scope: 0;
    in property <string> search-count: "";
    in property <[SearchSuggestion]> search-suggestions: [];
    in-out property <bool> search-popup-open: false;

    // ---- 右键菜单 ----
    in property <[MenuNode]> menu-items: [];
    in property <[MenuNode]> menu-sub-items: [];
    in-out property <int> menu-sub-parent: -1;
    in-out property <length> menu-x: 0px;
    in-out property <length> menu-y: 0px;
    in-out property <int> menu-show-trigger: 0;
    in-out property <int> menu-hide-trigger: 0;

    // ---- 设置页 ----
    in-out property <int> settings-page: 0;
    in-out property <bool> opt-destroy-ui: true;
    in-out property <bool> opt-tray: true;
    in-out property <int> opt-theme: 0;
    in-out property <bool> opt-takeover-folders: false;
    in-out property <bool> opt-takeover-this-pc: false;
    in-out property <bool> opt-takeover-drives: false;
    in property <string> index-status: "";
    in property <string> archiver-summary: "";
    in property <[ActionRow]> actions: [];
    in-out property <int> selected-action: -1;
    in-out property <bool> edit-enabled: false;
    in-out property <string> edit-label;
    in-out property <string> edit-program;
    in-out property <string> edit-args;
    in-out property <string> edit-working-dir;
    in-out property <int> edit-target-index: 0;
    in-out property <string> edit-extensions;

    // ---- 状态栏 ----
    in-out property <string> status-text: "就绪";

    // ---- 回调：导航 ----
    callback navigate(string);
    callback go-up();
    callback go-back();
    callback go-forward();
    callback refresh();

    // ---- 回调：标签 ----
    callback new-tab();
    callback close-tab(int);
    callback activate-tab(int);
    callback open-settings-tab();
    callback settings-select-page(int);

    // ---- 回调：列表 ----
    callback select-entry(int, bool);
    callback open-entry(int, bool);
    callback select-entry2(int);
    callback open-entry2(int);
    callback right-clicked(int, length, length);
    callback rename-commit(string);
    callback rename-cancel();
    callback toggle-split();
    callback sort-by(int);

    // ---- 回调：工具条 ----
    callback new-folder();
    callback cut-selected();
    callback copy-selected();
    callback rename-selected();
    callback delete-selected();
    callback paste-here();

    // ---- 回调：侧边栏 / 暂存盘 ----
    callback side-activate(string);
    callback toggle-network();
    callback stage-toggle();
    callback stage-add();
    callback stage-copy-here();
    callback stage-move-here();
    callback stage-clear();
    callback stage-remove(int);

    // ---- 回调：搜索 ----
    callback search-changed(string);
    callback search-submit(int);
    callback search-focus();
    callback close-search();

    // ---- 回调：菜单 / 预览 / 对比 ----
    callback menu-action(int);
    callback menu-hover(int);
    callback preview-selected();
    callback diff-selected();

    // ---- 回调：设置 ----
    callback save-general();
    callback takeover-changed();
    callback select-action(int);
    callback toggle-action(int, bool);
    callback apply-edit();
    callback add-action();
    callback delete-action();

    // ============================================================ 布局

    FocusScope {
        key-pressed(event) => {
            if (event.modifiers.control && event.text == "f") {
                root.search-focus();
                return EventResult.accept;
            }
            if (event.text == " ") {
                root.preview-selected();
                return EventResult.accept;
            }
            return EventResult.reject;
        }

        VerticalLayout {
            spacing: 0px;

            // ===== 第 1 行：标签栏（最顶层） =====
            Rectangle {
                height: 36px;
                background: #e9ebee;
                HorizontalLayout {
                    padding: 5px;
                    spacing: 4px;
                    Rectangle {
                        horizontal-stretch: 1;
                        background: Colors.transparent;
                        HorizontalLayout {
                            spacing: 4px;
                            for t[i] in root.tabs: Rectangle {
                                width: 168px;
                                height: 26px;
                                background: i == root.active-tab ? #ffffff : #dfe2e6;
                                border-radius: 4px;
                                TouchArea {
                                    width: 100%;
                                    height: 100%;
                                    clicked => { root.activate-tab(i); }
                                }
                                HorizontalLayout {
                                    padding-left: 8px;
                                    padding-right: 4px;
                                    spacing: 4px;
                                    Text {
                                        text: t.title;
                                        vertical-alignment: center;
                                        horizontal-stretch: 1;
                                        overflow: TextOverflow.elide;
                                        font-size: 12px;
                                        color: i == root.active-tab ? #000000 : #3c4043;
                                    }
                                    Rectangle {
                                        width: 16px;
                                        height: 16px;
                                        background: Colors.transparent;
                                        IconClose {
                                            width: 10px;
                                            height: 10px;
                                        }
                                        TouchArea {
                                            width: 100%;
                                            height: 100%;
                                            clicked => { root.close-tab(i); }
                                        }
                                    }
                                }
                            }
                        }
                    }
                    GhostButton {
                        text: "+";
                        btn-min-width: 30;
                        clicked => { root.new-tab(); }
                    }
                }
            }

            // ===== 第 2 行：导航工具条（归属当前 Tab） =====
            HorizontalLayout {
                height: 42px;
                padding: 6px;
                spacing: 4px;
                NavButton {
                    tip: "back";
                    enabled: root.can-go-back;
                    clicked => { root.go-back(); }
                }
                NavButton {
                    tip: "forward";
                    enabled: root.can-go-forward;
                    clicked => { root.go-forward(); }
                }
                NavButton {
                    tip: "up";
                    clicked => { root.go-up(); }
                }
                NavButton {
                    tip: "refresh";
                    clicked => { root.refresh(); }
                }

                // 面包屑
                Rectangle {
                    horizontal-stretch: 1;
                    height: 30px;
                    background: #ffffff;
                    border-width: 1px;
                    border-color: #d4d4d4;
                    border-radius: 4px;
                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        spacing: 2px;
                        for crumb[i] in root.breadcrumbs: Rectangle {
                            height: parent.height;
                            background: crumb-touch.has-hover ? #eceff3 : Colors.transparent;
                            border-radius: 3px;
                            HorizontalLayout {
                                padding-left: 5px;
                                padding-right: 5px;
                                spacing: 3px;
                                Text {
                                    text: crumb.name;
                                    vertical-alignment: center;
                                    font-size: 12px;
                                    color: #1a1a1a;
                                    overflow: TextOverflow.elide;
                                }
                                if i < root.breadcrumbs.length - 1: IconChevron {
                                    width: 12px;
                                    height: 12px;
                                }
                            }
                            crumb-touch := TouchArea {
                                width: 100%;
                                height: 100%;
                                clicked => { root.navigate(crumb.path); }
                            }
                        }
                    }
                }

                // 搜索框
                Rectangle {
                    width: 268px;
                    height: 30px;
                    background: #ffffff;
                    border-width: 1px;
                    border-color: #d4d4d4;
                    border-radius: 4px;
                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 4px;
                        spacing: 5px;
                        IconSearch {
                            width: 14px;
                            height: 14px;
                        }
                        LineEdit {
                            text <=> root.search-text;
                            horizontal-stretch: 1;
                            placeholder-text: "搜索（支持拼音首字母）";
                            edited(text) => { root.search-changed(text); }
                            accepted(text) => { root.search-submit(root.search-scope); }
                        }
                        if root.search-active: Rectangle {
                            width: 18px;
                            height: 18px;
                            background: Colors.transparent;
                            IconClose {
                                width: 10px;
                                height: 10px;
                            }
                            TouchArea {
                                width: 100%;
                                height: 100%;
                                clicked => { root.close-search(); }
                            }
                        }
                    }

                    search-popup := PopupWindow {
                        x: 0px;
                        y: parent.height + 2px;
                        close-policy: PopupClosePolicy.close-on-click-outside;
                        Rectangle {
                            width: 340px;
                            background: #ffffff;
                            border-width: 1px;
                            border-color: #b4b4b4;
                            border-radius: 4px;
                            drop-shadow-color: #00000026;
                            drop-shadow-offset-y: 2px;
                            drop-shadow-blur: 8px;
                            VerticalLayout {
                                padding: 4px;
                                spacing: 2px;
                                for suggestion in root.search-suggestions: Rectangle {
                                    height: 30px;
                                    background: sug-touch.has-hover ? #eceff3 : Colors.transparent;
                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        spacing: 8px;
                                        Text {
                                            text: suggestion.label;
                                            vertical-alignment: center;
                                            horizontal-stretch: 1;
                                            font-size: 12px;
                                            color: #1a1a1a;
                                            overflow: TextOverflow.elide;
                                        }
                                        Text {
                                            text: suggestion.hint;
                                            vertical-alignment: center;
                                            font-size: 10px;
                                            color: #80868b;
                                        }
                                    }
                                    sug-touch := TouchArea {
                                        width: 100%;
                                        height: 100%;
                                        clicked => { root.search-submit(suggestion.id); }
                                    }
                                }
                            }
                        }
                    }
                }

                GhostButton {
                    text: "设置";
                    btn-min-width: 60;
                    clicked => { root.open-settings-tab(); }
                }
            }

            // ===== 第 3 行：动作工具条（仅浏览模式） =====
            if root.active-tab-kind != "settings": Rectangle {
                height: 38px;
                background: #ffffff;
                border-width: 1px;
                border-color: #e4e6eb;
                HorizontalLayout {
                    padding: 5px;
                    spacing: 2px;
                    GhostButton {
                        text: "新建";
                        clicked => { root.new-folder(); }
                    }
                    GhostButton {
                        text: "剪切";
                        clicked => { root.cut-selected(); }
                    }
                    GhostButton {
                        text: "复制";
                        clicked => { root.copy-selected(); }
                    }
                    GhostButton {
                        text: "重命名";
                        clicked => { root.rename-selected(); }
                    }
                    GhostButton {
                        text: "删除";
                        clicked => { root.delete-selected(); }
                    }
                    GhostButton {
                        text: "粘贴";
                        clicked => { root.paste-here(); }
                    }
                    GhostButton {
                        text: "加入暂存";
                        clicked => { root.stage-add(); }
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                        background: Colors.transparent;
                    }
                    Text {
                        text: "排序";
                        vertical-alignment: center;
                        font-size: 11px;
                        color: #5f6368;
                    }
                    ComboBox {
                        width: 104px;
                        height: 26px;
                        model: ["名称", "修改时间", "大小", "类型"];
                        current-index <=> root.sort-mode;
                        selected(value) => { root.sort-by(self.current-index); }
                    }
                    GhostButton {
                        text: "分栏";
                        btn-min-width: 44;
                        clicked => { root.toggle-split(); }
                    }
                }
            }

            // ===== 第 4 行：主内容区（视图互斥） =====
            Rectangle {
                horizontal-stretch: 1;
                clip: true;

                // ---- 设置标签：独占工作区，无主侧边栏 ----
                if root.active-tab-kind == "settings": HorizontalLayout {
                    width: 100%;
                    height: 100%;

                    Rectangle {
                        width: 176px;
                        background: #fafafa;
                        VerticalLayout {
                            padding: 12px;
                            spacing: 2px;
                            Text {
                                text: "设置";
                                font-size: 15px;
                                font-weight: 700;
                                color: #1a1a1a;
                            }
                            SideNavItem {
                                label: "通用";
                                page: 0;
                                current: root.settings-page;
                                activated(page) => { root.settings-select-page(page); }
                            }
                            SideNavItem {
                                label: "搜索与索引";
                                page: 1;
                                current: root.settings-page;
                                activated(page) => { root.settings-select-page(page); }
                            }
                            SideNavItem {
                                label: "本地右键菜单";
                                page: 2;
                                current: root.settings-page;
                                activated(page) => { root.settings-select-page(page); }
                            }
                            SideNavItem {
                                label: "关于与诊断";
                                page: 3;
                                current: root.settings-page;
                                activated(page) => { root.settings-select-page(page); }
                            }
                        }
                    }

                    ScrollView {
                        horizontal-stretch: 1;
                        HorizontalLayout {
                            Rectangle {
                                width: 28px;
                                background: Colors.transparent;
                            }
                            VerticalLayout {
                                width: 860px;
                                padding-top: 18px;
                                padding-bottom: 18px;
                                padding-right: 18px;
                                spacing: 12px;

                            // 通用
                            if root.settings-page == 0: VerticalLayout {
                                spacing: 14px;
                                Text {
                                    text: "通用";
                                    font-size: 20px;
                                    font-weight: 700;
                                    color: #1a1a1a;
                                }

                                Rectangle {
                                    background: #ffffff;
                                    border-width: 1px;
                                    border-color: #e4e6eb;
                                    border-radius: 6px;
                                    VerticalLayout {
                                        padding: 16px;
                                        spacing: 14px;
                                        Text { text: "外观"; font-size: 13px; font-weight: 700; color: #1a1a1a; }
                                        Text { text: "主题"; font-size: 11px; color: #5f6368; }
                                        ComboBox {
                                            width: 220px;
                                            model: ["浅色", "深色", "跟随系统"];
                                            current-index <=> root.opt-theme;
                                        }
                                        CheckBox {
                                            text: "关闭所有标签后销毁 UI，保持后台常驻";
                                            checked <=> root.opt-destroy-ui;
                                        }
                                        CheckBox {
                                            text: "显示系统托盘图标";
                                            checked <=> root.opt-tray;
                                        }
                                        HorizontalLayout {
                                            alignment: end;
                                            GhostButton {
                                                text: "保存";
                                                btn-min-width: 64;
                                                clicked => { root.save-general(); }
                                            }
                                        }
                                    }
                                }

                                Rectangle {
                                    background: #ffffff;
                                    border-width: 1px;
                                    border-color: #e4e6eb;
                                    border-radius: 6px;
                                    VerticalLayout {
                                        padding: 16px;
                                        spacing: 10px;
                                        Text { text: "默认文件管理器"; font-size: 13px; font-weight: 700; color: #1a1a1a; }
                                        Text { text: "接管后，双击文件夹 / 盘符 / 「此电脑」时由 Rove 打开"; font-size: 11px; color: #5f6368; }
                                        CheckBox {
                                            text: "接管文件夹和磁盘";
                                            checked <=> root.opt-takeover-folders;
                                        }
                                        CheckBox {
                                            text: "接管桌面上的「此电脑」";
                                            checked <=> root.opt-takeover-this-pc;
                                        }
                                        CheckBox {
                                            text: "接管盘符双击";
                                            checked <=> root.opt-takeover-drives;
                                        }
                                        HorizontalLayout {
                                            alignment: end;
                                            GhostButton {
                                                text: "应用接管设置";
                                                btn-min-width: 96;
                                                clicked => { root.takeover-changed(); }
                                            }
                                        }
                                    }
                                }
                            }

                            // 搜索与索引
                            if root.settings-page == 1: VerticalLayout {
                                spacing: 14px;
                                Text {
                                    text: "搜索与索引";
                                    font-size: 20px;
                                    font-weight: 700;
                                    color: #1a1a1a;
                                }
                                Rectangle {
                                    background: #ffffff;
                                    border-width: 1px;
                                    border-color: #e4e6eb;
                                    border-radius: 6px;
                                    VerticalLayout {
                                        padding: 16px;
                                        spacing: 10px;
                                        Text { text: "MFT 实时索引"; font-size: 13px; font-weight: 700; color: #1a1a1a; }
                                        Text {
                                            text: root.index-status;
                                            font-size: 12px;
                                            color: #1a1a1a;
                                            wrap: TextWrap.word-wrap;
                                        }
                                        Text {
                                            text: "全盘搜索基于 NTFS $MFT 内存索引 + USN Journal 增量更新；未提权时自动回退为目录枚举索引。";
                                            font-size: 11px;
                                            color: #5f6368;
                                            wrap: TextWrap.word-wrap;
                                        }
                                    }
                                }
                                Rectangle {
                                    background: #ffffff;
                                    border-width: 1px;
                                    border-color: #e4e6eb;
                                    border-radius: 6px;
                                    VerticalLayout {
                                        padding: 16px;
                                        spacing: 10px;
                                        Text { text: "压缩软件探测"; font-size: 13px; font-weight: 700; color: #1a1a1a; }
                                        Text {
                                            text: root.archiver-summary;
                                            font-size: 12px;
                                            color: #1a1a1a;
                                            wrap: TextWrap.word-wrap;
                                        }
                                        Text { text: "探测结果写入 actions.toml，可在「本地右键菜单」页管理。"; font-size: 11px; color: #5f6368; }
                                    }
                                }
                            }

                            // 本地右键菜单
                            if root.settings-page == 2: VerticalLayout {
                                spacing: 14px;
                                Text {
                                    text: "本地右键菜单";
                                    font-size: 20px;
                                    font-weight: 700;
                                    color: #1a1a1a;
                                }
                                Rectangle {
                                    background: #ffffff;
                                    border-width: 1px;
                                    border-color: #e4e6eb;
                                    border-radius: 6px;
                                    HorizontalLayout {
                                        padding: 14px;
                                        spacing: 14px;

                                        VerticalLayout {
                                            width: 300px;
                                            spacing: 8px;
                                            Rectangle {
                                                vertical-stretch: 1;
                                                border-width: 1px;
                                                border-color: #d4d4d4;
                                                border-radius: 4px;
                                                ListView {
                                                    width: 100%;
                                                    height: 100%;
                                                    for row[i] in root.actions: Rectangle {
                                                        height: 34px;
                                                        background: i == root.selected-action ? #d3e6fa : #ffffff;
                                                        HorizontalLayout {
                                                            padding-left: 8px;
                                                            padding-right: 8px;
                                                            spacing: 8px;
                                                            CheckBox {
                                                                width: 20px;
                                                                checked: row.enabled;
                                                                toggled => { root.toggle-action(i, self.checked); }
                                                            }
                                                            VerticalLayout {
                                                                horizontal-stretch: 1;
                                                                Text {
                                                                    text: row.label;
                                                                    vertical-alignment: center;
                                                                    font-size: 12px;
                                                                    color: #1a1a1a;
                                                                    overflow: TextOverflow.elide;
                                                                }
                                                                Text {
                                                                    text: row.detail;
                                                                    vertical-alignment: center;
                                                                    font-size: 10px;
                                                                    color: #777777;
                                                                    overflow: TextOverflow.elide;
                                                                }
                                                            }
                                                        }
                                                        TouchArea {
                                                            width: 100%;
                                                            height: 100%;
                                                            clicked => { root.select-action(i); }
                                                        }
                                                    }
                                                }
                                            }
                                            HorizontalLayout {
                                                spacing: 8px;
                                                GhostButton {
                                                    text: "添加动作";
                                                    btn-min-width: 72;
                                                    clicked => { root.add-action(); }
                                                }
                                                GhostButton {
                                                    text: "删除";
                                                    btn-min-width: 56;
                                                    enabled: root.edit-enabled;
                                                    clicked => { root.delete-action(); }
                                                }
                                            }
                                        }

                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            spacing: 8px;
                                            Text { text: "动作属性"; font-size: 13px; font-weight: 700; color: #1a1a1a; }
                                            Text { text: "名称"; font-size: 11px; color: #5f6368; }
                                            LineEdit {
                                                text <=> root.edit-label;
                                                enabled: root.edit-enabled;
                                                placeholder-text: "菜单显示名称";
                                            }
                                            Text { text: "执行程序"; font-size: 11px; color: #5f6368; }
                                            LineEdit {
                                                text <=> root.edit-program;
                                                enabled: root.edit-enabled;
                                                placeholder-text: "C:\\Program Files\\...\\app.exe";
                                            }
                                            Text { text: "参数（支持 {target_path} {target_dir} {name} {stem} {ext}）"; font-size: 11px; color: #5f6368; }
                                            LineEdit {
                                                text <=> root.edit-args;
                                                enabled: root.edit-enabled;
                                                placeholder-text: "--flag \"{target_path}\"";
                                            }
                                            Text { text: "工作目录"; font-size: 11px; color: #5f6368; }
                                            LineEdit {
                                                text <=> root.edit-working-dir;
                                                enabled: root.edit-enabled;
                                            }
                                            Text { text: "生效目标"; font-size: 11px; color: #5f6368; }
                                            ComboBox {
                                                width: 160px;
                                                model: ["不限", "仅文件", "仅文件夹"];
                                                current-index <=> root.edit-target-index;
                                                enabled: root.edit-enabled;
                                            }
                                            Text { text: "后缀名白名单（逗号分隔，留空不限制）"; font-size: 11px; color: #5f6368; }
                                            LineEdit {
                                                text <=> root.edit-extensions;
                                                enabled: root.edit-enabled;
                                                placeholder-text: "zip, 7z, rar";
                                            }
                                            HorizontalLayout {
                                                spacing: 8px;
                                                GhostButton {
                                                    text: "应用修改";
                                                    btn-min-width: 76;
                                                    enabled: root.edit-enabled;
                                                    clicked => { root.apply-edit(); }
                                                }
                                                GhostButton {
                                                    text: "重置";
                                                    btn-min-width: 56;
                                                    enabled: root.edit-enabled;
                                                    clicked => { root.select-action(root.selected-action); }
                                                }
                                            }
                                        }
                                    }
                                }
                            }

                            // 关于与诊断
                            if root.settings-page == 3: VerticalLayout {
                                spacing: 14px;
                                Text {
                                    text: "关于与诊断";
                                    font-size: 20px;
                                    font-weight: 700;
                                    color: #1a1a1a;
                                }
                                Rectangle {
                                    background: #ffffff;
                                    border-width: 1px;
                                    border-color: #e4e6eb;
                                    border-radius: 6px;
                                    VerticalLayout {
                                        padding: 16px;
                                        spacing: 8px;
                                        Text { text: "Rove"; font-size: 14px; font-weight: 700; color: #1a1a1a; }
                                        Text { text: "高性能轻量级 Windows 文件管理器 · Rust + Slint"; font-size: 12px; color: #1a1a1a; }
                                        Text { text: "配置文件目录：%APPDATA%\\Rove"; font-size: 11px; color: #5f6368; }
                                        Text { text: "actions.toml 由压缩软件探测器自动维护，手写内容与注释会被保留。"; font-size: 11px; color: #5f6368; }
                                    }
                                }
                                }
                            }
                            Rectangle {
                                horizontal-stretch: 1;
                                background: Colors.transparent;
                            }
                        }
                    }
                }

                // ---- 浏览标签：侧边栏 + 文件列表 ----
                if root.active-tab-kind != "settings": HorizontalLayout {
                    width: 100%;
                    height: 100%;

                    // 左侧资源管理器侧边栏
                    Rectangle {
                        width: 224px;
                        background: #f7f8fa;
                        VerticalLayout {
                            spacing: 0px;

                            ScrollView {
                                vertical-stretch: 1;
                                VerticalLayout {
                                    padding: 8px;
                                    spacing: 2px;

                                    Text {
                                        text: "快速访问";
                                        font-size: 11px;
                                        font-weight: 700;
                                        color: #5f6368;
                                    }
                                    for item in root.quick-items: SideRow {
                                        label: item.label;
                                        detail: item.detail;
                                        tint: item.tint;
                                        activated => { root.side-activate(item.id); }
                                    }

                                    Text {
                                        text: "此电脑";
                                        font-size: 11px;
                                        font-weight: 700;
                                        color: #5f6368;
                                    }
                                    for drive in root.drives: DriveRow {
                                        drive: drive;
                                        activated => { root.side-activate(drive.letter); }
                                    }

                                    Text {
                                        text: "网络位置";
                                        font-size: 11px;
                                        font-weight: 700;
                                        color: #5f6368;
                                    }
                                    if root.network-expanded: SideRow {
                                        label: "网络";
                                        detail: "";
                                        tint: #9aa0a6;
                                        activated => { root.side-activate("network"); }
                                    }
                                }
                            }

                            // 底部：临时暂存托盘
                            Rectangle {
                                height: root.staging-visible ? 148px : 32px;
                                background: #ffffff;
                                border-width: 1px;
                                border-color: #e4e6eb;
                                VerticalLayout {
                                    padding: 8px;
                                    spacing: 6px;
                                    HorizontalLayout {
                                        height: 20px;
                                        spacing: 6px;
                                        Text {
                                            text: "临时暂存盘";
                                            horizontal-stretch: 1;
                                            vertical-alignment: center;
                                            font-size: 11px;
                                            font-weight: 700;
                                            color: #1a1a1a;
                                        }
                                        Text {
                                            text: root.staging-items.length + " 项";
                                            vertical-alignment: center;
                                            font-size: 10px;
                                            color: #80868b;
                                        }
                                    }
                                    if root.staging-visible: HorizontalLayout {
                                        height: 22px;
                                        spacing: 4px;
                                        GhostButton {
                                            text: "复制到此处";
                                            btn-min-width: 68;
                                            clicked => { root.stage-copy-here(); }
                                        }
                                        GhostButton {
                                            text: "移动到此处";
                                            btn-min-width: 76;
                                            clicked => { root.stage-move-here(); }
                                        }
                                        GhostButton {
                                            text: "清空";
                                            btn-min-width: 44;
                                            clicked => { root.stage-clear(); }
                                        }
                                    }
                                    if root.staging-visible: Rectangle {
                                        vertical-stretch: 1;
                                        border-width: 1px;
                                        border-color: #e4e6eb;
                                        border-radius: 4px;
                                        ListView {
                                            width: 100%;
                                            height: 100%;
                                            for item[i] in root.staging-items: Rectangle {
                                                height: 22px;
                                                background: #ffffff;
                                                HorizontalLayout {
                                                    padding: 4px;
                                                    Text {
                                                        text: item.name;
                                                        horizontal-stretch: 1;
                                                        vertical-alignment: center;
                                                        font-size: 11px;
                                                        color: #1a1a1a;
                                                        overflow: TextOverflow.elide;
                                                    }
                                                    Rectangle {
                                                        width: 16px;
                                                        height: 14px;
                                                        background: Colors.transparent;
                                                        IconClose {
                                                            width: 10px;
                                                            height: 10px;
                                                        }
                                                        TouchArea {
                                                            width: 100%;
                                                            height: 100%;
                                                            clicked => { root.stage-remove(i); }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                    if !root.staging-visible: Text {
                                        text: "暂存区是空的";
                                        vertical-alignment: center;
                                        font-size: 10px;
                                        color: #9aa0a6;
                                    }
                                }
                            }
                        }
                    }

                    // 文件列表
                    Rectangle {
                        horizontal-stretch: 1;
                        background: #ffffff;
                        clip: true;
                        VerticalLayout {
                            width: 100%;
                            height: 100%;
                            spacing: 0px;

                            // 列头
                            Rectangle {
                                height: 28px;
                                background: #f7f8fa;
                                HorizontalLayout {
                                    padding-left: 8px;
                                    padding-right: 10px;
                                    spacing: 8px;
                                    Text {
                                        text: "名称";
                                        horizontal-stretch: 1;
                                        vertical-alignment: center;
                                        font-size: 11px;
                                        font-weight: 700;
                                        color: #444746;
                                    }
                                    if root.show-path-column: Text {
                                        text: "路径";
                                        width: 260px;
                                        vertical-alignment: center;
                                        font-size: 11px;
                                        font-weight: 700;
                                        color: #444746;
                                    }
                                    Text {
                                        text: "修改时间";
                                        width: 132px;
                                        vertical-alignment: center;
                                        horizontal-alignment: right;
                                        font-size: 11px;
                                        font-weight: 700;
                                        color: #444746;
                                    }
                                    Text {
                                        text: "类型";
                                        width: 50px;
                                        vertical-alignment: center;
                                        horizontal-alignment: center;
                                        font-size: 11px;
                                        font-weight: 700;
                                        color: #444746;
                                    }
                                    Text {
                                        text: "大小";
                                        width: 80px;
                                        vertical-alignment: center;
                                        horizontal-alignment: right;
                                        font-size: 11px;
                                        font-weight: 700;
                                        color: #444746;
                                    }
                                }
                            }

                            // 列表
                            Rectangle {
                                horizontal-stretch: 1;
                                background: #ffffff;
                                clip: true;
                                HorizontalLayout {
                                    spacing: 1px;
                                    Rectangle {
                                        horizontal-stretch: 1;
                                        clip: true;
                                        ListView {
                                            width: 100%;
                                            height: 100%;
                                            for item[index] in root.entries: FileRow {
                                                entry: item;
                                                index: index;
                                                selected: index == root.selected-index;
                                                editing: index == root.rename-index;
                                                show-path: root.show-path-column;
                                                edit-text: root.rename-text;
                                                clicked => { root.select-entry(index, false); }
                                                double-clicked => { root.open-entry(index, false); }
                                                right-clicked(i, x, y) => { root.right-clicked(i, x, y); }
                                                commit-edit(text) => { root.rename-commit(text); }
                                                cancel-edit() => { root.rename-cancel(); }
                                            }
                                        }
                                    }
                                    if root.split-view: Rectangle {
                                        horizontal-stretch: 1;
                                        clip: true;
                                        ListView {
                                            width: 100%;
                                            height: 100%;
                                            for item[index] in root.entries2: FileRow {
                                                entry: item;
                                                index: index;
                                                selected: index == root.selected-index2;
                                                editing: false;
                                                show-path: false;
                                                edit-text: "";
                                                clicked => { root.select-entry2(index); }
                                                double-clicked => { root.open-entry2(index); }
                                                right-clicked(i, x, y) => { root.right-clicked(i, x, y); }
                                                commit-edit(text) => { root.rename-commit(text); }
                                                cancel-edit() => { root.rename-cancel(); }
                                            }
                                        }
                                    }
                                }

                                // 右键菜单
                                }
                            }
                        }
                    }
                }
            }

            // ===== 第 5 行：状态栏（横跨整个窗口最底部） =====
            Rectangle {
                height: 24px;
                background: #f7f8fa;
                border-width: 1px;
                border-color: #e4e6eb;
                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    Text {
                        text: root.status-text;
                        horizontal-stretch: 1;
                        vertical-alignment: center;
                        font-size: 11px;
                        color: #3c4043;
                    }
                    if root.search-active: Text {
                        text: root.search-count;
                        vertical-alignment: center;
                        font-size: 11px;
                        color: #0b57d0;
                    }
                }
            }
        }

    menu-popup := PopupWindow {
        x: root.menu-x;
        y: root.menu-y;
        close-policy: PopupClosePolicy.close-on-click-outside;
        Rectangle {
            background: #ffffff;
            border-width: 1px;
            border-color: #b4b4b4;
            border-radius: 4px;
            drop-shadow-color: #00000026;
            drop-shadow-offset-y: 2px;
            drop-shadow-blur: 8px;
            HorizontalLayout {
                spacing: 1px;
                VerticalLayout {
                    width: 208px;
                    for item[i] in root.menu-items: MenuRow {
                        item: item;
                        activated(id) => { root.menu-action(id); }
                        hovered(id) => { root.menu-hover(id); }
                    }
                }
                if root.menu-sub-parent >= 0: VerticalLayout {
                    width: 208px;
                    for sub[j] in root.menu-sub-items: MenuRow {
                        item: sub;
                        activated(id) => { root.menu-action(id); }
                        hovered(id) => { root.menu-hover(-1); }
                    }
                }
            }
        }
    }

    // 搜索建议弹窗显示控制
    changed search-popup-open => {
        if (root.search-popup-open && root.search-text != "") {
            search-popup.show();
        } else {
            search-popup.close();
        }
    }

    // 右键菜单触发
    changed menu-show-trigger => { menu-popup.show(); }
    changed menu-hide-trigger => { menu-popup.close(); }
}

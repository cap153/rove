import { Button, CheckBox, ComboBox, LineEdit, ListView, ScrollView } from "std-widgets.slint";

// ============================================================ 数据模型

export struct TextSpan {
    text: string,
    is-match: bool,
}

export struct FileEntry {
    name: string,
    path: string,
    kind: string,
    size: string,
    modified: string,
    is-dir: bool,
    has-image: bool,
    image: image,
    badge: string,
    badge-color: color,
    spans: [TextSpan],
}

export struct TabItem {
    id: int,
    kind: string,
    title: string,
    path: string,
}

export struct StagingItem {
    name: string,
    path: string,
}

export struct MenuNode {
    id: int,
    label: string,
    kind: string,
    enabled: bool,
}

export struct Breadcrumb {
    name: string,
    path: string,
}

export struct DriveItem {
    letter: string,
    label: string,
    used-percent: float,
    capacity: string,
}

export struct SideItem {
    id: string,
    label: string,
    detail: string,
}

export struct SearchSuggestion {
    id: int,
    label: string,
    hint: string,
}

export struct ActionRow {
    id: string,
    label: string,
    kind: string,
    enabled: bool,
    depth: int,
    detail: string,
    has-command: bool,
}

// ============================================================ 文件行

component FileRow inherits Rectangle {
    in property <FileEntry> entry;
    in property <int> index;
    in property <bool> selected;
    in property <bool> editing;
    in-out property <string> edit-text;
    callback clicked();
    callback double-clicked();
    callback right-clicked(int, length, length);
    callback commit-edit(string);
    callback cancel-edit();

    height: 28px;
    background: root.selected ? #d3e6fa : (Math.mod(root.index, 2) == 0 ? #ffffff : #fafafa);

    TouchArea {
        width: 100%;
        height: 100%;
        clicked => { root.clicked(); }
        double-clicked => { root.double-clicked(); }
        pointer-event(event) => {
            if event.button == PointerEventButton.right && event.kind == PointerEventKind.down {
                root.right-clicked(root.index, self.mouse-x, root.y + self.mouse-y);
            }
        }
    }

    HorizontalLayout {
        padding: 4px;
        spacing: 6px;

        // 缩略图 / 类型标记
        if root.entry.has-image: Image {
            source: root.entry.image;
            width: 20px;
            height: 20px;
            vertical-alignment: center;
        }
        if !root.entry.has-image: Text {
            text: root.entry.is-dir ? "[D]" : "[F]";
            width: 22px;
            vertical-alignment: center;
            color: root.entry.is-dir ? #b07200 : #6a6a6a;
            font-size: 11px;
        }

        // 名称（搜索时按 span 高亮）
        if root.editing: LineEdit {
            text <=> root.edit-text;
            horizontal-stretch: 1;
            height: 20px;
            accepted(text) => { root.commit-edit(text); }
            init => {
                self.focus();
                self.select-all();
            }
        }
        if !root.editing: HorizontalLayout {
            horizontal-stretch: 1;
            alignment: start;
            spacing: 0px;
            for span in root.entry.spans : Text {
                text: span.text;
                vertical-alignment: center;
                font-size: 12px;
                font-weight: span.is-match ? 700 : 400;
                color: span.is-match
                    ? (root.selected ? #0b3d91 : #0b57d0)
                    : (root.selected ? #000000 : #1a1a1a);
            }
        }

        // 路径列（搜索模式）
        if root.entry.path != "": Text {
            text: root.entry.path;
            width: 220px;
            vertical-alignment: center;
            horizontal-alignment: left;
            overflow: TextOverflow.elide;
            color: root.selected ? #333333 : #777777;
            font-size: 10px;
        }

        Text {
            text: root.entry.modified;
            width: 128px;
            vertical-alignment: center;
            horizontal-alignment: right;
            color: root.selected ? #333333 : #555555;
            font-size: 11px;
        }

        // 类型徽章
        Rectangle {
            width: 52px;
            height: 16px;
            background: root.entry.badge-color;
            border-radius: 8px;
            Text {
                text: root.entry.badge;
                horizontal-alignment: center;
                vertical-alignment: center;
                font-size: 9px;
                color: #ffffff;
            }
        }

        Text {
            text: root.entry.size;
            width: 84px;
            vertical-alignment: center;
            horizontal-alignment: right;
            color: root.selected ? #333333 : #555555;
            font-size: 11px;
        }
    }
}

// ============================================================ 菜单行

component MenuRow inherits Rectangle {
    in property <MenuNode> item;
    callback activated(int);
    callback hovered(int);

    height: root.item.kind == "separator" ? 9px : 26px;
    background: #ffffff;

    if root.item.kind == "separator": Rectangle {
        x: 8px;
        y: 4px;
        width: parent.width - 16px;
        height: 1px;
        background: #dcdcdc;
    }

    TouchArea {
        width: 100%;
        height: 100%;
        enabled: root.item.enabled && root.item.kind != "separator";
        changed has-hover => {
            if (self.has-hover) {
                root.hovered(root.item.id);
            }
        }
        clicked => { root.activated(root.item.id); }
    }

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 8px;
        Text {
            text: root.item.label;
            vertical-alignment: center;
            horizontal-stretch: 1;
            font-size: 12px;
            color: root.item.enabled ? #1a1a1a : #9a9a9a;
        }
        if root.item.kind == "submenu": Text {
            text: ">";
            vertical-alignment: center;
            color: #6a6a6a;
            font-size: 11px;
        }
    }
}

// ============================================================ 侧边栏行

component SideRow inherits Rectangle {
    in property <string> label;
    in property <string> detail;
    in property <string> glyph;
    callback activated();

    height: 30px;
    background: #f2f2f2;
    TouchArea {
        width: 100%;
        height: 100%;
        clicked => { root.activated(); }
    }
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 8px;
        spacing: 8px;
        Text {
            text: root.glyph;
            width: 18px;
            vertical-alignment: center;
            horizontal-alignment: center;
            font-size: 12px;
            color: #5f6368;
        }
        Text {
            text: root.label;
            vertical-alignment: center;
            horizontal-stretch: 1;
            font-size: 12px;
            color: #1a1a1a;
            overflow: TextOverflow.elide;
        }
        Text {
            text: root.detail;
            vertical-alignment: center;
            font-size: 10px;
            color: #80868b;
        }
    }
}

component DriveRow inherits Rectangle {
    in property <DriveItem> drive;
    callback activated();

    height: 46px;
    background: #f2f2f2;
    TouchArea {
        width: 100%;
        height: 100%;
        clicked => { root.activated(); }
    }
    VerticalLayout {
        padding-left: 10px;
        padding-right: 10px;
        padding-top: 5px;
        padding-bottom: 5px;
        spacing: 2px;
        HorizontalLayout {
            Text {
                text: root.drive.label + " (" + root.drive.letter + ")";
                vertical-alignment: center;
                horizontal-stretch: 1;
                font-size: 12px;
                color: #1a1a1a;
                overflow: TextOverflow.elide;
            }
            Text {
                text: root.drive.capacity;
                vertical-alignment: center;
                font-size: 10px;
                color: #80868b;
            }
        }
        Rectangle {
            height: 5px;
            background: #dfe1e5;
            border-radius: 3px;
            Rectangle {
                width: parent.width * root.drive.used-percent / 100;
                height: parent.height;
                background: root.drive.used-percent > 90 ? #d93025 : #1a73e8;
                border-radius: 3px;
            }
        }
    }
}

// 设置页左侧子导航项
component SideNavItem inherits Rectangle {
    in property <string> label;
    in property <int> page;
    in property <int> current;
    callback activated(int);

    height: 32px;
    background: root.page == root.current ? #e8f0fe : Colors.transparent;
    border-radius: 4px;
    TouchArea {
        width: 100%;
        height: 100%;
        clicked => { root.activated(root.page); }
    }
    HorizontalLayout {
        padding-left: 8px;
        Text {
            text: root.label;
            vertical-alignment: center;
            font-size: 12px;
            color: root.page == root.current ? #0b57d0 : #1a1a1a;
        }
    }
}

// ============================================================ 主窗口

export component MainWindow inherits Window {
    title: "Rove";
    min-width: 1000px;
    min-height: 620px;
    preferred-width: 1280px;
    preferred-height: 800px;
    background: #f2f2f2;
    default-font-family: "Microsoft YaHei";

    // ---- 标签 ----
    in property <[TabItem]> tabs: [];
    in-out property <int> active-tab: 0;
    in-out property <string> active-tab-kind: "explorer";

    // ---- 当前目录 ----
    in-out property <string> current-path: "";
    in-out property <string> current-path2: "";
    in property <[Breadcrumb]> breadcrumbs: [];
    in-out property <bool> can-go-back: false;
    in-out property <bool> can-go-forward: false;

    // ---- 列表 ----
    in property <[FileEntry]> entries: [];
    in property <[FileEntry]> entries2: [];
    in-out property <int> selected-index: -1;
    in-out property <int> selected-index2: -1;
    in-out property <bool> split-view: false;
    in-out property <int> sort-mode: 0;
    in-out property <bool> show-path-column: false;

    // ---- 重命名 ----
    in-out property <int> rename-index: -1;
    in-out property <string> rename-text: "";

    // ---- 侧边栏 ----
    in property <[SideItem]> quick-items: [];
    in property <[DriveItem]> drives: [];
    in-out property <bool> network-expanded: false;
    in property <[StagingItem]> staging-items: [];
    in-out property <bool> staging-visible: true;

    // ---- 搜索 ----
    in-out property <string> search-text: "";
    in-out property <bool> search-active: false;
    in-out property <int> search-scope: 0;
    in property <string> search-count: "";
    in property <[SearchSuggestion]> search-suggestions: [];
    in-out property <bool> search-popup-open: false;

    // ---- 右键菜单 ----
    in property <[MenuNode]> menu-items: [];
    in property <[MenuNode]> menu-sub-items: [];
    in-out property <int> menu-sub-parent: -1;
    in-out property <length> menu-x: 0px;
    in-out property <length> menu-y: 0px;
    in-out property <int> menu-show-trigger: 0;
    in-out property <int> menu-hide-trigger: 0;

    // ---- 设置页 ----
    in-out property <int> settings-page: 0;
    in-out property <bool> opt-destroy-ui: true;
    in-out property <bool> opt-tray: true;
    in-out property <int> opt-theme: 0;
    in-out property <bool> opt-takeover-folders: false;
    in-out property <bool> opt-takeover-this-pc: false;
    in-out property <bool> opt-takeover-drives: false;
    in property <string> index-status: "";
    in property <string> archiver-summary: "";
    in property <[ActionRow]> actions: [];
    in-out property <int> selected-action: -1;
    in-out property <bool> edit-enabled: false;
    in-out property <string> edit-label;
    in-out property <string> edit-program;
    in-out property <string> edit-args;
    in-out property <string> edit-working-dir;
    in-out property <int> edit-target-index: 0;
    in-out property <string> edit-extensions;

    // ---- 状态栏 ----
    in-out property <string> status-text: "就绪";

    // 搜索建议弹窗：open 为真即显示
    changed search-popup-open => {
        if (root.search-popup-open && root.search-text != "") {
            search-popup.show();
        } else {
            search-popup.close();
        }
    }

    // ---- 回调：导航 ----
    callback navigate(string);
    callback go-up();
    callback go-back();
    callback go-forward();
    callback refresh();

    // ---- 回调：标签 ----
    callback new-tab();
    callback close-tab(int);
    callback activate-tab(int);
    callback open-settings-tab();
    callback settings-select-page(int);

    // ---- 回调：列表 ----
    callback select-entry(int, bool);
    callback open-entry(int, bool);
    callback select-entry2(int);
    callback open-entry2(int);
    callback right-clicked(int, length, length);
    callback rename-commit(string);
    callback rename-cancel();
    callback toggle-split();
    callback sort-by(int);

    // ---- 回调：工具条 ----
    callback new-folder();
    callback cut-selected();
    callback copy-selected();
    callback rename-selected();
    callback delete-selected();
    callback paste-here();

    // ---- 回调：侧边栏 ----
    callback side-activate(string);
    callback toggle-network();
    callback stage-toggle();
    callback stage-add();
    callback stage-copy-here();
    callback stage-move-here();
    callback stage-clear();
    callback stage-remove(int);

    // ---- 回调：搜索 ----
    callback search-changed(string);
    callback search-submit(int);
    callback search-focus();
    callback close-search();

    // ---- 回调：菜单 / 预览 / 对比 ----
    callback menu-action(int);
    callback menu-hover(int);
    callback preview-selected();
    callback diff-selected();

    // ---- 回调：设置 ----
    callback save-general();
    callback takeover-changed();
    callback select-action(int);
    callback toggle-action(int, bool);
    callback apply-edit();
    callback add-action();
    callback delete-action();

    // ============================================================ 布局

    FocusScope {
        key-pressed(event) => {
            if (event.modifiers.control && event.text == "f") {
                root.search-focus();
                return EventResult.accept;
            }
            if (event.text == " ") {
                root.preview-selected();
                return EventResult.accept;
            }
            return EventResult.reject;
        }

        VerticalLayout {
            spacing: 0px;

            // ===== 顶栏：导航 + 面包屑 + 搜索 =====
            HorizontalLayout {
                height: 42px;
                padding: 4px;
                spacing: 4px;
                Button {
                    text: "←";
                    width: 32px;
                    height: 30px;
                    enabled: root.can-go-back;
                    clicked => { root.go-back(); }
                }
                Button {
                    text: "→";
                    width: 32px;
                    height: 30px;
                    enabled: root.can-go-forward;
                    clicked => { root.go-forward(); }
                }
                Button {
                    text: "↑";
                    width: 32px;
                    height: 30px;
                    clicked => { root.go-up(); }
                }
                Button {
                    text: "⟳";
                    width: 32px;
                    height: 30px;
                    clicked => { root.refresh(); }
                }

                // 面包屑
                Rectangle {
                    horizontal-stretch: 1;
                    height: 30px;
                    background: #ffffff;
                    border-width: 1px;
                    border-color: #d4d4d4;
                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        spacing: 2px;
                        for crumb in root.breadcrumbs: Rectangle {
                            height: parent.height;
                            background: Colors.transparent;
                            HorizontalLayout {
                                padding-left: 4px;
                                padding-right: 4px;
                                Text {
                                    text: crumb.name;
                                    vertical-alignment: center;
                                    font-size: 12px;
                                    color: #1a1a1a;
                                }
                                Text {
                                    text: "›";
                                    vertical-alignment: center;
                                    font-size: 12px;
                                    color: #9aa0a6;
                                }
                            }
                            TouchArea {
                                width: 100%;
                                height: 100%;
                                clicked => { root.navigate(crumb.path); }
                            }
                        }
                    }
                }

                // 搜索框
                Rectangle {
                    width: 280px;
                    height: 30px;
                    background: #ffffff;
                    border-width: 1px;
                    border-color: #d4d4d4;
                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 4px;
                        spacing: 4px;
                        Text {
                            text: "⌕";
                            vertical-alignment: center;
                            font-size: 13px;
                            color: #5f6368;
                        }
                        LineEdit {
                            text <=> root.search-text;
                            horizontal-stretch: 1;
                            placeholder-text: "搜索（支持拼音首字母）";
                            edited(text) => { root.search-changed(text); }
                            accepted(text) => { root.search-submit(root.search-scope); }
                        }
                        if root.search-active: Rectangle {
                            width: 18px;
                            height: 18px;
                            background: Colors.transparent;
                            Text {
                                text: "×";
                                horizontal-alignment: center;
                                vertical-alignment: center;
                                font-size: 11px;
                                color: #707070;
                            }
                            TouchArea {
                                width: 100%;
                                height: 100%;
                                clicked => { root.close-search(); }
                            }
                        }
                    }

                    // 搜索建议下拉
                    search-popup := PopupWindow {
                        x: 0px;
                        y: parent.height + 2px;
                        close-policy: PopupClosePolicy.close-on-click-outside;
                        Rectangle {
                            width: 340px;
                            background: #ffffff;
                            border-width: 1px;
                            border-color: #b4b4b4;
                            drop-shadow-color: #00000033;
                            drop-shadow-offset-y: 2px;
                            drop-shadow-blur: 8px;
                            VerticalLayout {
                                padding: 4px;
                                spacing: 2px;
                                for suggestion in root.search-suggestions: Rectangle {
                                    height: 30px;
                                    background: Colors.transparent;
                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        spacing: 8px;
                                        Text {
                                            text: suggestion.label;
                                            vertical-alignment: center;
                                            horizontal-stretch: 1;
                                            font-size: 12px;
                                            color: #1a1a1a;
                                            overflow: TextOverflow.elide;
                                        }
                                        Text {
                                            text: suggestion.hint;
                                            vertical-alignment: center;
                                            font-size: 10px;
                                            color: #80868b;
                                        }
                                    }
                                    TouchArea {
                                        width: 100%;
                                        height: 100%;
                                        clicked => { root.search-submit(suggestion.id); }
                                    }
                                }
                            }
                        }
                    }
                }

                Button {
                    text: "⚙ 设置";
                    width: 76px;
                    height: 30px;
                    clicked => { root.open-settings-tab(); }
                }
            }

            // ===== 标签栏 =====
            HorizontalLayout {
                height: 34px;
                padding: 4px;
                spacing: 4px;
                Rectangle {
                    horizontal-stretch: 1;
                    background: Colors.transparent;
                    HorizontalLayout {
                        spacing: 4px;
                        for t[i] in root.tabs: Rectangle {
                            width: 168px;
                            height: 26px;
                            background: i == root.active-tab ? #ffffff : #e2e2e2;
                            border-width: 1px;
                            border-color: #c8c8c8;
                            border-radius: 3px;
                            TouchArea {
                                width: 100%;
                                height: 100%;
                                clicked => { root.activate-tab(i); }
                            }
                            HorizontalLayout {
                                padding: 3px;
                                spacing: 4px;
                                Text {
                                    text: t.title;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                    overflow: TextOverflow.elide;
                                    font-size: 12px;
                                    color: #1a1a1a;
                                }
                                Rectangle {
                                    width: 14px;
                                    height: 14px;
                                    background: Colors.transparent;
                                    Text {
                                        text: "x";
                                        font-size: 11px;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                        color: #707070;
                                    }
                                    TouchArea {
                                        width: 100%;
                                        height: 100%;
                                        clicked => { root.close-tab(i); }
                                    }
                                }
                            }
                        }
                    }
                }
                Button {
                    text: "+";
                    width: 30px;
                    height: 26px;
                    clicked => { root.new-tab(); }
                }
            }

            // ===== 主体：侧边栏 + 内容 =====
            HorizontalLayout {
                spacing: 1px;

                // ---- 侧边栏 ----
                Rectangle {
                    width: 224px;
                    background: #f2f2f2;
                    VerticalLayout {
                        spacing: 0px;

                        ScrollView {
                            vertical-stretch: 1;
                            VerticalLayout {
                                padding: 6px;
                                spacing: 2px;

                                Text {
                                    text: "快速访问";
                                    font-size: 11px;
                                    font-weight: 700;
                                    color: #5f6368;
                                }
                                for item in root.quick-items: SideRow {
                                    label: item.label;
                                    detail: item.detail;
                                    glyph: "●";
                                    activated => { root.side-activate(item.id); }
                                }

                                Text {
                                    text: "此电脑";
                                    font-size: 11px;
                                    font-weight: 700;
                                    color: #5f6368;
                                }
                                for drive in root.drives: DriveRow {
                                    drive: drive;
                                    activated => { root.side-activate(drive.letter); }
                                }

                                Text {
                                    text: "网络位置";
                                    font-size: 11px;
                                    font-weight: 700;
                                    color: #5f6368;
                                }
                                if root.network-expanded: SideRow {
                                    label: "网络";
                                    detail: "";
                                    glyph: "●";
                                    activated => { root.side-activate("network"); }
                                }
                            }
                        }

                        // ---- 底部：暂存托盘 ----
                        Rectangle {
                            height: root.staging-visible ? 132px : 30px;
                            background: #ffffff;
                            border-width: 1px;
                            border-color: #d4d4d4;
                            VerticalLayout {
                                padding: 6px;
                                spacing: 4px;
                                HorizontalLayout {
                                    height: 20px;
                                    spacing: 6px;
                                    Text {
                                        text: "临时暂存盘";
                                        horizontal-stretch: 1;
                                        vertical-alignment: center;
                                        font-size: 11px;
                                        font-weight: 700;
                                        color: #1a1a1a;
                                    }
                                    Text {
                                        text: root.staging-items.length + " 项";
                                        vertical-alignment: center;
                                        font-size: 10px;
                                        color: #80868b;
                                    }
                                }
                                if root.staging-visible: HorizontalLayout {
                                    height: 22px;
                                    spacing: 4px;
                                    Button {
                                        text: "复制到此处";
                                        height: 20px;
                                        clicked => { root.stage-copy-here(); }
                                    }
                                    Button {
                                        text: "移动到此处";
                                        height: 20px;
                                        clicked => { root.stage-move-here(); }
                                    }
                                    Button {
                                        text: "清空";
                                        height: 20px;
                                        clicked => { root.stage-clear(); }
                                    }
                                }
                                if root.staging-visible: Rectangle {
                                    vertical-stretch: 1;
                                    border-width: 1px;
                                    border-color: #dcdcdc;
                                    ListView {
                                        width: 100%;
                                        height: 100%;
                                        for item[i] in root.staging-items: Rectangle {
                                            height: 22px;
                                            background: #ffffff;
                                            HorizontalLayout {
                                                padding: 4px;
                                                Text {
                                                    text: item.name;
                                                    horizontal-stretch: 1;
                                                    vertical-alignment: center;
                                                    font-size: 11px;
                                                    color: #1a1a1a;
                                                    overflow: TextOverflow.elide;
                                                }
                                                Rectangle {
                                                    width: 16px;
                                                    height: 14px;
                                                    background: Colors.transparent;
                                                    Text {
                                                        text: "x";
                                                        font-size: 10px;
                                                        horizontal-alignment: center;
                                                        vertical-alignment: center;
                                                        color: #707070;
                                                    }
                                                    TouchArea {
                                                        width: 100%;
                                                        height: 100%;
                                                        clicked => { root.stage-remove(i); }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                                if !root.staging-visible: Text {
                                    text: "暂存区是空的";
                                    vertical-alignment: center;
                                    font-size: 10px;
                                    color: #9aa0a6;
                                }
                            }
                        }
                    }
                }

                // ---- 内容区 ----
                Rectangle {
                    horizontal-stretch: 1;
                    background: #ffffff;
                    clip: true;

                    // ===== 设置标签页 =====
                    if root.active-tab-kind == "settings": HorizontalLayout {
                        width: 100%;
                        height: 100%;

                        // 左侧子导航
                        Rectangle {
                            width: 176px;
                            background: #fafafa;
                            VerticalLayout {
                                padding: 10px;
                                spacing: 2px;
                                Text {
                                    text: "设置";
                                    font-size: 15px;
                                    font-weight: 700;
                                    color: #1a1a1a;
                                }
                                SideNavItem {
                                    label: "通用";
                                    page: 0;
                                    current: root.settings-page;
                                    activated(page) => { root.settings-select-page(page); }
                                }
                                SideNavItem {
                                    label: "搜索与索引";
                                    page: 1;
                                    current: root.settings-page;
                                    activated(page) => { root.settings-select-page(page); }
                                }
                                SideNavItem {
                                    label: "本地右键菜单";
                                    page: 2;
                                    current: root.settings-page;
                                    activated(page) => { root.settings-select-page(page); }
                                }
                                SideNavItem {
                                    label: "关于与诊断";
                                    page: 3;
                                    current: root.settings-page;
                                    activated(page) => { root.settings-select-page(page); }
                                }
                            }
                        }

                        // 右侧卡片
                        ScrollView {
                            horizontal-stretch: 1;
                            VerticalLayout {
                                padding: 16px;
                                spacing: 12px;

                                // ---------- 通用 ----------
                                if root.settings-page == 0: VerticalLayout {
                                    spacing: 12px;
                                    Text {
                                        text: "通用";
                                        font-size: 20px;
                                        font-weight: 700;
                                        color: #1a1a1a;
                                    }

                                    // 外观卡片
                                    Rectangle {
                                        background: #ffffff;
                                        border-width: 1px;
                                        border-color: #e0e0e0;
                                        VerticalLayout {
                                            padding: 14px;
                                            spacing: 12px;
                                            Text { text: "外观"; font-size: 13px; font-weight: 700; color: #1a1a1a; }
                                            Text { text: "主题"; font-size: 11px; color: #5f6368; }
                                            ComboBox {
                                                model: ["浅色", "深色", "跟随系统"];
                                                current-index <=> root.opt-theme;
                                            }
                                            CheckBox {
                                                text: "关闭所有标签后销毁 UI，保持后台常驻";
                                                checked <=> root.opt-destroy-ui;
                                            }
                                            CheckBox {
                                                text: "显示系统托盘图标";
                                                checked <=> root.opt-tray;
                                            }
                                            HorizontalLayout {
                                                alignment: end;
                                                Button {
                                                    text: "保存";
                                                    clicked => { root.save-general(); }
                                                }
                                            }
                                        }
                                    }

                                    // 默认文件管理器卡片
                                    Rectangle {
                                        background: #ffffff;
                                        border-width: 1px;
                                        border-color: #e0e0e0;
                                        VerticalLayout {
                                            padding: 14px;
                                            spacing: 10px;
                                            Text { text: "默认文件管理器"; font-size: 13px; font-weight: 700; color: #1a1a1a; }
                                            Text { text: "接管后，双击文件夹 / 盘符 / 「此电脑」时由 Rove 打开"; font-size: 11px; color: #5f6368; }
                                            CheckBox {
                                                text: "接管文件夹和磁盘";
                                                checked <=> root.opt-takeover-folders;
                                            }
                                            CheckBox {
                                                text: "接管桌面上的「此电脑」";
                                                checked <=> root.opt-takeover-this-pc;
                                            }
                                            CheckBox {
                                                text: "接管盘符双击";
                                                checked <=> root.opt-takeover-drives;
                                            }
                                            HorizontalLayout {
                                                alignment: end;
                                                Button {
                                                    text: "应用接管设置";
                                                    clicked => { root.takeover-changed(); }
                                                }
                                            }
                                        }
                                    }
                                }

                                // ---------- 搜索与索引 ----------
                                if root.settings-page == 1: VerticalLayout {
                                    spacing: 12px;
                                    Text {
                                        text: "搜索与索引";
                                        font-size: 20px;
                                        font-weight: 700;
                                        color: #1a1a1a;
                                    }
                                    Rectangle {
                                        background: #ffffff;
                                        border-width: 1px;
                                        border-color: #e0e0e0;
                                        VerticalLayout {
                                            padding: 14px;
                                            spacing: 10px;
                                            Text { text: "MFT 实时索引"; font-size: 13px; font-weight: 700; color: #1a1a1a; }
                                            Text {
                                                text: root.index-status;
                                                font-size: 12px;
                                                color: #1a1a1a;
                                                wrap: TextWrap.word-wrap;
                                            }
                                            Text {
                                                text: "全盘搜索基于 NTFS $MFT 内存索引 + USN Journal 增量更新；未提权时自动回退为目录枚举索引。";
                                                font-size: 11px;
                                                color: #5f6368;
                                                wrap: TextWrap.word-wrap;
                                            }
                                        }
                                    }
                                    Rectangle {
                                        background: #ffffff;
                                        border-width: 1px;
                                        border-color: #e0e0e0;
                                        VerticalLayout {
                                            padding: 14px;
                                            spacing: 10px;
                                            Text { text: "压缩软件探测"; font-size: 13px; font-weight: 700; color: #1a1a1a; }
                                            Text {
                                                text: root.archiver-summary;
                                                font-size: 12px;
                                                color: #1a1a1a;
                                                wrap: TextWrap.word-wrap;
                                            }
                                            Text { text: "探测结果写入 actions.toml，可在「本地右键菜单」页管理。"; font-size: 11px; color: #5f6368; }
                                        }
                                    }
                                }

                                // ---------- 本地右键菜单 ----------
                                if root.settings-page == 2: VerticalLayout {
                                    spacing: 12px;
                                    Text {
                                        text: "本地右键菜单";
                                        font-size: 20px;
                                        font-weight: 700;
                                        color: #1a1a1a;
                                    }
                                    Rectangle {
                                        background: #ffffff;
                                        border-width: 1px;
                                        border-color: #e0e0e0;
                                        HorizontalLayout {
                                            padding: 12px;
                                            spacing: 12px;

                                            // 动作列表
                                            VerticalLayout {
                                                width: 300px;
                                                spacing: 8px;
                                                Rectangle {
                                                    vertical-stretch: 1;
                                                    border-width: 1px;
                                                    border-color: #d4d4d4;
                                                    ListView {
                                                        width: 100%;
                                                        height: 100%;
                                                        for row[i] in root.actions: Rectangle {
                                                            height: 30px;
                                                            background: i == root.selected-action ? #d3e6fa : #ffffff;
                                                            HorizontalLayout {
                                                                padding-left: 6px + row.depth * 16px;
                                                                padding-right: 6px;
                                                                spacing: 6px;
                                                                CheckBox {
                                                                    width: 20px;
                                                                    checked: row.enabled;
                                                                    toggled => { root.toggle-action(i, self.checked); }
                                                                }
                                                                VerticalLayout {
                                                                    horizontal-stretch: 1;
                                                                    Text {
                                                                        text: row.label;
                                                                        vertical-alignment: center;
                                                                        font-size: 12px;
                                                                        color: #1a1a1a;
                                                                        overflow: TextOverflow.elide;
                                                                    }
                                                                    Text {
                                                                        text: row.detail;
                                                                        vertical-alignment: center;
                                                                        font-size: 10px;
                                                                        color: #777777;
                                                                        overflow: TextOverflow.elide;
                                                                    }
                                                                }
                                                            }
                                                            TouchArea {
                                                                width: 100%;
                                                                height: 100%;
                                                                clicked => { root.select-action(i); }
                                                            }
                                                        }
                                                    }
                                                }
                                                HorizontalLayout {
                                                    spacing: 8px;
                                                    Button {
                                                        text: "添加动作";
                                                        clicked => { root.add-action(); }
                                                    }
                                                    Button {
                                                        text: "删除";
                                                        enabled: root.edit-enabled;
                                                        clicked => { root.delete-action(); }
                                                    }
                                                }
                                            }

                                            // 编辑表单
                                            VerticalLayout {
                                                horizontal-stretch: 1;
                                                spacing: 8px;
                                                Text { text: "动作属性"; font-size: 13px; font-weight: 700; color: #1a1a1a; }
                                                Text { text: "名称"; font-size: 11px; color: #555555; }
                                                LineEdit {
                                                    text <=> root.edit-label;
                                                    enabled: root.edit-enabled;
                                                    placeholder-text: "菜单显示名称";
                                                }
                                                Text { text: "执行程序"; font-size: 11px; color: #555555; }
                                                LineEdit {
                                                    text <=> root.edit-program;
                                                    enabled: root.edit-enabled;
                                                    placeholder-text: "C:\\Program Files\\...\\app.exe";
                                                }
                                                Text { text: "参数（支持 {target_path} {target_dir} {name} {stem} {ext}）"; font-size: 11px; color: #555555; }
                                                LineEdit {
                                                    text <=> root.edit-args;
                                                    enabled: root.edit-enabled;
                                                    placeholder-text: "--flag \"{target_path}\"";
                                                }
                                                Text { text: "工作目录"; font-size: 11px; color: #555555; }
                                                LineEdit {
                                                    text <=> root.edit-working-dir;
                                                    enabled: root.edit-enabled;
                                                }
                                                Text { text: "生效目标"; font-size: 11px; color: #555555; }
                                                ComboBox {
                                                    model: ["不限", "仅文件", "仅文件夹"];
                                                    current-index <=> root.edit-target-index;
                                                    enabled: root.edit-enabled;
                                                }
                                                Text { text: "后缀名白名单（逗号分隔，留空不限制）"; font-size: 11px; color: #555555; }
                                                LineEdit {
                                                    text <=> root.edit-extensions;
                                                    enabled: root.edit-enabled;
                                                    placeholder-text: "zip, 7z, rar";
                                                }
                                                HorizontalLayout {
                                                    spacing: 8px;
                                                    Button {
                                                        text: "应用修改";
                                                        enabled: root.edit-enabled;
                                                        clicked => { root.apply-edit(); }
                                                    }
                                                    Button {
                                                        text: "重置";
                                                        enabled: root.edit-enabled;
                                                        clicked => { root.select-action(root.selected-action); }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }

                                // ---------- 关于与诊断 ----------
                                if root.settings-page == 3: VerticalLayout {
                                    spacing: 12px;
                                    Text {
                                        text: "关于与诊断";
                                        font-size: 20px;
                                        font-weight: 700;
                                        color: #1a1a1a;
                                    }
                                    Rectangle {
                                        background: #ffffff;
                                        border-width: 1px;
                                        border-color: #e0e0e0;
                                        VerticalLayout {
                                            padding: 14px;
                                            spacing: 8px;
                                            Text { text: "Rove"; font-size: 14px; font-weight: 700; color: #1a1a1a; }
                                            Text { text: "高性能轻量级 Windows 文件管理器 · Rust + Slint"; font-size: 12px; color: #1a1a1a; }
                                            Text { text: "配置文件目录：%APPDATA%\\Rove"; font-size: 11px; color: #5f6368; }
                                            Text { text: "actions.toml 由压缩软件探测器自动维护，手写内容与注释会被保留。"; font-size: 11px; color: #5f6368; }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // ===== 文件浏览标签页 =====
                    if root.active-tab-kind != "settings": VerticalLayout {
                        width: 100%;
                        height: 100%;
                        spacing: 0px;

                        // 工具条
                        HorizontalLayout {
                            height: 34px;
                            padding: 4px;
                            spacing: 4px;
                            Button {
                                text: "新建";
                                width: 52px;
                                height: 26px;
                                clicked => { root.new-folder(); }
                            }
                            Button {
                                text: "剪切";
                                width: 52px;
                                height: 26px;
                                clicked => { root.cut-selected(); }
                            }
                            Button {
                                text: "复制";
                                width: 52px;
                                height: 26px;
                                clicked => { root.copy-selected(); }
                            }
                            Button {
                                text: "重命名";
                                width: 62px;
                                height: 26px;
                                clicked => { root.rename-selected(); }
                            }
                            Button {
                                text: "删除";
                                width: 52px;
                                height: 26px;
                                clicked => { root.delete-selected(); }
                            }
                            Button {
                                text: "粘贴";
                                width: 52px;
                                height: 26px;
                                clicked => { root.paste-here(); }
                            }
                            Rectangle { horizontal-stretch: 1; background: Colors.transparent; }
                            Text {
                                text: "排序";
                                vertical-alignment: center;
                                font-size: 11px;
                                color: #555555;
                            }
                            ComboBox {
                                width: 110px;
                                height: 26px;
                                model: ["名称", "修改时间", "大小", "类型"];
                                current-index <=> root.sort-mode;
                                selected(value) => { root.sort-by(self.current-index); }
                            }
                            Button {
                                text: "分栏";
                                width: 52px;
                                height: 26px;
                                clicked => { root.toggle-split(); }
                            }
                            Button {
                                text: "加入暂存";
                                width: 74px;
                                height: 26px;
                                clicked => { root.stage-add(); }
                            }
                        }

                        // 列头
                        Rectangle {
                            height: 26px;
                            background: #f7f7f7;
                            HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            spacing: 6px;
                            Text {
                                text: "名称";
                                horizontal-stretch: 1;
                                vertical-alignment: center;
                                font-size: 11px;
                                font-weight: 700;
                                color: #444444;
                            }
                            if root.show-path-column: Text {
                                text: "路径";
                                width: 220px;
                                vertical-alignment: center;
                                font-size: 11px;
                                font-weight: 700;
                                color: #444444;
                            }
                            Text {
                                text: "修改时间";
                                width: 128px;
                                vertical-alignment: center;
                                horizontal-alignment: right;
                                font-size: 11px;
                                font-weight: 700;
                                color: #444444;
                            }
                            Text {
                                text: "类型";
                                width: 52px;
                                vertical-alignment: center;
                                horizontal-alignment: center;
                                font-size: 11px;
                                font-weight: 700;
                                color: #444444;
                            }
                            Text {
                                text: "大小";
                                width: 84px;
                                vertical-alignment: center;
                                horizontal-alignment: right;
                                font-size: 11px;
                                font-weight: 700;
                                color: #444444;
                            }
                            }
                        }

                        // 文件列表
                        Rectangle {
                            horizontal-stretch: 1;
                            background: #ffffff;
                            clip: true;
                            HorizontalLayout {
                                spacing: 1px;
                                Rectangle {
                                    horizontal-stretch: 1;
                                    clip: true;
                                    ListView {
                                        width: 100%;
                                        height: 100%;
                                        for item[index] in root.entries: FileRow {
                                            entry: item;
                                            index: index;
                                            selected: index == root.selected-index;
                                            editing: index == root.rename-index;
                                            edit-text: root.rename-text;
                                            clicked => { root.select-entry(index, false); }
                                            double-clicked => { root.open-entry(index, false); }
                                            right-clicked(i, x, y) => { root.right-clicked(i, x, y); }
                                            commit-edit(text) => { root.rename-commit(text); }
                                            cancel-edit() => { root.rename-cancel(); }
                                        }
                                    }
                                }
                                if root.split-view: Rectangle {
                                    horizontal-stretch: 1;
                                    clip: true;
                                    ListView {
                                        width: 100%;
                                        height: 100%;
                                        for item[index] in root.entries2: FileRow {
                                            entry: item;
                                            index: index;
                                            selected: index == root.selected-index2;
                                            editing: false;
                                            edit-text: "";
                                            clicked => { root.select-entry2(index); }
                                            double-clicked => { root.open-entry2(index); }
                                            right-clicked(i, x, y) => { root.right-clicked(i, x, y); }
                                            commit-edit(text) => { root.rename-commit(text); }
                                            cancel-edit() => { root.rename-cancel(); }
                                        }
                                    }
                                }
                            }

                            // 右键菜单
                            menu-popup := PopupWindow {
                                x: root.menu-x;
                                y: root.menu-y;
                                close-policy: PopupClosePolicy.close-on-click-outside;
                                Rectangle {
                                    background: #ffffff;
                                    border-width: 1px;
                                    border-color: #b4b4b4;
                                    drop-shadow-color: #00000033;
                                    drop-shadow-offset-y: 2px;
                                    drop-shadow-blur: 8px;
                                    HorizontalLayout {
                                        spacing: 1px;
                                        VerticalLayout {
                                            width: 208px;
                                            for item[i] in root.menu-items: MenuRow {
                                                item: item;
                                                activated(id) => { root.menu-action(id); }
                                                hovered(id) => { root.menu-hover(id); }
                                            }
                                        }
                                        if root.menu-sub-parent >= 0: VerticalLayout {
                                            width: 208px;
                                            for sub[j] in root.menu-sub-items: MenuRow {
                                                item: sub;
                                                activated(id) => { root.menu-action(id); }
                                                hovered(id) => { root.menu-hover(-1); }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // ===== 状态栏 =====
            Rectangle {
                height: 24px;
                background: #f7f7f7;
                HorizontalLayout {
                padding: 4px;
                Text {
                    text: root.status-text;
                    horizontal-stretch: 1;
                    vertical-alignment: center;
                    font-size: 11px;
                    color: #333333;
                }
                if root.search-active: Text {
                    text: root.search-count;
                    vertical-alignment: center;
                    font-size: 11px;
                    color: #0b57d0;
                }
                }
            }
        }
    }
}

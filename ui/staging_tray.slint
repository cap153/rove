import { Theme, StagingItem, IconClose } from "common.slint";

// 临时暂存托盘：跨标签收集文件，一键批量复制/移动到当前目录。
// 支持折叠（仅剩标题栏）、单项移除、全部清空。
export component StagingTray inherits Rectangle {
    in-out property <[StagingItem]> items: [];
    in-out property <bool> expanded: true;

    callback item_removed(index: int);
    callback clear_requested();
    callback copy_here_requested();
    callback move_here_requested();

    // 动态高度计算：空载时大幅压缩列表区，使托盘变得小巧精致
    property <length> header-h: 32px; // 从 36px 压实到 32px
    property <length> list-h: root.items.length > 0 ? 116px : 60px; // 有内容时 116px，空载时压缩至 60px
    property <length> btn-h: 42px; // 按钮区压实到 42px

    height: root.expanded ? (root.header-h + root.list-h + root.btn-h) : root.header-h;
    background: Theme.bg-sidebar;
    clip: true;
    animate height { duration: 140ms; easing: ease-out; }

    // 顶部 1px 分隔线。
    Rectangle {
        y: 0px;
        width: 100%;
        height: 1px;
        background: Theme.divider;
    }

    VerticalLayout {
        width: 100%;
        height: 100%;
        spacing: 0px;
        padding-left: 8px;
        padding-right: 8px;

        // ---- 标题栏 ----
        Rectangle {
            height: root.header-h; // 改为引用变量

            TouchArea {
                width: 100%;
                height: 100%;
                clicked => {
                    root.expanded = !root.expanded;
                }
            }

            HorizontalLayout {
                spacing: 6px;
                padding-left: 4px;
                height: parent.height;

                Rectangle {
                    width: 16px;
                    height: 16px;
                    y: (parent.height - 16px) / 2;
                    border-radius: 4px;
                    background: Theme.accent.transparentize(0.84);

                    Text {
                        text: "⇄";
                        color: Theme.accent;
                        font-size: 10px;
                        font-weight: 700;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        width: 100%;
                        height: 100%;
                    }
                }

                Text {
                    text: "临时暂存托盘";
                    color: Theme.text-primary;
                    font-size: 12px;
                    font-weight: 600;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }

                if (root.items.length > 0) : Rectangle {
                    width: 18px;
                    height: 16px;
                    y: (parent.height - 16px) / 2;
                    border-radius: 8px;
                    background: Theme.accent;

                    Text {
                        text: root.items.length;
                        color: Theme.accent-text;
                        font-size: 10px;
                        font-weight: 700;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        width: 100%;
                        height: 100%;
                    }
                }

                Text {
                    text: root.expanded ? "▼" : "▲";
                    color: Theme.text-secondary;
                    font-size: 9px;
                    vertical-alignment: center;
                    width: 14px;
                }
            }
        }

        // ---- 条目列表（固定高度容器，避免布局绑定环） ----
        Rectangle {
            height: root.expanded ? root.list-h : 0px; // 改为引用变量
            clip: true;

            if (root.expanded && root.items.length > 0) : Flickable {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: parent.height;
                content-height: max(staging-layout.preferred-height, self.height);

                staging-layout := VerticalLayout {
                    x: 0px;
                    y: 0px;
                    width: parent.width;
                    spacing: 1px;

                    for item[i] in root.items : Rectangle {
                        width: parent.width;
                        height: 26px;
                        border-radius: 4px;
                        background: item-ta.has-hover ? Theme.bg-hover : transparent;

                        HorizontalLayout {
                            spacing: 6px;
                            padding-left: 4px;
                            padding-right: 2px;
                            height: parent.height;

                            Rectangle {
                                width: 16px;
                                height: 16px;
                                y: (parent.height - 16px) / 2;
                                border-radius: 4px;
                                background: item.icon-color.transparentize(0.84);

                                Text {
                                    text: item.icon-text;
                                    color: item.icon-color;
                                    font-size: 8px;
                                    font-weight: 700;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                    width: 100%;
                                    height: 100%;
                                }
                            }

                            Text {
                                text: item.name;
                                color: Theme.text-primary;
                                font-size: 11.5px;
                                vertical-alignment: center;
                                overflow: elide;
                                horizontal-stretch: 1;
                            }

                            Rectangle {
                                width: 16px;
                                height: 16px;
                                y: (parent.height - 16px) / 2;
                                border-radius: 4px;
                                background: rm-ta.has-hover ? Theme.bg-hover : transparent;

                                IconClose {
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                    size: 8px;
                                }

                                rm-ta := TouchArea {
                                    width: 100%;
                                    height: 100%;
                                    clicked => {
                                        root.item_removed(i);
                                    }
                                }
                            }
                        }

                        item-ta := TouchArea {
                            width: 100%;
                            height: 100%;
                        }
                    }
                }
            }

            // ---- 空态提示 ----
            if (root.expanded && root.items.length == 0) : VerticalLayout {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: parent.height;
                alignment: center;
                spacing: 4px;

                Text {
                    text: "暂存区是空的";
                    color: Theme.text-disabled;
                    font-size: 11.5px;
                    horizontal-alignment: center;
                }
                Text {
                    text: "在文件上右键「添加到暂存盘」，集中复制移动";
                    color: Theme.text-disabled;
                    font-size: 10px;
                    horizontal-alignment: center;
                }
            }
        }

        // ---- 操作按钮 ----
        if (root.expanded) : HorizontalLayout {
            height: root.btn-h; // 改为引用变量
            spacing: 6px;

            // 复制到当前目录。
            Rectangle {
                height: 28px;
                y: (parent.height - self.height) / 2; // 替换死板的 y: 12px
                horizontal-stretch: 1;
                border-radius: 6px;
                background: root.items.length > 0 ? Theme.accent : Theme.border;

                Text {
                    text: "复制到此处";
                    color: root.items.length > 0 ? Theme.accent-text : Theme.text-disabled;
                    font-size: 11.5px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    width: 100%;
                    height: 100%;
                }

                TouchArea {
                    width: 100%;
                    height: 100%;
                    clicked => {
                        if (root.items.length > 0) {
                            root.copy_here_requested();
                        }
                    }
                }
            }

            // 移动到当前目录。
            Rectangle {
                width: 84px;
                height: 28px;
                y: (parent.height - self.height) / 2; // 替换死板的 y: 12px
                border-radius: 6px;
                background: (root.items.length > 0) ? Theme.bg-badge : transparent;
                border-width: 1px;
                border-color: Theme.border;

                Text {
                    text: "移动";
                    color: root.items.length > 0 ? Theme.text-primary : Theme.text-disabled;
                    font-size: 11.5px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    width: 100%;
                    height: 100%;
                }

                TouchArea {
                    width: 100%;
                    height: 100%;
                    clicked => {
                        if (root.items.length > 0) {
                            root.move_here_requested();
                        }
                    }
                }
            }

            // 清空。
            Rectangle {
                width: 28px;
                height: 28px;
                y: (parent.height - self.height) / 2; // 替换死板的 y: 12px
                border-radius: 6px;
                background: (root.items.length > 0 && clear-ta.has-hover) ? Theme.bg-hover : transparent;

                Text {
                    text: "🗑";
                    color: root.items.length > 0 ? Theme.text-secondary : Theme.text-disabled;
                    font-size: 12px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    width: 100%;
                    height: 100%;
                }

                clear-ta := TouchArea {
                    width: 100%;
                    height: 100%;
                    clicked => {
                        if (root.items.length > 0) {
                            root.clear_requested();
                        }
                    }
                }
            }
        }
    }
}

import { I18n } from "i18n.slint";
import { Theme, StagingItem, IconClose } from "common.slint";

// 临时暂存托盘：跨标签收集文件，一键批量复制/移动到当前目录。
// 支持折叠（仅剩标题栏）、单项移除、全部清空。
export component StagingTray inherits Rectangle {
    in-out property <[StagingItem]> items: [];
    in-out property <bool> expanded: true;

    callback item_removed(index: int);
    callback clear_requested();
    callback copy_here_requested();
    callback move_here_requested();

    // 窄屏判定：当宽度不足以并排显示文字和按钮时触发
    private property <bool> is-narrow: root.width < 180px;

    // 动态高度计算：
    // 1. 窄屏且无文件时，大幅压缩空态区域；窄屏有文件时，保持滚动区。
    // 2. 窄屏按钮区改为垂直排列，高度扩展为 96px（3个按钮+间距）。
    property <length> header-h: 32px;
    property <length> list-h: root.items.length > 0 ? 116px : (root.is-narrow ? 10px : 60px);
    property <length> btn-h: root.is-narrow ? 96px : 42px;

    height: root.expanded ? (root.header-h + root.list-h + root.btn-h) : root.header-h;
    background: Theme.bg-sidebar;
    clip: true;
    animate height { duration: 140ms; easing: ease-out; }

    // 顶部 1px 分隔线。
    Rectangle {
        y: 0px;
        width: 100%;
        height: 1px;
        background: Theme.divider;
    }

    VerticalLayout {
        width: 100%;
        height: 100%;
        spacing: 0px;
        padding-left: 8px;
        padding-right: 8px;

        // ---- 标题栏 ----
        Rectangle {
            height: root.header-h;

            TouchArea {
                width: 100%;
                height: 100%;
                clicked => {
                    root.expanded = !root.expanded;
                }
            }

            HorizontalLayout {
                spacing: 6px;
                padding-left: 4px;
                height: parent.height;

                Rectangle {
                    width: 16px;
                    height: 16px;
                    y: (parent.height - 16px) / 2;
                    border-radius: 4px;
                    background: Theme.accent.transparentize(0.84);

                    Text {
                        text: "⇄";
                        color: Theme.accent;
                        font-size: 10px;
                        font-weight: 700;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        width: 100%;
                        height: 100%;
                    }
                }

                // 宽屏时显示全名，窄屏时显示“暂存”
                Text {
                    text: root.is-narrow ? I18n.strings[54] : I18n.strings[7];
                    color: Theme.text-primary;
                    font-size: 12px;
                    font-weight: 600;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    overflow: elide;
                }

                if (root.items.length > 0) : Rectangle {
                    width: 18px;
                    height: 16px;
                    y: (parent.height - 16px) / 2;
                    border-radius: 8px;
                    background: Theme.accent;

                    Text {
                        text: root.items.length;
                        color: Theme.accent-text;
                        font-size: 10px;
                        font-weight: 700;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        width: 100%;
                        height: 100%;
                    }
                }

                Text {
                    text: root.expanded ? "▼" : "▲";
                    color: Theme.text-secondary;
                    font-size: 9px;
                    vertical-alignment: center;
                    width: 14px;
                }
            }
        }

        // ---- 条目列表 ----
        Rectangle {
            height: root.expanded ? root.list-h : 0px;
            clip: true;

            if (root.expanded && root.items.length > 0) : Flickable {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: parent.height;
                content-height: max(staging-layout.preferred-height, self.height);

                staging-layout := VerticalLayout {
                    x: 0px;
                    y: 0px;
                    width: parent.width;
                    spacing: 1px;

                    for item[i] in root.items : Rectangle {
                        width: parent.width;
                        height: 26px;
                        border-radius: 4px;
                        background: item-ta.has-hover ? Theme.bg-hover : transparent;

                        // 整行 TouchArea 必须先声明：Slint 里后声明的元素在上层，
                        // 放到 HorizontalLayout 之后会把行内的 rm-ta 整个盖住，
                        // 单项 × 就既收不到 clicked、has-hover 也恒为 false。
                        item-ta := TouchArea {
                            width: 100%;
                            height: 100%;
                        }

                        HorizontalLayout {
                            spacing: 6px;
                            padding-left: 4px;
                            padding-right: 2px;
                            height: parent.height;

                            Rectangle {
                                width: 16px;
                                height: 16px;
                                y: (parent.height - 16px) / 2;
                                border-radius: 4px;
                                background: item.icon-color.transparentize(0.84);

                                Text {
                                    text: item.icon-text;
                                    color: item.icon-color;
                                    font-size: 8px;
                                    font-weight: 700;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                    width: 100%;
                                    height: 100%;
                                }
                            }

                            Text {
                                text: item.name;
                                color: Theme.text-primary;
                                font-size: 11.5px;
                                vertical-alignment: center;
                                overflow: elide;
                                horizontal-stretch: 1;
                            }

                            Rectangle {
                                width: 16px;
                                height: 16px;
                                y: (parent.height - 16px) / 2;
                                border-radius: 4px;
                                background: rm-ta.has-hover ? Theme.close-hover : transparent;

                                IconClose {
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                    size: 8px;
                                    icon-color: rm-ta.has-hover ? #FFFFFF : Theme.text-secondary;
                                }

                                rm-ta := TouchArea {
                                    width: 100%;
                                    height: 100%;
                                    clicked => {
                                        root.item_removed(i);
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // ---- 空态提示（仅宽屏显示，窄屏直接隐藏） ----
            if (root.expanded && root.items.length == 0 && !root.is-narrow) : VerticalLayout {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: parent.height;
                alignment: center;
                spacing: 4px;

                Text {
                    text: I18n.strings[55];
                    color: Theme.text-disabled;
                    font-size: 11.5px;
                    horizontal-alignment: center;
                }
                Text {
                    text: I18n.strings[35];
                    color: Theme.text-disabled;
                    font-size: 10px;
                    horizontal-alignment: center;
                }
            }
        }

        // ---- 操作按钮 ----
        if (root.expanded) : Rectangle {
            height: root.btn-h;
            width: 100%;

            // 1. 宽屏：横向排列
            if (!root.is-narrow) : HorizontalLayout {
                height: 42px;
                width: 100%; // 强制占满宽度
                spacing: 6px;

                // 复制到此处
                Rectangle {
                    height: 28px;
                    y: (parent.height - self.height) / 2;
                    horizontal-stretch: 1;
                    border-radius: 6px;
                    background: root.items.length > 0 ? Theme.accent : Theme.border;
                    Text {
                        text: I18n.strings[37];
                        color: root.items.length > 0 ? Theme.accent-text : Theme.text-disabled;
                        font-size: 11.5px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        width: 100%;
                        height: 100%;
                    }
                    TouchArea {
                        width: 100%;
                        height: 100%;
                        clicked => {
                            if (root.items.length > 0) { root.copy_here_requested(); }
                        }
                    }
                }

                // 移动
                Rectangle {
                    height: 28px;
                    y: (parent.height - self.height) / 2;
                    horizontal-stretch: 1;
                    border-radius: 6px;
                    background: (root.items.length > 0) ? Theme.bg-badge : transparent;
                    border-width: 1px;
                    border-color: Theme.border;
                    Text {
                        text: I18n.strings[67];
                        color: root.items.length > 0 ? Theme.text-primary : Theme.text-disabled;
                        font-size: 11.5px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        width: 100%;
                        height: 100%;
                    }
                    TouchArea {
                        width: 100%;
                        height: 100%;
                        clicked => {
                            if (root.items.length > 0) { root.move_here_requested(); }
                        }
                    }
                }

                // 清空（固定宽度 28px，不参与拉伸）
                Rectangle {
                    width: 28px;
                    height: 28px;
                    y: (parent.height - self.height) / 2;
                    border-radius: 6px;
                    background: (root.items.length > 0 && clear-ta.has-hover) ? Theme.close-hover : transparent;
                    Text {
                        text: "🗑";
                        color: root.items.length == 0 ? Theme.text-disabled : (clear-ta.has-hover ? #FFFFFF : Theme.text-secondary);
                        font-size: 12px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        width: 100%;
                        height: 100%;
                    }
                    clear-ta := TouchArea {
                        width: 100%;
                        height: 100%;
                        clicked => {
                            if (root.items.length > 0) { root.clear_requested(); }
                        }
                    }
                }
            }

            // 2. 窄屏：纵向排列
            if (root.is-narrow) : VerticalLayout {
                height: 96px;
                spacing: 6px;
                alignment: center;

                Rectangle {
                    height: 28px;
                    width: 100%;
                    border-radius: 6px;
                    background: root.items.length > 0 ? Theme.accent : Theme.border;
                    Text {
                        text: I18n.strings[36];
                        color: root.items.length > 0 ? Theme.accent-text : Theme.text-disabled;
                        font-size: 11.5px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        width: 100%;
                        height: 100%;
                    }
                    TouchArea {
                        width: 100%;
                        height: 100%;
                        clicked => {
                            if (root.items.length > 0) { root.copy_here_requested(); }
                        }
                    }
                }

                Rectangle {
                    height: 28px;
                    width: 100%;
                    border-radius: 6px;
                    background: (root.items.length > 0) ? Theme.bg-badge : transparent;
                    border-width: 1px;
                    border-color: Theme.border;
                    Text {
                        text: I18n.strings[67];
                        color: root.items.length > 0 ? Theme.text-primary : Theme.text-disabled;
                        font-size: 11.5px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        width: 100%;
                        height: 100%;
                    }
                    TouchArea {
                        width: 100%;
                        height: 100%;
                        clicked => {
                            if (root.items.length > 0) { root.move_here_requested(); }
                        }
                    }
                }

                Rectangle {
                    height: 28px;
                    width: 100%;
                    border-radius: 6px;
                    background: (root.items.length > 0 && clear-ta-narrow.has-hover) ? Theme.close-hover : transparent;
                    Text {
                        text: I18n.strings[66];
                        color: root.items.length == 0 ? Theme.text-disabled : (clear-ta-narrow.has-hover ? #FFFFFF : Theme.text-secondary);
                        font-size: 11.5px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        width: 100%;
                        height: 100%;
                    }
                    clear-ta-narrow := TouchArea {
                        width: 100%;
                        height: 100%;
                        clicked => {
                            if (root.items.length > 0) { root.clear_requested(); }
                        }
                    }
                }
            }
        }
    }
}

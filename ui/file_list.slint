import { I18n } from "i18n.slint";
import { Theme, FileRow, GridLine, HighlightName } from "common.slint";
import { SingleLineEdit } from "single_line_edit.slint";

// 可排序表头单元格（公共部分）。
component SortCell inherits Rectangle {
    in property <string> key;
    in property <string> label;
    in property <string> active-key;
    in property <bool> ascending;
    callback clicked(string);

    height: 100%;

    Text {
        x: 12px;
        width: parent.width - 20px;
        height: parent.height;
        text: root.label;
        color: root.active_key == root.key ? Theme.accent : Theme.text-secondary;
        font-size: 12px;
        font-weight: root.active_key == root.key ? 600 : 400;
        vertical-alignment: center;
        overflow: elide;
    }

    // 当前排序列显示方向箭头。
    if (root.active_key == root.key) : Text {
        x: root.width - 16px;
        width: 12px;
        height: parent.height;
        text: root.ascending ? "▲" : "▼";
        color: Theme.accent;
        font-size: 8px;
        vertical-alignment: center;
        horizontal-alignment: center;
    }

    TouchArea {
        width: 100%;
        height: 100%;
        clicked => {
            root.clicked(root.key);
        }
    }
}

// 文件列表：表头（可排序）+ 虚拟化主体。
// 虚拟化原理：Rust 侧只把当前可见窗口（视口行数 + 上下过扫描）的 FileRow
// 放入 `rows` 模型；每行按 `row.index * row-h` 绝对定位，因此无论目录
// 有多大，UI 元素数量恒定（约 40 个），滚动/搜索均不随文件数劣化。
export component FileList inherits Rectangle {
    background: Theme.bg-list;
    // 关键：横向滚动时表头/行会向左偏移，必须整体裁剪，
    // 否则会绘制到侧边栏区域之上。
    clip: true;
    // 核心新增：框选相关属性
    in-out property <bool> is-selecting: false;
    private property <length> sel-x1: 0px;
    private property <length> sel-y1: 0px;
    private property <length> sel-x2: 0px;
    private property <length> sel-y2: 0px;

    // 框选边缘自动滚：指针停在视口上下边缘时按 16ms 步进继续滚动，
    // 不用先松手、滚一下、再重新框（资源管理器同款行为）。
    private property <length> sel-vp-y: 0px;  // 指针在视口内的 y（不含表头）
    private property <float> sel-edge: 0;     // -1 上边缘 / 0 无 / 1 下边缘
    Timer {
        interval: 16ms;
        running: root.is-selecting && root.sel-edge != 0;
        triggered => {
            let want = flick.content-y - root.sel-edge * 16px;
            let next = min(root.max-content-y, max(root.min-content-y, want));
            if (next != flick.content-y) {
                flick.content-y = next;
                // 指针没动、内容滚了 → 指针的内容坐标按滚动量反算回去。
                root.sel-y2 = root.sel-vp-y - next;
                root.rubber-band-move(root.sel-x1, root.sel-y1, root.sel-x2, root.sel-y2);
                root.scroll-changed(-next);
            }
        }
    }

    // 供 Rust 调用的回调
    callback rubber-band-selected(x1: length, y1: length, x2: length, y2: length);
    callback rubber-band-move(x1: length, y1: length, x2: length, y2: length);

    // 暴露给 Rust，区分网格/列表的碰撞算法
    out property <bool> is-icons-view-out: root.is-icons-view;
    // 核心修复 1：允许列表容器自由向内压缩，绝不向外死锁 560px 宽度
    min-width: 0px;

    /// 可见窗口的行数据（由 Rust 维护）。
    in-out property <[FileRow]> rows: [];
    /// 完整条目数（虚拟视口高度 = total-count * row-h）。
    in-out property <int> total-count: 0;
    in-out property <string> sort-key: "name"; // "name" | "size" | "modified" | "type"
    in-out property <bool> sort-ascending: true;
    /// 非空时，对应路径的行进入内联重命名态。
    in-out property <string> rename-path: "";
    /// 重命名输入框的当前文本（供“点击别处即提交”时取用）。
    /// Slint 无法从外部直接读取 for 循环内的 TextInput，所以由输入框自己同步到这里。
    in-out property <string> rename-text: "";
    /// 重命名时主名的结束字节偏移；-1 表示全选（目录 / 无扩展名）。
    in-out property <int> rename-select-end: -1;
    /// 目录读取中。
    in-out property <bool> loading: false;
    /// 拖拽悬停命中的行索引（-1 为无悬停）
    in-out property <int> drop-hover-index: -1;
    /// 本栏是否恰好单选一个文件。多选时一律不显示名称浮层（避免多选时
    /// 满屏浮层互相遮挡）。由 Rust 按当前 pane 的 selection.len() 下发。
    in-out property <bool> single-selection: false;

    callback row-pointer-event(index: int, event: PointerEvent, x: length, y: length, on-name: bool);
    /// 单选后再次点击文件名才进入重命名：判断点击是否落在「名称」列。
    /// 图标视图的名称浮层另有 name-overlay-clicked，这里返回 false。
    public function name-hit(x: length) -> bool {
        if (root.view-mode == "details" || root.view-mode == "list") {
            return x >= root.col-name-x && x <= root.col-name-x + root.col-name-w;
        }
        return false;
    }
    callback name-overlay-clicked();
    /// 浮层自身是否被鼠标压住（true = 指针在展开的完整名浮层上）。
    /// 浮层盖住名称区，鼠标下移到文件名时格子自己的 hover 会变 false，
    /// Rust 靠这个标志把悬停保持住，避免浮层反复出现/消失。
    callback overlay-hover(inside: bool);
    /// 图标格子悬停变化：上报显示索引（-1 = 离开），供 Rust 重算名称浮层目标。
    callback hover-row(index: int);
    /// Ctrl+滚轮切视图：返回 true 表示事件已被消费，列表不再滚动。
    callback wheel-view(delta-y: length) -> bool;
    callback row-double-clicked(index: int);
    callback header-clicked(key: string);
    callback scroll-changed(offset: length);
    /// 排查用：滚动位置变化时连同几何一并上报（Rust 仅在重命名期间落日志）。
    callback scroll-dbg(offset: length, content-h: length, view-h: length, min-y: length, content-y: length);
    /// 用户主动滚动（滚轮/拖滚动条）信号：用于区分“真实滚动”与
    /// Slint 自动 reveal 焦点元素造成的假滚动。
    callback scroll-user-input();
    /// 排查用：重命名输入框的生命周期/焦点状态（只在重命名期间输出）。
    callback rename-dbg(kind: string, has-focus: bool);
    callback background-pointer-event(event: PointerEvent, x: length, y: length);
    callback rename-committed(path: string, new_name: string);
    callback rename-cancelled();
    /// 排查用：图标视图名字区/浮层的全部尺寸与判断结果（仅几何或展开目标变化时上报）。
    callback name-debug(info: string, name: string);
    /// 排查用：列表/滚动条宽度几何（窗口缩放、滚动条显隐时各一行）
    callback sb-debug(info: string);
    public function sb-debug-info() -> string {
        return "list_w=\{round(root.width / 1px)} list_abs_r=\{round((root.absolute-position.x + root.width) / 1px)}"
            + " flick_w=\{round(flick.width / 1px)} flick_abs_x=\{round(flick.absolute-position.x / 1px)}"
            + " sb_x=\{round(scrollbar.x / 1px)} sb_w=\{round(scrollbar.width / 1px)}"
            + " sb_abs_r=\{round((scrollbar.absolute-position.x + scrollbar.width) / 1px)}"
            + " view=\{root.view-mode}";
    }
    changed width => { root.sb-debug(root.sb-debug-info()); }
    /// 重命名输入内容变了（Rust 用它把超长名字截到 Windows 上限）。
    callback rename-text-changed(text: string);

    /// 外部点击（背景/侧栏/工具栏等）时调用：若有进行中的重命名，按已输入文本提交。
    /// 只在明确的用户点击路径上调用（不用 has-focus 失焦：那个会在输入框刚创建时
    /// 假触发，导致进入重命名后几十毫秒就用原名自动提交、根本没法输入）。
    public function commit-rename() {
        if (root.rename-path != "") {
            root.rename-committed(root.rename-path, root.rename-text);
        }
    }

    /// 列表可视高度（供 Rust 计算虚拟窗口行数与最大滚动量）。
    /// 核心修复：必须用 Flickable 的真实视口高度，不能用 root.height。
    /// 详细信息视图上方有 30px 表头（名称/修改时间/类型/大小），它不参与滚动，
    /// 若把表头算进视口，Rust 的 max_scroll 会少 30px 导致“永远滚不到最底”。
    out property <length> view-height: flick.height;

    /// 视图模式（Pulse 式）：details | list | icons-small | icons-medium | icons-large | icons-xl。
    in-out property <string> view-mode: "details";
    /// 是否显示「路径」列（details 视图）。仅回收站开启：回收站里各条目
    /// 来源不同，路径列是判断来源的唯一途径；普通目录的路径与地址栏一致，
    /// 没有展示价值，隐藏后把该列宽度让给名称列。
    in-out property <bool> show-path-column: false;
    /// 单元格几何（icons 系视图）：宽 / 高 / 缩略图边长。
    private property <length> cell-w: root.view-mode == "icons-xl" ? 196px
        : root.view-mode == "icons-large" ? 132px
        : root.view-mode == "icons-medium" ? 96px
        : root.view-mode == "icons-small" ? 190px
        : 0px;
    /// 字体行高（真实测出来的）：直接量“3 行汉字”的总高，与真正渲染名字
    /// 用的是同一套字体回退和行高，所以不多不少刚好装 3 行。
    /// （不能用拉丁字 "M\nM" 量：中文字体行高比拉丁字体大，量小了就会
    /// 把第 3 行挤掉。）
    fm-name-3 := Text { visible: false; font-size: 11.5px; text: I18n.strings[32]; }
    /// 同上，但带符号字（♡/❤）：表情/符号字体往往行高更高，
    /// 行里有它就整行变高。取两者最大值，保证任何名字的 3 行都装得下。
    fm-name-3e := Text { visible: false; font-size: 11.5px; text: I18n.strings[34]; }
    fm-size-1 := Text { visible: false; font-size: 11px; font-family: Theme.mono-font-family; text: "0"; }
    /// 单行实测行高（仅供 name-debug-info 诊断输出）。
    fm-name-1 := Text { visible: false; font-size: 11.5px; text: I18n.strings[31]; }
    fm-name-1e := Text { visible: false; font-size: 11.5px; text: I18n.strings[33]; }
    /// 名字固定展示 3 行的高度。
    /// **必须 +2px**：Slint 内部用 `floor(高度 / 行高)` 算“能放几行”，
    /// 当高度恰好等于 3×行高 时，浮点误差会算出 2.999… → floor 成 2 行，
    /// 第三个行就被丢掉（表现为“第二行就打了省略号”）。
    private property <length> name-h: max(30px, max(fm-name-3.preferred-height, fm-name-3e.preferred-height) + 2px);
    private property <length> size-line-h: max(9px, fm-size-1.preferred-height);
    /// 文字区总高（仅用做浮层“4 行”阀值）
    private property <length> text-h: root.name-h + 1px + root.size-line-h + 4px;
    private property <length> cell-h: root.view-mode == "icons-small" ? 52px
        : root.view-mode == "details" || root.view-mode == "list" ? 0px
        : root.cell-thumb + root.text-h + 20px;
    private property <length> cell-thumb: root.view-mode == "icons-xl" ? 132px
        : root.view-mode == "icons-large" ? 88px
        : root.view-mode == "icons-medium" ? 60px
        : 44px;
    /// 行高：details 30 / list 24 / icons = cell-h。
    private property <length> view-row-h: root.view-mode == "details" ? 30px
        : root.view-mode == "list" ? 24px
        : root.cell-h;
    /// 格子 AABB 宽度（可点击 / 高亮区），与下方 Repeater 的 width 一致。
    private property <length> item-w: root.cell-w - 8px;
    /// 图标间隙下限：原来格子之间只有 8px，鼠标很难从空白处起手框选。
    private property <length> min-gap: 16px;
    /// 每行单元格数：按「格子 + 最小间隙」取整，保证任一间隙都不小于 min-gap。
    /// 仍由 Slint 单一数据源算出，Rust 的虚拟窗口只读这个值。
    out property <int> cells-per-row: root.view-mode == "details" || root.view-mode == "list"
        ? 1
        : max(1, floor((flick.width - root.min-gap) / max(40px, root.item-w + root.min-gap)));
    /// 放不下一个完整格子后剩下的宽度，均分成 N+1 份给
    ///「最左 + N-1 个列间 + 最右」，两侧与列间完全相等（space-evenly）。
    private property <length> grid-gap: root.is-icons-view
        ? max(root.min-gap, (flick.width - root.cells-per-row * root.item-w) / (root.cells-per-row + 1))
        : 0px;
    /// 相邻格子原点的步进。
    private property <length> cell-step: root.item-w + root.grid-gap;
    pure function cell-x(col: int) -> length {
        return root.grid-gap + col * root.cell-step;
    }
    out property <length> row-height-out: root.view-row-h;
    /// 格子实际宽/高（Rust 卡选、拖放定位需要，不再在 Rust 里写一份固定数字）。
    out property <length> cell-w-out: root.cell-w;
    out property <length> cell-h-out: root.cell-h;
    /// 均分后的间隙（Rust 框选命中需要同一套 x 几何；分屏两栏宽度可能不同）。
    out property <length> grid-gap-out: root.grid-gap;
    /// 列表可视宽度（icons 网格列数计算用，供调试观测）。
    out property <length> view-width: flick.width;
    /// 名称区真实宽度（含自适应压缩后的值），供 Rust 精确判定「是否截断」，
    /// 避免用下发列宽估算导致「实际截断了却判定为没截断」。
    out property <length> name-area-w: root.view-mode == "details" || root.view-mode == "list"
        ? root.col-name-w
        : (root.view-mode == "icons-small" ? root.item-w - 58px : root.item-w - 8px);
    /// 当前视图是否为图标网格。
    out property <bool> is-icons-view: root.view-mode != "details" && root.view-mode != "list";

    // ---- 展开名称层（单个选中 / 重命名）----
    /// 本行是否正被“展开名称层”接管（接管时行内不画名字/容量，避免浮层下方漏字）
    pure function row-expanded(idx: int) -> bool {
        return (root.expand-active && root.expand-index == idx)
            || (root.hover-expand-active && root.hover-expand-index == idx);
    }

    /// 需要“展开名称”的条目**绝对索引**（-1 = 无）。由 Rust 计算：
    /// 正在重命名的条目，或本栏恰好只选中一个条目时。
    in-out property <int> expand-index: -1;
    /// 该条目的完整名称（Slint 无法按索引读模型，由 Rust 直接给）。
    in-out property <string> expand-name: "";
    /// 浮层名称的逐行高亮分段与框宽：都由 Rust 预算好，保证「高亮分段」与
    /// 「实际换行位置」严格同源（Slint 侧测量无法与 Rust 的切行一致）。
    in-out property <[GridLine]> expand-lines: [];
    in-out property <length> expand-box-w: 0px;

    /// 只在中/大/超大图标视图生效；小图标视图（横排单行）保持原样。
    /// 是否需要浮层（名字超过 3 行）由 Rust 判定：只有那时才会给 expand-index。
    private property <bool> expand-active: root.is-icons-view
        && root.view-mode != "icons-small"
        && root.expand-index >= 0;

    /// 悬停浮层的条目索引（-1 = 无）。
    ///
    /// 为什么要单独一份：`expand-index` 只能装一个值，选中项和悬停项
    /// 只能轮流占用它——悬停别的格子时它被改成悬停项，选中项的行内名称
    /// 随之被隐藏，下一个事件又改回去，两层浮层就一直互相顶掉（闪烁）。
    /// 这里让「选中/重命名」和「悬停」各用一套属性，两者可以同时显示。
    in-out property <int> hover-expand-index: -1;
    in-out property <[GridLine]> hover-expand-lines: [];
    in-out property <length> hover-expand-box-w: 0px;
    /// 悬停项与选中项是同一个格子时不再重复画（否则两个浮层叠在一起）。
    private property <bool> hover-expand-active: root.is-icons-view
        && root.view-mode != "icons-small"
        && root.hover-expand-index >= 0
        && root.hover-expand-index != root.expand-index;
    private property <int> ex-col: Math.mod(max(0, root.expand-index), max(1, root.cells-per-row));
    private property <int> ex-row: floor(max(0, root.expand-index) / max(1, root.cells-per-row));
    private property <int> hv-col: Math.mod(max(0, root.hover-expand-index), max(1, root.cells-per-row));
    private property <int> hv-row: floor(max(0, root.hover-expand-index) / max(1, root.cells-per-row));
    private property <length> ex-item-x: root.cell-x(root.ex-col);
    /// 框的最小宽度（= 格子的可见宽，左右各留 4px 边距）
    private property <length> ex-cell-w: root.cell-w - 8px;
    /// 一行名称的高度（11.5px 字号实测），网格与浮层共用。
    private property <length> line-h: fm-name-1.preferred-height;
    /// 框宽由 Rust 与逐行分段一起算好：Slint 自己测量无法与 Rust 的切行对齐，
    /// 对不上就会出现「高亮分段和实际换行位置错开」。
    private property <length> ex-box-w: max(root.expand-box-w, 1px);
    /// 排查用：重命名中 = 1（字符串模板里不能嵌套引号比较，所以先算好）
    private property <int> ex-renaming: root.rename-path == "" ? 0 : 1;
    /// 高度按行数：短名字就矮，长名字继续往下长（至少 30px）。
    private property <length> ex-box-h: max(root.expand-lines.length * root.line-h + 14px, 30px);

    /// 排查用：把“为什么截断 / 浮层为什么这样”的全部数字拼成一行。
    public function name-debug-info() -> string {
        return "mode=\{root.view-mode} cell=\{round(root.cell-w / 1px)}x\{round(root.cell-h / 1px)}"
            + " item-w=\{round(root.item-w / 1px)} gap=\{round(root.grid-gap / 1px)}"
            + " thumb=\{round(root.cell-thumb / 1px)} name-y=\{round((root.cell-thumb + 3px) / 1px)}"
            + " name-h=\{round(root.name-h / 1px)}"
            + " line-h=\{round(fm-name-1.preferred-height / 1px)} line-he=\{round(fm-name-1e.preferred-height / 1px)}"
            + " fit-lines=\{floor(root.name-h / max(1px, fm-name-1.preferred-height))}"
            + " size-h=\{round(root.size-line-h / 1px)} text-h=\{round(root.text-h / 1px)}"
            + " m3=\{round(fm-name-3.preferred-height / 1px)}"
            + " m3e=\{round(fm-name-3e.preferred-height / 1px)} m1s=\{round(fm-size-1.preferred-height / 1px)}"
            + " idx=\{root.expand-index} renaming=\{root.ex-renaming}"
            + " expand-active=\{root.expand-active ? 1 : 0}"
            + " expand-lines=\{root.expand-lines.length}"
            + " box=\{round(root.ex-box-w / 1px)}x\{round(root.ex-box-h / 1px)}";
    }
    changed cell-h => { root.name-debug(root.name-debug-info(), root.expand-name); }
    // 单选目标变化也打一条：点击同一个文件时 expand-name 不变，旧触发点会漏日志。
    changed expand-index => { root.name-debug(root.name-debug-info(), root.expand-name); }
    changed expand-name => {
        if (root.expand-index >= 0) {
            root.name-debug(root.name-debug-info(), root.expand-name);
        }
    }
    changed rename-path => { root.name-debug(root.name-debug-info(), root.expand-name); }
    /// 相对格子**居中**（含最左/最右列）。
    /// 浮层宽 1.1 倍格宽，居中后每侧只向外伸出 0.05 × item-w；而网格的
    /// min-gap 是 16px，三档视图 item-w 分别 88 / 124 / 188，伸出量最多
    /// 9.4px < 16px，因此首末列也不会越界，无需再按列贴边。
    private property <length> ex-want-x: ex-item-x + (root.item-w - ex-box-w) / 2;
    /// 兜底夹取：窗口极窄（列数=1 且浮层比可视区还宽）时才生效。
    private property <length> ex-box-x: max(4px, min(ex-want-x, root.width - 4px - ex-box-w));
    private property <length> ex-box-y: flick.y + flick.content-y + ex-row * root.cell-h
        + 4px + root.cell-thumb + 3px;

    // 悬停浮层的同一套几何（与选中浮层完全对称，只是换了索引/行/宽）。
    private property <length> hv-item-x: root.cell-x(root.hv-col);
    private property <length> hv-box-w: max(root.hover-expand-box-w, 1px);
    private property <length> hv-box-h: max(root.hover-expand-lines.length * root.line-h + 14px, 30px);
    private property <length> hv-want-x: hv-item-x + (root.item-w - hv-box-w) / 2;
    private property <length> hv-box-x: max(4px, min(hv-want-x, root.width - 4px - hv-box-w));
    private property <length> hv-box-y: flick.y + flick.content-y + hv-row * root.cell-h
        + 4px + root.cell-thumb + 3px;

    /// 滚动到顶端（导航/过滤变化时由 Rust 调用）。
    public function scroll-to-top() {
        flick.content-y = 0px;
    }

    /// 命中测试：接收相对于 FileList 自身的局部坐标 (lx, ly)
    public function row-hit-test(lx: length, ly: length) -> int {
        let header-h = root.view-mode == "details" ? 30px : 0px;
        let rel-x = lx - flick.content-x;
        let rel-y = ly - header-h - flick.content-y;

        // 仅在鼠标位于表头区域上方时返回 -1（其余越界由下方的总行数自然保护）
        if (rel-y < 0px) {
            return -1;
        }

        if (root.is-icons-view) {
            if (root.cell-w <= 0px || root.cell-h <= 0px || root.cells-per-row <= 0) {
                return -1;
            }
            let col = floor((rel-x - root.grid-gap) / root.cell-step);
            let r = floor(rel-y / root.cell-h);
            if (col < 0 || col >= root.cells-per-row) {
                return -1;
            }
            // 均分出来的间隙属于背景，不能归到相邻格子（否则拖放落点会偏）。
            let cx = root.cell-x(col);
            if (rel-x < cx || rel-x > cx + root.item-w) {
                return -1;
            }
            let idx = r * root.cells-per-row + col;
            return (idx >= 0 && idx < root.total-count) ? idx : -1;
        } else {
            if (root.row-h <= 0px) {
                return -1;
            }
            let idx = floor(rel-y / root.row-h);
            return (idx >= 0 && idx < root.total-rows) ? idx : -1;
        }
    }

    /// 获取指定单元格相对于 FileList 的坐标几何 [x, y, width, height]
    public function get-item-rect(idx: int) -> [length] {
        let header-h = root.view-mode == "details" ? 30px : 0px;
        if (root.is-icons-view) {
            let col = Math.mod(idx, root.cells-per-row);
            let r = floor(idx / root.cells-per-row);
            let x = root.cell-x(col);
            let y = header-h + r * root.cell-h + flick.content-y + 4px;
            let w = root.item-w;
            let h = root.cell-h - 8px;
            return [x, y, w, h];
        } else {
            let x = 0px;
            let y = header-h + idx * root.row-h + flick.content-y;
            let w = flick.width;
            let h = root.row-h;
            return [x, y, w, h];
        }
    }

    /// 拖出上膛：行被按下、可能即将拖出时置真，禁用 flick 的交互滚动，
    /// 让行拖动只用于发起 OLE 拖放（滚动改由滚动条触发）。详见 app.rs。
    public function set-drag-armed(v: bool) {
        root.drag-armed = v;
    }
    in-out property <bool> drag-armed: false;

    private property <length> row-h: root.view-row-h;
    /// 虚拟行数：icons 网格按每行 cells-per-row 折算。
    // 核心修复 1：容错总数，防止右分屏因未及时同步 total-count 而误判高度为 0 隐藏滚动条
    private property <int> effective-total: max(root.total-count, root.rows.length);
    private property <int> total-rows: root.view-mode == "details" || root.view-mode == "list"
        ? root.effective-total
        : ceil(root.effective-total / max(root.cells-per-row, 1));
    private property <length> w-icon: 40px;
    // 列宽为固定值（资源管理器风格）：窗口变宽时右侧留白，变窄时出横向滚动条，
    // 不再按剩余空间自动分配 —— 用户手动调过的宽度不会被窗口缩放覆盖。
    in-out property <length> w-name: 320px;
    in-out property <length> w-modified: 150px;
    /// 「修改时间」列的实际占宽：此电脑视图整列不存在，按 0 参与后面的列排布，
    /// 这样类型/大小/路径列会自动左移，不留空洞。
    private property <length> eff-modified-w: root.is-computer-view ? 0px : root.w-modified;
    /// 此电脑视图：整个「修改时间」列不显示，首列表头是「盘符」，
    /// 大小列表头改成「剩余」，单元格只显示剩余容量。
    in-out property <bool> is-computer-view: false;
    in-out property <length> w-type: 116px;
    in-out property <length> w-size: 96px;
    /// 该目录的列宽是「自适应」（没有用户手动拖过的记录）时为 true。
    /// 此时名称列会被压缩到不出横向滚动条；手动调过的目录完全按记录值，
    /// 用户拖宽就允许出现滚动条（不能悄悄改回去）。
    in-out property <bool> auto-col-widths: true;
    /// 双击列边界时用的估算宽度（Rust 按最长内容字符数估算后下发），
    /// 顺序：名称 / 修改时间 / 类型 / 大小 / 路径。
    in property <[length]> autofit-widths: [];
    /// 鼠标左键是否按住（main_window 从 Rust/winit 回填）。Slint 的 TextInput
    /// 拖选期间抓住鼠标，行内 TouchArea 收不到事件，重命名输入框的
    /// 「拖选贴边自动滚动」只能从这里拿按下状态。
    in property <bool> mouse-left-pressed: false;
    /// 用户拖动列边界结束（或双击自适应）后上报，由 Rust 按当前目录落盘。
    /// `name-w` = 松手瞬间名称列的**显示宽**（自适应时是视口剩余宽，不是 w-name）。
    /// 名称列宽度只能由 Rust 连同 auto 开关一起原子提交，原因见 record_col_width。
    callback col_resized(index: int, width: length, name-w: length);
    // 列宽拖动状态：记录按下时的指针绝对 x 与列宽，rs-col 是正在拖的列号
    // （-1 = 没在拖，用来给分隔符上高亮色）。
    private property <length> rs-start-px: 0px;
    private property <length> rs-start-w: 0px;
    private property <int> rs-col: -1;
    // 本次按下周期内是否真的拖动过（位移超过阈值）。双击自动调整只在「没有拖过」
    // 时生效，避免「先点一下分隔符、紧接着快速拖一下」被 Slint 当成双击而把刚拖出
    // 的宽度又弹回内容自适应。
    private property <bool> rs-dragged: false;
    /// 拖动右侧列（修改时间 / 类型 / 大小）时，按下瞬间名称列的显示宽快照。
    /// 拖动过程中右列一变，auto-name-w 就反向变化，松手时再读 col-name-w 会得到
    /// 「被拖动量抵消过」的值；必须用按下时的快照才能把名称列钉在用户看到的宽度。
    private property <length> rs-start-name-w: 0px;
    /// 拖动期间名称列宽的本地锁定值（-1 = 未锁定）。
    /// 拖右列时必须锁住名称列，否则 auto-name-w 会因 w-modified 变化
    /// 反向补偿，表现为「动的是另一条分隔符」。拖名称列自身时锁存的就是
    /// 实时拖出的宽度，等于把「跟手」也走同一个通道。
    private property <length> rs-name-lock: -1px;
    /// 最右侧留白：方便在空白处拖拽框选文件（减为原来一半，少占名称列空间）。
    private property <length> right-pad: 48px;
    /// 滚动条轨道宽（含内边距）。
    private property <length> sb-width: 12px;
    /// 滚动条按下时记录的滑块 y，用于计算拖拽增量。
    private property <length> sb-drag-grab-y: 0px;
    /// 横向滚动条按下时记录的滑块 x 与鼠标 x（拖拽用增量算目标位置）。
    private property <length> hsb-drag-start-thumb-x: 0px;
    private property <length> hsb-drag-start-mouse-x: 0px;

    // 视口纵向边界，供滚轮/滚动条钳制。
    private property <length> min-content-y: min(0px, flick.height - flick.content-height);
    private property <length> max-content-y: 0px;
    // 横向：所有列的最小总宽（窄窗口时出现横向滚动）。「路径」列隐藏时
    // 其 240px 基宽不计入，避免窄窗口出现无意义的横向滚动。
    // 横向滚动的判定基准：列表视图单列铺满；详细信息以「最后一列右边分隔符」
    // 为准 —— 分隔符右侧的留白不算内容宽度，否则留白会把滚动条顶出来。
    private property <length> min-list-width: root.view-mode == "list"
        ? 8px + root.w-icon + 140px
        : root.col-end + 8px;
    private property <length> min-content-x: min(0px, flick.width - flick.content-width);
    private property <length> max-content-x: 0px;
    // 「路径」列基宽：隐藏时为 0。
    private property <length> path-w-base: root.show-path-column ? 240px : 0px;
    // 列几何（表头与行共用，保证像素级对齐）。
    private property <length> col-icon-x: 8px;
    private property <length> col-name-x: 8px + root.w-icon;
    /// 名称列上限：1920 逻辑宽（含 4K@2x）下 auto-name-w 触不到此上限，
    /// 名称列始终撑满剩余空间；仅在超宽屏（auto-name-w 超过此值）时才封顶，
    /// 避免名称列被拉得过长、右侧留白过多导致用不习惯。
    private property <length> name-max-w: 2000px;
    /// 自适应预算：视口宽扣掉图标列、其余固定列、路径列、以及「大小」列右侧
    /// 预留的框选留白，剩下的全给名称列。只在该目录没有手动列宽记录时生效。
    private property <length> auto-name-w: max(160px,
        flick.width - root.col-name-x - root.eff-modified-w - root.w-type - root.w-size
        - root.col-path-w - root.right-pad - 8px);
    private property <length> col-name-w: root.view-mode == "list"
        ? max(140px, flick.width - root.col-name-x - 10px)
        : (root.view-mode == "details"
            ? (root.rs-name-lock >= 0px
                // 拖动任何分隔符期间用本地锁定值：不能靠 auto-col-widths，
                // 它要等松手后 Rust 提交才变，拖动过程中仍为 true，
                // 而 auto-name-w 里减掉了右列宽度 —— 往左拖右列会让名称列
                // 反向变宽，用户看到的是左边那条分隔符在跑（不是手上那条）。
                ? root.rs-name-lock
                : (root.auto-col-widths
                    ? min(root.auto-name-w, root.name-max-w)
                    : root.w-name))
            : root.w-name);
    private property <length> col-path-w: root.path-w-base;
    /// 最后一列的右边界（= 「大小」列右边那条分隔符的位置，显示路径列时顺延）。
    /// 三个用途：行点击区的右界、表头最后一条分隔线、横向滚动条的判定基准。
    private property <length> col-end: root.col-path-x + root.col-path-w;
    private property <length> col-modified-x: root.col-name-x + root.col-name-w;
    private property <length> col-type-x: root.col-modified-x + root.eff-modified-w;
    private property <length> col-size-x: root.col-type-x + root.w-type;
    private property <length> col-path-x: root.col-size-x + root.w-size;

    /// 外部（Rust）按目录下发列宽。不用双向绑定：两个分屏各持一套宽度，
    /// 绑定会互相覆盖，函数式下发更直接。
    public function set-col-widths(n: length, m: length, t: length, s: length) {
        root.w-name = n;
        root.w-modified = m;
        root.w-type = t;
        root.w-size = s;
    }
    // 在 Slint 侧切换「名称列窗口自适应」开关。必须走 Slint 侧（而非 Rust 的
    // set_col_auto_widths），否则 Rust 直接 set 的值不会可靠传播到 col-name-w 的求值，
    // 导致切目录把 auto 置回 true 后，名称列仍停在 w-name（内容拟合宽）——表现为
    // 长文件名目录出现横向滚动条、短文件名目录右侧留白。拖拽时置 false 也是 Slint 侧设的，可正常传播。
    public function set-auto-col-widths(flag: bool) {
        root.auto-col-widths = flag;
    }

    // 供 Rust 切换标签时，强制重置滚动条（直接操作底层 Flickable）
    public function set-scroll-y(v: length) {
        self.suppress-scroll-event = true;
        flick.content-y = -v;
        self.suppress-scroll-event = false;
    }

    /// 防回环锁：程序主动修改滚动条时，屏蔽回调，防止污染数据
    private property <bool> suppress-scroll-event: false;

    /// 滚动偏移（content-y 的负值）。任何滚动来源（拖拽、惯性、滚轮、
    /// 滚动条、程序重置）都会改变它，从而通知 Rust 更新虚拟窗口。
    private property <length> scroll-pos: -flick.content-y;
    changed scroll-pos => {
        if (!self.suppress-scroll-event) {
            root.scroll-changed(self.scroll-pos);
        }
        // 排查用：把“位置+当时几何”一起抛给 Rust。
        // 只有这样才能看出位置上跳是因为 content-height/view-height 算错
        // （min-content-y 把滚动量卡在某个值），还是程序主动 push。
        root.scroll-dbg(
            self.scroll-pos,
            flick.content-height,
            flick.height,
            root.min-content-y,
            flick.content-y,
        );
    };

    // 注意：Rectangle 不是布局，直接子元素必须显式给出几何，否则尺寸为 0。
    VerticalLayout {
        x: 0px;
        y: 0px;
        width: 100%;
        height: 100%;
        spacing: 0px;
        min-width: 0px;

        // ---- 表头（仅详细信息视图） ----
        header := Rectangle {
            // 核心修复：非详细信息视图时高度必须归零，否则 VerticalLayout 中会留下 30px 的透明死区空白
            height: root.view-mode == "details" ? 30px : 0px;
            // 核心修复 2：非详细视图时宽度必须归零！绝不允许 560px 的隐藏表头撑爆外层布局导致内容溢出窗口
            width: root.view-mode == "details" ? parent.width : 0px;
            background: Theme.bg-toolbar;
            clip: true;
            visible: root.view-mode == "details";

            // 表头单元格：显式列定位，与行共用列几何；横向滚动时随内容移动。
            Rectangle {
                x: flick.content-x;
                y: 0px;
                width: max(flick.content-width, parent.width);
                height: parent.height;

                Rectangle {
                    x: root.col-icon-x;
                    width: root.w-icon;
                    height: parent.height;
                }
                SortCell {
                    x: root.col-name-x;
                    width: root.col-name-w;
                    key: root.is-computer-view ? "drive" : "name";
                    label: root.is-computer-view ? I18n.strings[237] : I18n.strings[30];
                    active-key: root.sort-key;
                    ascending: root.sort-ascending;
                    clicked(k) => {
                        root.header-clicked(k);
                    }
                }
                SortCell {
                    visible: !root.is-computer-view;
                    x: root.col-modified-x;
                    width: root.w-modified;
                    key: "modified";
                    label: I18n.strings[17];
                    active-key: root.sort-key;
                    ascending: root.sort-ascending;
                    clicked(k) => {
                        root.header-clicked(k);
                    }
                }
                SortCell {
                    x: root.col-type-x;
                    width: root.w-type;
                    key: "type";
                    label: I18n.strings[70];
                    active-key: root.sort-key;
                    ascending: root.sort-ascending;
                    clicked(k) => {
                        root.header-clicked(k);
                    }
                }
                SortCell {
                    x: root.col-size-x;
                    width: root.w-size;
                    key: "size";
                    label: root.is-computer-view ? I18n.strings[25] : I18n.strings[38];
                    active-key: root.sort-key;
                    ascending: root.sort-ascending;
                    clicked(k) => {
                        root.header-clicked(k);
                    }
                }
                SortCell {
                    visible: root.show-path-column;
                    x: root.col-path-x;
                    width: root.col-path-w;
                    key: "path";
                    label: I18n.strings[74];
                    active-key: root.sort-key;
                    ascending: root.sort-ascending;
                    clicked(k) => {
                        root.header-clicked(k);
                    }
                }
            }

            // 列宽拖拽手柄：后声明 → 叠在表头之上，只占 6px 条带，不影响点击
            // 标题排序。拖动结束（up）或双击自适应后上报，由 Rust 按目录落盘。
            // 关键：表头单元格容器已经用 `x: flick.content-x` 随横向滚动移动，
            // 这些手柄与分隔符必须同步补偿，否则出现横向滚动条后手柄停在原位，
            // 与列边界错位、点不中（用户反馈「排序分隔符不跟着滚」）。
            h-name := TouchArea {
                x: root.col-modified-x - 3px + flick.content-x;
                width: 6px;
                height: parent.height - 1px;
                mouse-cursor: col-resize;
                // 可见分隔符：默认 1px 细线，悬停或正在拖动时变强调色。
                Rectangle {
                    x: 2.5px;
                    y: (parent.height - 16px) / 2;
                    width: 1px;
                    height: 16px;
                    background: root.rs-col == 0 || h-name.has-hover ? Theme.accent : Theme.text-secondary;
                }
                moved => {
                    if (self.pressed) {
                        let d = self.absolute-position.x + self.mouse-x - root.rs-start-px;
                        if (abs(d) > 4px) {
                            // 首次越过拖拽阈值：先把 w-name 对齐到当前「显示宽」
                            // （自适应时等于视口剩余宽，而非默认 320），再解除自适应，
                            // 这样 col-name-w 从 auto-name-w 平滑过渡到 w-name，
                            // 分隔符不会在按下瞬间跳位置、导致 up 落空。
                            if (!root.rs-dragged) {
                                root.w-name = root.rs-start-w;
                                root.auto-col-widths = false;
                                root.rs-dragged = true;
                            }
                            root.w-name = max(120px, root.rs-start-w + d);
                            root.rs-name-lock = root.w-name;
                        }
                    }
                }
                pointer-event(e) => {
                    if (e.kind == PointerEventKind.down) {
                        root.rs-col = 0;
                        root.rs-dragged = false;
                        root.rs-start-px = self.absolute-position.x + self.mouse-x;
                        // 记录当前「显示宽」col-name-w（自适应时是视口剩余宽，手动时是
                        // w-name），用它当起点，避免起点跳变。down 时不碰 auto/w-name，
                        // 否则分隔符会瞬移、鼠标 up 落空，首拖像「被自动调整」。
                        root.rs-start-w = root.col-name-w;
                    }
                    if (e.kind == PointerEventKind.up) {
                        root.rs-col = -1;
                        root.rs-name-lock = -1px;
                        // 只有真正拖动过才提交，单击分隔符不锁定/不改动自适应。
                        if (root.rs-dragged) {
                            root.col_resized(0, root.w-name, root.w-name);
                        }
                    }
                }
                // 双击 = 自适应：宽度传 -1 表示「按内容估算」，由 Rust 现算。
                // 但若本次按下周期内真的拖动过（rs-dragged），说明用户本意是拖拽，
                // 不是双击，跳过自动调整，避免把刚拖出的宽度弹回内容自适应。
                double-clicked => {
                    if (!root.rs-dragged) {
                        root.col_resized(0, -1px, root.w-name);
                    }
                }
            }
            h-mod := TouchArea {
                // 此电脑视图没有修改时间列，这条分隔符也就没有意义（否则会和
                // 名称列右侧的手柄叠在同一位置，点不准）。
                visible: !root.is-computer-view;
                x: root.col-type-x - 3px + flick.content-x;
                width: 6px;
                height: parent.height - 1px;
                mouse-cursor: col-resize;
                Rectangle {
                    x: 2.5px;
                    y: (parent.height - 16px) / 2;
                    width: 1px;
                    height: 16px;
                    background: root.rs-col == 1 || h-mod.has-hover ? Theme.accent : Theme.text-secondary;
                }
                moved => {
                    if (self.pressed) {
                        let d = self.absolute-position.x + self.mouse-x - root.rs-start-px;
                        if (abs(d) > 4px) {
                            if (!root.rs-dragged) {
                                root.rs-dragged = true;
                            }
                            root.w-modified = max(70px, root.rs-start-w + d);
                        }
                    }
                }
                pointer-event(e) => {
                    if (e.kind == PointerEventKind.down) {
                        root.rs-col = 1;
                        root.rs-dragged = false;
                        root.rs-start-px = self.absolute-position.x + self.mouse-x;
                        root.rs-start-w = root.w-modified;
                        // 名称列显示宽在 down 时拍快照：拖动过程中右列一变，
                        // auto-name-w 就会跟着反向变，用它当提交值会得到「被拖动量
                        // 反向抵消过」的宽度，等于名称列照旧不动。
                        root.rs-start-name-w = root.col-name-w;
                        // 名字列宽已在上两行取完，但如果按下时鼠标已贴着手柄、
                        // 接下来第一帧就会越过阈值，那时 col-name-w 已被 w-modified
                        // 带脏，所以马上加锁。
                        root.rs-name-lock = root.rs-start-name-w;
                    }
                    if (e.kind == PointerEventKind.up) {
                        root.rs-col = -1;
                        root.rs-name-lock = -1px;
                        // 只有真正拖动过才提交，单击分隔符不改宽度。
                        if (root.rs-dragged) {
                            root.col_resized(1, root.w-modified, root.rs-start-name-w);
                        }
                    }
                }
                double-clicked => {
                    if (!root.rs-dragged) {
                        root.col_resized(1, -1px, root.rs-start-name-w);
                    }
                }
            }
            h-type := TouchArea {
                x: root.col-size-x - 3px + flick.content-x;
                width: 6px;
                height: parent.height - 1px;
                mouse-cursor: col-resize;
                Rectangle {
                    x: 2.5px;
                    y: (parent.height - 16px) / 2;
                    width: 1px;
                    height: 16px;
                    background: root.rs-col == 2 || h-type.has-hover ? Theme.accent : Theme.text-secondary;
                }
                moved => {
                    if (self.pressed) {
                        let d = self.absolute-position.x + self.mouse-x - root.rs-start-px;
                        if (abs(d) > 4px) {
                            if (!root.rs-dragged) {
                                root.rs-dragged = true;
                            }
                            root.w-type = max(60px, root.rs-start-w + d);
                        }
                    }
                }
                pointer-event(e) => {
                    if (e.kind == PointerEventKind.down) {
                        root.rs-col = 2;
                        root.rs-dragged = false;
                        root.rs-start-px = self.absolute-position.x + self.mouse-x;
                        root.rs-start-w = root.w-type;
                        root.rs-start-name-w = root.col-name-w;
                        root.rs-name-lock = root.rs-start-name-w;
                    }
                    if (e.kind == PointerEventKind.up) {
                        root.rs-col = -1;
                        root.rs-name-lock = -1px;
                        if (root.rs-dragged) {
                            root.col_resized(2, root.w-type, root.rs-start-name-w);
                        }
                    }
                }
                double-clicked => {
                    if (!root.rs-dragged) {
                        root.col_resized(2, -1px, root.rs-start-name-w);
                    }
                }
            }
            h-size := TouchArea {
                x: root.col-path-x - 3px + flick.content-x;
                width: 6px;
                height: parent.height - 1px;
                mouse-cursor: col-resize;
                Rectangle {
                    x: 2.5px;
                    y: (parent.height - 16px) / 2;
                    width: 1px;
                    height: 16px;
                    background: root.rs-col == 3 || h-size.has-hover ? Theme.accent : Theme.text-secondary;
                }
                moved => {
                    if (self.pressed) {
                        let d = self.absolute-position.x + self.mouse-x - root.rs-start-px;
                        if (abs(d) > 4px) {
                            if (!root.rs-dragged) {
                                root.rs-dragged = true;
                            }
                            root.w-size = max(60px, root.rs-start-w + d);
                        }
                    }
                }
                pointer-event(e) => {
                    if (e.kind == PointerEventKind.down) {
                        root.rs-col = 3;
                        root.rs-dragged = false;
                        root.rs-start-px = self.absolute-position.x + self.mouse-x;
                        root.rs-start-w = root.w-size;
                        root.rs-start-name-w = root.col-name-w;
                        root.rs-name-lock = root.rs-start-name-w;
                    }
                    if (e.kind == PointerEventKind.up) {
                        root.rs-col = -1;
                        root.rs-name-lock = -1px;
                        if (root.rs-dragged) {
                            root.col_resized(3, root.w-size, root.rs-start-name-w);
                        }
                    }
                }
                double-clicked => {
                    if (!root.rs-dragged) {
                        root.col_resized(3, -1px, root.rs-start-name-w);
                    }
                }
            }

            // 「大小」列右边（显示路径列时是路径列右边）的分隔符：
            // 它界定行点击区与横向滚动的边界，右侧留白从这里往后算。
            if (root.show-path-column) : Rectangle {
                x: root.col-end - 0.5px + flick.content-x;
                y: (parent.height - 16px) / 2;
                width: 1px;
                height: 16px;
                background: Theme.text-secondary;
            }

            // 底部分隔线。
            Rectangle {
                x: 0px;
                y: parent.height - 1px;
                width: 100%;
                height: 1px;
                background: Theme.divider;
            }
        }

        // ---- 主体 ----
        flick := Flickable {
            horizontal-stretch: 1;
            vertical-stretch: 1;
            // 任务 2.3：禁用鼠标拖拽平移。Flickable 会在按下后延迟转发并按方向
            // 拦截拖动（见 i-slint-core flickable.rs handle_mouse_filter），导致行
            // 拖出手势被"吃掉"变成滚动。关闭后行的按下/移动立即直达行 TouchArea，
            // 拖动只用于发起 OLE 拖出；滚动仍由滚轮（不受此属性影响）、滚动条与触摸承担。
            mouse-drag-pan-enabled: false;
            // 行被按下（可能拖出）时仍临时禁用交互滚动兜底。
            interactive: !root.drag-armed;
            content-height: max(root.total-rows * root.row-h, self.height);
            // 横向：图标网格视图宽度严格等于视口自身（自动向下换行），只有详细/列表视图才使用 min-list-width
            content-width: root.is-icons-view ? self.width : max(root.min-list-width, self.width);

            // 空白处点击 / 右键 / 框选。
            TouchArea {
                x: 0px;
                y: 0px;
                // 横向也要撑满内容宽度：横向滚动后，视口右侧不会再漏出不响应的空白。
                width: max(parent.width, parent.content-width);
                // 核心修复：撑满整个滚动内容区域，而非仅视口高度。
                // Flickable 会按 content-height 裁剪子元素，背景 TouchArea 默认只有
                // parent.height（视口高）——滚动后下方内容在视口外，空白处点不到，
                // 右键也会落空。改成 max(视口高, 内容高) 让空白处始终可点。
                height: max(parent.height, parent.content-height);

                scroll-event(event) => {
                    // Ctrl+滚轮切视图：Rust 按住 Ctrl 时消费事件，列表不再滚动。
                    if (event.delta-y != 0px && root.wheel-view(event.delta-y)) { return EventResult.accept; }
                    // 只有横向滚动条时（纵向内容不溢出），垂直滚轮之前被下面的
                    // delta-y 分支吞掉、content-y 又被 clamp 回 0，表现为「滚轮完全没反应」。
                    // 这里把 delta-y 折算成横向滚动量，让滚轮仍然可用。
                    if (event.delta-y != 0px && root.min-content-y >= 0px && root.min-content-x < 0px) {
                        root.scroll-user-input();
                        flick.content-x = min(root.max-content-x, max(root.min-content-x, flick.content-x + event.delta-y));
                        return EventResult.accept;
                    }
                    if (event.delta-y != 0px) {
                        root.scroll-user-input();
                        flick.content-y = min(root.max-content-y, max(root.min-content-y, flick.content-y + event.delta-y));
                        root.scroll-changed(-flick.content-y);
                        return EventResult.accept;
                    }
                    if (event.delta-x != 0px) {
                        flick.content-x = min(root.max-content-x, max(root.min-content-x, flick.content-x + event.delta-x));
                        return EventResult.accept;
                    }
                    return EventResult.reject;
                }

                pointer-event(event) => {
                    if (event.kind == PointerEventKind.down) {
                        // 左键：触发框选；右键：走原有逻辑
                        if (event.button == PointerEventButton.left) {
                            root.sel-x1 = self.mouse-x;
                            root.sel-y1 = self.mouse-y;
                            root.sel-x2 = self.mouse-x;
                            root.sel-y2 = self.mouse-y;
                            root.is-selecting = true;
                            // 让 Rust 记录 Ctrl/Shift 累加基线（普通框选则清空旧选择）
                            root.background-pointer-event(event, self.mouse-x, self.mouse-y);
                            return EventResult.accept;
                        } else if (event.button == PointerEventButton.right) {
                            // 核心修复：加上 flick.content-y 补偿滚动偏移，还原为视口坐标。
                            // flick.content-y 是负值（向下滚动为负），加它等于减去滚动偏移。
                            let header-h = root.view-mode == "details" ? 30px : 0px;
                            let viewport_y = self.mouse-y + flick.content-y + header-h;
                            root.background-pointer-event(event, self.mouse-x, viewport_y);
                            return EventResult.accept;
                        }
                    }

                    if (event.kind == PointerEventKind.move && root.is-selecting) {
                        root.sel-x2 = self.mouse-x;
                        root.sel-y2 = self.mouse-y;
                        // 视口内 y = 内容 y + 滚动偏移（content-y 向下滚为负）。
                        let vp_y = self.mouse-y + flick.content-y;
                        root.sel-vp-y = vp_y;
                        // 表头在 flick 之外，flick.height 本身就是不含表头的视口高，
                        // 不能再减一次 header-h，否则底部触发区会平白上移 30px。
                        let vp_h = flick.height;
                        // 距上下边缘 26px 内进入自动滚，越靠近边缘越快由定时器步进决定。
                        root.sel-edge = vp_y < 26px ? -1 : (vp_y > vp_h - 26px ? 1 : 0);
                        // 核心：在背景 TouchArea 中直接触发移动回调
                        root.rubber-band-move(root.sel-x1, root.sel-y1, root.sel-x2, root.sel-y2);
                        return EventResult.accept;
                    }

                    if ((event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) && root.is-selecting) {
                        root.is-selecting = false;
                        root.sel-edge = 0;
                        // 每次抬手都交给 Rust 收尾：由它按拖动距离判定是否成框，
                        // 误触 / 取消时恢复按下前的选择（Ctrl/Shift 累加基线）。
                        if (event.kind == PointerEventKind.up) {
                            root.rubber-band-selected(root.sel-x1, root.sel-y1, root.sel-x2, root.sel-y2);
                        } else {
                            // cancel：传零尺寸矩形，等价于撤销本轮框选。
                            root.rubber-band-selected(root.sel-x1, root.sel-y1, root.sel-x1, root.sel-y1);
                        }
                        return EventResult.accept;
                    }

                    return EventResult.reject;
                }
            }

            for row[i] in root.rows : Rectangle {
                visible: !root.is-icons-view;
                // 名称浮层是否显示。必须只看 ta.has-hover，不能再引入浮层自身的
                // hover：浮层里一旦放 TouchArea，就会在鼠标静止时新出现而 Slint
                // 不会立即更新其 has-hover → 浮层永远活不过一帧，变成闪烁。
                // 因此浮层不接管鼠标，点击靠下方 ta，并按 name-overlay-shown
                // 把整行都当作名称区（见 ta 的 name-hit 参数）。
                private property <bool> name-overlay-shown: root.rename-path != row.path
                    && !root.is-selecting
                    && (ta.has-hover || (row.selected && root.single-selection))
                    && (row.name-truncated
                        || name-measure-details.preferred-width > root.col-name-w);
                y: row.index * root.row-h;
                x: 0px;
                // 行元素（含点击区）只铺到最后一列右边界：右侧留白里不存在行，
                // 点它等于点空白、从那里起手就是框选。列表视图仍整行铺满。
                width: root.view-mode == "list" ? flick.content-width : root.col-end;
                height: root.row-h;
                background: (row.index == root.drop-hover-index && row.is-dir) || row.selected
                    ? Theme.bg-selected
                    : (row.index == root.drop-hover-index ? Theme.bg-hover : (ta.has-hover ? Theme.bg-hover : transparent));
                border-width: (row.index == root.drop-hover-index && row.is-dir) ? 2px : 0px;
                border-color: Theme.accent;
                border-radius: 4px;

                ta := TouchArea {
                    // 行容器本身已截止到最后一列边界，这里铺满行即可；
                    // 用整行的 100% 保证列内任何位置（含图标、名称、类型、大小）都能点。
                    width: 100%;
                    height: 100%;

                    pointer-event(event) => {
                        // 核心修复：如果当前行正在重命名，拒绝事件，让点击穿透到 TextInput。
                        // 不能把整个 TouchArea 的 enabled 设为 false，否则 scroll-event 也会失效，
                        // 导致鼠标悬停在该行时滚轮卡死。
                        //
                        // 例外：点“自己这一行、但不在输入框上”的地方（图标、其它列、行尾空白）
                        // = 提交重命名。输入框会自己吃掉它范内的点击，能走到这里的就一定是
                        // 输入框以外，所以直接提交不会误伤打字。
                        if (root.rename-path == row.path) {
                            if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                                root.commit-rename();
                            }
                            return EventResult.reject;
                        }
                        // 点击到另一行也算“点击其他位置”：先按已输入文本提交重命名。
                        // （TouchArea 不抢焦点，所以光靠 has-focus 失焦是等不到的。）
                        if (root.rename-path != "" && event.kind == PointerEventKind.down) {
                            root.commit-rename();
                        }

                        if (event.kind == PointerEventKind.down) {
                            // 核心修复：绝对内容Y + 滚动偏移 + 表头高度 = 视口Y。
                            // flick.content-y 是负值（向下滚动为负），加它等于减去滚动偏移。
                            let header-h = root.view-mode == "details" ? 30px : 0px;
                            let viewport_y = row.index * root.row-h + self.mouse-y + flick.content-y + header-h;
                            root.row-pointer-event(row.index, event, self.mouse-x, viewport_y, root.name-hit(self.mouse-x) || name-overlay-shown);
                            return EventResult.accept;
                        }
                        // 拖拽手势：move/up 继续转发给按下时捕获的行 TouchArea。
                        // 关键：必须与 down 分支用完全相同的视口Y变换，否则滚动后首次 move
                        // 会和 down 差一个 content-y 偏移，位移阈值被瞬间越过 → 零位移误触发拖出。
                        if (event.kind == PointerEventKind.move
                            || event.kind == PointerEventKind.up
                            || event.kind == PointerEventKind.cancel) {
                            let header-h = root.view-mode == "details" ? 30px : 0px;
                            let viewport_y = row.index * root.row-h + self.mouse-y + flick.content-y + header-h;
                            root.row-pointer-event(row.index, event, self.mouse-x, viewport_y, root.name-hit(self.mouse-x) || name-overlay-shown);
                            return EventResult.accept;
                        }
                        return EventResult.reject;
                    }

                    double-clicked => {
                        if (root.rename-path != row.path) {
                            root.row-double-clicked(row.index);
                        }
                    }

                    scroll-event(event) => {
                    // Ctrl+滚轮切视图：Rust 按住 Ctrl 时消费事件，列表不再滚动。
                    if (event.delta-y != 0px && root.wheel-view(event.delta-y)) { return EventResult.accept; }
                        // 只有横向滚动条时把垂直滚轮折算成横向滚动（否则事件被吞、
                        // 页面毫无反应）。行是覆盖面积最大的区域，必须在这里也处理。
                        if (event.delta-y != 0px && root.min-content-y >= 0px && root.min-content-x < 0px) {
                            root.scroll-user-input();
                            flick.content-x = min(root.max-content-x, max(root.min-content-x, flick.content-x + event.delta-y));
                            return EventResult.accept;
                        }
                        if (event.delta-y != 0px) {
                            root.scroll-user-input();
                            flick.content-y = min(root.max-content-y, max(root.min-content-y, flick.content-y + event.delta-y));
                            root.scroll-changed(-flick.content-y);
                            return EventResult.accept;
                        }
                        if (event.delta-x != 0px) {
                            flick.content-x = min(root.max-content-x, max(root.min-content-x, flick.content-x + event.delta-x));
                            return EventResult.accept;
                        }
                        return EventResult.reject;
                    }
                }

                // 图标：真实缩略图（异步加载完成后）或彩色圆角方块 + 扩展名角标。
                Rectangle {
                    x: root.col-icon-x;
                    y: 0px;
                    width: root.w-icon;
                    height: parent.height;

                    if (row.thumb.width > 0) : Image {
                        x: 8px;
                        y: (parent.height - 24px) / 2;
                        width: 24px;
                        height: 24px;
                        source: row.thumb;
                        image-fit: contain;
                    }
                    if (row.thumb.width <= 0) : Rectangle {
                        x: 8px;
                        y: (parent.height - 22px) / 2;
                        width: 22px;
                        height: 22px;
                        border-radius: 5px;
                        background: row.icon-color.transparentize(row.is-dir ? 0.82 : 0.84);

                        Text {
                            text: row.icon-text;
                            color: row.icon-color;
                            font-size: 8.5px;
                            font-weight: 700;
                            font-family: Theme.mono-font-family;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            width: 100%;
                            height: 100%;
                        }
                    }
                }

                // 完整名称测量（不显示）：判断名称是否被列宽截断，并给浮层定宽。
                name-measure-details := Text {
                    visible: false;
                    text: row.name;
                    font-size: 13px;
                    font-weight: row.is-dir ? 500 : 400;
                    wrap: no-wrap;
                }

                // 名称 / 内联重命名：套一层单行浮层突出显示，宽度随输入文本
                // 伸展/收缩，最长占整行（从名称列起点到行右边界）。
                if (root.rename-path == row.path) : Rectangle {
                    // 浮层几何：优先从名称列起点往右伸展，可越过「大小」列直到
                    // 视口右边界（占满整行）；右边塞不下完整文件名时整体左移，
                    // 覆盖本行的图标列，仍保证「最长占整行」。
                    // 视口右边缘（相对行左）：横向未滚到底时 parent.width
                    // 是整个内容宽，直接拿来定浮层右界会被 Flickable 裁掉。
                    property <length> row-right: max(120px, min(parent.width, flick.width - flick.content-x) - 4px);
                    // 视口左边缘（相对行左）：横向滚到右边时为正値，浮层不能往左
                    // 越过它，否则左边会被列表左边缘裁掉（只有 0px 下限是不够的）。
                    property <length> row-left: max(0px, -flick.content-x + 4px);
                    property <length> wanted: max(80px, rename-measure-details.preferred-width + 18px);
                    property <length> box-w: min(self.wanted, self.row-right - self.row-left);
                    property <length> box-x: (root.col-name-x + self.box-w <= self.row-right)
                        ? max(self.row-left, root.col-name-x)
                        : max(self.row-left, self.row-right - self.box-w);
                    x: self.box-x;
                    y: 0px;
                    width: self.box-w;
                    height: parent.height;
                    z: 10;
                    border-radius: 4px;
                    background: Theme.bg-input;
                    border-width: 1.5px;
                    border-color: Theme.accent;
                    drop-shadow-blur: 8px;
                    drop-shadow-color: #00000022;
                    drop-shadow-offset-y: 2px;

                    rename-measure-details := Text {
                        visible: false;
                        text: root.rename-text;
                        font-size: 13px;
                        wrap: no-wrap;
                    }

                    rename-input-details := SingleLineEdit {
                    mouse-pressed: root.mouse-left-pressed;
                    x: 6px;
                    width: parent.width - 12px;
                    height: parent.height;
                    text <=> root.rename-text;
                    // 核心修复：必须显式指定颜色，否则沿用主题默认白字 —— 在白底上就看不见了。
                    text-color: Theme.text-primary;
                    font-size: 13px;
                    selection-background: Theme.accent;
                    selection-foreground: Theme.accent-text;

                    init => {
                        // init 里不调 focus()：此时元素刚创建、几何未定，Slint 收到焦点事件会
                        // 调 Flickable 的 reveal 把“焦点元素”滚进视野，且用的是未定几何 ——
                        // 实测把滚动位置从底部 180 直接推到 55（滚动条自己往上跳，
                        // 连带把行模型推出可见窗口 → 重建 → 输入框被销毁 → 焦点丢失）。
                        // 统一改由下面的定时器拽，那里已能同步抵消 reveal。
                        root.rename-text = row.name;
                        root.rename-dbg("init", self.has-focus);
                    }

                    focus-changed(has) => {
                        root.rename-dbg("focus-changed", has);
                    }

                    // 延迟一拍再抢焦点（同步抵消 Slint 的自动 reveal）。
                    // 为何用定时器：init 阶段 focus() 会被同帧焦点重算覆盖；且模型重建会
                    // 得到全新实例，旧实例的焦点随之丢。`changed` 写不了限定名（
                    // `changed root.x` 语法错误），而 `if`/`for` 内元素 id 无法从外部访问，
                    // 定时器是唯一可靠的跨帧触发点。
                    rename-focus := Timer {
                        interval: 60ms;
                        running: true;
                        triggered => {
                            self.running = false;
                            // 核心修复：必须限定“当前确实在使用本输入框的视图”。
                            // `visible: !is-icons-view` 只影响渲染，不阻止元素实例化 ——
                            // 图标视图的重命名输入框在详细视图下同样会被创建，它们
                            // 的定时器也会 focus()，最后一个赢 → 焦点被抢到不可见的
                            // 图标输入框上（表现为“没全选、打不了字”）。实测日志：
                            //   kind=timer has_focus=true → 8ms 后 kind=icon2-timer
                            //   → kind=focus-changed has_focus=false。
                            if (root.rename-path == row.path && !root.is-icons-view) {
                                // 必须先 focus 再 select-all：获得焦点会把光标重置到文末。
                                let keep-y = flick.content-y;
                                rename-input-details.focus-input();
                                if (root.rename-select-end > 0) {
                                    rename-input-details.select-range(0, root.rename-select-end);
                                } else {
                                    rename-input-details.select-all-text();
                                }
                                // focus() 会触发 Slint 的自动 reveal 把滚动位置推走，
                                // 这里立刻恢复，抵消那次自动滚动（同步，无闪烁）。
                                flick.content-y = keep-y;
                                root.rename-dbg("timer", rename-input-details.has-focus);
                            }
                        }
                    }

                    // 250ms 后再报一次，确认 focus 是否被后续处理抢走。
                    rename-focus-late := Timer {
                        interval: 250ms;
                        running: true;
                        triggered => {
                            self.running = false;
                            if (root.rename-path == row.path && !root.is-icons-view) {
                                root.rename-dbg("late", rename-input-details.has-focus);
                            }
                        }
                    }

                    edited(t) => {
                        root.rename-text = t;
                        root.rename-text-changed(t);
                    }

                    accepted(t) => {
                        root.rename-text = t;
                        root.rename-committed(row.path, t);
                    }

                    key-pressed(event) => {
                        if (event.text == Key.Escape) {
                            root.rename-cancelled();
                            return EventResult.accept;
                        }
                        return EventResult.reject;
                    }
                    }
                }

                // 名称(普通):无高亮查询时的默认渲染,保持 elide。
                if (root.rename-path != row.path && row.name-parts.length == 0) : Text {
                    x: root.col-name-x;
                    width: root.col-name-w;
                    height: parent.height;
                    text: row.name;
                    color: Theme.text-primary;
                    font-size: 13px;
                    font-weight: row.is-dir ? 500 : 400;
                    vertical-alignment: center;
                    overflow: elide;
                    // 剪切态文件整体淡出。
                    opacity: row.cut ? 0.45 : (row.is-hidden ? 0.5 : 1.0);
                }
                // 名称(搜索命中高亮):命中片段用强调色。
                if (root.rename-path != row.path && row.name-parts.length > 0) : HighlightName {
                    x: root.col-name-x;
                    width: root.col-name-w;
                    height: parent.height;
                    parts: row.name-parts;
                    font-size: 13px;
                    is-dir: row.is-dir;
                    opacity: row.cut ? 0.45 : (row.is-hidden ? 0.5 : 1.0);
                }

                // 名称截断浮层：单选时（选中或鼠标悬停）展示完整文件名。
                // 多选一律不弹，避免框选后满屏浮层互相遮挡。
                // 截断判定分两路，务必与**行内实际渲染**同源：
                //  · 说明：判定必须与行内实际渲染**实测同源**，不能依赖
                //    Rust 的 row.name-truncated —— 那是 grid_display_lines
                //    用「ASCII 7px / 非 ASCII 13px」字符宽估算的结果，遇到
                //    ✿ ⭐ ❤️ 这类回退字体符号会低估实际宽度：行内已被
                //    elide 截断扩展名，估算却认为放得下，浮层就不弹。
                //    实测过 parts=3 / trunc_flag=0 / measure=375 / col=350
                //    正是这种情形。因此统一用 name-measure-details 实测宽度，
                //    row.name-truncated 只当兜底（两者任一成立就弹）。
                if (name-overlay-shown) : Rectangle {
                    // 视口右边缘（相对行左），理由同重命名浮层。
                    property <length> row-right: max(120px, min(parent.width, flick.width - flick.content-x) - 4px);
                    property <length> row-left: max(0px, -flick.content-x + 4px);
                    property <length> wanted: max(80px, name-measure-details.preferred-width + 16px);
                    property <length> box-w: min(self.wanted, self.row-right - self.row-left);
                    // 右边还有空间 → 从名称列起点往右伸展、越过「大小」列占满整行；
                    // 塞不下 → 整体左移覆盖自己的图标，仍保证 longest = 整行。
                    property <length> box-x: (root.col-name-x + self.box-w <= self.row-right)
                        ? max(self.row-left, root.col-name-x)
                        : max(self.row-left, self.row-right - self.box-w);
                    x: self.box-x;
                    y: 0px;
                    width: self.box-w;
                    height: parent.height;
                    z: 20;
                    border-radius: 4px;
                    background: Theme.bg-popup;
                    border-width: 1px;
                    border-color: Theme.border;
                    drop-shadow-blur: 8px;
                    drop-shadow-color: #00000022;
                    drop-shadow-offset-y: 2px;
                    // 纯文字（无搜索查询）：浮层宽度已按完整名算，无需再 elide。
                    if (row.tip-parts.length == 0) : Text {
                        x: 6px;
                        width: parent.width - 12px;
                        height: parent.height;
                        text: row.name;
                        color: Theme.text-primary;
                        font-size: 13px;
                        font-weight: row.is-dir ? 500 : 400;
                        vertical-alignment: center;
                    }
                    // 搜索态：用**未截断**的完整高亮分段，浮层才不会把省略号带进来。
                    if (row.tip-parts.length > 0) : HighlightName {
                        x: 6px;
                        width: parent.width - 12px;
                        height: parent.height;
                        parts: row.tip-parts;
                        font-size: 13px;
                        is-dir: row.is-dir;
                    }
                }

                // 修改时间（此电脑视图整列不存在）
                Rectangle {
                    visible: root.view-mode == "details" && !root.is-computer-view;
                    x: root.col-modified-x;
                    y: 0px;
                    width: root.w-modified;
                    height: parent.height;

                    Text {
                        x: 12px;
                        width: parent.width - 18px;
                        height: parent.height;
                        text: row.modified-text;
                        color: Theme.text-secondary;
                        font-size: 12px;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }

                // 类型徽标
                Rectangle {
                    visible: root.view-mode == "details";
                    x: root.col-type-x;
                    y: 0px;
                    width: root.w-type;
                    height: parent.height;

                    Rectangle {
                        x: 12px;
                        y: (parent.height - 18px) / 2;
                        width: min(badge-text.preferred-width + 14px, parent.width - 16px);
                        height: 18px;
                        border-radius: 4px;
                        background: row.icon-color.transparentize(row.is-dir ? 0.86 : 0.88);

                        badge-text := Text {
                            text: row.type-text;
                            color: row.icon-color;
                            font-size: 11px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            width: 100%;
                            height: 100%;
                            overflow: elide;
                        }
                    }
                }

                // 大小（左对齐，与表头一致）
                Rectangle {
                    visible: root.view-mode == "details";
                    x: root.col-size-x;
                    y: 0px;
                    width: root.w-size;
                    height: parent.height;

                    Text {
                        x: 12px;
                        width: parent.width - 18px;
                        height: parent.height;
                        text: row.size-text;
                        color: Theme.text-secondary;
                        font-size: 12px;
                        vertical-alignment: center;
                        overflow: elide;
                        font-family: Theme.mono-font-family;
                    }
                }

                // 路径（仅回收站显示，见 show-path-column）
                Rectangle {
                    visible: root.view-mode == "details" && root.show-path-column;
                    x: root.col-path-x;
                    y: 0px;
                    width: root.col-path-w;
                    height: parent.height;

                    Text {
                        x: 12px;
                        width: parent.width - 18px;
                        height: parent.height;
                        text: row.path;
                        color: Theme.text-secondary;
                        font-size: 12px;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }
            }

            // ---- 图标网格（icons-* 视图）：单元格 = 缩略图 + 名称 ----
            for row[i] in root.rows : Rectangle {
                visible: root.is-icons-view;
                x: root.cell-x(Math.mod(row.index, root.cells-per-row));
                y: floor(row.index / root.cells-per-row) * root.cell-h + 4px;
                width: root.item-w;
                height: root.cell-h - 8px;
                // 小图标的名称浮层会往右伸出格子；z 只在同一父级里排序，
                // 所以要把「整个格子」抬到邻居之上，浮层才不会被右邻盖住。
                z: (root.rename-path == row.path || row.selected || ta-icons.has-hover) ? 10 : 0;
                border-radius: 8px;
                // 拖拽悬停到文件夹：显示醒目的选中色 + 强调色高亮边框；悬停到普通文件显示弱悬停底色
                background: (row.index == root.drop-hover-index && row.is-dir) || row.selected
                    ? Theme.bg-selected
                    : (row.index == root.drop-hover-index ? Theme.bg-hover : (ta-icons.has-hover ? Theme.bg-hover : transparent));
                border-width: (row.index == root.drop-hover-index && row.is-dir) ? 2.5px : (row.index == root.drop-hover-index ? 1px : 0px);
                border-color: (row.index == root.drop-hover-index && row.is-dir) ? Theme.accent : Theme.border;

                ta-icons := TouchArea {
                    width: 100%;
                    height: 100%;

                    changed has-hover => {
                        root.hover-row(self.has-hover ? row.index : -1);
                    }

                    scroll-event(event) => {
                    // Ctrl+滚轮切视图：Rust 按住 Ctrl 时消费事件，列表不再滚动。
                    if (event.delta-y != 0px && root.wheel-view(event.delta-y)) { return EventResult.accept; }
                        // 仅横向可滚时把垂直滚轮折算成横向。
                        if (event.delta-y != 0px && root.min-content-y >= 0px && root.min-content-x < 0px) {
                            root.scroll-user-input();
                            flick.content-x = min(root.max-content-x, max(root.min-content-x, flick.content-x + event.delta-y));
                            return EventResult.accept;
                        }
                        if (event.delta-y != 0px) {
                            root.scroll-user-input();
                            flick.content-y = min(root.max-content-y, max(root.min-content-y, flick.content-y + event.delta-y));
                            root.scroll-changed(-flick.content-y);
                            return EventResult.accept;
                        }
                        if (event.delta-x != 0px) {
                            flick.content-x = min(root.max-content-x, max(root.min-content-x, flick.content-x + event.delta-x));
                            return EventResult.accept;
                        }
                        return EventResult.reject;
                    }

                    double-clicked => {
                        if (root.rename-path != row.path) {
                            root.row-double-clicked(row.index);
                        }
                    }

                    pointer-event(event) => {
                        // 核心修复：本单元正在重命名时拒绝指针事件，让点击穿透到 TextInput。
                        // 不能禁用整个 TouchArea，否则 scroll-event 也会失效、滚轮卡死。
                        //
                        // 例外：点“自己的图标/格子里的空白”= 提交重命名（与资源管理器一致）。
                        // 浮层输入框在上面一层，落在它范围内的点击会被输入框吃掉，
                        // 能走到这里的就只剩图标和格子空白。
                        if (root.rename-path == row.path) {
                            if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                                root.commit-rename();
                            }
                            return EventResult.reject;
                        }
                        // 点击到另一个单元也算“点击其他位置”：先按已输入文本提交重命名。
                        if (root.rename-path != "" && event.kind == PointerEventKind.down) {
                            root.commit-rename();
                        }
                        // 核心修复：视口Y = 行的内容绝对Y + 鼠标在行内偏移 + 滚动偏移(加上负值) + 表头高度。
                        // flick.content-y 是负值（向下滚动为负），加它即把内容坐标折算回视口坐标。
                        let header-h = root.view-mode == "details" ? 30px : 0px;
                        let viewport_y = floor(row.index / root.cells-per-row) * root.cell-h + 4px + self.mouse-y + flick.content-y + header-h;
                        // 「单选后再点文件名重命名」在图标视图也生效：按落点判定是否点在名称区
                        // —— 中/大/超大图标竖排（缩略图在上、名在下）：y 越过缩略图高度即名称区；
                        // 小图标横排（图标左、名右）：x 越过 50px 即名称区。
                        // 注意：不能像详情视图那样再发一次 clicked，否则一次点击会触发两次 down，
                        // 后一次被 Rust 当成双击直接打开文件。
                        let is_small = root.view-mode == "icons-small";
                        let on_name = is_small ? self.mouse-x >= 50px : self.mouse-y >= root.cell-thumb;
                        root.row-pointer-event(row.index, event,
                            root.cell-x(Math.mod(row.index, root.cells-per-row)) + self.mouse-x,
                            viewport_y, on_name);
                        return EventResult.accept;
                    }
                }

                // 小图标：横排（图标左 + 名称右，垂直居中）。
                if (root.view-mode == "icons-small") : HorizontalLayout {
                    x: 4px;
                    y: (parent.height - 44px) / 2;
                    width: parent.width - 8px;
                    height: 44px;
                    spacing: 6px;

                    Rectangle {
                        width: 44px;
                        border-radius: 6px;
                        background: transparent;

                        if (row.thumb.width > 0) : Image {
                            width: 100%;
                            height: 100%;
                            source: row.thumb;
                            image-fit: contain;
                        }
                        // 缩略图缺失（回收站 / 离线网络路径 / 系统图标过小）时，
                        // 与详细视图一样退回彩色扩展名角标，避免空白格子。
                        if (row.thumb.width <= 0) : Rectangle {
                            width: 100%;
                            height: 100%;
                            border-radius: 6px;
                            background: row.icon-color.transparentize(row.is-dir ? 0.82 : 0.84);

                            Text {
                                text: row.icon-text;
                                color: row.icon-color;
                                font-size: 11px;
                                font-weight: 700;
                                font-family: Theme.mono-font-family;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                                width: 100%;
                                height: 100%;
                            }
                        }
                    }

                    // 名称:搜索命中时高亮,否则普通 elide。
                    // 重命名时的输入框改由下面的「单行浮层」承载（不在布局里，
                    // 否则 HorizontalLayout 会把宽度锁死在格子内，无法往右伸展）。
                    if (root.rename-path != row.path && row.name-parts.length > 0) : HighlightName {
                        width: parent.width - 50px;
                        height: 44px;
                        parts: row.name-parts;
                        font-size: 12px;
                        is-dir: row.is-dir;
                    }
                    if (root.rename-path != row.path && row.name-parts.length == 0) : Text {
                        width: parent.width - 50px;
                        height: 44px;
                        text: row.name;
                        color: Theme.text-primary;
                        font-size: 12px;
                        font-weight: row.is-dir ? 500 : 400;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }

                // 小图标视图的完整名测量（判断截断 + 给浮层定宽）。
                name-measure-small := Text {
                    visible: false;
                    text: row.name;
                    font-size: 12px;
                    font-weight: row.is-dir ? 500 : 400;
                    wrap: no-wrap;
                }

                // 小图标：重命名单行浮层 + 截断展示浮层，共用的几何：
                //   · 起点 = 名称区左边界（图标 44px + spacing 6px）；
                //   · 优先往右伸展，最长占「整行」；
                //   · 右侧塞不下完整文件名时**整体往左伸展**，允许 x 为负、
                //     越过本格子左边界盖在左边的其他文件上，直到占满整行。
                //   · 浮层宽度 = min(完整名宽 + 内边距, 整行宽)，随文本伸展/收缩。
                // 用格子层级而不是布局层级，才能突破格子宽度盖住左右邻居；
                // 格子自身的 z 已在上面提升，因此负 x 的部分也在邻居之上。
                if (root.view-mode == "icons-small"
                    && (root.rename-path == row.path
                        || (!root.is-selecting
                            && (ta-icons.has-hover || (row.selected && root.single-selection))
                            // 与详细信息视图同款修正：row.name-truncated 是 Rust 的
                            // 字符宽估算（非 ASCII 一律按 13px），遇 ✿ ⭐ ❤️ 等
                            // 回退字体符号会低估宽度 → 行内已截断却不弹浮层。
                            // 行内名称文本框宽 = parent.width - 50px，用它做实测比较，
                            // 估算值只当兜底（任一成立就弹）。
                            && (row.name-truncated
                                || name-measure-small.preferred-width > parent.width - 50px)))) : Rectangle {
                    // 本格子左上角相对「整行」的可用区间：
                    //   row-left 可为负（列表最左边在本格子左侧时），
                    //   row-right 是格子左边到列表右边界的距离。
                    property <length> row-left: 4px - root.cell-x(Math.mod(row.index, root.cells-per-row));
                    property <length> row-right: max(120px,
                        root.width - root.cell-x(Math.mod(row.index, root.cells-per-row)) - 4px);
                    property <length> full-row-w: max(80px, self.row-right - self.row-left);
                    property <length> wanted: (root.rename-path == row.path)
                        ? max(60px, rename-measure-small.preferred-width + 18px)
                        : max(60px, name-measure-small.preferred-width + 16px);
                    // 上限改成整行宽（原来是 row-right-4px，等于禁止左伸展）。
                    property <length> box-w: min(self.wanted, self.full-row-w);
                    property <length> box-x: (50px + self.box-w <= self.row-right)
                        ? 50px
                        : max(self.row-left, self.row-right - self.box-w);

                    x: self.box-x;
                    y: (parent.height - 30px) / 2;
                    width: self.box-w;
                    height: 30px;
                    z: 20;
                    border-radius: 4px;
                    background: root.rename-path == row.path ? Theme.bg-input : Theme.bg-popup;
                    border-width: root.rename-path == row.path ? 1.5px : 1px;
                    border-color: root.rename-path == row.path ? Theme.accent : Theme.border;
                    drop-shadow-blur: 8px;
                    drop-shadow-color: #00000022;
                    drop-shadow-offset-y: 2px;

                    rename-measure-small := Text {
                        visible: false;
                        text: root.rename-text;
                        font-size: 12px;
                        wrap: no-wrap;
                    }

                    // 非重命名：展示完整文件名（搜索态保留命中高亮）。
                    if (root.rename-path != row.path && row.tip-parts.length == 0) : Text {
                        x: 6px;
                        width: parent.width - 12px;
                        height: parent.height;
                        text: row.name;
                        color: Theme.text-primary;
                        font-size: 12px;
                        font-weight: row.is-dir ? 500 : 400;
                        vertical-alignment: center;
                    }
                    if (root.rename-path != row.path && row.tip-parts.length > 0) : HighlightName {
                        x: 6px;
                        width: parent.width - 12px;
                        height: parent.height;
                        parts: row.tip-parts;
                        font-size: 12px;
                        is-dir: row.is-dir;
                    }

                    // 重命名：单行输入框（焦点/提交逻辑与之前一致，只是换了容器）。
                    if (root.rename-path == row.path) : rename-input-icon-small := SingleLineEdit {
                        mouse-pressed: root.mouse-left-pressed;
                        x: 6px;
                        width: parent.width - 12px;
                        height: parent.height;
                        text <=> root.rename-text;
                        text-color: Theme.text-primary;
                        font-size: 12px;
                        selection-background: Theme.accent;
                        selection-foreground: Theme.accent-text;

                        init => { root.rename-text = row.name; }

                        rename-focus-icon := Timer {
                            interval: 60ms;
                            running: true;
                            triggered => {
                                self.running = false;
                                if (root.rename-path == row.path && root.view-mode == "icons-small") {
                                    let keep-y = flick.content-y;
                                    rename-input-icon-small.focus-input();
                                    if (root.rename-select-end > 0) {
                                        rename-input-icon-small.select-range(0, root.rename-select-end);
                                    } else {
                                        rename-input-icon-small.select-all-text();
                                    }
                                    flick.content-y = keep-y;
                                    root.rename-dbg("icon-timer", rename-input-icon-small.has-focus);
                                }
                            }
                        }

                        edited(t) => {
                            root.rename-text = t;
                            root.rename-text-changed(t);
                        }
                        accepted(t) => {
                            root.rename-text = t;
                            root.rename-committed(row.path, t);
                        }
                        key-pressed(event) => {
                            if (event.text == Key.Escape) {
                                root.rename-cancelled();
                                return EventResult.accept;
                            }
                            return EventResult.reject;
                        }
                    }
                }

                // 中/大/超大图标：竖排（缩略图上 + 名称/大小下）。
                // 这里全部用**绝对定位**，不用 VerticalLayout：
                // 用布局时容量行会把自己的真实行高算进去，比预想的略高一点，
                // Slint 就会从名字那里扣掉几个像素，导致第 3 行被挤成省略号。
                // 绝对定位后名字区高度是写死的，谁也挤不掉。
                if (root.view-mode != "icons-small") : Rectangle {
                    x: 4px;
                    y: 4px;
                    width: parent.width - 8px;
                    height: parent.height - 8px;
                    background: transparent;

                    Rectangle {
                        x: 0px;
                        y: 0px;
                        width: 100%;
                        height: root.cell-thumb;
                        border-radius: 6px;
                        background: Theme.bg-input;
                        clip: true;

                        if (row.thumb.width > 0) : Image {
                            width: 100%;
                            height: 100%;
                            source: row.thumb;
                            image-fit: contain;
                        }
                        // 与详细/列表视图同一套兜底：拿不到缩略图时画居中的
                        // 彩色扩展名角标。回收站条目原路径已不存在，系统图标
                        // 降级又只有 32px，被尺寸门槛丢弃后就会走到这里。
                        if (row.thumb.width <= 0) : Rectangle {
                            x: (parent.width - min(72px, parent.width - 8px)) / 2;
                            y: (parent.height - min(72px, parent.height - 8px)) / 2;
                            width: min(72px, parent.width - 8px);
                            height: min(72px, parent.height - 8px);
                            border-radius: 10px;
                            background: row.icon-color.transparentize(row.is-dir ? 0.82 : 0.84);

                            Text {
                                text: row.icon-text;
                                color: row.icon-color;
                                font-size: 18px;
                                font-weight: 700;
                                font-family: Theme.mono-font-family;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                                width: 100%;
                                height: 100%;
                            }
                        }
                    }

                    // 名称区：高度写死 3 行。
                    // 重命名不在这里渲染：中/大/超大图标的重命名输入框统一放到
                    // 列表最上层的“展开名称层”（见文件末尾），因为行内元素
                    // 无法盖到下一行上面，而需求是允许盖住邻居。
                    // 名称区：Rust 已按格宽切好行、并保留搜索命中的高亮分段，
                    // 这里逐行渲染即可（搜索态与常态共用同一条路径）。
                    // 不用 Slint 的多行 Text / HighlightName：前者在 overflow:elide
                    // 时会被 ❀ 等符号的字体回退弄丢首行，后者是单行组件。
                    if (!root.row-expanded(row.index)) : Rectangle {
                        x: 0px;
                        y: root.cell-thumb + 3px;
                        width: 100%;
                        height: root.name-h;
                        clip: true;
                        background: transparent;

                        for line[i] in row.grid-lines : HorizontalLayout {
                            x: 0px;
                            y: i * root.line-h;
                            width: 100%;
                            height: root.line-h;
                            spacing: 0px;
                            alignment: center;

                            for part in line.parts : Text {
                                width: self.preferred-width;
                                height: 100%;
                                text: part.text;
                                color: part.hl ? Theme.accent : Theme.text-primary;
                                font-size: 11.5px;
                                font-weight: row.is-dir ? 500 : 400;
                                vertical-alignment: top;
                            }
                        }
                    }

                    // 容量行：紧跟在名字区下面（被浮层接管的那一行不画，避免漏底）。
                    if (row.size-text != "" && !root.row-expanded(row.index)) : Text {
                        x: 0px;
                        y: root.cell-thumb + 4px + root.name-h;
                        width: 100%;
                        height: root.size-line-h + 4px;
                        text: row.size-text;
                        color: Theme.text-secondary;
                        font-size: 11px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        overflow: elide;
                        font-family: Theme.mono-font-family;
                    }
                }

                // 剪切态淡出。
                opacity: row.cut ? 0.45 : (row.is-hidden ? 0.5 : 1.0);
            }

            // ---- 框选视觉层（不需要 TouchArea 拦截） ----
            if (root.is-selecting) : Rectangle {
                // 必须高于图标格子的 z（含名称浮层的格子会抬到 10，浮层自身 20），
                // 否则框选方框被图标盖在下面，验收时看起来「框选没了」。
                z: 40;
                x: min(root.sel-x1, root.sel-x2);
                y: min(root.sel-y1, root.sel-y2);
                width: abs(root.sel-x1 - root.sel-x2);
                height: abs(root.sel-y1 - root.sel-y2);
                // 像原生一样淡雅（透明度 0.88 的强调色）
                background: Theme.accent.transparentize(0.88);
                border-width: 1px;
                border-color: Theme.accent;
            }
        }
    }

    // ---- 自绘横向滚动条（仅在详细/列表视图溢出时出现，图标视图永久禁用） ----
    hscrollbar := Rectangle {
    x: 2px;
    y: parent.height - self.height - 2px;
    width: parent.width - (scrollbar.visible ? 10px : 0px) - 4px;
    height: 8px;
    visible: !root.is-icons-view && flick.content-width > flick.width + 1px;

        property <length> track-w: self.width;
        property <length> thumb-w: max(32px, min(self.track-w, self.track-w * flick.width / max(flick.content-width, 1px)));
        // 核心修复：行程为 track-w - thumb-w，避免溢出
        property <length> thumb-x: (self.track-w - self.thumb-w) * (-flick.content-x / max(flick.content-width - flick.width, 1px));

        hthumb := Rectangle {
            x: min(hscrollbar.track-w - hscrollbar.thumb-w, max(0px, hscrollbar.thumb-x));
            y: parent.height - self.height;
            width: hscrollbar.thumb-w;
            height: (hscrollbar-ta.has-hover || hscrollbar-ta.pressed) ? 6px : 4px;
            border-radius: self.height / 2;
            background: hscrollbar-ta.pressed
                ? Theme.text-primary.transparentize(0.35)
                : (hscrollbar-ta.has-hover ? Theme.text-primary.transparentize(0.5) : Theme.text-primary.transparentize(0.72));

            animate height, background { duration: 150ms; easing: ease-out; }
        }

        hscrollbar-ta := TouchArea {
            width: 100%;
            height: 100%;

            pointer-event(event) => {
                if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                    hsb-drag-start-thumb-x = min(hscrollbar.track-w - hscrollbar.thumb-w, max(0px, hscrollbar.thumb-x));
                    // 记下按下时的鼠标 x：拖拽位移 = 当前 mouse-x - 起始 mouse-x。
                    // 之前直接把「当前 mouse-x + 起始滑块位置」当目标位置，
                    // 于是滑块在最右端时按下再往左拖，目标仍被顶在最右 → 无法回拖。
                    hsb-drag-start-mouse-x = self.mouse-x;
                }
            }

            moved => {
                if (self.pressed) {
                    let target = hsb-drag-start-thumb-x + (self.mouse-x - hsb-drag-start-mouse-x);
                    let ratio = target / max(hscrollbar.track-w - hscrollbar.thumb-w, 1px);
                    flick.content-x = max(root.min-content-x, min(root.max-content-x, -ratio * (flick.content-width - flick.width)));
                }
            }
        }
    }

    // ---- 自绘垂直滚动条（现代浮动呼吸胶囊，绝不消失） ----
    scrollbar := Rectangle {
        x: parent.width - self.width - 2px;
        // 核心修复：轨道必须精确覆盖 Flickable 视口（即表头下沿到列表底部），
        // 不能用整个 root 高度。否则轨道顶部伸进 30px 表头区，
        // 滑块在顶部时压住表头、且滑块长度按多 30px 的轨道换算而偏长。
        y: flick.y + 2px;
        width: 8px;
        height: flick.height - 4px;
        visible: flick.content-height > flick.height + 1px;
        changed visible => { root.sb-debug(root.sb-debug-info()); }

        property <length> track-h: self.height;
        property <length> thumb-h: max(32px, min(self.track-h, self.track-h * flick.height / max(flick.content-height, 1px)));
        // 核心修复：行程为 track-h - thumb-h，滑块滚到底部时严丝合缝贴底，绝不再消失！
        property <length> thumb-y: (self.track-h - self.thumb-h) * (-flick.content-y / max(flick.content-height - flick.height, 1px));

        thumb := Rectangle {
            x: parent.width - self.width;
            y: min(scrollbar.track-h - scrollbar.thumb-h, max(0px, scrollbar.thumb-y));
            width: (scrollbar-ta.has-hover || scrollbar-ta.pressed) ? 6px : 4px;
            height: scrollbar.thumb-h;
            border-radius: self.width / 2;
            background: scrollbar-ta.pressed
                ? Theme.text-primary.transparentize(0.35)
                : (scrollbar-ta.has-hover ? Theme.text-primary.transparentize(0.5) : Theme.text-primary.transparentize(0.72));

            animate width, background { duration: 150ms; easing: ease-out; }
        }

        scrollbar-ta := TouchArea {
            width: 100%;
            height: 100%;

            pointer-event(event) => {
                if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                    // 精准记录按下时鼠标相对于滑块顶部的距离
                    root.sb-drag-grab-y = self.mouse-y - min(scrollbar.track-h - scrollbar.thumb-h, max(0px, scrollbar.thumb-y));
                }
            }

            moved => {
                if (self.pressed) {
                    root.scroll-user-input();
                    let max-travel = max(scrollbar.track-h - scrollbar.thumb-h, 1px);
                    let target-y = self.mouse-y - root.sb-drag-grab-y;
                    let ratio = max(0.0, min(1.0, target-y / max-travel));
                    let offset = -ratio * (flick.content-height - flick.height);
                    flick.content-y = max(root.min-content-y, min(root.max-content-y, offset));
                    root.scroll-changed(-flick.content-y);
                }
            }

            scroll-event(event) => {
                    // Ctrl+滚轮切视图：Rust 按住 Ctrl 时消费事件，列表不再滚动。
                    if (event.delta-y != 0px && root.wheel-view(event.delta-y)) { return EventResult.accept; }
                // 只有横向滚动条时，鼠标停在纵向滚动条区域滚轮也要能横滚。
                if (event.delta-y != 0px && root.min-content-y >= 0px && root.min-content-x < 0px) {
                    root.scroll-user-input();
                    flick.content-x = min(root.max-content-x, max(root.min-content-x, flick.content-x + event.delta-y));
                    return EventResult.accept;
                }
                if (event.delta-y != 0px) {
                    root.scroll-user-input();
                    flick.content-y = min(root.max-content-y, max(root.min-content-y, flick.content-y + event.delta-y));
                    root.scroll-changed(-flick.content-y);
                    return EventResult.accept;
                }
                if (event.delta-x != 0px) {
                    flick.content-x = min(root.max-content-x, max(root.min-content-x, flick.content-x + event.delta-x));
                    return EventResult.accept;
                }
                return EventResult.reject;
            }
        }
    }

    // ---- 空目录 / 加载占位 ----
    if (root.loading) : Rectangle {
        x: 0px;
        y: 0px;
        width: 100%;
        height: 100%;
        background: Theme.bg-list;

        Text {
            text: I18n.strings[60];
            color: Theme.text-secondary;
            font-size: 13px;
            horizontal-alignment: center;
            vertical-alignment: center;
            width: 100%;
            height: 100%;
        }
    }
    if (!root.loading && root.total-count == 0) : Rectangle {
        x: 0px;
        y: 0px;
        width: 100%;
        height: 100%;
        background: Theme.bg-list;

        VerticalLayout {
            alignment: center;
            spacing: 8px;
            width: 100%;

            Text {
                text: I18n.strings[61];
                color: Theme.text-secondary;
                font-size: 14px;
                horizontal-alignment: center;
            }
        }
    }

    // ---- 展开名称层（单个选中 / 重命名）----
    //
    // 为什么必须画在这里：网格里的每一行是 Flickable 的**同级**元素，
    // 行内的浮层只能盖住自己所在的那一行（z 只在同一父级里排序）。
    // 放到整个 FileList 的最上层，才能盖住左右邻居、并突破格子宽度。
    //
    // 两种状态：
    //   · 只是“选中一个” → 纯文字，没有任何 TouchArea，鼠标穿透（双击/拖拽照常）；
    //   · “重命名中” → 里面放多行输入框，可以正常打字。
    if (root.expand-active) : Rectangle {
        x: root.ex-box-x;
        y: root.ex-box-y;
        width: root.ex-box-w;
        height: root.ex-box-h;
        border-radius: 6px;
        background: Theme.bg-input;
        border-width: root.rename-path != "" ? 1.5px : 1px;
        border-color: root.rename-path != "" ? Theme.accent : Theme.border;
        // 轻微阴影，让它看起来“浮”在格子上
        drop-shadow-blur: 8px;
        drop-shadow-color: #00000022;
        drop-shadow-offset-y: 2px;

        if (root.rename-path != "") : rename-input-expand := TextInput {
            x: 4px;
            y: 6px;
            width: parent.width - 8px;
            height: parent.height - 12px;
            text <=> root.rename-text;
            edited => {
                root.rename-text-changed(self.text);
            }
            color: Theme.text-primary;
            font-size: 11.5px;
            horizontal-alignment: center;
            vertical-alignment: top;
            single-line: false;
            wrap: char-wrap;
            selection-background-color: Theme.accent;
            selection-foreground-color: Theme.accent-text;

            // 多行模式下回车会被当成换行；改用 key-pressed 提前拦下当作“提交”。
            key-pressed(event) => {
                if (event.text == Key.Return) {
                    root.rename-committed(root.rename-path, root.rename-text);
                    return EventResult.accept;
                }
                if (event.text == Key.Escape) {
                    root.rename-cancelled();
                    return EventResult.accept;
                }
                return EventResult.reject;
            }

            // 延迟一拍再抢焦点：输入框刚创建时 Slint 还会再布局一次。
            // 本层不在 Flickable 内部，focus() 不会把列表滚动位置推走。
            Timer {
                interval: 60ms;
                running: true;
                triggered => {
                    self.running = false;
                    if (root.rename-path != "") {
                        rename-input-expand.focus();
                        if (root.rename-select-end > 0) {
                            rename-input-expand.set-selection-offsets(0, root.rename-select-end);
                        } else {
                            rename-input-expand.select-all();
                        }
                        root.rename-dbg("expand-timer", rename-input-expand.has-focus);
                    }
                }
            }
        }
        // 单独选中时的纯文字浮层：按 Rust 切好的行渲染，命中片段照常高亮。
        // 不用单个 Text：富文本高亮必须拆成多个 Text，而多行 Text 在 elide
        // 模式下会因 ❀ 等符号的字体回退把首行整行裁掉。
        // `rename-path == ""` 与行无关，提到外层只判一次（原先每个行实例都判）。
        if (root.rename-path == "") : Rectangle {
            x: 4px;
            y: 6px;
            width: parent.width - 8px;
            height: parent.height - 12px;
            background: transparent;

            for line[i] in root.expand-lines : HorizontalLayout {
                x: 0px;
                y: i * root.line-h;
                width: 100%;
                height: root.line-h;
                spacing: 0px;
                alignment: center;

                for part in line.parts : Text {
                    width: self.preferred-width;
                    height: 100%;
                    text: part.text;
                    color: part.hl ? Theme.accent : Theme.text-primary;
                    font-size: 11.5px;
                    vertical-alignment: top;
                }
            }

            // 单选后再次点击这个文件名浮层 → 进入重命名（Rust 侧复核仍为单选）。
            TouchArea {
                width: 100%;
                height: 100%;
                // 防闪烁：浮层是后声明的同级元素、盖住了名称区，鼠标下移到
                // 文件名上时格子自己的 TouchArea 会收到 has-hover=false，
                // 于是浮层消失 → 鼠标又落回格子 → 浮层再出现，来回抖。
                // 把「鼠标在浮层上」单独上报给 Rust，由它在这次期间不把
                // 悬停索引清成 -1（与事件到达先后无关，比重新钉索引可靠）。
                changed has-hover => {
                    root.overlay-hover(self.has-hover);
                }
                clicked => { root.name-overlay-clicked(); }
            }
        }
    }

    // ---- 悬停名称浮层（与选中/重命名浮层完全独立）----
    //
    // 为什么需要独立一层：`expand-index` 只能装一个值。选中一个文件后再悬停
    // 另一个被截断的文件时，两者都要显示完整名，一层装不下，轮用同一个
    // 索引就会“你出现我就消失”，鼠标一动两层互相顶掉，表现为两个浮层闪烁。
    if (root.hover-expand-active) : Rectangle {
        x: root.hv-box-x;
        y: root.hv-box-y;
        width: root.hv-box-w;
        height: root.hv-box-h;
        border-radius: 6px;
        background: Theme.bg-input;
        border-width: 1px;
        border-color: Theme.border;
        drop-shadow-blur: 8px;
        drop-shadow-color: #00000022;
        drop-shadow-offset-y: 2px;

        Rectangle {
            x: 4px;
            y: 6px;
            width: parent.width - 8px;
            height: parent.height - 12px;
            background: transparent;

            for line[i] in root.hover-expand-lines : HorizontalLayout {
                x: 0px;
                y: i * root.line-h;
                width: 100%;
                height: root.line-h;
                spacing: 0px;
                alignment: center;

                for part in line.parts : Text {
                    width: self.preferred-width;
                    height: 100%;
                    text: part.text;
                    color: part.hl ? Theme.accent : Theme.text-primary;
                    font-size: 11.5px;
                    vertical-alignment: top;
                }
            }

            // 悬停浮层同样可以被点击：单击选中该文件。
            TouchArea {
                width: 100%;
                height: 100%;
                changed has-hover => {
                    root.overlay-hover(self.has-hover);
                }
                clicked => { root.name-overlay-clicked(); }
            }
        }
    }
}

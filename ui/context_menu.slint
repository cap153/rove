import { Theme } from "common.slint";

// 右键菜单数据项。kind = "separator" 时为分隔线，"submenu" 时右侧显示箭头。
export struct MenuItem {
    id: string,
    label: string,
    icon-text: string,
    icon-color: color,
    kind: string,
    enabled: bool,
}

// 单行菜单项（供主菜单与子菜单复用）。
// 分隔行高 9px（与 Rust 侧高度计算一致），并绘制居中分隔线。
component MenuRow inherits Rectangle {
    in property <MenuItem> item;
    in property <bool> highlighted;
    callback triggered(id: string);
    callback hovered(entered: bool);

    height: root.item.kind == "separator" ? 9px : 28px;
    background: root.highlighted && root.item.kind != "separator" ? Theme.bg-hover : transparent;
    opacity: root.item.enabled ? 1.0 : 0.45;

    if (root.item.kind == "separator") : Rectangle {
        x: 8px;
        y: (parent.height - 1px) / 2;
        width: parent.width - 16px;
        height: 1px;
        background: Theme.divider;
    }

    HorizontalLayout {
        x: 0px;
        y: 0px;
        width: 100%;
        height: parent.height;
        spacing: 8px;
        padding-left: 8px;
        padding-right: 8px;

        // 图标方块。
        if (root.item.icon-text != "") : Rectangle {
            width: 16px;
            height: 16px;
            y: (parent.height - 16px) / 2;
            border-radius: 4px;
            background: root.item.icon-color.transparentize(0.84);

            Text {
                text: root.item.icon-text;
                color: root.item.icon-color;
                font-size: 8.5px;
                font-weight: 700;
                horizontal-alignment: center;
                vertical-alignment: center;
                width: 100%;
                height: 100%;
            }
        }

        Text {
            text: root.item.label;
            color: root.item.kind == "danger" ? Theme.danger : Theme.text-primary;
            font-size: 12.5px;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }

        // 子菜单箭头。
        if (root.item.kind == "submenu") : Text {
            text: "›";
            color: Theme.text-secondary;
            font-size: 13px;
            vertical-alignment: center;
            width: 12px;
        }
    }

    TouchArea {
        width: 100%;
        height: 100%;
        enabled: root.item.enabled;

        clicked => {
            if (root.item.kind != "separator" && root.item.kind != "submenu") {
                root.triggered(root.item.id);
            }
        }

        // 悬停进入/离开：驱动子菜单展开与消失。
        pointer-event(event) => {
            if (event.kind == PointerEventKind.move) {
                root.hovered(true);
            }
        }
    }
}

// 自绘上下文菜单弹层。位置（menu-x/menu-y）由外层（MainWindow）负责钳制到
// 窗口边界内；高度由 Rust 构建模型时一并给出。
export component ContextMenu inherits Rectangle {
    in-out property <[MenuItem]> items: [];
    in-out property <length> items-height: 0px;
    in-out property <int> hover-index: -1;

    callback item_triggered(id: string);
    callback submenu_hovered(index: int, entered: bool);
    callback dismiss_requested();

    width: 224px;
    // items-height 已含上下 4px 内边距（Rust 计算：行高和 + 8）。
    height: root.items-height;
    visible: root.items.length > 0;
    background: Theme.bg-popup;
    border-width: 1px;
    border-color: Theme.border;
    border-radius: 8px;
    z: 100;

    VerticalLayout {
        x: 0px;
        y: 0px;
        width: 100%;
        height: 100%;
        spacing: 0px;
        padding-top: 4px;
        padding-bottom: 4px;
        padding-left: 4px;
        padding-right: 4px;

        for item[i] in root.items : MenuRow {
            width: parent.width;
            item: item;
            highlighted: root.hover-index == i;
            triggered(id) => {
                root.item_triggered(id);
            }
            hovered(entered) => {
                if (entered && root.hover-index != i) {
                    root.hover-index = i;
                    if (item.kind == "submenu") {
                        root.submenu_hovered(i, true);
                    } else {
                        root.submenu_hovered(-1, true);
                    }
                }
            }
        }
    }
}

// 二级菜单弹层（仅一层，满足「发送到」等场景）。
export component SubMenuPopover inherits Rectangle {
    in-out property <[MenuItem]> items: [];
    in-out property <length> items-height: 0px;
    in-out property <int> hover-index: -1;

    callback item_triggered(id: string);

    width: 200px;
    height: root.items-height;
    visible: root.items.length > 0;
    background: Theme.bg-popup;
    border-width: 1px;
    border-color: Theme.border;
    border-radius: 8px;
    z: 110;

    VerticalLayout {
        x: 0px;
        y: 0px;
        width: 100%;
        height: 100%;
        spacing: 0px;
        padding-top: 4px;
        padding-bottom: 4px;
        padding-left: 4px;
        padding-right: 4px;

        for item[i] in root.items : MenuRow {
            width: parent.width;
            item: item;
            highlighted: root.hover-index == i;
            triggered(id) => {
                root.item_triggered(id);
            }
            hovered(entered) => {
                if (entered) {
                    root.hover-index = i;
                }
            }
        }
    }
}

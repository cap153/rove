import { I18n } from "i18n.slint";
// 设置页面（独立标签页）。
// 目前实现：左侧子导航 + 右侧「本地右键菜单」分组管理。

import { Theme, SettingsNavItem, SettingsActionGroup, SettingsActionItem, SettingsShortcutGroup, SettingsShortcutItem, SettingsDriveItem, IconRefresh, IconClose } from "common.slint";
import { SingleLineEdit } from "single_line_edit.slint";

component Toggle inherits Rectangle {
    /// 只读：由外部状态驱动。内部绝不能写这个属性 —— 一旦写，Slint 会打断
    /// 它和外部的绑定，之后开关就再也跟不上真实状态（表现为「点了设置生效，
    /// 但右边的开关不动」）。
    in property <bool> checked: true;
    in property <bool> enabled: true;
    /// 点击：外部负责取反并回填状态。
    callback toggled();

    width: 36px;
    height: 20px;
    border-radius: 10px;
    background: root.checked ? Theme.accent : Theme.border;
    opacity: root.enabled ? 1.0 : 0.4;

    Rectangle {
        x: root.checked ? parent.width - self.width - 2px : 2px;
        y: (parent.height - self.height) / 2;
        width: 16px;
        height: 16px;
        border-radius: 8px;
        background: white;
    }

    TouchArea {
        width: 100%;
        height: 100%;
        enabled: root.enabled;
        clicked => {
            root.toggled();
        }
    }
}

// 驱动器图标：纯矢量绘制（盘体 + 指示灯），不依赖字体字形。
component SettingRow inherits Rectangle {
    in property <SettingsActionItem> item;
    callback toggled(id: string, enabled: bool);
    callback edit(id: string);
    callback delete(id: string);

    height: 42px;
    background: row-ta.has-hover ? Theme.bg-hover : transparent;

    // 全行点击切换开关（编辑/删除按钮位于其上层，独立拦截不受影响）
    row-ta := TouchArea {
        width: 100%;
        height: 100%;
        clicked => {
            root.toggled(root.item.id, !root.item.enabled);
        }
    }

    HorizontalLayout {
        x: 16px;
        width: parent.width - 32px;
        height: parent.height;
        spacing: 12px;

        // 开关
        Toggle {
            y: (parent.height - self.height) / 2;
            checked: root.item.enabled;
            enabled: true;
            toggled => {
                root.toggled(root.item.id, !root.item.enabled);
            }
        }

        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 1px;

            Text {
                text: root.item.label;
                color: Theme.text-primary;
                font-size: 13px;
                overflow: elide;
            }

            Text {
                text: root.item.target + (root.item.extensions != "" ? " / " + root.item.extensions : "");
                color: Theme.text-secondary;
                font-size: 11px;
                overflow: elide;
            }
        }

        // 编辑按钮（仅自定义；builtin 行隐藏）。
        // 用文字而非 ✎/✕ 字形：部分系统字体缺这两个符号，会渲染成空白。
        Rectangle {
            visible: !root.item.builtin;
            width: 44px;
            height: 26px;
            y: (parent.height - self.height) / 2;
            border-radius: 6px;
            border-width: 1px;
            border-color: Theme.border;
            background: edit-ta.has-hover ? Theme.bg-hover : transparent;

            Text {
                text: I18n.strings[72];
                color: Theme.text-secondary;
                font-size: 11px;
                horizontal-alignment: center;
                vertical-alignment: center;
                width: 100%;
                height: 100%;
            }

            edit-ta := TouchArea {
                width: 100%;
                height: 100%;
                clicked => {
                    root.edit(root.item.id);
                }
            }
        }

        // 删除按钮（仅自定义；builtin 行隐藏）。
        Rectangle {
            visible: !root.item.builtin;
            width: 44px;
            height: 26px;
            y: (parent.height - self.height) / 2;
            border-radius: 6px;
            border-width: 1px;
            border-color: Theme.border;
            background: del-ta.has-hover ? Theme.bg-hover : transparent;

            Text {
                text: I18n.strings[23];
                color: #C0392B;
                font-size: 11px;
                horizontal-alignment: center;
                vertical-alignment: center;
                width: 100%;
                height: 100%;
            }

            del-ta := TouchArea {
                width: 100%;
                height: 100%;
                clicked => {
                    root.delete(root.item.id);
                }
            }
        }
    }
}

component GroupCard inherits Rectangle {
    in property <SettingsActionGroup> group;
    callback toggled(id: string, enabled: bool);
    callback group_toggled(name: string, expanded: bool);
    callback edit(id: string);
    callback delete(id: string);

    height: root.group.expanded ? 44px + root.group.items.length * 42px : 44px;
    background: Theme.bg-input;
    border-radius: 8px;
    clip: true;

    VerticalLayout {
        width: 100%;

        Rectangle {
            height: 44px;

            HorizontalLayout {
                x: 16px;
                width: parent.width - 32px;
                height: parent.height;
                spacing: 8px;

                Text {
                    text: root.group.expanded ? "▼" : "▶";
                    color: Theme.text-secondary;
                    font-size: 9.5px;
                    // 显式指定符号字体：否则 Windows 字体回退会把 ▶(U+25B6)
                    // 解析成 Emoji（蓝底白字播放键），与 ▼ 风格严重不一致。
                    font-family: Theme.symbol-font-family;
                    vertical-alignment: center;
                    width: 14px;
                }

                Text {
                    text: root.group.name;
                    color: Theme.text-primary;
                    font-size: 13px;
                    font-weight: 500;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
            }

            TouchArea {
                width: 100%;
                height: 100%;
                clicked => {
                    root.group_toggled(root.group.name, !root.group.expanded);
                }
            }
        }

        Rectangle {
            height: root.group.expanded ? root.group.items.length * 42px : 0px;

            // 非布局父元素下的布局默认取首选宽度，必须显式撑满，
            // 否则行宽被压缩、右侧的编辑/删除按钮会被 clip 裁掉。
            VerticalLayout {
                width: 100%;
                spacing: 0px;

                for item in root.group.items : SettingRow {
                    item: item;
                    toggled(id, enabled) => {
                        root.toggled(id, enabled);
                    }
                    edit(id) => {
                        root.edit(id);
                    }
                    delete(id) => {
                        root.delete(id);
                    }
                }
            }
        }
    }
}

// 统一桌面级滚动容器（完全复刻 file_list.slint 的呼吸胶囊滚动条规范与定位）
component SettingsScrollContainer inherits Rectangle {
    in property <length> content-height;
    in-out property <length> content-y: 0px;

    vertical-stretch: 1;
    clip: true;

    // 记录按下时鼠标相对于滑块顶部的抓取偏移，消除拖拽跳动
    private property <length> sb-drag-grab-y: 0px;

    flick := Flickable {
        x: 0px;
        y: 0px;
        width: 100%;
        height: 100%;
        interactive: false; // 严禁触屏手势
        content-width: self.width;
        content-height: max(self.height, root.content-height);
        content-y <=> root.content-y;

        @children
    }

    // ---- 自绘垂直滚动条（完全移植自 file_list.slint，位置/尺寸/动画/色彩 100% 对齐） ----
    scrollbar := Rectangle {
        x: parent.width - self.width - 2px;
        y: 2px;
        width: 8px;
        height: parent.height - 4px;
        visible: flick.content-height > flick.height + 1px;

        property <length> track-h: self.height;
        property <length> thumb-h: max(32px, min(self.track-h, self.track-h * flick.height / max(flick.content-height, 1px)));
        property <length> thumb-y: (self.track-h - self.thumb-h) * (-flick.content-y / max(flick.content-height - flick.height, 1px));

        thumb := Rectangle {
            x: parent.width - self.width;
            y: min(scrollbar.track-h - scrollbar.thumb-h, max(0px, scrollbar.thumb-y));
            width: (scrollbar-ta.has-hover || scrollbar-ta.pressed) ? 6px : 4px;
            height: scrollbar.thumb-h;
            border-radius: self.width / 2;
            background: scrollbar-ta.pressed
                ? Theme.text-primary.transparentize(0.35)
                : (scrollbar-ta.has-hover ? Theme.text-primary.transparentize(0.5) : Theme.text-primary.transparentize(0.72));

            animate width, background { duration: 150ms; easing: ease-out; }
        }

        scrollbar-ta := TouchArea {
            width: 100%;
            height: 100%;

            pointer-event(event) => {
                if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                    root.sb-drag-grab-y = self.mouse-y - min(scrollbar.track-h - scrollbar.thumb-h, max(0px, scrollbar.thumb-y));
                }
            }

            moved => {
                if (self.pressed) {
                    let max-travel = max(scrollbar.track-h - scrollbar.thumb-h, 1px);
                    let target-y = self.mouse-y - root.sb-drag-grab-y;
                    let ratio = max(0.0, min(1.0, target-y / max-travel));
                    let offset = -ratio * (flick.content-height - flick.height);
                    flick.content-y = max(min(0px, flick.height - flick.content-height), min(0px, offset));
                }
            }

            scroll-event(event) => {
                if (event.delta-y != 0px) {
                    let min-y = min(0px, flick.height - flick.content-height);
                    flick.content-y = min(0px, max(min-y, flick.content-y + event.delta-y));
                    return EventResult.accept;
                }
                return EventResult.reject;
            }
        }
    }
}

// 通用设置里的下拉行：标题 + 当前值 + 展开的选项列表。
component ComboRow inherits Rectangle {
    in property <string> label: "";
    in property <[string]> options: [];
    in-out property <int> selected: 0;
    callback selection_changed(int);
    in-out property <bool> open: false;

    height: 58px;
    background: Theme.bg-input;
    border-radius: 8px;
    border-width: 1px;
    border-color: Theme.border;

    Text {
        x: 16px;
        y: 0px;
        width: parent.width - 240px;
        height: parent.height;
        text: root.label;
        color: Theme.text-primary;
        font-size: 13px;
        font-weight: 500;
        vertical-alignment: center;
        overflow: elide;
    }

    Rectangle {
        x: parent.width - 210px;
        y: 11px;
        width: 194px;
        height: 36px;
        background: Theme.bg-main;
        border-radius: 6px;
        border-width: 1px;
        border-color: Theme.border;

        Text {
            x: 10px;
            y: 0px;
            width: parent.width - 34px;
            height: parent.height;
            text: root.options[root.selected];
            color: Theme.text-primary;
            font-size: 12px;
            vertical-alignment: center;
            overflow: elide;
        }
        Text {
            x: parent.width - 20px;
            y: 0px;
            width: 16px;
            height: parent.height;
            text: root.open ? "▲" : "▼";
            color: Theme.text-secondary;
            font-size: 8px;
            vertical-alignment: center;
            horizontal-alignment: center;
        }
        TouchArea {
            width: 100%;
            height: 100%;
            clicked => { root.open = !root.open; }
        }
    }

    if (root.open) : Rectangle {
        x: parent.width - 210px;
        y: 48px;
        width: 194px;
        height: min(140px, root.options.length * 30px + 8px);
        background: Theme.bg-input;
        border-radius: 6px;
        border-width: 1px;
        border-color: Theme.border;
        z: 100;

        for opt[i] in root.options : Rectangle {
            x: 4px;
            y: 4px + i * 30px;
            width: parent.width - 8px;
            height: 30px;
            border-radius: 4px;
            background: i == root.selected ? Theme.bg-selected : (opt-ta.has-hover ? Theme.bg-hover : transparent);

            Text {
                x: 8px;
                y: 0px;
                width: parent.width - 16px;
                height: parent.height;
                text: opt;
                color: Theme.text-primary;
                font-size: 12px;
                vertical-alignment: center;
                overflow: elide;
            }
            opt-ta := TouchArea {
                width: 100%;
                height: 100%;
                clicked => {
                    root.selected = i;
                    root.open = false;
                    root.selection_changed(i);
                }
            }
        }
    }
}

export component SettingsPage inherits Rectangle {
    in property <[SettingsNavItem]> nav-items: [];
    in property <[SettingsActionGroup]> action-groups: [];
    in property <[SettingsShortcutGroup]> shortcut-groups: [];
    in property <string> recording-item-key: ""; // 正在录制的 item-key，如 "open:0"

    // 快捷键右键菜单状态
    property <bool> menu-open: false;
    property <string> menu-target-id: "";
    property <int> menu-target-slot: 0;
    property <bool> menu-target-custom: false;
    property <bool> menu-target-readonly: false;
    property <length> menu-x: 0px;
    property <length> menu-y: 0px;

    callback shortcut_record_clicked(string, int);      // id, slot
    callback shortcut_reset_clicked(string, int);       // id, slot
    callback shortcut_unbind_clicked(string, int);      // id, slot
    callback shortcut_add_alternate_clicked(string);    // id
    callback shortcut_remove_alternate_clicked(string, int); // id, slot
    callback shortcut_reset_all_clicked();
    // 当前子页的标题 / 描述 / 是否显示「新增动作」入口。
    in property <string> page-title: I18n.strings[59];
    in property <string> page-desc: I18n.strings[44];
    in property <bool> show-add: true;
    /// 是否显示隐藏文件（由 MainWindow 透传自 config）。
    in-out property <bool> show-hidden: false;
    /// 开关「显示隐藏项目」时触发（bool = 新的开关态）。
    callback show_hidden_toggled(bool);
    /// 鼠标左键是否按住（透传自主窗口）：输入框拖选贴边自动滚动用。
    in property <bool> mouse-pressed: false;
    /// 「新建标签时编辑地址栏」开关（透传自 config，默认关闭）。
    in-out property <bool> auto-edit-path-on-new-tab: false;
    callback auto_edit_path_on_new_tab_toggled(bool);
    /// 「接管资源管理器」开关（来自 config.explorer_takeover，默认关闭）。
    in-out property <bool> explorer-takeover: false;
    callback explorer_takeover_toggled(bool);
    /// 「开机自启动」开关（真源是注册表 Run 键，由 Rust 读实况下发）。
    in-out property <bool> autostart: false;
    callback autostart_toggled(bool);
    /// 显示语言：0 跟随系统 / 1 简体中文 / 2 English。
    in-out property <int> language-index: 0;
    callback language_changed(int);
    /// 启动时打开：0 上次的标签页(包括分屏) / 1 电脑选项。
    in-out property <int> startup-index: 0;
    callback startup_changed(int);

    // ---- 搜索与索引数据与回调 ----
    in property <bool> search-ready: true;
    in property <string> search-status-text: I18n.strings[71];
    in property <string> search-items-count: "0";
    in property <string> search-size-text: "0 MB";
    in property <int> search-drives-count: 0;
    in property <string> search-last-scan-time: I18n.strings[58];
    in property <[SettingsDriveItem]> search-drives: [];
    in property <[string]> search-builtin-exclusions: [];
    in property <[string]> search-custom-exclusions: [];
    in-out property <bool> search-idle-enabled: true;
    in-out property <int> search-idle-minutes: 60;
    in-out property <int> search-max-results: 1000;

    callback search_rescan_clicked();
    callback search_drive_toggled(string, bool); // letter, enabled
    callback search_add_exclusion_clicked();
    callback search_remove_exclusion_clicked(string); // path
    callback search_pick_folder_clicked();
    callback search_reset_exclusions_clicked();
    in-out property <string> exclude-input-text: "";

    // ---- 隐藏的系统右键菜单项（关键词）----
    in property <[string]> menu-hide-keywords: [];
    in-out property <string> hide-input-text: "";
    callback menu_hide_add_clicked();
    callback menu_hide_remove_clicked(string); // keyword
    callback menu_hide_restore_clicked();
    /// 设置页内有文本输入框持有键盘焦点。
    /// 用回调上报给 MainWindow（嵌套在 if 内的元素 id 不能从外部访问，故用回调）。
    callback text_focus_changed(bool);
    callback search_idle_toggled(bool);
    callback search_idle_minutes_changed(int);
    callback search_max_results_changed(int);
    // 分组列表内容高度（Rust 按模型计算）。与 Slint 侧实测值取 max，
    // 任一来源少报都不会导致内容被裁切后无法滚动到。
    in property <length> content-height: 0px;

    callback nav_changed(id: string);
    callback action_toggled(id: string, enabled: bool);
    callback group_toggled(name: string, expanded: bool);
    callback action_add();
    callback action_edit(id: string);
    callback action_delete(id: string);
    // 诊断：滚动几何变化时回报（视口 / 内容 / 实测首选高度）。
    callback scroll_debug(viewport: length, content: length, preferred: length);

    background: Theme.bg-main;

    // 点击空白关闭右键菜单
    if (root.menu-open) : TouchArea {
        width: 100%;
        height: 100%;
        z: 99;
        clicked => { root.menu-open = false; }
    }

    HorizontalLayout {
        spacing: 0px;
        width: 100%;
        height: 100%;

        // 左侧子导航
        Rectangle {
            width: 200px;
            height: 100%;
            background: Theme.bg-sidebar;

            VerticalLayout {
                x: 0px;
                y: 16px;
                width: 100%;

                for nav in root.nav-items : Rectangle {
                    height: 40px;
                    background: nav.selected ? Theme.bg-hover : transparent;

                    HorizontalLayout {
                        x: 16px;
                        width: parent.width - 32px;
                        height: parent.height;

                        Text {
                            text: nav.label;
                            color: nav.selected ? Theme.text-primary : Theme.text-secondary;
                            font-size: 13px;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                    }

                    TouchArea {
                        width: 100%;
                        height: 100%;
                        clicked => {
                            root.nav_changed(nav.id);
                        }
                    }
                }
            }
        }

        // 右侧内容区（占满右半区，右边框直达窗口最边缘，与 file_list 滚动条
        // 处于同一垂直线）。外层取消右边距，把呼吸感下放到标题/描述/子页——
        // 如此自绘滚动条紧贴窗口右缘，不再悬浮于页面半空。
        // 注意：不要给这个布局写 height:100%。它是 HorizontalLayout 的子布局，
        // 交叉轴（纵向）本就会被布局器撑满；显式写高度反而会覆盖该行为。
        VerticalLayout {
            horizontal-stretch: 1;
            padding-left: 24px;
            padding-top: 20px;
            padding-bottom: 20px;
            spacing: 16px;

            // 页面标题 + 新增按钮
            Rectangle {
                height: 38px;

                HorizontalLayout {
                    padding-left: 0px;
                    padding-right: 24px;
                    height: parent.height;

                    Text {
                        text: root.page-title;
                        color: Theme.text-primary;
                        font-size: 18px;
                        font-weight: 600;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }

                    if (root.show-add) : Rectangle {
                        width: 90px;
                        height: 32px;
                        background: add-ta.has-hover ? Theme.accent-hover : Theme.accent;
                        border-radius: 6px;

                        Text {
                            text: I18n.strings[4];
                            color: white;
                            font-size: 12px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            width: 100%;
                            height: 100%;
                        }

                        add-ta := TouchArea {
                            width: 100%;
                            height: 100%;
                            clicked => {
                                root.action_add();
                            }
                        }
                    }

                    // 快捷键页面的「全部恢复默认」按钮
                    if (root.page-title == I18n.strings[45]) : Rectangle {
                        width: 104px;
                        height: 30px;
                        border-radius: 6px;
                        border-width: 1px;
                        border-color: Theme.border;
                        background: reset-all-ta.has-hover ? Theme.bg-hover : Theme.bg-input;

                        Text {
                            text: I18n.strings[20];
                            color: Theme.text-secondary;
                            font-size: 12px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            width: 100%;
                            height: 100%;
                        }

                        reset-all-ta := TouchArea {
                            width: 100%;
                            height: 100%;
                            clicked => { root.shortcut_reset_all_clicked(); }
                        }
                    }
                }
            }

            HorizontalLayout {
                padding-right: 24px;
                Text {
                    text: root.page-desc;
                    color: Theme.text-secondary;
                    font-size: 12px;
                    wrap: word-wrap;
                }
            }

            // ---- 子页 1：通用设置面板 ----
            if (root.page-title == I18n.strings[79]) : SettingsScrollContainer {
                content-height: gen-layout.preferred-height + 28px;

                gen-layout := VerticalLayout {
                    width: 100%;
                    padding-right: 24px;
                    spacing: 12px;
                    alignment: start;

                    // 接管资源管理器：文件夹 / 磁盘 / 此电脑的默认打开程序改为 Rove。
                    Rectangle {
                        width: 100%;
                        background: gen-takeover-ta.has-hover ? Theme.bg-hover : Theme.bg-input;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: Theme.border;
                        height: 58px;

                        gen-takeover-ta := TouchArea {
                            width: 100%;
                            height: 100%;
                            clicked => {
                                root.explorer-takeover = !root.explorer-takeover;
                                root.explorer_takeover_toggled(root.explorer-takeover);
                            }
                        }

                        HorizontalLayout {
                            padding-left: 16px;
                            padding-right: 16px;
                            spacing: 12px;

                            VerticalLayout {
                                alignment: center;
                                spacing: 2px;
                                horizontal-stretch: 1;

                                Text {
                                    text: I18n.strings[238];
                                    color: Theme.text-primary;
                                    font-size: 13px;
                                    font-weight: 500;
                                    overflow: elide;
                                }
                                Text {
                                    text: I18n.strings[239];
                                    color: Theme.text-secondary;
                                    font-size: 11px;
                                    overflow: elide;
                                }
                            }

                            Toggle {
                                y: (parent.height - self.height) / 2;
                                checked: root.explorer-takeover;
                                toggled => {
                                    root.explorer-takeover = !root.explorer-takeover;
                                    root.explorer_takeover_toggled(root.explorer-takeover);
                                }
                            }
                        }
                    }

                    // 开机自启动：登录 Windows 时后台常驻（托盘 + 对话框吸附 + 索引预热）。
                    Rectangle {
                        width: 100%;
                        background: gen-autostart-ta.has-hover ? Theme.bg-hover : Theme.bg-input;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: Theme.border;
                        height: 58px;

                        gen-autostart-ta := TouchArea {
                            width: 100%;
                            height: 100%;
                            clicked => {
                                root.autostart = !root.autostart;
                                root.autostart_toggled(root.autostart);
                            }
                        }

                        HorizontalLayout {
                            padding-left: 16px;
                            padding-right: 16px;
                            spacing: 12px;

                            VerticalLayout {
                                alignment: center;
                                spacing: 2px;
                                horizontal-stretch: 1;

                                Text {
                                    text: I18n.strings[244];
                                    color: Theme.text-primary;
                                    font-size: 13px;
                                    font-weight: 500;
                                    overflow: elide;
                                }
                                Text {
                                    text: I18n.strings[245];
                                    color: Theme.text-secondary;
                                    font-size: 11px;
                                    overflow: elide;
                                }
                            }

                            Toggle {
                                y: (parent.height - self.height) / 2;
                                checked: root.autostart;
                                toggled => {
                                    root.autostart = !root.autostart;
                                    root.autostart_toggled(root.autostart);
                                }
                            }
                        }
                    }

                    Rectangle {
                        width: 100%;
                        background: gen-row-ta.has-hover ? Theme.bg-hover : Theme.bg-input;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: Theme.border;
                        height: 58px;

                        gen-row-ta := TouchArea {
                            width: 100%;
                            height: 100%;
                            clicked => {
                                root.show-hidden = !root.show-hidden;
                                root.show_hidden_toggled(root.show-hidden);
                            }
                        }

                        HorizontalLayout {
                            padding-left: 16px;
                            padding-right: 16px;
                            spacing: 12px;

                            VerticalLayout {
                                alignment: center;
                                spacing: 2px;
                                horizontal-stretch: 1;

                                Text {
                                    text: I18n.strings[53];
                                    color: Theme.text-primary;
                                    font-size: 13px;
                                    font-weight: 500;
                                    overflow: elide;
                                }
                                Text {
                                    text: I18n.strings[21];
                                    color: Theme.text-secondary;
                                    font-size: 11px;
                                    overflow: elide;
                                }
                            }

                            Toggle {
                                y: (parent.height - self.height) / 2;
                                checked: root.show-hidden;
                                toggled => {
                                    root.show-hidden = !root.show-hidden;
                                    root.show_hidden_toggled(root.show-hidden);
                                }
                            }
                        }
                    }

                    // 新建标签时是否自动进入地址栏编辑态（默认关闭）。
                    Rectangle {
                        width: 100%;
                        background: gen-auto-edit-ta.has-hover ? Theme.bg-hover : Theme.bg-input;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: Theme.border;
                        height: 58px;

                        gen-auto-edit-ta := TouchArea {
                            width: 100%;
                            height: 100%;
                            clicked => {
                                root.auto-edit-path-on-new-tab = !root.auto-edit-path-on-new-tab;
                                root.auto_edit_path_on_new_tab_toggled(root.auto-edit-path-on-new-tab);
                            }
                        }

                        HorizontalLayout {
                            padding-left: 16px;
                            padding-right: 16px;
                            spacing: 12px;

                            VerticalLayout {
                                alignment: center;
                                spacing: 2px;
                                horizontal-stretch: 1;

                                Text {
                                    text: I18n.strings[233];
                                    color: Theme.text-primary;
                                    font-size: 13px;
                                    font-weight: 500;
                                    overflow: elide;
                                }
                                Text {
                                    text: I18n.strings[234];
                                    color: Theme.text-secondary;
                                    font-size: 11px;
                                    overflow: elide;
                                }
                            }

                            Toggle {
                                y: (parent.height - self.height) / 2;
                                checked: root.auto-edit-path-on-new-tab;
                                toggled => {
                                    root.auto-edit-path-on-new-tab = !root.auto-edit-path-on-new-tab;
                                    root.auto_edit_path_on_new_tab_toggled(root.auto-edit-path-on-new-tab);
                                }
                            }
                        }
                    }

                    ComboRow {
                        // 展开时抬高层级：否则下拉列表会被布局里更靠后的行盖住。
                        z: self.open ? 10 : 0;
                        label: I18n.strings[85];
                        options: [I18n.strings[86], I18n.strings[87], I18n.strings[88]];
                        selected: root.language-index;
                        selection_changed(i) => {
                            root.language-index = i;
                            root.language_changed(i);
                        }
                    }

                    ComboRow {
                        z: self.open ? 10 : 0;
                        label: I18n.strings[89];
                        options: [I18n.strings[90], I18n.strings[91]];
                        selected: root.startup-index;
                        selection_changed(i) => {
                            root.startup-index = i;
                            root.startup_changed(i);
                        }
                    }
                }
            }

            // ---- 子页：搜索与索引 ----
            if (root.page-title == I18n.strings[50]) : SettingsScrollContainer {
                content-height: search-layout.preferred-height + 28px;

                // 点击本页空白处：释放文本框焦点。
                // 必须放在这个 if 块内——才能直接访问 input-ta（跨 if 作用域访问 id 会被 Slint 拒绝）。
                // 声明在内容之前（最底层）：内容区 Rectangle/布局不消费指针事件，
                // 空白处的点击会穿透到这里，而各级按钮 TouchArea 仍在上层正常工作。
                TouchArea {
                    width: 100%;
                    height: 100%;
                    clicked => {
                        input-ta.blur-input();
                    }
                }

                search-layout := VerticalLayout {
                    x: 0px;
                    y: 0px;
                    width: parent.width;
                    padding-top: 4px;
                    padding-right: 24px;
                    padding-bottom: 24px;
                    spacing: 16px;
                    alignment: start;

                    // 1. 顶部指标看板卡片
                    Rectangle {
                        width: 100%;
                        background: Theme.bg-input;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: Theme.border;
                        height: 126px;

                        VerticalLayout {
                            padding: 14px;
                            spacing: 12px;

                            // 卡片头部：状态与重新扫描按钮
                            HorizontalLayout {
                                height: 28px;
                                spacing: 8px;

                                Rectangle {
                                    width: 8px;
                                    height: 8px;
                                    border-radius: 4px;
                                    y: (parent.height - self.height) / 2;
                                    background: root.search-ready ? Theme.accent : #E67E22;
                                }

                                Text {
                                    text: root.search-status-text;
                                    color: root.search-ready ? Theme.accent : #E67E22;
                                    font-size: 12px;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                }

                                // 重新扫描驱动器按钮
                                Rectangle {
                                    width: 132px;
                                    height: 28px;
                                    y: (parent.height - self.height) / 2;
                                    border-radius: 6px;
                                    border-width: 1px;
                                    border-color: Theme.border;
                                    background: rescan-ta.has-hover ? Theme.bg-hover : Theme.bg-main;

                                    HorizontalLayout {
                                        alignment: center;
                                        spacing: 6px;

                                        IconRefresh { size: 12px; icon-color: Theme.text-secondary; y: (parent.height - self.height) / 2; }

                                        Text {
                                            text: I18n.strings[80];
                                            color: Theme.text-primary;
                                            font-size: 11.5px;
                                            vertical-alignment: center;
                                        }
                                    }

                                    rescan-ta := TouchArea {
                                        width: 100%;
                                        height: 100%;
                                        clicked => { root.search_rescan_clicked(); }
                                    }
                                }
                            }

                            // 4 栏指标网格
                            HorizontalLayout {
                                height: 58px;
                                spacing: 10px;

                                // 指标 1：已索引项目
                                Rectangle {
                                    height: 58px;
                                    horizontal-stretch: 1;
                                    background: Theme.bg-main;
                                    border-radius: 6px;
                                    VerticalLayout {
                                        alignment: center;
                                        spacing: 2px;
                                        Text { text: root.search-items-count; font-size: 15px; font-weight: 600; color: Theme.text-primary; horizontal-alignment: center; }
                                        Text { text: I18n.strings[41]; font-size: 10.5px; color: Theme.text-secondary; horizontal-alignment: center; }
                                    }
                                }

                                // 指标 2：索引大小
                                Rectangle {
                                    height: 58px;
                                    horizontal-stretch: 1;
                                    background: Theme.bg-main;
                                    border-radius: 6px;
                                    VerticalLayout {
                                        alignment: center;
                                        spacing: 2px;
                                        Text { text: root.search-size-text; font-size: 15px; font-weight: 600; color: Theme.text-primary; horizontal-alignment: center; }
                                        Text { text: I18n.strings[22]; font-size: 10.5px; color: Theme.text-secondary; horizontal-alignment: center; }
                                    }
                                }

                                // 指标 3：驱动器
                                Rectangle {
                                    height: 58px;
                                    horizontal-stretch: 1;
                                    background: Theme.bg-main;
                                    border-radius: 6px;
                                    VerticalLayout {
                                        alignment: center;
                                        spacing: 2px;
                                        Text { text: root.search-drives-count; font-size: 15px; font-weight: 600; color: Theme.text-primary; horizontal-alignment: center; }
                                        Text { text: I18n.strings[42]; font-size: 10.5px; color: Theme.text-secondary; horizontal-alignment: center; }
                                    }
                                }

                                // 指标 4：上次同步
                                Rectangle {
                                    height: 58px;
                                    horizontal-stretch: 1;
                                    background: Theme.bg-main;
                                    border-radius: 6px;
                                    VerticalLayout {
                                        alignment: center;
                                        spacing: 2px;
                                        Text { text: root.search-last-scan-time; font-size: 15px; font-weight: 600; color: Theme.text-primary; horizontal-alignment: center; }
                                        Text { text: I18n.strings[6]; font-size: 10.5px; color: Theme.text-secondary; horizontal-alignment: center; }
                                    }
                                }
                            }
                        }
                    }

                    // 2. 驱动器管理卡片
                    Rectangle {
                        width: 100%;
                        background: Theme.bg-input;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: Theme.border;
                        height: 44px + root.search-drives.length * 44px;

                        VerticalLayout {
                            padding-left: 16px;
                            padding-right: 16px;
                            padding-top: 10px;
                            padding-bottom: 10px;
                            spacing: 0px;

                            Text {
                                height: 24px;
                                text: I18n.strings[84];
                                color: Theme.text-secondary;
                                font-size: 12px;
                                font-weight: 600;
                            }

                            for drive in root.search-drives : Rectangle {
                                height: 44px;
                                background: d-ta.has-hover ? Theme.bg-hover : transparent;
                                border-radius: 6px;

                                d-ta := TouchArea {
                                    width: 100%;
                                    height: 100%;
                                    clicked => { root.search_drive_toggled(drive.letter, !drive.indexed); }
                                }

                                HorizontalLayout {
                                    padding-left: 8px;
                                    padding-right: 8px;
                                    spacing: 12px;

                                    Text {
                                        text: drive.is-ssd ? "⚡" : "🖴";
                                        color: drive.is-ssd ? Theme.accent : Theme.text-secondary;
                                        font-size: 14px;
                                        font-family: Theme.symbol-font-family;
                                        vertical-alignment: center;
                                    }

                                    VerticalLayout {
                                        alignment: center;
                                        horizontal-stretch: 1;
                                        spacing: 1px;
                                        Text {
                                            text: drive.label + " (" + drive.letter + ":)";
                                            color: Theme.text-primary;
                                            font-size: 13px;
                                            font-weight: 500;
                                            overflow: elide;
                                        }
                                        Text {
                                            text: drive.total-space;
                                            color: Theme.text-secondary;
                                            font-size: 11px;
                                        }
                                    }

                                    // 状态角标
                                    Rectangle {
                                        width: 50px;
                                        height: 20px;
                                        y: (parent.height - self.height) / 2;
                                        border-radius: 4px;
                                        background: drive.indexed ? Theme.accent.transparentize(0.85) : Theme.bg-badge;
                                        Text {
                                            text: drive.indexed ? I18n.strings[40] : I18n.strings[57];
                                            color: drive.indexed ? Theme.accent : Theme.text-disabled;
                                            font-size: 10.5px;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                            width: 100%;
                                            height: 100%;
                                        }
                                    }

                                    Toggle {
                                        y: (parent.height - self.height) / 2;
                                        checked: drive.indexed;
                                        toggled => { root.search_drive_toggled(drive.letter, !drive.indexed); }
                                    }
                                }
                            }
                        }
                    }

                    // 3. 忽略与排除路径
                    Rectangle {
                        width: 100%;
                        background: Theme.bg-input;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: Theme.border;
                        height: 126px; // 删减了一行副标题，高度回缩

                        VerticalLayout {
                            padding: 12px;
                            spacing: 12px;

                            // 标题行
                            HorizontalLayout {
                                height: 20px;
                                spacing: 8px;
                                Text { text: I18n.strings[46]; font-size: 12px; font-weight: 600; color: Theme.text-secondary; }
                            }

                            // 操作栏：选择 + 输入框 + 添加 + 恢复
                            HorizontalLayout {
                                height: 28px;
                                spacing: 8px;

                                // 选择按钮
                                Rectangle {
                                    width: 52px;
                                    height: 100%;
                                    border-radius: 5px;
                                    border-width: 1px;
                                    border-color: Theme.border;
                                    background: pick-ta.has-hover ? Theme.bg-hover : Theme.bg-main;

                                    Text {
                                        text: I18n.strings[78];
                                        color: Theme.text-primary;
                                        font-size: 11px;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                        width: 100%;
                                        height: 100%;
                                    }

                                    pick-ta := TouchArea {
                                        width: 100%;
                                        height: 100%;
                                        clicked => { root.search_pick_folder_clicked(); }
                                    }
                                }

                                // 输入框（自适应拉伸）
                                Rectangle {
                                    horizontal-stretch: 1;
                                    height: 100%;
                                    border-radius: 5px;
                                    border-width: 1px;
                                    border-color: input-ta.has-focus ? Theme.accent : Theme.border;
                                    background: Theme.bg-main;

                                    input-ta := SingleLineEdit {
                                        mouse-pressed: root.mouse-pressed;
                                        x: 8px;
                                        width: parent.width - 16px;
                                        height: 100%;
                                        text <=> root.exclude-input-text;
                                        text-color: Theme.text-primary;
                                        font-size: 11px;

                                        // 与“添加”按钮完全同一个回调：回车即添加。
                                        // 注：这里刻意不做任何「失焦即提交」——文本框失焦时序不可靠
                                        // （focus() 写在自身 init 里时，“获得焦点”不会被 changed 观察到，
                                        //  “失去焦点”却可能假触发），状态变更只挂在可确定的用户动作上。
                                        accepted(_t) => {
                                            root.search_add_exclusion_clicked();
                                        }

                                        // 上报聚焦态，供 Rust 放行按键（否则 Enter 被全局 keymap 吃掉）。
                                        focus-changed(has) => {
                                            root.text_focus_changed(has);
                                        }

                                        // 点击页面空白处 → 释放焦点（见下方背景 TouchArea）。
                                    }

                                    // 占位提示：仅当输入为空且未聚焦时显示。
                                    if (root.exclude-input-text == "" && !input-ta.has-focus) : Text {
                                        x: 8px;
                                        width: parent.width - 16px;
                                        height: 100%;
                                        text: I18n.strings[48];
                                        color: Theme.text-disabled;
                                        font-size: 11px;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                }

                                // 添加按钮
                                Rectangle {
                                    width: 52px;
                                    height: 100%;
                                    border-radius: 5px;
                                    border-width: 1px;
                                    border-color: Theme.border;
                                    background: add-ex-ta.has-hover ? Theme.bg-hover : Theme.bg-main;

                                    Text {
                                        text: I18n.strings[63];
                                        color: Theme.accent;
                                        font-size: 11px;
                                        font-weight: 600;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                        width: 100%;
                                        height: 100%;
                                    }

                                    add-ex-ta := TouchArea {
                                        width: 100%;
                                        height: 100%;
                                        clicked => { root.search_add_exclusion_clicked(); }
                                    }
                                }

                                // 恢复默认按钮
                                Rectangle {
                                    width: 52px;
                                    height: 100%;
                                    border-radius: 5px;
                                    border-width: 1px;
                                    border-color: Theme.border;
                                    background: reset-ta.has-hover ? Theme.bg-hover : Theme.bg-main;

                                    Text {
                                        text: I18n.strings[47];
                                        color: Theme.text-secondary;
                                        font-size: 11px;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                        width: 100%;
                                        height: 100%;
                                    }

                                    reset-ta := TouchArea {
                                        width: 100%;
                                        height: 100%;
                                        clicked => { root.search_reset_exclusions_clicked(); }
                                    }
                                }
                            }

                            // 横向流式标签栏
                            tags-flick := Flickable {
                                height: 30px;
                                content-width: max(tags-layout.preferred-width, self.width);
                                interactive: false;

                                tags-layout := HorizontalLayout {
                                    x: 0px;
                                    y: 2px;
                                    height: 26px;
                                    spacing: 8px;

                                    // 核心修复：自定义项排在前面，这样新添加的（insert 0）会直接在最左侧！
                                    for item in root.search-custom-exclusions : Rectangle {
                                        height: 26px;
                                        // 核心防抖逻辑：用隐藏的 ghost-text 测量真实文本的宽度，防止悬停变成“删除”时宽度缩水闪烁
                                        width: min(max(ghost-text.preferred-width + 24px, 64px), 200px);
                                        border-radius: 5px;
                                        background: c-ta.has-hover ? Theme.close-hover : Theme.bg-main;
                                        border-width: 1px;
                                        border-color: c-ta.has-hover ? Theme.close-hover : Theme.border;

                                        // 用于测宽度的幽灵元素，不渲染只计算
                                        ghost-text := Text {
                                            text: item;
                                            visible: false;
                                        }

                                        c-ta := TouchArea {
                                            width: 100%;
                                            height: 100%;
                                            clicked => { root.search_remove_exclusion_clicked(item); }
                                        }

                                        c-txt := Text {
                                            text: c-ta.has-hover ? I18n.strings[23] : item;
                                            color: c-ta.has-hover ? #FFFFFF : Theme.text-primary;
                                            font-size: 11px;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                            width: 100%;
                                            height: 100%;
                                            overflow: elide;
                                        }
                                    }

                                    // 内置系统排除项排在后面（灰显，不可删除）
                                    for item in root.search-builtin-exclusions : Rectangle {
                                        height: 26px;
                                        width: bi-txt.preferred-width + 16px;
                                        border-radius: 5px;
                                        background: Theme.bg-badge;
                                        border-width: 1px;
                                        border-color: Theme.border.transparentize(0.5);

                                        bi-txt := Text {
                                            text: item;
                                            color: Theme.text-disabled;
                                            font-size: 11px;
                                            font-family: Theme.mono-font-family;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                            width: 100%;
                                            height: 100%;
                                        }
                                    }
                                }
                            }

                            // 横向滚动条（悬停加粗高亮 + 点击跳转 + 拖动滑块）
                            if (tags-flick.content-width > tags-flick.width) : Rectangle {
                                height: 6px;
                                width: 100%;
                                background: transparent;

                                property <length> max-scroll: max(1px, tags-flick.content-width - tags-flick.width);
                                property <length> thumb-w: max(32px, self.width * (tags-flick.width / max(tags-flick.content-width, 1px)));
                                property <length> max-travel: max(0px, self.width - self.thumb-w);
                                property <bool> active: h-track-ta.has-hover || h-track-ta.pressed;

                                // 视觉轨道：3px → 5px，命中区固定 6px
                                Rectangle {
                                    y: (parent.height - self.height) / 2;
                                    width: 100%;
                                    height: parent.active ? 5px : 3px;
                                    border-radius: self.height / 2;
                                    background: parent.active ? Theme.bg-hover : Theme.bg-main;

                                    animate height { duration: 120ms; }
                                    animate background { duration: 120ms; }
                                }

                                h-track-ta := TouchArea {
                                    width: 100%;
                                    height: 100%;

                                    property <length> drag-start-x: 0px;
                                    property <length> drag-start-scroll: 0px;

                                    pointer-event(event) => {
                                        if (event.kind == PointerEventKind.down) {
                                            // 按在滑块上直接拖拽；按在轨道空白处先跳转到该位置。
                                            let thumb-left = parent.max-travel * (-tags-flick.content-x / parent.max-scroll);
                                            if (self.mouse-x < thumb-left || self.mouse-x > thumb-left + parent.thumb-w) {
                                                let click-ratio = (self.mouse-x - parent.thumb-w / 2) / max(1px, parent.max-travel);
                                                tags-flick.content-x = -max(0.0, min(1.0, click-ratio)) * parent.max-scroll;
                                            }
                                            self.drag-start-scroll = tags-flick.content-x;
                                            self.drag-start-x = self.mouse-x;
                                        }
                                    }

                                    moved => {
                                        if (self.pressed && parent.max-travel > 0px) {
                                            let delta-x = self.mouse-x - self.drag-start-x;
                                            let delta-scroll = (delta-x / parent.max-travel) * parent.max-scroll;
                                            tags-flick.content-x = max(-parent.max-scroll, min(0px, self.drag-start-scroll - delta-scroll));
                                        }
                                    }
                                }

                                // 滑块本体（悬停/拖动时加粗加亮）
                                Rectangle {
                                    x: parent.max-travel * (-tags-flick.content-x / parent.max-scroll);
                                    y: (parent.height - self.height) / 2;
                                    width: parent.thumb-w;
                                    height: parent.active ? 5px : 3px;
                                    border-radius: self.height / 2;
                                    background: h-track-ta.pressed ? Theme.accent : (h-track-ta.has-hover ? Theme.text-secondary : Theme.border);
                                    opacity: parent.active ? 0.9 : 0.6;

                                    animate height { duration: 120ms; }
                                    animate background { duration: 120ms; }
                                    animate opacity { duration: 120ms; }
                                }
                            }
                        }
                    }

                    // 4. 自动化与结果策略卡片
                    Rectangle {
                        width: 100%;
                        background: Theme.bg-input;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: Theme.border;
                        height: 108px;

                        VerticalLayout {
                            padding-left: 16px;
                            padding-right: 16px;
                            padding-top: 10px;
                            padding-bottom: 10px;
                            spacing: 4px;

                            // 行 1：空闲重扫
                            HorizontalLayout {
                                height: 42px;
                                spacing: 12px;

                                VerticalLayout {
                                    alignment: center;
                                    horizontal-stretch: 1;
                                    spacing: 1px;
                                    Text { text: I18n.strings[69]; font-size: 13px; font-weight: 500; color: Theme.text-primary; }
                                    Text { text: I18n.strings[43]; font-size: 11px; color: Theme.text-secondary; overflow: elide; }
                                }

                                Toggle {
                                    y: (parent.height - self.height) / 2;
                                    checked: root.search-idle-enabled;
                                    toggled => {
                                        root.search-idle-enabled = !root.search-idle-enabled;
                                        root.search_idle_toggled(root.search-idle-enabled);
                                    }
                                }

                                // 步进器
                                Rectangle {
                                    width: 108px;
                                    height: 28px;
                                    y: (parent.height - self.height) / 2;
                                    border-radius: 6px;
                                    border-width: 1px;
                                    border-color: Theme.border;
                                    background: Theme.bg-main;
                                    opacity: root.search-idle-enabled ? 1.0 : 0.4;

                                    HorizontalLayout {
                                        Rectangle {
                                            width: 26px;
                                            background: idle-minus-ta.has-hover ? Theme.bg-hover : transparent;
                                            Text { text: "—"; color: Theme.text-secondary; font-size: 11px; horizontal-alignment: center; vertical-alignment: center; width: 100%; height: 100%; }
                                            idle-minus-ta := TouchArea {
                                                width: 100%;
                                                height: 100%;
                                                enabled: root.search-idle-enabled && root.search-idle-minutes > 10;
                                                clicked => {
                                                    root.search-idle-minutes = max(10, root.search-idle-minutes - 10);
                                                    root.search_idle_minutes_changed(root.search-idle-minutes);
                                                }
                                            }
                                        }
                                        Text {
                                            text: root.search-idle-minutes + I18n.strings[0];
                                            font-size: 11px;
                                            color: Theme.text-primary;
                                            font-weight: 500;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                            horizontal-stretch: 1;
                                        }
                                        Rectangle {
                                            width: 26px;
                                            background: idle-plus-ta.has-hover ? Theme.bg-hover : transparent;
                                            Text { text: "+"; color: Theme.text-secondary; font-size: 13px; horizontal-alignment: center; vertical-alignment: center; width: 100%; height: 100%; }
                                            idle-plus-ta := TouchArea {
                                                width: 100%;
                                                height: 100%;
                                                enabled: root.search-idle-enabled && root.search-idle-minutes < 360;
                                                clicked => {
                                                    root.search-idle-minutes = min(360, root.search-idle-minutes + 10);
                                                    root.search_idle_minutes_changed(root.search-idle-minutes);
                                                }
                                            }
                                        }
                                    }
                                }
                            }

                            // 行 2：结果上限限制
                            HorizontalLayout {
                                height: 42px;
                                spacing: 12px;

                                VerticalLayout {
                                    alignment: center;
                                    horizontal-stretch: 1;
                                    spacing: 1px;
                                    Text { text: I18n.strings[18]; font-size: 13px; font-weight: 500; color: Theme.text-primary; }
                                    Text { text: I18n.strings[82]; font-size: 11px; color: Theme.text-secondary; overflow: elide; }
                                }

                                // 步进器
                                Rectangle {
                                    width: 108px;
                                    height: 28px;
                                    y: (parent.height - self.height) / 2;
                                    border-radius: 6px;
                                    border-width: 1px;
                                    border-color: Theme.border;
                                    background: Theme.bg-main;

                                    HorizontalLayout {
                                        Rectangle {
                                            width: 26px;
                                            background: max-minus-ta.has-hover ? Theme.bg-hover : transparent;
                                            Text { text: "—"; color: Theme.text-secondary; font-size: 11px; horizontal-alignment: center; vertical-alignment: center; width: 100%; height: 100%; }
                                            max-minus-ta := TouchArea {
                                                width: 100%;
                                                height: 100%;
                                                enabled: root.search-max-results > 200;
                                                clicked => {
                                                    root.search-max-results = max(200, root.search-max-results - 200);
                                                    root.search_max_results_changed(root.search-max-results);
                                                }
                                            }
                                        }
                                        Text {
                                            text: root.search-max-results + I18n.strings[1];
                                            font-size: 11px;
                                            color: Theme.text-primary;
                                            font-weight: 500;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                            horizontal-stretch: 1;
                                        }
                                        Rectangle {
                                            width: 26px;
                                            background: max-plus-ta.has-hover ? Theme.bg-hover : transparent;
                                            Text { text: "+"; color: Theme.text-secondary; font-size: 13px; horizontal-alignment: center; vertical-alignment: center; width: 100%; height: 100%; }
                                            max-plus-ta := TouchArea {
                                                width: 100%;
                                                height: 100%;
                                                enabled: root.search-max-results < 5000;
                                                clicked => {
                                                    root.search-max-results = min(5000, root.search-max-results + 200);
                                                    root.search_max_results_changed(root.search-max-results);
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }



            // ---- 子页 2：本地右键菜单分组列表 ----
            if (root.page-title == I18n.strings[59]) : SettingsScrollContainer {
                content-height: max(root.content-height, groups-layout.preferred-height) + 28px;

                // 点击本页空白处 → 释放关键词输入框焦点。
                // 必须放在这个 if 块内：才能直接访问 hide-input-ta。
                // 声明在内容之前（最底层）：内容区不消费指针事件，空白处点击会穿透到这里。
                TouchArea {
                    width: 100%;
                    height: 100%;
                    clicked => {
                        hide-input-ta.blur-input();
                    }
                }

                groups-layout := VerticalLayout {
                    width: 100%;
                    padding-right: 24px;
                    spacing: 12px;
                    alignment: start;

                    // 隐藏的系统菜单项（关键词）：包含即隐藏，`!` 开头为精确匹配。
                    // 只作用于系统 / 第三方项，Rove 自己的菜单项不受影响。
                    Rectangle {
                        width: 100%;
                        background: Theme.bg-input;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: Theme.border;
                        // 12+20+12+28+12+30+12 = 126；出现横向滚动条时多留 12+6。
                        height: hide-tags-flick.content-width > hide-tags-flick.width ? 144px : 126px;

                        VerticalLayout {
                            padding: 12px;
                            spacing: 12px;

                            HorizontalLayout {
                                height: 20px;
                                Text { text: I18n.strings[83]; font-size: 12px; font-weight: 600; color: Theme.text-secondary; }
                            }

                            // 输入框 + 添加 + 恢复
                            HorizontalLayout {
                                height: 28px;
                                spacing: 8px;

                                Rectangle {
                                    horizontal-stretch: 1;
                                    height: 100%;
                                    border-radius: 5px;
                                    border-width: 1px;
                                    border-color: hide-input-ta.has-focus ? Theme.accent : Theme.border;
                                    background: Theme.bg-main;

                                    hide-input-ta := SingleLineEdit {
                                        mouse-pressed: root.mouse-pressed;
                                        x: 8px;
                                        width: parent.width - 16px;
                                        height: 100%;
                                        text <=> root.hide-input-text;
                                        text-color: Theme.text-primary;
                                        font-size: 11px;

                                        // 回车 = 添加（与「添加」按钮同一回调）。
                                        accepted(_t) => {
                                            root.menu_hide_add_clicked();
                                        }

                                        // 上报聚焦态，供 Rust 放行按键（否则 Enter 被全局 keymap 吃掉）。
                                        focus-changed(has) => {
                                            root.text_focus_changed(has);
                                        }
                                    }

                                    if (root.hide-input-text == "" && !hide-input-ta.has-focus) : Text {
                                        x: 8px;
                                        width: parent.width - 16px;
                                        height: 100%;
                                        text: I18n.strings[75];
                                        color: Theme.text-disabled;
                                        font-size: 11px;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                }

                                // 添加按钮
                                Rectangle {
                                    width: 52px;
                                    height: 100%;
                                    border-radius: 5px;
                                    border-width: 1px;
                                    border-color: Theme.border;
                                    background: hide-add-ta.has-hover ? Theme.bg-hover : Theme.bg-main;

                                    Text {
                                        text: I18n.strings[63];
                                        color: Theme.accent;
                                        font-size: 11px;
                                        font-weight: 600;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                        width: 100%;
                                        height: 100%;
                                    }

                                    hide-add-ta := TouchArea {
                                        width: 100%;
                                        height: 100%;
                                        clicked => { root.menu_hide_add_clicked(); }
                                    }
                                }

                                // 恢复默认按钮：把列表重置回默认那几条。
                                Rectangle {
                                    width: 52px;
                                    height: 100%;
                                    border-radius: 5px;
                                    border-width: 1px;
                                    border-color: Theme.border;
                                    background: hide-restore-ta.has-hover ? Theme.bg-hover : Theme.bg-main;

                                    Text {
                                        text: I18n.strings[47];
                                        color: Theme.text-secondary;
                                        font-size: 11px;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                        width: 100%;
                                        height: 100%;
                                    }

                                    hide-restore-ta := TouchArea {
                                        width: 100%;
                                        height: 100%;
                                        clicked => { root.menu_hide_restore_clicked(); }
                                    }
                                }
                            }

                            // 已添加的关键词（悬停变红并变成「删除」，点击即删）
                            hide-tags-flick := Flickable {
                                height: 30px;
                                content-width: max(hide-tags-layout.preferred-width, self.width);
                                interactive: false;

                                hide-tags-layout := HorizontalLayout {
                                    x: 0px;
                                    y: 2px;
                                    height: 26px;
                                    spacing: 8px;

                                    // 新添加的（insert 0）排在最左侧。
                                    for item in root.menu-hide-keywords : Rectangle {
                                        height: 26px;
                                        // 用隐藏的 ghost-text 测真实文本宽度：否则悬停变成「删除」时宽度会缩水闪烁。
                                        width: min(max(hide-ghost-text.preferred-width + 24px, 64px), 200px);
                                        border-radius: 5px;
                                        background: hide-c-ta.has-hover ? Theme.close-hover : Theme.bg-main;
                                        border-width: 1px;
                                        border-color: hide-c-ta.has-hover ? Theme.close-hover : Theme.border;

                                        hide-ghost-text := Text {
                                            text: item;
                                            visible: false;
                                        }

                                        hide-c-ta := TouchArea {
                                            width: 100%;
                                            height: 100%;
                                            clicked => { root.menu_hide_remove_clicked(item); }
                                        }

                                        hide-c-txt := Text {
                                            text: hide-c-ta.has-hover ? I18n.strings[23] : item;
                                            color: hide-c-ta.has-hover ? #FFFFFF : Theme.text-primary;
                                            font-size: 11px;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                            width: 100%;
                                            height: 100%;
                                            overflow: elide;
                                        }
                                    }
                                }
                            }

                            // 横向滚动条（悬停加粗高亮 + 点击跳转 + 拖动滑块）
                            if (hide-tags-flick.content-width > hide-tags-flick.width) : Rectangle {
                                height: 6px;
                                width: 100%;
                                background: transparent;

                                property <length> max-scroll: max(1px, hide-tags-flick.content-width - hide-tags-flick.width);
                                property <length> thumb-w: max(32px, self.width * (hide-tags-flick.width / max(hide-tags-flick.content-width, 1px)));
                                property <length> max-travel: max(0px, self.width - self.thumb-w);
                                property <bool> active: hide-h-track-ta.has-hover || hide-h-track-ta.pressed;

                                Rectangle {
                                    y: (parent.height - self.height) / 2;
                                    width: 100%;
                                    height: parent.active ? 5px : 3px;
                                    border-radius: self.height / 2;
                                    background: parent.active ? Theme.bg-hover : Theme.bg-main;

                                    animate height { duration: 120ms; }
                                    animate background { duration: 120ms; }
                                }

                                hide-h-track-ta := TouchArea {
                                    width: 100%;
                                    height: 100%;

                                    property <length> drag-start-x: 0px;
                                    property <length> drag-start-scroll: 0px;

                                    pointer-event(event) => {
                                        if (event.kind == PointerEventKind.down) {
                                            let thumb-left = parent.max-travel * (-hide-tags-flick.content-x / parent.max-scroll);
                                            if (self.mouse-x < thumb-left || self.mouse-x > thumb-left + parent.thumb-w) {
                                                let click-ratio = (self.mouse-x - parent.thumb-w / 2) / max(1px, parent.max-travel);
                                                hide-tags-flick.content-x = -max(0.0, min(1.0, click-ratio)) * parent.max-scroll;
                                            }
                                            self.drag-start-scroll = hide-tags-flick.content-x;
                                            self.drag-start-x = self.mouse-x;
                                        }
                                    }

                                    moved => {
                                        if (self.pressed && parent.max-travel > 0px) {
                                            let delta-x = self.mouse-x - self.drag-start-x;
                                            let delta-scroll = (delta-x / parent.max-travel) * parent.max-scroll;
                                            hide-tags-flick.content-x = max(-parent.max-scroll, min(0px, self.drag-start-scroll - delta-scroll));
                                        }
                                    }
                                }

                                Rectangle {
                                    x: parent.max-travel * (-hide-tags-flick.content-x / parent.max-scroll);
                                    y: (parent.height - self.height) / 2;
                                    width: parent.thumb-w;
                                    height: parent.active ? 5px : 3px;
                                    border-radius: self.height / 2;
                                    background: hide-h-track-ta.pressed ? Theme.accent : (hide-h-track-ta.has-hover ? Theme.text-secondary : Theme.border);
                                    opacity: parent.active ? 0.9 : 0.6;

                                    animate height { duration: 120ms; }
                                    animate background { duration: 120ms; }
                                    animate opacity { duration: 120ms; }
                                }
                            }
                        }
                    }

                    for group in root.action-groups : GroupCard {
                        width: 100%;
                        group: group;
                        toggled(id, enabled) => { root.action_toggled(id, enabled); }
                        group_toggled(name, expanded) => { root.group_toggled(name, expanded); }
                        edit(id) => { root.action_edit(id); }
                        delete(id) => { root.action_delete(id); }
                    }
                }
            }

            // ---- 子页：快捷键 ----
            if (root.page-title == I18n.strings[45]) : SettingsScrollContainer {
                content-height: keys-layout.preferred-height + 28px;

                keys-layout := VerticalLayout {
                    width: 100%;
                    padding-top: 4px;
                    padding-right: 24px;
                    padding-bottom: 24px;
                    spacing: 16px;
                    alignment: start;

                    for group in root.shortcut-groups : Rectangle {
                        background: Theme.bg-input;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: Theme.border;
                        height: 42px + group.items.length * 40px;

                        VerticalLayout {
                            padding-left: 16px;
                            padding-right: 16px;
                            padding-top: 10px;
                            padding-bottom: 10px;
                            spacing: 0px;

                            Text {
                                height: 24px;
                                text: group.name;
                                color: Theme.text-secondary;
                                font-size: 12px;
                                font-weight: 600;
                            }

                            for item in group.items : row-rect := Rectangle {
                                height: 42px;
                                border-radius: 6px;
                                background: row-k-ta.has-hover ? Theme.bg-hover : transparent;

                                // 全行点击：左键进入录制，右键弹出操作菜单
                                row-k-ta := TouchArea {
                                    width: 100%;
                                    height: 100%;
                                    pointer-event(event) => {
                                        if (event.kind == PointerEventKind.down) {
                                            if (event.button == PointerEventButton.right) {
                                                root.menu-target-id = item.id;
                                                root.menu-target-slot = item.slot-index;
                                                root.menu-target-custom = item.is-customized;
                                                root.menu-target-readonly = item.is-readonly;

                                                // 核心修复：absolute-position 精准换算到 SettingsPage 根坐标
                                                let row-top = row-rect.absolute-position.y - root.absolute-position.y;
                                                let row-left = row-rect.absolute-position.x - root.absolute-position.x;
                                                root.menu-x = min(root.width - 170px, max(10px, row-left + self.mouse-x));
                                                root.menu-y = min(root.height - (item.slot-index > 0 ? 144px : 112px), row-top + self.mouse-y + 4px);
                                                root.menu-open = true;
                                            } else if (event.button == PointerEventButton.left) {
                                                if (!item.is-readonly) {
                                                    root.shortcut_record_clicked(item.id, item.slot-index);
                                                }
                                            }
                                        }
                                    }
                                }

                                HorizontalLayout {
                                    spacing: 12px;
                                    padding-left: 8px;
                                    padding-right: 8px;

                                    // 名称与槽位/锁定标识
                                    HorizontalLayout {
                                        horizontal-stretch: 1;
                                        spacing: 6px;
                                        alignment: start;

                                        Text {
                                            text: item.name;
                                            color: item.is-readonly ? Theme.text-secondary : Theme.text-primary;
                                            font-size: 13px;
                                            vertical-alignment: center;
                                        }
                                        if (item.slot-index > 0) : Text {
                                            text: I18n.strings[2];
                                            color: Theme.text-disabled;
                                            font-size: 11px;
                                            vertical-alignment: center;
                                        }
                                        if (item.is-readonly) : Text {
                                            text: I18n.strings[3];
                                            color: Theme.text-disabled;
                                            font-size: 11px;
                                            vertical-alignment: center;
                                        }
                                    }

                                    // 按键芯片（录制提示用中文字体，绝无方块字）
                                    Rectangle {
                                        height: 26px;
                                        width: max(key-txt.preferred-width + 16px, 48px);
                                        y: (parent.height - self.height) / 2;
                                        border-radius: 5px;
                                        border-width: 1px;
                                        border-color: root.recording-item-key == item.item-key
                                            ? Theme.accent
                                            : (item.is-readonly ? Theme.border.transparentize(0.5) : Theme.border);
                                        background: root.recording-item-key == item.item-key
                                            ? Theme.accent.transparentize(0.85)
                                            : (item.is-readonly ? Theme.bg-input : Theme.bg-main);

                                        key-txt := Text {
                                            text: root.recording-item-key == item.item-key
                                                ? I18n.strings[73]
                                                : (item.chord == "" ? "—" : item.chord);
                                            color: root.recording-item-key == item.item-key
                                                ? Theme.accent
                                                : (item.chord == "" ? Theme.text-disabled : Theme.text-primary);
                                            font-size: 11.5px;
                                            // 关键修复：录制中强制使用中文字体，避免西文 Mono 字体缺中文字形
                                            font-family: root.recording-item-key == item.item-key
                                                ? Theme.font-family
                                                : Theme.mono-font-family;
                                            font-weight: 500;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                            width: 100%;
                                            height: 100%;
                                        }
                                    }

                                    // 更多操作按钮 ⋮（符号字体，防 Emoji 回退）
                                    more-btn := Rectangle {
                                        width: 24px;
                                        height: 26px;
                                        y: (parent.height - self.height) / 2;
                                        border-radius: 4px;
                                        background: more-ta.has-hover ? Theme.bg-hover : transparent;

                                        Text {
                                            text: "⋮";
                                            color: Theme.text-secondary;
                                            font-size: 13px;
                                            font-family: Theme.symbol-font-family;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                            width: 100%;
                                            height: 100%;
                                        }

                                        more-ta := TouchArea {
                                            width: 100%;
                                            height: 100%;
                                            clicked => {
                                                root.menu-target-id = item.id;
                                                root.menu-target-slot = item.slot-index;
                                                root.menu-target-custom = item.is-customized;
                                                root.menu-target-readonly = item.is-readonly;

                                                // 核心修复：点击 ⋮ 时精准定位在按钮左下方
                                                let btn-top = more-btn.absolute-position.y - root.absolute-position.y;
                                                let btn-left = more-btn.absolute-position.x - root.absolute-position.x;
                                                root.menu-x = max(10px, btn-left - 130px);
                                                root.menu-y = min(root.height - (item.slot-index > 0 ? 144px : 112px), btn-top + 28px);
                                                root.menu-open = true;
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }

        }
    }

    // ---- 复刻 Sigma 右键快捷菜单 ----
    if (root.menu-open) : Rectangle {
        x: root.menu-x;
        y: root.menu-y;
        z: 100;
        width: 164px;
        height: root.menu-target-slot > 0 ? 134px : 102px; // 备用行多一项，高度自适应
        background: Theme.bg-popup;
        border-radius: 6px;
        border-width: 1px;
        border-color: Theme.border;
        drop-shadow-blur: 12px;
        drop-shadow-color: #00000033;

        VerticalLayout {
            padding: 4px;
            spacing: 2px;

            // 1. 重置快捷键
            Rectangle {
                height: 28px;
                border-radius: 4px;
                background: mi-reset-ta.has-hover ? Theme.bg-hover : transparent;
                opacity: root.menu-target-custom ? 1.0 : 0.4;

                Text {
                    x: 10px;
                    text: I18n.strings[81];
                    color: Theme.text-primary;
                    font-size: 12px;
                    vertical-alignment: center;
                }

                mi-reset-ta := TouchArea {
                    enabled: root.menu-target-custom;
                    clicked => {
                        root.menu-open = false;
                        root.shortcut_reset_clicked(root.menu-target-id, root.menu-target-slot);
                    }
                }
            }

            // 2. 取消绑定
            Rectangle {
                height: 28px;
                border-radius: 4px;
                background: mi-unbind-ta.has-hover ? Theme.bg-hover : transparent;
                opacity: !root.menu-target-readonly ? 1.0 : 0.4;

                Text {
                    x: 10px;
                    text: I18n.strings[28];
                    color: Theme.text-primary;
                    font-size: 12px;
                    vertical-alignment: center;
                }

                mi-unbind-ta := TouchArea {
                    enabled: !root.menu-target-readonly;
                    clicked => {
                        root.menu-open = false;
                        root.shortcut_unbind_clicked(root.menu-target-id, root.menu-target-slot);
                    }
                }
            }

            // 3. 添加备用快捷键绑定
            Rectangle {
                height: 28px;
                border-radius: 4px;
                background: mi-alt-ta.has-hover ? Theme.bg-hover : transparent;
                opacity: !root.menu-target-readonly ? 1.0 : 0.4;

                Text {
                    x: 10px;
                    text: I18n.strings[64];
                    color: Theme.text-primary;
                    font-size: 12px;
                    vertical-alignment: center;
                }

                mi-alt-ta := TouchArea {
                    enabled: !root.menu-target-readonly;
                    clicked => {
                        root.menu-open = false;
                        root.shortcut_add_alternate_clicked(root.menu-target-id);
                    }
                }
            }

            // 4. 移除备用快捷键绑定（仅在备用槽位显示，危险红）
            if (root.menu-target-slot > 0) : Rectangle {
                height: 28px;
                border-radius: 4px;
                background: mi-rm-ta.has-hover ? Theme.bg-hover : transparent;

                Text {
                    x: 10px;
                    text: I18n.strings[68];
                    color: #C0392B;
                    font-size: 12px;
                    vertical-alignment: center;
                }

                mi-rm-ta := TouchArea {
                    clicked => {
                        root.menu-open = false;
                        root.shortcut_remove_alternate_clicked(root.menu-target-id, root.menu-target-slot);
                    }
                }
            }
        }
    }
}

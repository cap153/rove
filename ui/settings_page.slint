// 设置页面（独立标签页）。
// 目前实现：左侧子导航 + 右侧「本地右键菜单」分组管理。

import { Theme, SettingsNavItem, SettingsActionGroup, SettingsActionItem } from "common.slint";

component Toggle inherits Rectangle {
    in-out property <bool> checked: true;
    in property <bool> enabled: true;
    callback toggled();

    width: 36px;
    height: 20px;
    border-radius: 10px;
    background: root.checked ? Theme.accent : Theme.border;
    opacity: root.enabled ? 1.0 : 0.4;

    Rectangle {
        x: root.checked ? parent.width - self.width - 2px : 2px;
        y: (parent.height - self.height) / 2;
        width: 16px;
        height: 16px;
        border-radius: 8px;
        background: white;
    }

    TouchArea {
        width: 100%;
        height: 100%;
        enabled: root.enabled;
        clicked => {
            root.checked = !root.checked;
            root.toggled();
        }
    }
}

component SettingRow inherits Rectangle {
    in property <SettingsActionItem> item;
    callback toggled(id: string, enabled: bool);
    callback edit(id: string);
    callback delete(id: string);

    height: 42px;
    background: transparent;

    HorizontalLayout {
        x: 16px;
        width: parent.width - 32px;
        height: parent.height;
        spacing: 12px;

        // 开关
        Toggle {
            y: (parent.height - self.height) / 2;
            checked: root.item.enabled;
            enabled: true;
            toggled => {
                root.toggled(root.item.id, self.checked);
            }
        }

        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 1px;

            Text {
                text: root.item.label;
                color: Theme.text-primary;
                font-size: 13px;
                overflow: elide;
            }

            Text {
                text: root.item.target + (root.item.extensions != "" ? " / " + root.item.extensions : "");
                color: Theme.text-secondary;
                font-size: 11px;
                overflow: elide;
            }
        }

        // 编辑按钮（仅自定义；builtin 行隐藏）。
        // 用文字而非 ✎/✕ 字形：部分系统字体缺这两个符号，会渲染成空白。
        Rectangle {
            visible: !root.item.builtin;
            width: 44px;
            height: 26px;
            y: (parent.height - self.height) / 2;
            border-radius: 6px;
            border-width: 1px;
            border-color: Theme.border;
            background: edit-ta.has-hover ? Theme.bg-hover : transparent;

            Text {
                text: "编辑";
                color: Theme.text-secondary;
                font-size: 11px;
                horizontal-alignment: center;
                vertical-alignment: center;
                width: 100%;
                height: 100%;
            }

            edit-ta := TouchArea {
                width: 100%;
                height: 100%;
                clicked => {
                    root.edit(root.item.id);
                }
            }
        }

        // 删除按钮（仅自定义；builtin 行隐藏）。
        Rectangle {
            visible: !root.item.builtin;
            width: 44px;
            height: 26px;
            y: (parent.height - self.height) / 2;
            border-radius: 6px;
            border-width: 1px;
            border-color: Theme.border;
            background: del-ta.has-hover ? Theme.bg-hover : transparent;

            Text {
                text: "删除";
                color: #C0392B;
                font-size: 11px;
                horizontal-alignment: center;
                vertical-alignment: center;
                width: 100%;
                height: 100%;
            }

            del-ta := TouchArea {
                width: 100%;
                height: 100%;
                clicked => {
                    root.delete(root.item.id);
                }
            }
        }
    }
}

component GroupCard inherits Rectangle {
    in property <SettingsActionGroup> group;
    callback toggled(id: string, enabled: bool);
    callback group_toggled(name: string, expanded: bool);
    callback edit(id: string);
    callback delete(id: string);

    height: root.group.expanded ? 44px + root.group.items.length * 42px : 44px;
    background: Theme.bg-input;
    border-radius: 8px;
    clip: true;

    VerticalLayout {
        width: 100%;

        Rectangle {
            height: 44px;

            HorizontalLayout {
                x: 16px;
                width: parent.width - 32px;
                height: parent.height;
                spacing: 8px;

                Text {
                    text: root.group.expanded ? "▼" : "▶";
                    color: Theme.text-secondary;
                    font-size: 10px;
                    vertical-alignment: center;
                    width: 14px;
                }

                Text {
                    text: root.group.name;
                    color: Theme.text-primary;
                    font-size: 13px;
                    font-weight: 500;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
            }

            TouchArea {
                width: 100%;
                height: 100%;
                clicked => {
                    root.group_toggled(root.group.name, !root.group.expanded);
                }
            }
        }

        Rectangle {
            height: root.group.expanded ? root.group.items.length * 42px : 0px;

            // 非布局父元素下的布局默认取首选宽度，必须显式撑满，
            // 否则行宽被压缩、右侧的编辑/删除按钮会被 clip 裁掉。
            VerticalLayout {
                width: 100%;
                spacing: 0px;

                for item in root.group.items : SettingRow {
                    item: item;
                    toggled(id, enabled) => {
                        root.toggled(id, enabled);
                    }
                    edit(id) => {
                        root.edit(id);
                    }
                    delete(id) => {
                        root.delete(id);
                    }
                }
            }
        }
    }
}

export component SettingsPage inherits Rectangle {
    in property <[SettingsNavItem]> nav-items: [];
    in property <[SettingsActionGroup]> action-groups: [];
    // 当前子页的标题 / 描述 / 是否显示「新增动作」入口。
    in property <string> page-title: "本地右键菜单";
    in property <string> page-desc: "开关控制菜单项显隐；内置动作仅允许开关，自定义动作可编辑或删除。";
    in property <bool> show-add: true;
    // 分组列表真实内容高度（Rust 按展开状态计算，驱动 Flickable 滚动范围）。
    in property <length> content-height: 0px;

    callback nav_changed(id: string);
    callback action_toggled(id: string, enabled: bool);
    callback group_toggled(name: string, expanded: bool);
    callback action_add();
    callback action_edit(id: string);
    callback action_delete(id: string);

    background: Theme.bg-main;

    HorizontalLayout {
        spacing: 0px;
        width: 100%;
        height: 100%;

        // 左侧子导航
        Rectangle {
            width: 200px;
            height: 100%;
            background: Theme.bg-sidebar;

            VerticalLayout {
                x: 0px;
                y: 16px;
                width: 100%;

                for nav in root.nav-items : Rectangle {
                    height: 40px;
                    background: nav.selected ? Theme.bg-hover : transparent;

                    HorizontalLayout {
                        x: 16px;
                        width: parent.width - 32px;
                        height: parent.height;
                        spacing: 10px;

                        Text {
                            text: nav.icon;
                            color: nav.selected ? Theme.accent : Theme.text-secondary;
                            font-size: 14px;
                            vertical-alignment: center;
                            width: 20px;
                        }

                        Text {
                            text: nav.label;
                            color: nav.selected ? Theme.text-primary : Theme.text-secondary;
                            font-size: 13px;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                    }

                    TouchArea {
                        width: 100%;
                        height: 100%;
                        clicked => {
                            root.nav_changed(nav.id);
                        }
                    }
                }
            }
        }

        // 右侧内容
        VerticalLayout {
            horizontal-stretch: 1;
            padding-left: 24px;
            padding-right: 24px;
            padding-top: 20px;
            padding-bottom: 20px;
            spacing: 16px;

            // 页面标题 + 新增按钮
            Rectangle {
                height: 38px;

                HorizontalLayout {
                    width: 100%;
                    height: parent.height;

                    Text {
                        text: root.page-title;
                        color: Theme.text-primary;
                        font-size: 18px;
                        font-weight: 600;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }

                    if (root.show-add) : Rectangle {
                        width: 90px;
                        height: 32px;
                        background: add-ta.has-hover ? Theme.accent-hover : Theme.accent;
                        border-radius: 6px;

                        Text {
                            text: "+ 新增动作";
                            color: white;
                            font-size: 12px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            width: 100%;
                            height: 100%;
                        }

                        add-ta := TouchArea {
                            width: 100%;
                            height: 100%;
                            clicked => {
                                root.action_add();
                            }
                        }
                    }
                }
            }

            Text {
                text: root.page-desc;
                color: Theme.text-secondary;
                font-size: 12px;
                wrap: word-wrap;
            }

            Flickable {
                visible: root.action-groups.length > 0;
                vertical-stretch: 1;
                content-height: max(root.content-height, self.height);

                VerticalLayout {
                    y: 0px;
                    width: 100%;
                    spacing: 12px;

                    for group in root.action-groups : GroupCard {
                        group: group;
                        toggled(id, enabled) => {
                            root.action_toggled(id, enabled);
                        }
                        group_toggled(name, expanded) => {
                            root.group_toggled(name, expanded);
                        }
                        edit(id) => {
                            root.action_edit(id);
                        }
                        delete(id) => {
                            root.action_delete(id);
                        }
                    }
                }
            }

            // 未实现的子页占位提示（有内容时隐藏）。
            if (root.action-groups.length == 0) : Text {
                text: "该设置页将在后续 Sprint 实现。";
                color: Theme.text-disabled;
                font-size: 12px;
                vertical-alignment: top;
            }
        }
    }
}

import { Button, LineEdit, ListView } from "std-widgets.slint";

export struct DiffRow {
    kind: string,
    old-line: int,
    new-line: int,
    text: string,
}

export component DiffWindow inherits Window {
    title: "文本对比";
    min-width: 860px;
    min-height: 560px;
    preferred-width: 980px;
    preferred-height: 640px;
    background: #f2f2f2;
    default-font-family: "Microsoft YaHei";

    in-out property <string> left-path;
    in-out property <string> right-path;
    in property <[DiffRow]> rows: [];
    in property <string> summary: "";
    in property <string> status-text: "";

    callback compare();
    callback close-window();

    VerticalLayout {
        padding: 10px;
        spacing: 8px;

        // 路径选择
        HorizontalLayout {
            height: 28px;
            spacing: 6px;
            Text { text: "旧"; width: 24px; vertical-alignment: center; font-size: 12px; color: #1a1a1a; }
            LineEdit {
                text <=> root.left-path;
                horizontal-stretch: 1;
                placeholder-text: "左侧文件路径";
            }
            Text { text: "新"; width: 24px; vertical-alignment: center; font-size: 12px; color: #1a1a1a; }
            LineEdit {
                text <=> root.right-path;
                horizontal-stretch: 1;
                placeholder-text: "右侧文件路径";
            }
            Button {
                text: "对比";
                width: 60px;
                clicked => { root.compare(); }
            }
        }

        HorizontalLayout {
            height: 22px;
            Text {
                text: root.summary;
                vertical-alignment: center;
                horizontal-stretch: 1;
                font-size: 11px;
                color: #555555;
            }
            Text {
                text: root.status-text;
                vertical-alignment: center;
                font-size: 11px;
                color: #555555;
            }
        }

        Rectangle {
            horizontal-stretch: 1;
            background: #ffffff;
            border-width: 1px;
            border-color: #d4d4d4;
            ListView {
                width: 100%;
                height: 100%;
                for row[i] in root.rows: Rectangle {
                    height: 22px;
                    background: row.kind == "add" ? #e6f4e6
                        : row.kind == "del" ? #fdeaea
                        : row.kind == "mod" ? #fff4d6
                        : #ffffff;
                    HorizontalLayout {
                        padding: 3px;
                        spacing: 6px;
                        Text {
                            text: row.old-line > 0 ? row.old-line : "";
                            width: 48px;
                            horizontal-alignment: right;
                            vertical-alignment: center;
                            font-size: 10px;
                            color: #8a8a8a;
                        }
                        Text {
                            text: row.new-line > 0 ? row.new-line : "";
                            width: 48px;
                            horizontal-alignment: right;
                            vertical-alignment: center;
                            font-size: 10px;
                            color: #8a8a8a;
                        }
                        Text {
                            text: row.kind == "add" ? "+" : row.kind == "del" ? "-" : row.kind == "mod" ? "~" : " ";
                            width: 12px;
                            vertical-alignment: center;
                            font-size: 11px;
                            color: row.kind == "add" ? #1e7b1e : row.kind == "del" ? #b02020 : row.kind == "mod" ? #8a6100 : #cccccc;
                        }
                        Text {
                            text: row.text;
                            horizontal-stretch: 1;
                            vertical-alignment: center;
                            font-family: "Consolas";
                            font-size: 11px;
                            color: #1a1a1a;
                            overflow: TextOverflow.elide;
                        }
                    }
                }
            }
        }

        HorizontalLayout {
            height: 28px;
            alignment: end;
            Button {
                text: "关闭";
                clicked => { root.close-window(); }
            }
        }
    }
}
